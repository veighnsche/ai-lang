// ALL_EXAMPLES.ail — every .ail program in the repo, concatenated for external review.
// REVIEW COPY ONLY: not a compilable unit. Each section is one real file; section
// headers give the repo path. Shipped programs come first, then the rejection gallery
// (broken-login/): each file there is intentionally rejected by the compiler.

// ===== sketches/auth-login/db.ail =====
// auth-login/db.ail — user lookup module.
// Type-discipline era: pw_hash is a branded secret (Db__Hash), not a
// bare str. Raw hashes enter the program only through seal, one explicit
// gate per construction site; the brand erases to string at runtime.
// Delimiter era: no curly braces anywhere in ai-lang.
//   () application + records (construction reads as a call)
//   [] enumerations (mod lists, given sequences)
//   :  declares (type fields)
//   =  binds (record fields)
// Drill: Db__User(id = ..., ...) instead of Db__User id: ... .
// Brand migration changed field types, so revs bump by rule:
// Db__User 3 -> 4, db__get_user 4 -> 5, Db__Hash starts at 1.

mod db
  provides [db__get_user, Db__User, Db__Hash]
  uses []
  emits [db.user_not_found, db.down]

error db.user_not_found(id: str)
error db.down()

brand Db__Hash is str rev 1

type Db__User rev 4 (
  id: str
  pw_hash: Db__Hash
  failed_attempts: int
)

fn db__get_user(id: str) -> Db__User rev 5
  emits [db.user_not_found, db.down]
  tests
    known_user(id = "u_01") => Ok(id = "u_01", pw_hash = seal Db__Hash("secret"), failed_attempts = 0)
    unknown_user(id = "u_99") => db.user_not_found(id = "u_99")
=
  match id
    "u_01" => Ok(id = "u_01", pw_hash = seal Db__Hash("secret"), failed_attempts = 0)
    _ => db.user_not_found(id = id)

// ai-lock.json (sketch):
//   "db.Db__Hash@1": "h4100", "db.Db__User@4": "h3d11", "db.db__get_user@5": "hb905"
// Revs 3/4 stay addressable under their hashes; pins decide who uses what.

// ===== sketches/auth-login/auth.ail =====
// auth-login/auth.ail — login with one retry, zero braces. Match arms are bare expressions with nesting
// shown by indentation. Tests read as call specifications:
// name(inputs) => expected output.
// Type-discipline era: the password is a branded secret (Auth__Password),
// the stored hash another brand (Db__Hash), and the two never meet in
// ail code. The comparison is a foreign predicate: auth__check_pw says
// Ok or auth.mismatch, and the proof wraps it. Secrets enter through
// seal only; grep seal is the whole audit.
// Helper era: the lockout-plus-password decision lives once in
// auth__verify, called from both the first try and the retry. The call
// sites carry no given table: the helper is deterministic per test,
// and its one check_pw table scripts every reaching test.

mod auth
  provides [auth__login, auth__verify, Auth__Session, Auth__Password, Auth__Verdict, auth__check_pw]
  uses [db__get_user@5, Db__User@4, Db__Hash@1]
  emits [auth.login_failed, auth.account_locked, auth.unavailable, auth.mismatch]

error auth.login_failed(user_id: str)
error auth.account_locked(user_id: str)
error auth.unavailable(reason: str)
error auth.mismatch()

brand Auth__Password is str rev 1

type Auth__Session rev 2 (
  user_id: str
  remaining_tries: int
)

type Auth__Verdict rev 1 (
)

extern auth__check_pw(pw: Auth__Password, hash: Db__Hash) -> Auth__Verdict rev 1
  emits [auth.mismatch]

fn auth__login(id: str, pw: Auth__Password) -> Auth__Session rev 5
  emits [auth.login_failed, auth.account_locked, auth.unavailable]
  tests
    happy(id = "u_01", pw = seal Auth__Password("secret")) => Ok(user_id = "u_01", remaining_tries = 3)
    flaky(id = "u_01", pw = seal Auth__Password("secret")) => Ok(user_id = "u_01", remaining_tries = 3)
    missing(id = "u_99", pw = seal Auth__Password("anything")) => auth.login_failed(user_id = "u_99")
    down(id = "u_01", pw = seal Auth__Password("secret")) => auth.unavailable(reason = "db down twice")
    locked(id = "u_01", pw = seal Auth__Password("secret")) => auth.account_locked(user_id = "u_01")
    badpw(id = "u_01", pw = seal Auth__Password("secret")) => auth.login_failed(user_id = "u_01")
    retry_badpw(id = "u_01", pw = seal Auth__Password("secret")) => auth.login_failed(user_id = "u_01")
    retry_missing(id = "u_99", pw = seal Auth__Password("anything")) => auth.login_failed(user_id = "u_99")
    retry_locked(id = "u_01", pw = seal Auth__Password("secret")) => auth.account_locked(user_id = "u_01")
=
  match call db__get_user(id)
    given
      happy => [exchange args (id = "u_01") outcome Ok(id = "u_01", pw_hash = seal Db__Hash("secret"), failed_attempts = 0)]
      flaky => [exchange args (id = "u_01") outcome db.down()]
      missing => [exchange args (id = "u_99") outcome db.user_not_found(id = "u_99")]
      down => [exchange args (id = "u_01") outcome db.down()]
      locked => [exchange args (id = "u_01") outcome Ok(id = "u_01", pw_hash = seal Db__Hash("secret"), failed_attempts = 5)]
      badpw => [exchange args (id = "u_01") outcome Ok(id = "u_01", pw_hash = seal Db__Hash("wrong"), failed_attempts = 0)]
      retry_badpw => [exchange args (id = "u_01") outcome db.down()]
      retry_missing => [exchange args (id = "u_99") outcome db.down()]
      retry_locked => [exchange args (id = "u_01") outcome db.down()]
      vh_ok => -
      vh_bad => -
      vh_locked => -
    on db.user_not_found _ => auth.login_failed(user_id = id)
    on db.down _ =>
      match call db__get_user(id)
        given
          happy => -
          flaky => [exchange args (id = "u_01") outcome Ok(id = "u_01", pw_hash = seal Db__Hash("secret"), failed_attempts = 0)]
          missing => -
          down => [exchange args (id = "u_01") outcome db.down()]
          locked => -
          badpw => -
          retry_badpw => [exchange args (id = "u_01") outcome Ok(id = "u_01", pw_hash = seal Db__Hash("wrong"), failed_attempts = 0)]
          retry_missing => [exchange args (id = "u_99") outcome db.user_not_found(id = "u_99")]
          retry_locked => [exchange args (id = "u_01") outcome Ok(id = "u_01", pw_hash = seal Db__Hash("secret"), failed_attempts = 5)]
          vh_ok => -
          vh_bad => -
          vh_locked => -
        on db.user_not_found _ => auth.login_failed(user_id = id)
        on db.down _ => auth.unavailable(reason = "db down twice")
        on Ok user => match call auth__verify(user.id, user.failed_attempts, pw, user.pw_hash)
          on auth.login_failed _ => auth.login_failed(user_id = user.id)
          on auth.account_locked _ => auth.account_locked(user_id = user.id)
          on Ok s => Ok(user_id = s.user_id, remaining_tries = s.remaining_tries)
    on Ok user => match call auth__verify(user.id, user.failed_attempts, pw, user.pw_hash)
      on auth.login_failed _ => auth.login_failed(user_id = user.id)
      on auth.account_locked _ => auth.account_locked(user_id = user.id)
      on Ok s => Ok(user_id = s.user_id, remaining_tries = s.remaining_tries)

fn auth__verify(user_id: str, failed_attempts: int, pw: Auth__Password, pw_hash: Db__Hash) -> Auth__Session rev 1
  emits [auth.login_failed, auth.account_locked]
  tests
    vh_ok(user_id = "u_01", failed_attempts = 0, pw = seal Auth__Password("secret"), pw_hash = seal Db__Hash("secret")) => Ok(user_id = "u_01", remaining_tries = 3)
    vh_bad(user_id = "u_01", failed_attempts = 1, pw = seal Auth__Password("secret"), pw_hash = seal Db__Hash("wrong")) => auth.login_failed(user_id = "u_01")
    vh_locked(user_id = "u_01", failed_attempts = 5, pw = seal Auth__Password("secret"), pw_hash = seal Db__Hash("secret")) => auth.account_locked(user_id = "u_01")
=
  match failed_attempts >= 3
    true => auth.account_locked(user_id = user_id)
    false => match call auth__check_pw(pw, pw_hash)
      given
        happy => [exchange args (pw = seal Auth__Password("secret"), hash = seal Db__Hash("secret")) outcome Ok()]
        flaky => [exchange args (pw = seal Auth__Password("secret"), hash = seal Db__Hash("secret")) outcome Ok()]
        missing => -
        down => -
        locked => -
        badpw => [exchange args (pw = seal Auth__Password("secret"), hash = seal Db__Hash("wrong")) outcome auth.mismatch()]
        retry_badpw => [exchange args (pw = seal Auth__Password("secret"), hash = seal Db__Hash("wrong")) outcome auth.mismatch()]
        retry_missing => -
        retry_locked => -
        vh_ok => [exchange args (pw = seal Auth__Password("secret"), hash = seal Db__Hash("secret")) outcome Ok()]
        vh_bad => [exchange args (pw = seal Auth__Password("secret"), hash = seal Db__Hash("wrong")) outcome auth.mismatch()]
        vh_locked => -
      on auth.mismatch _ => auth.login_failed(user_id = user_id)
      on Ok ok => Ok(user_id = user_id, remaining_tries = 3 - failed_attempts)

// Delimiter rules:
// 1. No curlies. Records construct with parens: Name(field = value).
//    Empty record: Name(). Construction and calls share one application
//    syntax; positional calls like db__get_user(id) stay legal for now,
//    full named-arg unification is open.
// 2. Colon declares, equals binds: (id: str) in types, (id = "u_01") in values.
// 3. Brackets enumerate: mod lists, given sequences. Nothing else.
// 4. Match arms are single expressions; nesting is indentation, including
//    an arm whose expression continues on the next line.
// 5. Helpers are intra-module calls: same-file callee, no uses pin, no
//    given table at the call site. The helper's own tables script
//    every reaching test, so shared logic is written once.

// ===== sketches/retry-loop/retry.ail =====
// retry-loop/retry.ail — retry with fuel, zero braces. The loop is a
// proven self-call: retry__fetch recurses only through decreases fuel,
// under the false arm of fuel <= 0 with fuel - 1 at the site, so the
// compiler sees termination before running a single test.
// Delete the decreases line and the same file is a cycle error —
// proof-gated admission (a11): the finite fuel trace never hangs;
// without the proof the compiler refuses to admit it.
// Tests read as call specifications: name(inputs) => expected output.

mod retry
  provides [retry__fetch, Retry__Doc, net__fetch]
  uses []
  emits [retry.exhausted, net.down]

error retry.exhausted()
error net.down()

type Retry__Doc rev 1 (
  body: str
)

extern net__fetch() -> Retry__Doc rev 1
  emits [net.down]

fn retry__fetch(fuel: int) -> Retry__Doc rev 1
  decreases fuel
  emits [retry.exhausted]
  tests
    now(fuel = 2) => Ok(body = "hi")
    later(fuel = 2) => Ok(body = "hi")
    never(fuel = 2) => retry.exhausted()
    empty(fuel = 0) => retry.exhausted()
=
  match fuel <= 0
    true => retry.exhausted()
    false => match call net__fetch()
      given
        now => [exchange args () outcome Ok(body = "hi")]
        later => [exchange args () outcome net.down(), exchange args () outcome Ok(body = "hi")]
        never => [exchange args () outcome net.down(), exchange args () outcome net.down()]
        empty => -
      on net.down _ => match call retry__fetch(fuel - 1)
        on retry.exhausted _ => retry.exhausted()
        on Ok d => Ok(body = d.body)
      on Ok d => Ok(body = d.body)

// ===== sketches/counter/counter.ail =====
// counter/counter.ail — a bounded counter, zero braces. State lives in
// one private cell; authority to touch it is declared per function.
// Every test starts from init, so three and three_again agree: the
// tables themselves prove sequential tests cannot interfere.
// Tests read as call specifications: name(inputs) => expected output.

mod counter
  provides [count__bump, count__twice, Count__Tally]
  uses []
  emits []

state Count__total: int = 0

type Count__Tally rev 1 (
  total: int
)

fn count__bump(by: int) -> Count__Tally rev 1
  effects [Count__total.read, Count__total.write]
  emits []
  tests
    three(by = 3) => Ok(total = 3)
    three_again(by = 3) => Ok(total = 3)
    zero(by = 0) => Ok(total = 0)
=
  match call state__get(Count__total)
    on Ok c => match call state__put(Count__total, c.value + by)
      on Ok _ => Ok(total = c.value + by)

fn count__twice(by: int) -> Count__Tally rev 1
  effects [Count__total.read, Count__total.write]
  emits []
  tests
    double(by = 2) => Ok(total = 4)
=
  match call count__bump(by)
    on Ok s => match call count__bump(by)
      on Ok t => Ok(total = t.total)

// ===== sketches/broken-login/db.ail =====
// broken-login/db.ail — shared provider for the squiggle demos.
// Clean file: opening it shows zero diagnostics.

mod db
  provides [db__get, Db__User]
  uses []
  emits [db.user_not_found, db.down]

error db.user_not_found(id: str)
error db.down()

type Db__User rev 1 (
  id: str
  pw_hash: str
  failed_attempts: int
)

fn db__get(id: str) -> Db__User rev 1
  emits [db.user_not_found, db.down]
  tests
    known(id = "u_01") => Ok(id = "u_01", pw_hash = "s", failed_attempts = 0)
    unknown(id = "u_99") => db.user_not_found(id = "u_99")
=
  match id
    "u_01" => Ok(id = "u_01", pw_hash = "s", failed_attempts = 0)
    _ => db.user_not_found(id = id)

// ===== sketches/broken-login/bad-name.ail =====
// broken-login/bad-name.ail — DEMO: red squiggle, name breaks the grammar.
// Functions must read domain__verb. This one doesn't.

mod auth
  provides [go, Auth__S]
  uses [db__get@1, Db__User@1]
  emits [auth.bad]

error auth.bad()

type Auth__S rev 1 (
  id: str
)

fn go(id: str) -> Auth__S rev 1
  emits [auth.bad]
  tests
    happy(id = "u_01") => Ok(id = "u_01")
    missing(id = "u_99") => auth.bad()
    down(id = "u_01") => auth.bad()
=
  match call db__get(id)
    given
      happy => [exchange args (id = "u_01") outcome Ok(id = "u_01", pw_hash = "s", failed_attempts = 0)]
      missing => [exchange args (id = "u_99") outcome db.user_not_found(id = "u_99")]
      down => [exchange args (id = "u_01") outcome db.down()]
    on db.user_not_found _ => auth.bad()
    on db.down _ => auth.bad()
    on Ok u => Ok(id = u.id)

// ===== sketches/broken-login/dangling-test.ail =====
// broken-login/dangling-test.ail — DEMO: red squiggle, a test with no script.
// The extra test names an outcome the given table never scripts.
// DEMO-EXPECTS: given table [happy] != tests [extra happy]

mod auth
  provides [auth__dangle, Auth__Dangle]
  uses [db__get@1, Db__User@1]
  emits [auth.bad]

error auth.bad()

type Auth__Dangle rev 1 (
  id: str
)

fn auth__dangle(id: str) -> Auth__Dangle rev 1
  emits [auth.bad]
  tests
    happy(id = "u_01") => Ok(id = "u_01")
    extra(id = "u_02") => Ok(id = "u_02")
=
  match call db__get(id)
    given
      happy => [exchange args (id = "u_01") outcome Ok(id = "u_01", pw_hash = "s", failed_attempts = 0)]
    on db.user_not_found _ => auth.bad()
    on db.down _ => auth.bad()
    on Ok u => Ok(id = u.id)

// ===== sketches/broken-login/dead-script.ail =====
// broken-login/dead-script.ail — DEMO: yellow squiggle, a script no test runs.
// The zzz outcome is scripted but the decision table never selects it.
// DEMO-EXPECTS: given table [down happy missing zzz] != tests [down happy missing]

mod auth
  provides [auth__script, Auth__Script]
  uses [db__get@1, Db__User@1]
  emits [auth.bad]

error auth.bad()

type Auth__Script rev 1 (
  id: str
)

fn auth__script(id: str) -> Auth__Script rev 1
  emits [auth.bad]
  tests
    happy(id = "u_01") => Ok(id = "u_01")
    missing(id = "u_99") => auth.bad()
    down(id = "u_01") => auth.bad()
=
  match call db__get(id)
    given
      happy => [exchange args (id = "u_01") outcome Ok(id = "u_01", pw_hash = "s", failed_attempts = 0)]
      zzz => [exchange args (id = "u_01") outcome db.down()]
      missing => [exchange args (id = "u_99") outcome db.user_not_found(id = "u_99")]
      down => [exchange args (id = "u_01") outcome db.down()]
    on db.user_not_found _ => auth.bad()
    on db.down _ => auth.bad()
    on Ok u => Ok(id = u.id)

