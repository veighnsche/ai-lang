// std/scalars/scalars.ail — row 2 of the standard-library program.
// Monomorphic boolean logic, three-way comparisons, selection,
// predicates, integer and decimal fundamentals, decimal observation
// (parts), bounded arithmetic, exact power and recurrence helpers,
// the pure NOW conversions, and a bounded backoff delay that reuses
// the power helper.
// Every function returns a named success record. Bool answers use
// Bool__Value, three-way comparisons use Int__Value with exactly -1,
// 0, or 1, and false compares before true. Names follow the brief
// verbatim (std__int__abs and friends): the R3 verb class admits
// hierarchical separators — see issue 5.
// All calls are same-file locals and execute. No externs, no state.

mod scalars
  provides [std__bool__not, std__bool__and, std__bool__or, std__bool__xor, std__bool__implies, std__bool__equivalent, std__compare__int, std__compare__dec, std__compare__str, std__compare__bool, std__select__int, std__select__bool, std__select__str, std__select__dec, std__int__is_zero, std__int__is_positive, std__int__is_negative, std__int__in_closed_range, std__int__in_open_range, std__dec__is_zero, std__dec__is_positive, std__dec__is_negative, std__dec__in_closed_range, std__dec__in_open_range, std__int__abs, std__int__negate, std__int__sign, std__int__min, std__int__max, std__int__clamp, std__int__distance, std__int__square, std__int__pow_from, std__int__pow, std__int__add_bounded, std__int__subtract_bounded, std__int__multiply_bounded, std__int__factorial_from, std__int__factorial, std__int__sum_from, std__int__sum_to, std__dec__abs, std__dec__negate, std__dec__sign, std__dec__min, std__dec__max, std__dec__clamp, std__dec__distance, std__dec__square, std__dec__pow_from, std__dec__pow, std__dec__lerp, std__convert__bool_to_str, std__convert__str_to_bool, std__convert__bool_to_int, std__convert__int_to_bool, std__convert__bool_to_dec, std__convert__dec_to_bool, std__convert__int_to_str_from, std__convert__int_to_str, std__convert__str_to_int_from, std__convert__str_to_int, std__convert__str_to_dec_from, std__convert__str_to_dec, std__convert__int_to_dec, std__convert__int_to_dec_from, std__dec__scale_by_power_of_ten, std__dec__scale_by_power_of_ten_from, std__dec__from_parts, std__dec__parts, std__dec__strip_from, std__dec__truncate, std__dec__floor, std__dec__ceil, std__int__binomial, std__int__binomial_from, std__int__is_prime, std__int__is_prime_from, std__int__next_power_of_two, std__int__next_power_of_two_pow2, std__int__next_power_of_two_from, std__int__sqrt_floor, std__int__sqrt_floor_search, std__int__gcd, std__int__gcd_euclid, std__int__lcm, std__backoff__delay, Int__Value, Dec__Value, Str__Value, Bool__Value, Int__Root, Dec__Parts, Dec__Strip]
  uses []
  emits [math.invalid_bounds, math.out_of_range, math.dec_invalid_bounds, math.dec_out_of_range, math.negative_input, math.nonpositive_input, math.negative_exponent, math.invalid_count, math.negative_scale, convert.invalid_boolean, convert.invalid_boolean_encoding, convert.invalid_dec_encoding, convert.invalid_integer, convert.invalid_decimal]

error math.invalid_bounds(lower: int, upper: int)
error math.out_of_range(value: int, lower: int, upper: int)
error math.dec_invalid_bounds(lower: dec, upper: dec)
error math.dec_out_of_range(value: dec, lower: dec, upper: dec)
error math.negative_input(value: int)
error math.nonpositive_input(value: int)
error math.negative_exponent(exponent: int)
error math.invalid_count(n: int, k: int)
error math.negative_scale(scale: int)
error convert.invalid_boolean(value: str)
error convert.invalid_integer(value: str)
error convert.invalid_decimal(value: str)
error convert.invalid_boolean_encoding(value: int)
error convert.invalid_dec_encoding(value: dec)

type Int__Value rev 1 (
  value: int
)

type Dec__Value rev 1 (
  value: dec
)

type Str__Value rev 1 (
  value: str
)

type Bool__Value rev 1 (
  value: bool
)

type Int__Root rev 1 (
  root: int
  remainder: int
)

type Dec__Parts rev 1 (
  coefficient: int
  scale: int
)

type Dec__Strip rev 1 (
  stripped: int
  exact: bool
)

fn std__bool__not(value: bool) -> Bool__Value rev 1
  emits []
  tests
    not_true(value = true) => Ok(value = false)
    not_false(value = false) => Ok(value = true)
=
  match value
    true => Ok(value = false)
    false => Ok(value = true)

fn std__bool__and(left: bool, right: bool) -> Bool__Value rev 1
  emits []
  tests
    and_tt(left = true, right = true) => Ok(value = true)
    and_tf(left = true, right = false) => Ok(value = false)
    and_ft(left = false, right = true) => Ok(value = false)
    and_ff(left = false, right = false) => Ok(value = false)
=
  match left
    true => match right
      true => Ok(value = true)
      false => Ok(value = false)
    false => Ok(value = false)

fn std__bool__or(left: bool, right: bool) -> Bool__Value rev 1
  emits []
  tests
    or_tt(left = true, right = true) => Ok(value = true)
    or_tf(left = true, right = false) => Ok(value = true)
    or_ft(left = false, right = true) => Ok(value = true)
    or_ff(left = false, right = false) => Ok(value = false)
=
  match left
    true => Ok(value = true)
    false => match right
      true => Ok(value = true)
      false => Ok(value = false)

fn std__bool__xor(left: bool, right: bool) -> Bool__Value rev 1
  emits []
  tests
    xor_tt(left = true, right = true) => Ok(value = false)
    xor_tf(left = true, right = false) => Ok(value = true)
    xor_ft(left = false, right = true) => Ok(value = true)
    xor_ff(left = false, right = false) => Ok(value = false)
=
  match left
    true => match right
      true => Ok(value = false)
      false => Ok(value = true)
    false => match right
      true => Ok(value = true)
      false => Ok(value = false)

fn std__bool__implies(left: bool, right: bool) -> Bool__Value rev 1
  emits []
  tests
    imp_tt(left = true, right = true) => Ok(value = true)
    imp_tf(left = true, right = false) => Ok(value = false)
    imp_ft(left = false, right = true) => Ok(value = true)
    imp_ff(left = false, right = false) => Ok(value = true)
=
  match left
    true => match right
      true => Ok(value = true)
      false => Ok(value = false)
    false => Ok(value = true)

fn std__bool__equivalent(left: bool, right: bool) -> Bool__Value rev 1
  emits []
  tests
    equiv_tt(left = true, right = true) => Ok(value = true)
    equiv_tf(left = true, right = false) => Ok(value = false)
    equiv_ft(left = false, right = true) => Ok(value = false)
    equiv_ff(left = false, right = false) => Ok(value = true)
=
  match left
    true => match right
      true => Ok(value = true)
      false => Ok(value = false)
    false => match right
      true => Ok(value = false)
      false => Ok(value = true)

fn std__compare__int(left: int, right: int) -> Int__Value rev 1
  emits []
  tests
    cmp_int_eq(left = 4, right = 4) => Ok(value = 0)
    cmp_int_gt(left = 5, right = 4) => Ok(value = 1)
    cmp_int_lt(left = 3, right = 4) => Ok(value = -1)
=
  match left == right
    true => Ok(value = 0)
    false => match left >= right
      true => Ok(value = 1)
      false => Ok(value = -1)

fn std__compare__dec(left: dec, right: dec) -> Int__Value rev 1
  emits []
  tests
    cmp_dec_eq(left = d"1.5", right = d"1.5") => Ok(value = 0)
    cmp_dec_gt(left = d"1.6", right = d"1.5") => Ok(value = 1)
    cmp_dec_lt(left = d"1.4", right = d"1.5") => Ok(value = -1)
=
  match left == right
    true => Ok(value = 0)
    false => match left >= right
      true => Ok(value = 1)
      false => Ok(value = -1)

fn std__compare__str(left: str, right: str) -> Int__Value rev 1
  emits []
  tests
    cmp_str_eq(left = "a", right = "a") => Ok(value = 0)
    cmp_str_gt(left = "b", right = "a") => Ok(value = 1)
    cmp_str_lt(left = "a", right = "b") => Ok(value = -1)
=
  match left == right
    true => Ok(value = 0)
    false => match left >= right
      true => Ok(value = 1)
      false => Ok(value = -1)

fn std__compare__bool(left: bool, right: bool) -> Int__Value rev 1
  emits []
  tests
    cmp_bool_tt(left = true, right = true) => Ok(value = 0)
    cmp_bool_ff(left = false, right = false) => Ok(value = 0)
    cmp_bool_tf(left = true, right = false) => Ok(value = 1)
    cmp_bool_ft(left = false, right = true) => Ok(value = -1)
=
  match left == right
    true => Ok(value = 0)
    false => match left
      true => Ok(value = 1)
      false => Ok(value = -1)

fn std__select__int(condition: bool, when_true: int, when_false: int) -> Int__Value rev 1
  emits []
  tests
    sel_int_t(condition = true, when_true = 1, when_false = 2) => Ok(value = 1)
    sel_int_f(condition = false, when_true = 1, when_false = 2) => Ok(value = 2)
=
  match condition
    true => Ok(value = when_true)
    false => Ok(value = when_false)

fn std__select__bool(condition: bool, when_true: bool, when_false: bool) -> Bool__Value rev 1
  emits []
  tests
    sel_bool_t(condition = true, when_true = true, when_false = false) => Ok(value = true)
    sel_bool_f(condition = false, when_true = true, when_false = false) => Ok(value = false)
=
  match condition
    true => Ok(value = when_true)
    false => Ok(value = when_false)

fn std__select__str(condition: bool, when_true: str, when_false: str) -> Str__Value rev 1
  emits []
  tests
    sel_str_t(condition = true, when_true = "a", when_false = "b") => Ok(value = "a")
    sel_str_f(condition = false, when_true = "a", when_false = "b") => Ok(value = "b")
=
  match condition
    true => Ok(value = when_true)
    false => Ok(value = when_false)

fn std__select__dec(condition: bool, when_true: dec, when_false: dec) -> Dec__Value rev 1
  emits []
  tests
    sel_dec_t(condition = true, when_true = d"1.5", when_false = d"2.5") => Ok(value = d"1.5")
    sel_dec_f(condition = false, when_true = d"1.5", when_false = d"2.5") => Ok(value = d"2.5")
=
  match condition
    true => Ok(value = when_true)
    false => Ok(value = when_false)

fn std__int__is_zero(value: int) -> Bool__Value rev 1
  emits []
  tests
    is_zero_z(value = 0) => Ok(value = true)
    is_zero_p(value = 3) => Ok(value = false)
    is_zero_n(value = -3) => Ok(value = false)
=
  match value == 0
    true => Ok(value = true)
    false => Ok(value = false)

fn std__int__is_positive(value: int) -> Bool__Value rev 1
  emits []
  tests
    is_pos_z(value = 0) => Ok(value = false)
    is_pos_p(value = 3) => Ok(value = true)
    is_pos_n(value = -3) => Ok(value = false)
=
  match value == 0
    true => Ok(value = false)
    false => match value >= 0
      true => Ok(value = true)
      false => Ok(value = false)

fn std__int__is_negative(value: int) -> Bool__Value rev 1
  emits []
  tests
    is_neg_z(value = 0) => Ok(value = false)
    is_neg_p(value = 3) => Ok(value = false)
    is_neg_n(value = -3) => Ok(value = true)
=
  match value == 0
    true => Ok(value = false)
    false => match value <= 0
      true => Ok(value = true)
      false => Ok(value = false)

fn std__int__in_closed_range(value: int, lower: int, upper: int) -> Bool__Value rev 1
  emits [math.invalid_bounds]
  tests
    closed_in(value = 5, lower = 0, upper = 10) => Ok(value = true)
    closed_low_edge(value = 0, lower = 0, upper = 10) => Ok(value = true)
    closed_high_edge(value = 10, lower = 0, upper = 10) => Ok(value = true)
    closed_below(value = -1, lower = 0, upper = 10) => Ok(value = false)
    closed_above(value = 11, lower = 0, upper = 10) => Ok(value = false)
    closed_bad(value = 5, lower = 10, upper = 0) => math.invalid_bounds(lower = 10, upper = 0)
=
  match lower <= upper
    true => match value >= lower
      true => match value <= upper
        true => Ok(value = true)
        false => Ok(value = false)
      false => Ok(value = false)
    false => math.invalid_bounds(lower = lower, upper = upper)

fn std__int__in_open_range(value: int, lower: int, upper: int) -> Bool__Value rev 1
  emits [math.invalid_bounds]
  tests
    open_in(value = 5, lower = 0, upper = 10) => Ok(value = true)
    open_low_edge(value = 0, lower = 0, upper = 10) => Ok(value = false)
    open_high_edge(value = 10, lower = 0, upper = 10) => Ok(value = false)
    open_below(value = -1, lower = 0, upper = 10) => Ok(value = false)
    open_above(value = 11, lower = 0, upper = 10) => Ok(value = false)
    open_bad(value = 5, lower = 10, upper = 0) => math.invalid_bounds(lower = 10, upper = 0)
=
  match lower <= upper
    true => match value <= lower
      true => Ok(value = false)
      false => match value >= upper
        true => Ok(value = false)
        false => Ok(value = true)
    false => math.invalid_bounds(lower = lower, upper = upper)

fn std__dec__is_zero(value: dec) -> Bool__Value rev 1
  emits []
  tests
    dec_zero_z(value = d"0.0") => Ok(value = true)
    dec_zero_p(value = d"1.5") => Ok(value = false)
    dec_zero_n(value = d"-1.5") => Ok(value = false)
=
  match value == d"0.0"
    true => Ok(value = true)
    false => Ok(value = false)

fn std__dec__is_positive(value: dec) -> Bool__Value rev 1
  emits []
  tests
    dec_pos_z(value = d"0.0") => Ok(value = false)
    dec_pos_p(value = d"1.5") => Ok(value = true)
    dec_pos_n(value = d"-1.5") => Ok(value = false)
=
  match value == d"0.0"
    true => Ok(value = false)
    false => match value >= d"0.0"
      true => Ok(value = true)
      false => Ok(value = false)

fn std__dec__is_negative(value: dec) -> Bool__Value rev 1
  emits []
  tests
    dec_neg_z(value = d"0.0") => Ok(value = false)
    dec_neg_p(value = d"1.5") => Ok(value = false)
    dec_neg_n(value = d"-1.5") => Ok(value = true)
=
  match value == d"0.0"
    true => Ok(value = false)
    false => match value <= d"0.0"
      true => Ok(value = true)
      false => Ok(value = false)

fn std__dec__in_closed_range(value: dec, lower: dec, upper: dec) -> Bool__Value rev 1
  emits [math.dec_invalid_bounds]
  tests
    dec_closed_in(value = d"5.0", lower = d"0.0", upper = d"10.0") => Ok(value = true)
    dec_closed_below(value = d"-0.5", lower = d"0.0", upper = d"10.0") => Ok(value = false)
    dec_closed_above(value = d"10.5", lower = d"0.0", upper = d"10.0") => Ok(value = false)
    dec_closed_bad(value = d"5.0", lower = d"10.0", upper = d"0.0") => math.dec_invalid_bounds(lower = d"10.0", upper = d"0.0")
=
  match lower <= upper
    true => match value >= lower
      true => match value <= upper
        true => Ok(value = true)
        false => Ok(value = false)
      false => Ok(value = false)
    false => math.dec_invalid_bounds(lower = lower, upper = upper)

fn std__dec__in_open_range(value: dec, lower: dec, upper: dec) -> Bool__Value rev 1
  emits [math.dec_invalid_bounds]
  tests
    dec_open_in(value = d"5.0", lower = d"0.0", upper = d"10.0") => Ok(value = true)
    dec_open_edge(value = d"0.0", lower = d"0.0", upper = d"10.0") => Ok(value = false)
    dec_open_high(value = d"10.0", lower = d"0.0", upper = d"10.0") => Ok(value = false)
    dec_open_above(value = d"10.5", lower = d"0.0", upper = d"10.0") => Ok(value = false)
    dec_open_bad(value = d"5.0", lower = d"10.0", upper = d"0.0") => math.dec_invalid_bounds(lower = d"10.0", upper = d"0.0")
=
  match lower <= upper
    true => match value <= lower
      true => Ok(value = false)
      false => match value >= upper
        true => Ok(value = false)
        false => Ok(value = true)
    false => math.dec_invalid_bounds(lower = lower, upper = upper)

fn std__int__abs(value: int) -> Int__Value rev 1
  emits []
  tests
    abs_neg(value = -3) => Ok(value = 3)
    abs_pos(value = 3) => Ok(value = 3)
    abs_zero(value = 0) => Ok(value = 0)
=
  match value >= 0
    true => Ok(value = value)
    false => Ok(value = 0 - value)

fn std__int__negate(value: int) -> Int__Value rev 1
  emits []
  tests
    neg_pos(value = 3) => Ok(value = -3)
    neg_neg(value = -3) => Ok(value = 3)
    neg_zero(value = 0) => Ok(value = 0)
=
  Ok(value = 0 - value)

fn std__int__sign(value: int) -> Int__Value rev 1
  emits []
  tests
    sign_zero(value = 0) => Ok(value = 0)
    sign_pos(value = 3) => Ok(value = 1)
    sign_neg(value = -3) => Ok(value = -1)
=
  match value == 0
    true => Ok(value = 0)
    false => match value >= 0
      true => Ok(value = 1)
      false => Ok(value = -1)

fn std__int__min(left: int, right: int) -> Int__Value rev 1
  emits []
  tests
    min_lt(left = 3, right = 4) => Ok(value = 3)
    min_gt(left = 5, right = 4) => Ok(value = 4)
    min_eq(left = 4, right = 4) => Ok(value = 4)
=
  match left <= right
    true => Ok(value = left)
    false => Ok(value = right)

fn std__int__max(left: int, right: int) -> Int__Value rev 1
  emits []
  tests
    max_lt(left = 3, right = 4) => Ok(value = 4)
    max_gt(left = 5, right = 4) => Ok(value = 5)
    max_eq(left = 4, right = 4) => Ok(value = 4)
=
  match left >= right
    true => Ok(value = left)
    false => Ok(value = right)

fn std__int__clamp(value: int, lower: int, upper: int) -> Int__Value rev 1
  emits [math.invalid_bounds]
  tests
    clamp_in(value = 5, lower = 0, upper = 10) => Ok(value = 5)
    clamp_low(value = -3, lower = 0, upper = 10) => Ok(value = 0)
    clamp_high(value = 14, lower = 0, upper = 10) => Ok(value = 10)
    clamp_bad(value = 5, lower = 10, upper = 0) => math.invalid_bounds(lower = 10, upper = 0)
=
  match lower <= upper
    true => match value >= lower
      true => match value <= upper
        true => Ok(value = value)
        false => Ok(value = upper)
      false => Ok(value = lower)
    false => math.invalid_bounds(lower = lower, upper = upper)

fn std__int__distance(left: int, right: int) -> Int__Value rev 1
  emits []
  tests
    dist_gt(left = 5, right = 2) => Ok(value = 3)
    dist_lt(left = 2, right = 5) => Ok(value = 3)
    dist_eq(left = 4, right = 4) => Ok(value = 0)
=
  match left >= right
    true => Ok(value = left - right)
    false => Ok(value = right - left)

fn std__int__square(value: int) -> Int__Value rev 1
  emits []
  tests
    sq_pos(value = 4) => Ok(value = 16)
    sq_neg(value = -4) => Ok(value = 16)
    sq_zero(value = 0) => Ok(value = 0)
=
  Ok(value = value * value)

fn std__int__pow_from(base: int, exponent: int) -> Int__Value rev 1
  decreases exponent
  emits []
  tests
    pow_from_zero(base = 5, exponent = 0) => Ok(value = 1)
    pow_from_three(base = 2, exponent = 3) => Ok(value = 8)
=
  match exponent <= 0
    true => Ok(value = 1)
    false => match call std__int__pow_from(base, exponent - 1)
      on Ok r => Ok(value = base * r.value)

fn std__int__pow(base: int, exponent: int) -> Int__Value rev 1
  emits [math.negative_exponent]
  tests
    pow_zero_exp(base = 5, exponent = 0) => Ok(value = 1)
    pow_pos(base = 2, exponent = 3) => Ok(value = 8)
    pow_zero_zero(base = 0, exponent = 0) => Ok(value = 1)
    pow_neg(base = 2, exponent = -1) => math.negative_exponent(exponent = -1)
=
  match exponent >= 0
    true => match call std__int__pow_from(base, exponent)
      on Ok r => Ok(value = r.value)
    false => math.negative_exponent(exponent = exponent)

fn std__int__add_bounded(left: int, right: int, lower: int, upper: int) -> Int__Value rev 1
  emits [math.invalid_bounds, math.out_of_range]
  tests
    add_ok(left = 3, right = 4, lower = 0, upper = 10) => Ok(value = 7)
    add_low(left = -3, right = -4, lower = 0, upper = 10) => math.out_of_range(value = -7, lower = 0, upper = 10)
    add_high(left = 6, right = 7, lower = 0, upper = 10) => math.out_of_range(value = 13, lower = 0, upper = 10)
    add_bad(left = 1, right = 1, lower = 10, upper = 0) => math.invalid_bounds(lower = 10, upper = 0)
=
  match lower <= upper
    true => match left + right >= lower
      true => match left + right <= upper
        true => Ok(value = left + right)
        false => math.out_of_range(value = left + right, lower = lower, upper = upper)
      false => math.out_of_range(value = left + right, lower = lower, upper = upper)
    false => math.invalid_bounds(lower = lower, upper = upper)

fn std__int__subtract_bounded(left: int, right: int, lower: int, upper: int) -> Int__Value rev 1
  emits [math.invalid_bounds, math.out_of_range]
  tests
    sub_ok(left = 9, right = 4, lower = 0, upper = 10) => Ok(value = 5)
    sub_low(left = 2, right = 9, lower = 0, upper = 10) => math.out_of_range(value = -7, lower = 0, upper = 10)
    sub_high(left = 20, right = 3, lower = 0, upper = 10) => math.out_of_range(value = 17, lower = 0, upper = 10)
    sub_bad(left = 1, right = 1, lower = 10, upper = 0) => math.invalid_bounds(lower = 10, upper = 0)
=
  match lower <= upper
    true => match left - right >= lower
      true => match left - right <= upper
        true => Ok(value = left - right)
        false => math.out_of_range(value = left - right, lower = lower, upper = upper)
      false => math.out_of_range(value = left - right, lower = lower, upper = upper)
    false => math.invalid_bounds(lower = lower, upper = upper)

fn std__int__multiply_bounded(left: int, right: int, lower: int, upper: int) -> Int__Value rev 1
  emits [math.invalid_bounds, math.out_of_range]
  tests
    mul_ok(left = 3, right = 4, lower = 0, upper = 20) => Ok(value = 12)
    mul_low(left = -3, right = 4, lower = 0, upper = 20) => math.out_of_range(value = -12, lower = 0, upper = 20)
    mul_high(left = 6, right = 7, lower = 0, upper = 20) => math.out_of_range(value = 42, lower = 0, upper = 20)
    mul_bad(left = 1, right = 1, lower = 10, upper = 0) => math.invalid_bounds(lower = 10, upper = 0)
=
  match lower <= upper
    true => match left * right >= lower
      true => match left * right <= upper
        true => Ok(value = left * right)
        false => math.out_of_range(value = left * right, lower = lower, upper = upper)
      false => math.out_of_range(value = left * right, lower = lower, upper = upper)
    false => math.invalid_bounds(lower = lower, upper = upper)

fn std__int__factorial_from(value: int) -> Int__Value rev 1
  decreases value
  emits []
  tests
    fact_from_zero(value = 0) => Ok(value = 1)
    fact_from_three(value = 3) => Ok(value = 6)
=
  match value <= 0
    true => Ok(value = 1)
    false => match call std__int__factorial_from(value - 1)
      on Ok r => Ok(value = value * r.value)

fn std__int__factorial(value: int) -> Int__Value rev 1
  emits [math.negative_input]
  tests
    fact_zero(value = 0) => Ok(value = 1)
    fact_five(value = 5) => Ok(value = 120)
    fact_neg(value = -2) => math.negative_input(value = -2)
=
  match value >= 0
    true => match call std__int__factorial_from(value)
      on Ok r => Ok(value = r.value)
    false => math.negative_input(value = value)

fn std__int__sum_from(upper: int) -> Int__Value rev 1
  decreases upper
  emits []
  tests
    sum_from_zero(upper = 0) => Ok(value = 0)
    sum_from_four(upper = 4) => Ok(value = 10)
=
  match upper <= 0
    true => Ok(value = 0)
    false => match call std__int__sum_from(upper - 1)
      on Ok r => Ok(value = upper + r.value)

fn std__int__sum_to(upper: int) -> Int__Value rev 1
  emits [math.negative_input]
  tests
    sum_zero(upper = 0) => Ok(value = 0)
    sum_four(upper = 4) => Ok(value = 10)
    sum_neg(upper = -2) => math.negative_input(value = -2)
=
  match upper >= 0
    true => match call std__int__sum_from(upper)
      on Ok r => Ok(value = r.value)
    false => math.negative_input(value = upper)

fn std__int__binomial_from(n: int, k: int, i: int, num: int, den: int) -> Int__Value rev 1
  decreases i
  emits []
  tests
    bin_from_done(n = 5, k = 2, i = 0, num = 20, den = 2) => Ok(value = 10)
    bin_from_step(n = 5, k = 2, i = 2, num = 1, den = 1) => Ok(value = 10)
=
  match i <= 0
    true => Ok(value = num / den)
    false => match call std__int__binomial_from(n, k, i - 1, num * (n - k + i), den * i)
      on Ok r => Ok(value = r.value)

fn std__int__binomial(n: int, k: int) -> Int__Value rev 1
  emits [math.invalid_count]
  tests
    choose(n = 5, k = 2) => Ok(value = 10)
    full(n = 6, k = 6) => Ok(value = 1)
    none(n = 5, k = 0) => Ok(value = 1)
    zero_zero(n = 0, k = 0) => Ok(value = 1)
    neg_k(n = 5, k = -1) => math.invalid_count(n = 5, k = -1)
    k_too_big(n = 3, k = 5) => math.invalid_count(n = 3, k = 5)
=
  match k >= 0
    true => match k <= n
      true => match call std__int__binomial_from(n, k, k, 1, 1)
        on Ok r => Ok(value = r.value)
      false => math.invalid_count(n = n, k = k)
    false => math.invalid_count(n = n, k = k)

fn std__int__is_prime_from(value: int, e: int) -> Bool__Value rev 1
  decreases e
  emits []
  tests
    prime_from_two(value = 2, e = 0) => Ok(value = true)
    prime_from_nine(value = 9, e = 7) => Ok(value = false)
    prime_from_three(value = 3, e = 1) => Ok(value = true)
=
  match e <= 0
    true => Ok(value = true)
    false => match value % (e + 1) == 0
      true => Ok(value = false)
      false => match call std__int__is_prime_from(value, e - 1)
        on Ok r => Ok(value = r.value)

fn std__int__is_prime(value: int) -> Bool__Value rev 1
  emits []
  tests
    two(value = 2) => Ok(value = true)
    three(value = 3) => Ok(value = true)
    four(value = 4) => Ok(value = false)
    nine(value = 9) => Ok(value = false)
    one(value = 1) => Ok(value = false)
    zero(value = 0) => Ok(value = false)
    negative(value = -5) => Ok(value = false)
=
  match value >= 2
    true => match call std__int__is_prime_from(value, value - 2)
      on Ok r => Ok(value = r.value)
    false => Ok(value = false)

fn std__int__next_power_of_two_pow2(e: int) -> Int__Value rev 1
  decreases e
  emits []
  tests
    pow2_zero(e = 0) => Ok(value = 1)
    pow2_three(e = 3) => Ok(value = 8)
=
  match e <= 0
    true => Ok(value = 1)
    false => match call std__int__next_power_of_two_pow2(e - 1)
      on Ok r => Ok(value = 2 * r.value)

fn std__int__next_power_of_two_from(value: int, e: int, best: int) -> Int__Value rev 1
  decreases e
  emits []
  tests
    npot_from_one(value = 1, e = 0, best = 2) => Ok(value = 1)
    npot_from_five(value = 5, e = 0, best = 8) => Ok(value = 8)
    npot_from_step(value = 5, e = 3, best = 32) => Ok(value = 8)
    npot_from_keep(value = 5, e = 2, best = 8) => Ok(value = 8)
=
  match e <= 0
    true => match 1 >= value
      true => Ok(value = 1)
      false => Ok(value = best)
    false => match call std__int__next_power_of_two_pow2(e)
      on Ok t => match t.value >= value
        true => match call std__int__next_power_of_two_from(value, e - 1, t.value)
          on Ok r => Ok(value = r.value)
        false => match call std__int__next_power_of_two_from(value, e - 1, best)
          on Ok r => Ok(value = r.value)

fn std__int__next_power_of_two(value: int) -> Int__Value rev 1
  emits [math.nonpositive_input]
  tests
    npot_one(value = 1) => Ok(value = 1)
    npot_five(value = 5) => Ok(value = 8)
    npot_sixteen(value = 16) => Ok(value = 16)
    npot_zero(value = 0) => math.nonpositive_input(value = 0)
    npot_negative(value = -3) => math.nonpositive_input(value = -3)
=
  match value >= 1
    true => match call std__int__next_power_of_two_from(value, value, 1)
      on Ok r => Ok(value = r.value)
    false => math.nonpositive_input(value = value)

fn std__int__sqrt_floor_search(value: int, lo: int, hi: int) -> Int__Value rev 1
  decreases lo, hi by narrowing
  emits []
  tests
    search_ten(value = 10, lo = 0, hi = 11) => Ok(value = 3)
    search_exact(value = 9, lo = 3, hi = 4) => Ok(value = 3)
    search_nine(value = 9, lo = 0, hi = 10) => Ok(value = 3)
=
  match (hi - lo) <= 1
    true => Ok(value = lo)
    false => match ((lo + hi) / 2) * ((lo + hi) / 2) <= value
      true => match call std__int__sqrt_floor_search(value, (lo + hi) / 2, hi)
        on Ok r => Ok(value = r.value)
      false => match call std__int__sqrt_floor_search(value, lo, (lo + hi) / 2)
        on Ok r => Ok(value = r.value)

fn std__int__sqrt_floor(value: int) -> Int__Root rev 1
  emits [math.negative_input]
  tests
    sqrt_zero(value = 0) => Ok(root = 0, remainder = 0)
    sqrt_one(value = 1) => Ok(root = 1, remainder = 0)
    sqrt_four(value = 4) => Ok(root = 2, remainder = 0)
    sqrt_ten(value = 10) => Ok(root = 3, remainder = 1)
    sqrt_neg(value = -4) => math.negative_input(value = -4)
=
  match value >= 0
    true => match call std__int__sqrt_floor_search(value, 0, value + 1)
      on Ok r => Ok(root = r.value, remainder = value - r.value * r.value)
    false => math.negative_input(value = value)

fn std__int__gcd_euclid(a: int, b: int) -> Int__Value rev 1
  decreases a, b by euclid
  emits []
  tests
    euclid_basic(a = 12, b = 8) => Ok(value = 4)
    euclid_coprime(a = 8, b = 9) => Ok(value = 1)
    euclid_zero_b(a = 5, b = 0) => Ok(value = 5)
=
  match b <= 0
    true => Ok(value = a)
    false => match call std__int__gcd_euclid(b, a % b)
      on Ok r => Ok(value = r.value)

fn std__int__gcd(left: int, right: int) -> Int__Value rev 1
  emits []
  tests
    gcd_basic(left = 12, right = 8) => Ok(value = 4)
    gcd_coprime(left = 8, right = 9) => Ok(value = 1)
    gcd_zero_left(left = 0, right = 5) => Ok(value = 5)
    gcd_zero_right(left = 5, right = 0) => Ok(value = 5)
    gcd_zero_zero(left = 0, right = 0) => Ok(value = 0)
    gcd_negative(left = -12, right = 8) => Ok(value = 4)
    gcd_equal(left = 7, right = 7) => Ok(value = 7)
=
  match call std__int__abs(left)
    on Ok a => match call std__int__abs(right)
      on Ok b => match call std__int__gcd_euclid(a.value, b.value)
        on Ok r => Ok(value = r.value)

fn std__int__lcm(left: int, right: int) -> Int__Value rev 1
  emits []
  tests
    lcm_basic(left = 4, right = 6) => Ok(value = 12)
    lcm_zero_left(left = 0, right = 5) => Ok(value = 0)
    lcm_zero_right(left = 5, right = 0) => Ok(value = 0)
    lcm_equal(left = 7, right = 7) => Ok(value = 7)
    lcm_negative(left = -4, right = 6) => Ok(value = 12)
=
  match left == 0
    true => Ok(value = 0)
    false => match right == 0
      true => Ok(value = 0)
      false => match call std__int__gcd(left, right)
        on Ok g => match call std__int__abs(left)
          on Ok a => match call std__int__abs(right)
            on Ok b => Ok(value = a.value * b.value / g.value)

fn std__dec__abs(value: dec) -> Dec__Value rev 1
  emits []
  tests
    dec_abs_neg(value = d"-2.5") => Ok(value = d"2.5")
    dec_abs_pos(value = d"2.5") => Ok(value = d"2.5")
    dec_abs_zero(value = d"0.0") => Ok(value = d"0.0")
=
  match value >= d"0.0"
    true => Ok(value = value)
    false => Ok(value = d"0.0" - value)

fn std__dec__negate(value: dec) -> Dec__Value rev 1
  emits []
  tests
    dec_neg_pos(value = d"2.5") => Ok(value = d"-2.5")
    dec_neg_neg(value = d"-2.5") => Ok(value = d"2.5")
    dec_neg_zero(value = d"0.0") => Ok(value = d"0.0")
=
  Ok(value = d"0.0" - value)

fn std__dec__sign(value: dec) -> Int__Value rev 1
  emits []
  tests
    dec_sign_zero(value = d"0.0") => Ok(value = 0)
    dec_sign_pos(value = d"2.5") => Ok(value = 1)
    dec_sign_neg(value = d"-2.5") => Ok(value = -1)
=
  match value == d"0.0"
    true => Ok(value = 0)
    false => match value >= d"0.0"
      true => Ok(value = 1)
      false => Ok(value = -1)

fn std__dec__min(left: dec, right: dec) -> Dec__Value rev 1
  emits []
  tests
    dec_min_lt(left = d"1.5", right = d"2.5") => Ok(value = d"1.5")
    dec_min_gt(left = d"3.5", right = d"2.5") => Ok(value = d"2.5")
    dec_min_eq(left = d"2.5", right = d"2.5") => Ok(value = d"2.5")
=
  match left <= right
    true => Ok(value = left)
    false => Ok(value = right)

fn std__dec__max(left: dec, right: dec) -> Dec__Value rev 1
  emits []
  tests
    dec_max_lt(left = d"1.5", right = d"2.5") => Ok(value = d"2.5")
    dec_max_gt(left = d"3.5", right = d"2.5") => Ok(value = d"3.5")
    dec_max_eq(left = d"2.5", right = d"2.5") => Ok(value = d"2.5")
=
  match left >= right
    true => Ok(value = left)
    false => Ok(value = right)

fn std__dec__clamp(value: dec, lower: dec, upper: dec) -> Dec__Value rev 1
  emits [math.dec_invalid_bounds]
  tests
    dec_clamp_in(value = d"5.0", lower = d"0.0", upper = d"10.0") => Ok(value = d"5.0")
    dec_clamp_low(value = d"-3.0", lower = d"0.0", upper = d"10.0") => Ok(value = d"0.0")
    dec_clamp_high(value = d"14.0", lower = d"0.0", upper = d"10.0") => Ok(value = d"10.0")
    dec_clamp_bad(value = d"5.0", lower = d"10.0", upper = d"0.0") => math.dec_invalid_bounds(lower = d"10.0", upper = d"0.0")
=
  match lower <= upper
    true => match value >= lower
      true => match value <= upper
        true => Ok(value = value)
        false => Ok(value = upper)
      false => Ok(value = lower)
    false => math.dec_invalid_bounds(lower = lower, upper = upper)

fn std__dec__distance(left: dec, right: dec) -> Dec__Value rev 1
  emits []
  tests
    dec_dist_gt(left = d"5.5", right = d"2.5") => Ok(value = d"3.0")
    dec_dist_lt(left = d"2.5", right = d"5.5") => Ok(value = d"3.0")
    dec_dist_eq(left = d"2.5", right = d"2.5") => Ok(value = d"0.0")
=
  match left >= right
    true => Ok(value = left - right)
    false => Ok(value = right - left)

fn std__dec__square(value: dec) -> Dec__Value rev 1
  emits []
  tests
    dec_sq_pos(value = d"4.0") => Ok(value = d"16.0")
    dec_sq_neg(value = d"-4.0") => Ok(value = d"16.0")
    dec_sq_frac(value = d"1.5") => Ok(value = d"2.25")
=
  Ok(value = value * value)

fn std__dec__pow_from(base: dec, exponent: int) -> Dec__Value rev 1
  decreases exponent
  emits []
  tests
    dec_pow_from_zero(base = d"2.5", exponent = 0) => Ok(value = d"1.0")
    dec_pow_from_two(base = d"1.5", exponent = 2) => Ok(value = d"2.25")
=
  match exponent <= 0
    true => Ok(value = d"1.0")
    false => match call std__dec__pow_from(base, exponent - 1)
      on Ok r => Ok(value = base * r.value)

fn std__dec__pow(base: dec, exponent: int) -> Dec__Value rev 1
  emits [math.negative_exponent]
  tests
    dec_pow_zero_exp(base = d"2.5", exponent = 0) => Ok(value = d"1.0")
    dec_pow_pos(base = d"1.5", exponent = 2) => Ok(value = d"2.25")
    dec_pow_neg(base = d"1.5", exponent = -1) => math.negative_exponent(exponent = -1)
=
  match exponent >= 0
    true => match call std__dec__pow_from(base, exponent)
      on Ok r => Ok(value = r.value)
    false => math.negative_exponent(exponent = exponent)

fn std__dec__lerp(start: dec, end: dec, fraction: dec) -> Dec__Value rev 1
  emits [math.dec_out_of_range]
  tests
    lerp_zero(start = d"10.0", end = d"20.0", fraction = d"0.0") => Ok(value = d"10.0")
    lerp_one(start = d"10.0", end = d"20.0", fraction = d"1.0") => Ok(value = d"20.0")
    lerp_mid(start = d"10.0", end = d"20.0", fraction = d"0.5") => Ok(value = d"15.0")
    lerp_below(start = d"10.0", end = d"20.0", fraction = d"-0.5") => math.dec_out_of_range(value = d"-0.5", lower = d"0.0", upper = d"1.0")
    lerp_above(start = d"10.0", end = d"20.0", fraction = d"1.5") => math.dec_out_of_range(value = d"1.5", lower = d"0.0", upper = d"1.0")
=
  match fraction >= d"0.0"
    true => match fraction <= d"1.0"
      true => Ok(value = start + (end - start) * fraction)
      false => math.dec_out_of_range(value = fraction, lower = d"0.0", upper = d"1.0")
    false => math.dec_out_of_range(value = fraction, lower = d"0.0", upper = d"1.0")

fn std__dec__scale_by_power_of_ten_from(value: dec, e: int, factor: dec) -> Dec__Value rev 1
  decreases e
  emits []
  tests
    scale_from_zero_e(value = d"1.5", e = 0, factor = d"10.0") => Ok(value = d"1.5")
    scale_from_two(value = d"1.5", e = 2, factor = d"10.0") => Ok(value = d"150.0")
    scale_from_down(value = d"150.0", e = 2, factor = d"0.1") => Ok(value = d"1.5")
=
  match e <= 0
    true => Ok(value = value)
    false => match call std__dec__scale_by_power_of_ten_from(value * factor, e - 1, factor)
      on Ok r => Ok(value = r.value)

fn std__dec__scale_by_power_of_ten(value: dec, exponent: int) -> Dec__Value rev 1
  emits []
  tests
    scale_up(value = d"1.5", exponent = 2) => Ok(value = d"150.0")
    scale_same(value = d"1.5", exponent = 0) => Ok(value = d"1.5")
    scale_down(value = d"150.0", exponent = -2) => Ok(value = d"1.5")
    scale_down_neg(value = d"-2.5", exponent = -1) => Ok(value = d"-0.25")
=
  match exponent >= 0
    true => match call std__dec__scale_by_power_of_ten_from(value, exponent, d"10.0")
      on Ok r => Ok(value = r.value)
    false => match call std__dec__scale_by_power_of_ten_from(value, 0 - exponent, d"0.1")
      on Ok r => Ok(value = r.value)

fn std__dec__from_parts(coefficient: int, scale: int) -> Dec__Value rev 1
  emits [math.negative_scale]
  tests
    parts_cents(coefficient = 25, scale = 2) => Ok(value = d"0.25")
    parts_units(coefficient = 7, scale = 0) => Ok(value = d"7.0")
    parts_neg(coefficient = -5, scale = 1) => Ok(value = d"-0.5")
    parts_neg_scale(coefficient = 3, scale = -1) => math.negative_scale(scale = -1)
=
  match scale >= 0
    true => match call std__convert__int_to_dec(coefficient)
      on Ok whole => match call std__dec__scale_by_power_of_ten(whole.value, 0 - scale)
        on Ok moved => Ok(value = moved.value)
    false => math.negative_scale(scale = scale)

fn std__dec__parts(value: dec) -> Dec__Parts rev 1
  emits []
  tests
    parts_whole(value = d"7.0") => Ok(coefficient = 70, scale = 1)
    parts_cents(value = d"0.25") => Ok(coefficient = 25, scale = 2)
    parts_neg(value = d"-0.5") => Ok(coefficient = -5, scale = 1)
    parts_trailing(value = d"12.340") => Ok(coefficient = 1234, scale = 2)
    parts_zero(value = d"0.00") => Ok(coefficient = 0, scale = 1)
    parts_neg_zero(value = d"-0.0") => Ok(coefficient = 0, scale = 1)
    parts_hundreds(value = d"100.0") => Ok(coefficient = 1000, scale = 1)
    parts_big(value = d"123456789.123456789") => Ok(coefficient = 123456789123456789, scale = 9)
=
  match call dec__parts(value)
    on Ok p => Ok(coefficient = p.coefficient, scale = p.scale)

fn std__dec__strip_from(remaining: int, current: int, exact: bool) -> Dec__Strip rev 1
  decreases remaining
  emits []
  tests
    strip_done(remaining = 0, current = 27, exact = true) => Ok(stripped = 27, exact = true)
    strip_done_neg(remaining = 0, current = -5, exact = true) => Ok(stripped = -5, exact = true)
    strip_step(remaining = 1, current = 27, exact = true) => Ok(stripped = 2, exact = false)
    strip_exact_kept(remaining = 1, current = 20, exact = true) => Ok(stripped = 2, exact = true)
    strip_neg(remaining = 1, current = -27, exact = true) => Ok(stripped = -3, exact = false)
    strip_already_inexact(remaining = 2, current = 27, exact = false) => Ok(stripped = 0, exact = false)
=
  match remaining <= 0
    true => Ok(stripped = current, exact = exact)
    false => match current % 10 == 0
      true => match call std__dec__strip_from(remaining - 1, current / 10, exact)
        on Ok r => Ok(stripped = r.stripped, exact = r.exact)
      false => match call std__dec__strip_from(remaining - 1, current / 10, false)
        on Ok r => Ok(stripped = r.stripped, exact = r.exact)

fn std__dec__truncate(value: dec) -> Dec__Value rev 1
  emits []
  tests
    trunc_pos(value = d"2.7") => Ok(value = d"2.0")
    trunc_neg(value = d"-2.7") => Ok(value = d"-2.0")
    trunc_neg_frac(value = d"-0.5") => Ok(value = d"0.0")
    trunc_exact(value = d"2.0") => Ok(value = d"2.0")
    trunc_exact_neg(value = d"-2.0") => Ok(value = d"-2.0")
    trunc_multi(value = d"123.456") => Ok(value = d"123.0")
    trunc_multi_neg(value = d"-123.456") => Ok(value = d"-123.0")
    trunc_zero(value = d"0.0") => Ok(value = d"0.0")
=
  match call std__dec__parts(value)
    on Ok p => match call std__dec__strip_from(p.scale, p.coefficient, true)
      on Ok s => match s.exact
        true => match call std__convert__int_to_dec(s.stripped)
          on Ok whole => Ok(value = whole.value)
        false => match s.stripped >= 0
          true => match call std__convert__int_to_dec(s.stripped)
            on Ok whole => Ok(value = whole.value)
          false => match call std__convert__int_to_dec(s.stripped + 1)
            on Ok whole => Ok(value = whole.value)

fn std__dec__floor(value: dec) -> Dec__Value rev 1
  emits []
  tests
    floor_pos(value = d"2.7") => Ok(value = d"2.0")
    floor_neg(value = d"-2.7") => Ok(value = d"-3.0")
    floor_neg_frac(value = d"-0.5") => Ok(value = d"-1.0")
    floor_exact(value = d"2.0") => Ok(value = d"2.0")
    floor_exact_neg(value = d"-2.0") => Ok(value = d"-2.0")
    floor_multi(value = d"123.456") => Ok(value = d"123.0")
    floor_zero(value = d"0.0") => Ok(value = d"0.0")
=
  match call std__dec__parts(value)
    on Ok p => match call std__dec__strip_from(p.scale, p.coefficient, true)
      on Ok s => match call std__convert__int_to_dec(s.stripped)
        on Ok whole => Ok(value = whole.value)

fn std__dec__ceil(value: dec) -> Dec__Value rev 1
  emits []
  tests
    ceil_pos(value = d"2.7") => Ok(value = d"3.0")
    ceil_neg(value = d"-2.7") => Ok(value = d"-2.0")
    ceil_frac(value = d"0.5") => Ok(value = d"1.0")
    ceil_neg_frac(value = d"-0.5") => Ok(value = d"0.0")
    ceil_exact(value = d"2.0") => Ok(value = d"2.0")
    ceil_exact_neg(value = d"-2.0") => Ok(value = d"-2.0")
    ceil_multi(value = d"123.456") => Ok(value = d"124.0")
    ceil_zero(value = d"0.0") => Ok(value = d"0.0")
=
  match call std__dec__parts(value)
    on Ok p => match call std__dec__strip_from(p.scale, p.coefficient, true)
      on Ok s => match s.exact
        true => match call std__convert__int_to_dec(s.stripped)
          on Ok whole => Ok(value = whole.value)
        false => match call std__convert__int_to_dec(s.stripped + 1)
          on Ok whole => Ok(value = whole.value)

fn std__convert__bool_to_str(value: bool) -> Str__Value rev 1
  emits []
  tests
    b2s_t(value = true) => Ok(value = "true")
    b2s_f(value = false) => Ok(value = "false")
=
  match value
    true => Ok(value = "true")
    false => Ok(value = "false")

fn std__convert__str_to_bool(value: str) -> Bool__Value rev 1
  emits [convert.invalid_boolean]
  tests
    s2b_t(value = "true") => Ok(value = true)
    s2b_f(value = "false") => Ok(value = false)
    s2b_bogus(value = "yes") => convert.invalid_boolean(value = "yes")
=
  match value
    "true" => Ok(value = true)
    "false" => Ok(value = false)
    _ => convert.invalid_boolean(value = value)

fn std__convert__bool_to_int(value: bool) -> Int__Value rev 1
  emits []
  tests
    b2i_t(value = true) => Ok(value = 1)
    b2i_f(value = false) => Ok(value = 0)
=
  match value
    true => Ok(value = 1)
    false => Ok(value = 0)

fn std__convert__int_to_bool(value: int) -> Bool__Value rev 1
  emits [convert.invalid_boolean_encoding]
  tests
    i2b_zero(value = 0) => Ok(value = false)
    i2b_one(value = 1) => Ok(value = true)
    i2b_two(value = 2) => convert.invalid_boolean_encoding(value = 2)
=
  match value == 0
    true => Ok(value = false)
    false => match value == 1
      true => Ok(value = true)
      false => convert.invalid_boolean_encoding(value = value)

fn std__convert__bool_to_dec(value: bool) -> Dec__Value rev 1
  emits []
  tests
    b2d_t(value = true) => Ok(value = d"1.0")
    b2d_f(value = false) => Ok(value = d"0.0")
=
  match value
    true => Ok(value = d"1.0")
    false => Ok(value = d"0.0")

fn std__convert__dec_to_bool(value: dec) -> Bool__Value rev 1
  emits [convert.invalid_dec_encoding]
  tests
    d2b_zero(value = d"0.0") => Ok(value = false)
    d2b_one(value = d"1.0") => Ok(value = true)
    d2b_two(value = d"2.0") => convert.invalid_dec_encoding(value = d"2.0")
=
  match value == d"0.0"
    true => Ok(value = false)
    false => match value == d"1.0"
      true => Ok(value = true)
      false => convert.invalid_dec_encoding(value = value)

fn std__convert__int_to_dec_from(m: int, acc: dec, step: dec) -> Dec__Value rev 1
  decreases m
  emits []
  tests
    from_zero(m = 0, acc = d"0.0", step = d"1.0") => Ok(value = d"0.0")
    from_two(m = 2, acc = d"0.0", step = d"1.0") => Ok(value = d"2.0")
    from_neg_step(m = 2, acc = d"0.0", step = d"-1.0") => Ok(value = d"-2.0")
=
  match m <= 0
    true => Ok(value = acc)
    false => match call std__convert__int_to_dec_from(m - 1, acc + step, step)
      on Ok r => Ok(value = r.value)

fn std__convert__int_to_str_from(n: int, acc: str, m: int) -> Str__Value rev 1
  decreases m
  emits []
  tests
    str_from_fuel_out(n = 5, acc = "x", m = 0) => Ok(value = "x")
    str_from_digit(n = 5, acc = "", m = 6) => Ok(value = "5")
    str_from_multi(n = 42, acc = "", m = 3) => Ok(value = "42")
=
  match m <= 0
    true => Ok(value = acc)
    false => match n <= 9
      true => Ok(value = "0123456789"[n:n + 1] + acc)
      false => match call std__convert__int_to_str_from(n / 10, "0123456789"[n % 10:n % 10 + 1] + acc, m - 1)
        on Ok r => Ok(value = r.value)

fn std__convert__int_to_str(value: int) -> Str__Value rev 1
  emits []
  tests
    i2s_zero(value = 0) => Ok(value = "0")
    i2s_pos(value = 42) => Ok(value = "42")
    i2s_thousand(value = 1000) => Ok(value = "1000")
    i2s_neg(value = -7) => Ok(value = "-7")
=
  match value < 0
    true => match call std__convert__int_to_str_from(0 - value, "", 0 - value + 1)
      on Ok r => Ok(value = "-" + r.value)
    false => match call std__convert__int_to_str_from(value, "", value + 1)
      on Ok r => Ok(value = r.value)

fn std__convert__str_to_int_from(orig: str, value: str, pos: int, acc: int, n: int) -> Int__Value rev 1
  decreases n
  emits [convert.invalid_integer]
  tests
    sti_done(orig = "42", value = "42", pos = 2, acc = 42, n = 0) => Ok(value = 42)
    sti_step(orig = "42", value = "42", pos = 0, acc = 0, n = 2) => Ok(value = 42)
    sti_bad_high(orig = "1a", value = "1a", pos = 1, acc = 1, n = 1) => convert.invalid_integer(value = "1a")
    sti_bad_low(orig = "1-2", value = "1-2", pos = 1, acc = 1, n = 2) => convert.invalid_integer(value = "1-2")
=
  match n <= 0
    true => Ok(value = acc)
    false => match value[pos] >= 48
      true => match value[pos] <= 57
        true => match call std__convert__str_to_int_from(orig, value, pos + 1, acc * 10 + (value[pos] - 48), n - 1)
          on convert.invalid_integer e => convert.invalid_integer(value = e.value)
          on Ok r => Ok(value = r.value)
        false => convert.invalid_integer(value = orig)
      false => convert.invalid_integer(value = orig)

fn std__convert__str_to_int(value: str) -> Int__Value rev 1
  emits [convert.invalid_integer]
  tests
    s2i_zero(value = "0") => Ok(value = 0)
    s2i_pos(value = "42") => Ok(value = 42)
    s2i_neg(value = "-7") => Ok(value = -7)
    s2i_empty(value = "") => convert.invalid_integer(value = "")
    s2i_bare_minus(value = "-") => convert.invalid_integer(value = "-")
    s2i_bad(value = "12a") => convert.invalid_integer(value = "12a")
    s2i_neg_bad(value = "-1a") => convert.invalid_integer(value = "-1a")
=
  match #value == 0
    true => convert.invalid_integer(value = value)
    false => match value[0:1] == "-"
      true => match #value >= 2
        true => match call std__convert__str_to_int_from(value, value, 1, 0, #value - 1)
          on convert.invalid_integer e => convert.invalid_integer(value = e.value)
          on Ok r => Ok(value = 0 - r.value)
        false => convert.invalid_integer(value = value)
      false => match call std__convert__str_to_int_from(value, value, 0, 0, #value)
        on convert.invalid_integer e => convert.invalid_integer(value = e.value)
        on Ok r => Ok(value = r.value)

fn std__convert__str_to_dec_from(orig: str, value: str, pos: int, coeff: int, scale: int, dot: int, n: int) -> Dec__Value rev 1
  decreases n
  emits [convert.invalid_decimal]
  tests
    std_done_int(orig = "42", value = "42", pos = 2, coeff = 42, scale = 0, dot = 0, n = 0) => Ok(value = d"42.0")
    std_done_frac(orig = "1.5", value = "1.5", pos = 3, coeff = 15, scale = 1, dot = 1, n = 0) => Ok(value = d"1.5")
    std_trailing_dot(orig = "1.", value = "1.", pos = 2, coeff = 1, scale = 0, dot = 1, n = 0) => convert.invalid_decimal(value = "1.")
    std_step_int(orig = "42", value = "42", pos = 0, coeff = 0, scale = 0, dot = 0, n = 2) => Ok(value = d"42.0")
    std_step_frac(orig = "1.5", value = "1.5", pos = 2, coeff = 1, scale = 0, dot = 1, n = 1) => Ok(value = d"1.5")
    std_step_dot(orig = "1.5", value = "1.5", pos = 1, coeff = 1, scale = 0, dot = 0, n = 2) => Ok(value = d"1.5")
    std_double_dot(orig = "1.2.3", value = "1.2.3", pos = 3, coeff = 12, scale = 1, dot = 1, n = 2) => convert.invalid_decimal(value = "1.2.3")
    std_bad_high(orig = "12a", value = "12a", pos = 2, coeff = 12, scale = 0, dot = 0, n = 1) => convert.invalid_decimal(value = "12a")
    std_bad_low(orig = "1-2", value = "1-2", pos = 1, coeff = 1, scale = 0, dot = 0, n = 2) => convert.invalid_decimal(value = "1-2")
=
  match n <= 0
    true => match dot == 0
      true => match call std__convert__int_to_dec(coeff)
        on Ok whole => Ok(value = whole.value)
      false => match scale == 0
        true => convert.invalid_decimal(value = orig)
        false => match call std__convert__int_to_dec(coeff)
          on Ok whole => match call std__dec__scale_by_power_of_ten(whole.value, 0 - scale)
            on Ok moved => Ok(value = moved.value)
    false => match value[pos:pos + 1] == "."
      true => match dot == 0
        true => match call std__convert__str_to_dec_from(orig, value, pos + 1, coeff, scale, 1, n - 1)
          on convert.invalid_decimal e => convert.invalid_decimal(value = e.value)
          on Ok r => Ok(value = r.value)
        false => convert.invalid_decimal(value = orig)
      false => match value[pos] >= 48
        true => match value[pos] <= 57
          true => match dot == 0
            true => match call std__convert__str_to_dec_from(orig, value, pos + 1, coeff * 10 + (value[pos] - 48), scale, dot, n - 1)
              on convert.invalid_decimal e => convert.invalid_decimal(value = e.value)
              on Ok r => Ok(value = r.value)
            false => match call std__convert__str_to_dec_from(orig, value, pos + 1, coeff * 10 + (value[pos] - 48), scale + 1, dot, n - 1)
              on convert.invalid_decimal e => convert.invalid_decimal(value = e.value)
              on Ok r => Ok(value = r.value)
          false => convert.invalid_decimal(value = orig)
        false => convert.invalid_decimal(value = orig)

fn std__convert__str_to_dec(value: str) -> Dec__Value rev 1
  emits [convert.invalid_decimal]
  tests
    s2d_zero(value = "0") => Ok(value = d"0.0")
    s2d_int(value = "42") => Ok(value = d"42.0")
    s2d_neg(value = "-7") => Ok(value = d"-7.0")
    s2d_frac(value = "1.5") => Ok(value = d"1.5")
    s2d_neg_frac(value = "-0.5") => Ok(value = d"-0.5")
    s2d_lead_dot(value = ".5") => Ok(value = d"0.5")
    s2d_lead_dot_neg(value = "-.5") => Ok(value = d"-0.5")
    s2d_empty(value = "") => convert.invalid_decimal(value = "")
    s2d_bare_minus(value = "-") => convert.invalid_decimal(value = "-")
    s2d_double_dot(value = "1.2.3") => convert.invalid_decimal(value = "1.2.3")
    s2d_bad(value = "12a") => convert.invalid_decimal(value = "12a")
    s2d_neg_bad(value = "-12a") => convert.invalid_decimal(value = "-12a")
    s2d_trailing_dot(value = "1.") => convert.invalid_decimal(value = "1.")
=
  match #value == 0
    true => convert.invalid_decimal(value = value)
    false => match value[0:1] == "-"
      true => match #value >= 2
        true => match call std__convert__str_to_dec_from(value, value, 1, 0, 0, 0, #value - 1)
          on convert.invalid_decimal e => convert.invalid_decimal(value = e.value)
          on Ok r => Ok(value = d"0.0" - r.value)
        false => convert.invalid_decimal(value = value)
      false => match call std__convert__str_to_dec_from(value, value, 0, 0, 0, 0, #value)
        on convert.invalid_decimal e => convert.invalid_decimal(value = e.value)
        on Ok r => Ok(value = r.value)

fn std__convert__int_to_dec(value: int) -> Dec__Value rev 1
  emits []
  tests
    i2d_zero(value = 0) => Ok(value = d"0.0")
    i2d_pos(value = 3) => Ok(value = d"3.0")
    i2d_neg(value = -2) => Ok(value = d"-2.0")
=
  match value >= 0
    true => match call std__convert__int_to_dec_from(value, d"0.0", d"1.0")
      on Ok r => Ok(value = r.value)
    false => match call std__convert__int_to_dec_from(0 - value, d"0.0", d"-1.0")
      on Ok r => Ok(value = r.value)

fn std__backoff__delay(attempt: int, base_ms: int, cap_ms: int) -> Int__Value rev 1
  emits [math.negative_input]
  tests
    backoff_zero(attempt = 0, base_ms = 100, cap_ms = 1000) => Ok(value = 100)
    backoff_grows(attempt = 2, base_ms = 100, cap_ms = 1000) => Ok(value = 400)
    backoff_capped_product(attempt = 4, base_ms = 100, cap_ms = 1000) => Ok(value = 1000)
    backoff_capped_attempt(attempt = 31, base_ms = 100, cap_ms = 1000) => Ok(value = 1000)
    backoff_negative_attempt(attempt = -1, base_ms = 100, cap_ms = 1000) => math.negative_input(value = -1)
    backoff_negative_base(attempt = 1, base_ms = -5, cap_ms = 1000) => math.negative_input(value = -5)
    backoff_negative_cap(attempt = 1, base_ms = 100, cap_ms = -7) => math.negative_input(value = -7)
=
  match base_ms >= 0
    true => match cap_ms >= 0
      true => match attempt >= 0
        true => match attempt <= 30
          true => match call std__int__pow_from(2, attempt)
            on Ok p => match base_ms * p.value <= cap_ms
              true => Ok(value = base_ms * p.value)
              false => Ok(value = cap_ms)
          false => Ok(value = cap_ms)
        false => math.negative_input(value = attempt)
      false => math.negative_input(value = cap_ms)
    false => math.negative_input(value = base_ms)

// Shape notes, kept with the program, not in a second file.
// 1. Termination and cost are separate claims. std__int__pow_from ends for
//    every non-negative exponent by the decreases proof, while
//    std__backoff__delay caps attempts at 30 so builds stay cheap. The cap
//    is a cost policy at the call site, not part of the power proof.
// 2. Recursion never hides an error arm. fallible recursion splits in
//    two: a total helper with no emits under the guard, and a checked
//    entry that rejects negatives before delegating.
// 3. String order in std__compare__str is byte order on the wire encoding.
//    It is deterministic, not Unicode aware. Grapheme or collation
//    aware comparison waits on the Text layer and pinned data.
