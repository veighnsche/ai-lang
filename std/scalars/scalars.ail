// std/scalars/scalars.ail — row 2 of the standard-library program.
// Monomorphic boolean logic, three-way comparisons, selection,
// predicates, integer and decimal fundamentals, bounded arithmetic,
// exact power and recurrence helpers, the pure NOW conversions, and a
// bounded backoff delay that reuses the power helper.
// Every function returns a named success record. Bool answers use
// Bool__Value, three-way comparisons use Int__Value with exactly -1,
// 0, or 1, and false compares before true. Names use one double
// underscore only in prose: the R3 grammar allows a single __
// separator, so spec name std__int__abs lands here as int__abs.
// The mapping table lives in docs/v13-stdlib.md.
// All calls are same-file locals and execute. No externs, no state.

mod scalars
  provides [bool__not, bool__and, bool__or, bool__xor, bool__implies, bool__equivalent, compare__int, compare__dec, compare__str, compare__bool, select__int, select__bool, select__str, select__dec, int__is_zero, int__is_positive, int__is_negative, int__in_closed_range, int__in_open_range, dec__is_zero, dec__is_positive, dec__is_negative, dec__in_closed_range, dec__in_open_range, int__abs, int__negate, int__sign, int__min, int__max, int__clamp, int__distance, int__square, int__pow_from, int__pow, int__add_bounded, int__subtract_bounded, int__multiply_bounded, int__factorial_from, int__factorial, int__sum_from, int__sum_to, dec__abs, dec__negate, dec__sign, dec__min, dec__max, dec__clamp, dec__distance, dec__square, dec__pow_from, dec__pow, dec__lerp, convert__bool_to_str, convert__str_to_bool, convert__bool_to_int, convert__int_to_bool, convert__bool_to_dec, convert__dec_to_bool, backoff__delay, Int__Value, Dec__Value, Str__Value, Bool__Value]
  uses []
  emits [math.invalid_bounds, math.out_of_range, math.dec_invalid_bounds, math.dec_out_of_range, math.negative_input, math.negative_exponent, convert.invalid_boolean, convert.invalid_boolean_encoding, convert.invalid_dec_encoding]

error math.invalid_bounds(lower: int, upper: int)
error math.out_of_range(value: int, lower: int, upper: int)
error math.dec_invalid_bounds(lower: dec, upper: dec)
error math.dec_out_of_range(value: dec, lower: dec, upper: dec)
error math.negative_input(value: int)
error math.negative_exponent(exponent: int)
error convert.invalid_boolean(value: str)
error convert.invalid_boolean_encoding(value: int)
error convert.invalid_dec_encoding(value: dec)

type Int__Value rev 1 (
  value: int
)

type Dec__Value rev 1 (
  value: dec
)

type Str__Value rev 1 (
  value: str
)

type Bool__Value rev 1 (
  value: bool
)

fn bool__not(value: bool) -> Bool__Value rev 1
  emits []
  tests
    not_true(value = true) => Ok(value = false)
    not_false(value = false) => Ok(value = true)
=
  match value
    true => Ok(value = false)
    false => Ok(value = true)

fn bool__and(left: bool, right: bool) -> Bool__Value rev 1
  emits []
  tests
    and_tt(left = true, right = true) => Ok(value = true)
    and_tf(left = true, right = false) => Ok(value = false)
    and_ft(left = false, right = true) => Ok(value = false)
    and_ff(left = false, right = false) => Ok(value = false)
=
  match left
    true => match right
      true => Ok(value = true)
      false => Ok(value = false)
    false => Ok(value = false)

fn bool__or(left: bool, right: bool) -> Bool__Value rev 1
  emits []
  tests
    or_tt(left = true, right = true) => Ok(value = true)
    or_tf(left = true, right = false) => Ok(value = true)
    or_ft(left = false, right = true) => Ok(value = true)
    or_ff(left = false, right = false) => Ok(value = false)
=
  match left
    true => Ok(value = true)
    false => match right
      true => Ok(value = true)
      false => Ok(value = false)

fn bool__xor(left: bool, right: bool) -> Bool__Value rev 1
  emits []
  tests
    xor_tt(left = true, right = true) => Ok(value = false)
    xor_tf(left = true, right = false) => Ok(value = true)
    xor_ft(left = false, right = true) => Ok(value = true)
    xor_ff(left = false, right = false) => Ok(value = false)
=
  match left
    true => match right
      true => Ok(value = false)
      false => Ok(value = true)
    false => match right
      true => Ok(value = true)
      false => Ok(value = false)

fn bool__implies(left: bool, right: bool) -> Bool__Value rev 1
  emits []
  tests
    imp_tt(left = true, right = true) => Ok(value = true)
    imp_tf(left = true, right = false) => Ok(value = false)
    imp_ft(left = false, right = true) => Ok(value = true)
    imp_ff(left = false, right = false) => Ok(value = true)
=
  match left
    true => match right
      true => Ok(value = true)
      false => Ok(value = false)
    false => Ok(value = true)

fn bool__equivalent(left: bool, right: bool) -> Bool__Value rev 1
  emits []
  tests
    equiv_tt(left = true, right = true) => Ok(value = true)
    equiv_tf(left = true, right = false) => Ok(value = false)
    equiv_ft(left = false, right = true) => Ok(value = false)
    equiv_ff(left = false, right = false) => Ok(value = true)
=
  match left
    true => match right
      true => Ok(value = true)
      false => Ok(value = false)
    false => match right
      true => Ok(value = false)
      false => Ok(value = true)

fn compare__int(left: int, right: int) -> Int__Value rev 1
  emits []
  tests
    cmp_int_eq(left = 4, right = 4) => Ok(value = 0)
    cmp_int_gt(left = 5, right = 4) => Ok(value = 1)
    cmp_int_lt(left = 3, right = 4) => Ok(value = -1)
=
  match left == right
    true => Ok(value = 0)
    false => match left >= right
      true => Ok(value = 1)
      false => Ok(value = -1)

fn compare__dec(left: dec, right: dec) -> Int__Value rev 1
  emits []
  tests
    cmp_dec_eq(left = d"1.5", right = d"1.5") => Ok(value = 0)
    cmp_dec_gt(left = d"1.6", right = d"1.5") => Ok(value = 1)
    cmp_dec_lt(left = d"1.4", right = d"1.5") => Ok(value = -1)
=
  match left == right
    true => Ok(value = 0)
    false => match left >= right
      true => Ok(value = 1)
      false => Ok(value = -1)

fn compare__str(left: str, right: str) -> Int__Value rev 1
  emits []
  tests
    cmp_str_eq(left = "a", right = "a") => Ok(value = 0)
    cmp_str_gt(left = "b", right = "a") => Ok(value = 1)
    cmp_str_lt(left = "a", right = "b") => Ok(value = -1)
=
  match left == right
    true => Ok(value = 0)
    false => match left >= right
      true => Ok(value = 1)
      false => Ok(value = -1)

fn compare__bool(left: bool, right: bool) -> Int__Value rev 1
  emits []
  tests
    cmp_bool_tt(left = true, right = true) => Ok(value = 0)
    cmp_bool_ff(left = false, right = false) => Ok(value = 0)
    cmp_bool_tf(left = true, right = false) => Ok(value = 1)
    cmp_bool_ft(left = false, right = true) => Ok(value = -1)
=
  match left == right
    true => Ok(value = 0)
    false => match left
      true => Ok(value = 1)
      false => Ok(value = -1)

fn select__int(condition: bool, when_true: int, when_false: int) -> Int__Value rev 1
  emits []
  tests
    sel_int_t(condition = true, when_true = 1, when_false = 2) => Ok(value = 1)
    sel_int_f(condition = false, when_true = 1, when_false = 2) => Ok(value = 2)
=
  match condition
    true => Ok(value = when_true)
    false => Ok(value = when_false)

fn select__bool(condition: bool, when_true: bool, when_false: bool) -> Bool__Value rev 1
  emits []
  tests
    sel_bool_t(condition = true, when_true = true, when_false = false) => Ok(value = true)
    sel_bool_f(condition = false, when_true = true, when_false = false) => Ok(value = false)
=
  match condition
    true => Ok(value = when_true)
    false => Ok(value = when_false)

fn select__str(condition: bool, when_true: str, when_false: str) -> Str__Value rev 1
  emits []
  tests
    sel_str_t(condition = true, when_true = "a", when_false = "b") => Ok(value = "a")
    sel_str_f(condition = false, when_true = "a", when_false = "b") => Ok(value = "b")
=
  match condition
    true => Ok(value = when_true)
    false => Ok(value = when_false)

fn select__dec(condition: bool, when_true: dec, when_false: dec) -> Dec__Value rev 1
  emits []
  tests
    sel_dec_t(condition = true, when_true = d"1.5", when_false = d"2.5") => Ok(value = d"1.5")
    sel_dec_f(condition = false, when_true = d"1.5", when_false = d"2.5") => Ok(value = d"2.5")
=
  match condition
    true => Ok(value = when_true)
    false => Ok(value = when_false)

fn int__is_zero(value: int) -> Bool__Value rev 1
  emits []
  tests
    is_zero_z(value = 0) => Ok(value = true)
    is_zero_p(value = 3) => Ok(value = false)
    is_zero_n(value = -3) => Ok(value = false)
=
  match value == 0
    true => Ok(value = true)
    false => Ok(value = false)

fn int__is_positive(value: int) -> Bool__Value rev 1
  emits []
  tests
    is_pos_z(value = 0) => Ok(value = false)
    is_pos_p(value = 3) => Ok(value = true)
    is_pos_n(value = -3) => Ok(value = false)
=
  match value == 0
    true => Ok(value = false)
    false => match value >= 0
      true => Ok(value = true)
      false => Ok(value = false)

fn int__is_negative(value: int) -> Bool__Value rev 1
  emits []
  tests
    is_neg_z(value = 0) => Ok(value = false)
    is_neg_p(value = 3) => Ok(value = false)
    is_neg_n(value = -3) => Ok(value = true)
=
  match value == 0
    true => Ok(value = false)
    false => match value <= 0
      true => Ok(value = true)
      false => Ok(value = false)

fn int__in_closed_range(value: int, lower: int, upper: int) -> Bool__Value rev 1
  emits [math.invalid_bounds]
  tests
    closed_in(value = 5, lower = 0, upper = 10) => Ok(value = true)
    closed_low_edge(value = 0, lower = 0, upper = 10) => Ok(value = true)
    closed_high_edge(value = 10, lower = 0, upper = 10) => Ok(value = true)
    closed_below(value = -1, lower = 0, upper = 10) => Ok(value = false)
    closed_above(value = 11, lower = 0, upper = 10) => Ok(value = false)
    closed_bad(value = 5, lower = 10, upper = 0) => math.invalid_bounds(lower = 10, upper = 0)
=
  match lower <= upper
    true => match value >= lower
      true => match value <= upper
        true => Ok(value = true)
        false => Ok(value = false)
      false => Ok(value = false)
    false => math.invalid_bounds(lower = lower, upper = upper)

fn int__in_open_range(value: int, lower: int, upper: int) -> Bool__Value rev 1
  emits [math.invalid_bounds]
  tests
    open_in(value = 5, lower = 0, upper = 10) => Ok(value = true)
    open_low_edge(value = 0, lower = 0, upper = 10) => Ok(value = false)
    open_high_edge(value = 10, lower = 0, upper = 10) => Ok(value = false)
    open_below(value = -1, lower = 0, upper = 10) => Ok(value = false)
    open_above(value = 11, lower = 0, upper = 10) => Ok(value = false)
    open_bad(value = 5, lower = 10, upper = 0) => math.invalid_bounds(lower = 10, upper = 0)
=
  match lower <= upper
    true => match value <= lower
      true => Ok(value = false)
      false => match value >= upper
        true => Ok(value = false)
        false => Ok(value = true)
    false => math.invalid_bounds(lower = lower, upper = upper)

fn dec__is_zero(value: dec) -> Bool__Value rev 1
  emits []
  tests
    dec_zero_z(value = d"0.0") => Ok(value = true)
    dec_zero_p(value = d"1.5") => Ok(value = false)
    dec_zero_n(value = d"-1.5") => Ok(value = false)
=
  match value == d"0.0"
    true => Ok(value = true)
    false => Ok(value = false)

fn dec__is_positive(value: dec) -> Bool__Value rev 1
  emits []
  tests
    dec_pos_z(value = d"0.0") => Ok(value = false)
    dec_pos_p(value = d"1.5") => Ok(value = true)
    dec_pos_n(value = d"-1.5") => Ok(value = false)
=
  match value == d"0.0"
    true => Ok(value = false)
    false => match value >= d"0.0"
      true => Ok(value = true)
      false => Ok(value = false)

fn dec__is_negative(value: dec) -> Bool__Value rev 1
  emits []
  tests
    dec_neg_z(value = d"0.0") => Ok(value = false)
    dec_neg_p(value = d"1.5") => Ok(value = false)
    dec_neg_n(value = d"-1.5") => Ok(value = true)
=
  match value == d"0.0"
    true => Ok(value = false)
    false => match value <= d"0.0"
      true => Ok(value = true)
      false => Ok(value = false)

fn dec__in_closed_range(value: dec, lower: dec, upper: dec) -> Bool__Value rev 1
  emits [math.dec_invalid_bounds]
  tests
    dec_closed_in(value = d"5.0", lower = d"0.0", upper = d"10.0") => Ok(value = true)
    dec_closed_below(value = d"-0.5", lower = d"0.0", upper = d"10.0") => Ok(value = false)
    dec_closed_above(value = d"10.5", lower = d"0.0", upper = d"10.0") => Ok(value = false)
    dec_closed_bad(value = d"5.0", lower = d"10.0", upper = d"0.0") => math.dec_invalid_bounds(lower = d"10.0", upper = d"0.0")
=
  match lower <= upper
    true => match value >= lower
      true => match value <= upper
        true => Ok(value = true)
        false => Ok(value = false)
      false => Ok(value = false)
    false => math.dec_invalid_bounds(lower = lower, upper = upper)

fn dec__in_open_range(value: dec, lower: dec, upper: dec) -> Bool__Value rev 1
  emits [math.dec_invalid_bounds]
  tests
    dec_open_in(value = d"5.0", lower = d"0.0", upper = d"10.0") => Ok(value = true)
    dec_open_edge(value = d"0.0", lower = d"0.0", upper = d"10.0") => Ok(value = false)
    dec_open_high(value = d"10.0", lower = d"0.0", upper = d"10.0") => Ok(value = false)
    dec_open_above(value = d"10.5", lower = d"0.0", upper = d"10.0") => Ok(value = false)
    dec_open_bad(value = d"5.0", lower = d"10.0", upper = d"0.0") => math.dec_invalid_bounds(lower = d"10.0", upper = d"0.0")
=
  match lower <= upper
    true => match value <= lower
      true => Ok(value = false)
      false => match value >= upper
        true => Ok(value = false)
        false => Ok(value = true)
    false => math.dec_invalid_bounds(lower = lower, upper = upper)

fn int__abs(value: int) -> Int__Value rev 1
  emits []
  tests
    abs_neg(value = -3) => Ok(value = 3)
    abs_pos(value = 3) => Ok(value = 3)
    abs_zero(value = 0) => Ok(value = 0)
=
  match value >= 0
    true => Ok(value = value)
    false => Ok(value = 0 - value)

fn int__negate(value: int) -> Int__Value rev 1
  emits []
  tests
    neg_pos(value = 3) => Ok(value = -3)
    neg_neg(value = -3) => Ok(value = 3)
    neg_zero(value = 0) => Ok(value = 0)
=
  Ok(value = 0 - value)

fn int__sign(value: int) -> Int__Value rev 1
  emits []
  tests
    sign_zero(value = 0) => Ok(value = 0)
    sign_pos(value = 3) => Ok(value = 1)
    sign_neg(value = -3) => Ok(value = -1)
=
  match value == 0
    true => Ok(value = 0)
    false => match value >= 0
      true => Ok(value = 1)
      false => Ok(value = -1)

fn int__min(left: int, right: int) -> Int__Value rev 1
  emits []
  tests
    min_lt(left = 3, right = 4) => Ok(value = 3)
    min_gt(left = 5, right = 4) => Ok(value = 4)
    min_eq(left = 4, right = 4) => Ok(value = 4)
=
  match left <= right
    true => Ok(value = left)
    false => Ok(value = right)

fn int__max(left: int, right: int) -> Int__Value rev 1
  emits []
  tests
    max_lt(left = 3, right = 4) => Ok(value = 4)
    max_gt(left = 5, right = 4) => Ok(value = 5)
    max_eq(left = 4, right = 4) => Ok(value = 4)
=
  match left >= right
    true => Ok(value = left)
    false => Ok(value = right)

fn int__clamp(value: int, lower: int, upper: int) -> Int__Value rev 1
  emits [math.invalid_bounds]
  tests
    clamp_in(value = 5, lower = 0, upper = 10) => Ok(value = 5)
    clamp_low(value = -3, lower = 0, upper = 10) => Ok(value = 0)
    clamp_high(value = 14, lower = 0, upper = 10) => Ok(value = 10)
    clamp_bad(value = 5, lower = 10, upper = 0) => math.invalid_bounds(lower = 10, upper = 0)
=
  match lower <= upper
    true => match value >= lower
      true => match value <= upper
        true => Ok(value = value)
        false => Ok(value = upper)
      false => Ok(value = lower)
    false => math.invalid_bounds(lower = lower, upper = upper)

fn int__distance(left: int, right: int) -> Int__Value rev 1
  emits []
  tests
    dist_gt(left = 5, right = 2) => Ok(value = 3)
    dist_lt(left = 2, right = 5) => Ok(value = 3)
    dist_eq(left = 4, right = 4) => Ok(value = 0)
=
  match left >= right
    true => Ok(value = left - right)
    false => Ok(value = right - left)

fn int__square(value: int) -> Int__Value rev 1
  emits []
  tests
    sq_pos(value = 4) => Ok(value = 16)
    sq_neg(value = -4) => Ok(value = 16)
    sq_zero(value = 0) => Ok(value = 0)
=
  Ok(value = value * value)

fn int__pow_from(base: int, exponent: int) -> Int__Value rev 1
  decreases exponent
  emits []
  tests
    pow_from_zero(base = 5, exponent = 0) => Ok(value = 1)
    pow_from_three(base = 2, exponent = 3) => Ok(value = 8)
=
  match exponent <= 0
    true => Ok(value = 1)
    false => match call int__pow_from(base, exponent - 1)
      on Ok r => Ok(value = base * r.value)

fn int__pow(base: int, exponent: int) -> Int__Value rev 1
  emits [math.negative_exponent]
  tests
    pow_zero_exp(base = 5, exponent = 0) => Ok(value = 1)
    pow_pos(base = 2, exponent = 3) => Ok(value = 8)
    pow_zero_zero(base = 0, exponent = 0) => Ok(value = 1)
    pow_neg(base = 2, exponent = -1) => math.negative_exponent(exponent = -1)
=
  match exponent >= 0
    true => match call int__pow_from(base, exponent)
      on Ok r => Ok(value = r.value)
    false => math.negative_exponent(exponent = exponent)

fn int__add_bounded(left: int, right: int, lower: int, upper: int) -> Int__Value rev 1
  emits [math.invalid_bounds, math.out_of_range]
  tests
    add_ok(left = 3, right = 4, lower = 0, upper = 10) => Ok(value = 7)
    add_low(left = -3, right = -4, lower = 0, upper = 10) => math.out_of_range(value = -7, lower = 0, upper = 10)
    add_high(left = 6, right = 7, lower = 0, upper = 10) => math.out_of_range(value = 13, lower = 0, upper = 10)
    add_bad(left = 1, right = 1, lower = 10, upper = 0) => math.invalid_bounds(lower = 10, upper = 0)
=
  match lower <= upper
    true => match left + right >= lower
      true => match left + right <= upper
        true => Ok(value = left + right)
        false => math.out_of_range(value = left + right, lower = lower, upper = upper)
      false => math.out_of_range(value = left + right, lower = lower, upper = upper)
    false => math.invalid_bounds(lower = lower, upper = upper)

fn int__subtract_bounded(left: int, right: int, lower: int, upper: int) -> Int__Value rev 1
  emits [math.invalid_bounds, math.out_of_range]
  tests
    sub_ok(left = 9, right = 4, lower = 0, upper = 10) => Ok(value = 5)
    sub_low(left = 2, right = 9, lower = 0, upper = 10) => math.out_of_range(value = -7, lower = 0, upper = 10)
    sub_high(left = 20, right = 3, lower = 0, upper = 10) => math.out_of_range(value = 17, lower = 0, upper = 10)
    sub_bad(left = 1, right = 1, lower = 10, upper = 0) => math.invalid_bounds(lower = 10, upper = 0)
=
  match lower <= upper
    true => match left - right >= lower
      true => match left - right <= upper
        true => Ok(value = left - right)
        false => math.out_of_range(value = left - right, lower = lower, upper = upper)
      false => math.out_of_range(value = left - right, lower = lower, upper = upper)
    false => math.invalid_bounds(lower = lower, upper = upper)

fn int__multiply_bounded(left: int, right: int, lower: int, upper: int) -> Int__Value rev 1
  emits [math.invalid_bounds, math.out_of_range]
  tests
    mul_ok(left = 3, right = 4, lower = 0, upper = 20) => Ok(value = 12)
    mul_low(left = -3, right = 4, lower = 0, upper = 20) => math.out_of_range(value = -12, lower = 0, upper = 20)
    mul_high(left = 6, right = 7, lower = 0, upper = 20) => math.out_of_range(value = 42, lower = 0, upper = 20)
    mul_bad(left = 1, right = 1, lower = 10, upper = 0) => math.invalid_bounds(lower = 10, upper = 0)
=
  match lower <= upper
    true => match left * right >= lower
      true => match left * right <= upper
        true => Ok(value = left * right)
        false => math.out_of_range(value = left * right, lower = lower, upper = upper)
      false => math.out_of_range(value = left * right, lower = lower, upper = upper)
    false => math.invalid_bounds(lower = lower, upper = upper)

fn int__factorial_from(value: int) -> Int__Value rev 1
  decreases value
  emits []
  tests
    fact_from_zero(value = 0) => Ok(value = 1)
    fact_from_three(value = 3) => Ok(value = 6)
=
  match value <= 0
    true => Ok(value = 1)
    false => match call int__factorial_from(value - 1)
      on Ok r => Ok(value = value * r.value)

fn int__factorial(value: int) -> Int__Value rev 1
  emits [math.negative_input]
  tests
    fact_zero(value = 0) => Ok(value = 1)
    fact_five(value = 5) => Ok(value = 120)
    fact_neg(value = -2) => math.negative_input(value = -2)
=
  match value >= 0
    true => match call int__factorial_from(value)
      on Ok r => Ok(value = r.value)
    false => math.negative_input(value = value)

fn int__sum_from(upper: int) -> Int__Value rev 1
  decreases upper
  emits []
  tests
    sum_from_zero(upper = 0) => Ok(value = 0)
    sum_from_four(upper = 4) => Ok(value = 10)
=
  match upper <= 0
    true => Ok(value = 0)
    false => match call int__sum_from(upper - 1)
      on Ok r => Ok(value = upper + r.value)

fn int__sum_to(upper: int) -> Int__Value rev 1
  emits [math.negative_input]
  tests
    sum_zero(upper = 0) => Ok(value = 0)
    sum_four(upper = 4) => Ok(value = 10)
    sum_neg(upper = -2) => math.negative_input(value = -2)
=
  match upper >= 0
    true => match call int__sum_from(upper)
      on Ok r => Ok(value = r.value)
    false => math.negative_input(value = upper)

fn dec__abs(value: dec) -> Dec__Value rev 1
  emits []
  tests
    dec_abs_neg(value = d"-2.5") => Ok(value = d"2.5")
    dec_abs_pos(value = d"2.5") => Ok(value = d"2.5")
    dec_abs_zero(value = d"0.0") => Ok(value = d"0.0")
=
  match value >= d"0.0"
    true => Ok(value = value)
    false => Ok(value = d"0.0" - value)

fn dec__negate(value: dec) -> Dec__Value rev 1
  emits []
  tests
    dec_neg_pos(value = d"2.5") => Ok(value = d"-2.5")
    dec_neg_neg(value = d"-2.5") => Ok(value = d"2.5")
    dec_neg_zero(value = d"0.0") => Ok(value = d"0.0")
=
  Ok(value = d"0.0" - value)

fn dec__sign(value: dec) -> Int__Value rev 1
  emits []
  tests
    dec_sign_zero(value = d"0.0") => Ok(value = 0)
    dec_sign_pos(value = d"2.5") => Ok(value = 1)
    dec_sign_neg(value = d"-2.5") => Ok(value = -1)
=
  match value == d"0.0"
    true => Ok(value = 0)
    false => match value >= d"0.0"
      true => Ok(value = 1)
      false => Ok(value = -1)

fn dec__min(left: dec, right: dec) -> Dec__Value rev 1
  emits []
  tests
    dec_min_lt(left = d"1.5", right = d"2.5") => Ok(value = d"1.5")
    dec_min_gt(left = d"3.5", right = d"2.5") => Ok(value = d"2.5")
    dec_min_eq(left = d"2.5", right = d"2.5") => Ok(value = d"2.5")
=
  match left <= right
    true => Ok(value = left)
    false => Ok(value = right)

fn dec__max(left: dec, right: dec) -> Dec__Value rev 1
  emits []
  tests
    dec_max_lt(left = d"1.5", right = d"2.5") => Ok(value = d"2.5")
    dec_max_gt(left = d"3.5", right = d"2.5") => Ok(value = d"3.5")
    dec_max_eq(left = d"2.5", right = d"2.5") => Ok(value = d"2.5")
=
  match left >= right
    true => Ok(value = left)
    false => Ok(value = right)

fn dec__clamp(value: dec, lower: dec, upper: dec) -> Dec__Value rev 1
  emits [math.dec_invalid_bounds]
  tests
    dec_clamp_in(value = d"5.0", lower = d"0.0", upper = d"10.0") => Ok(value = d"5.0")
    dec_clamp_low(value = d"-3.0", lower = d"0.0", upper = d"10.0") => Ok(value = d"0.0")
    dec_clamp_high(value = d"14.0", lower = d"0.0", upper = d"10.0") => Ok(value = d"10.0")
    dec_clamp_bad(value = d"5.0", lower = d"10.0", upper = d"0.0") => math.dec_invalid_bounds(lower = d"10.0", upper = d"0.0")
=
  match lower <= upper
    true => match value >= lower
      true => match value <= upper
        true => Ok(value = value)
        false => Ok(value = upper)
      false => Ok(value = lower)
    false => math.dec_invalid_bounds(lower = lower, upper = upper)

fn dec__distance(left: dec, right: dec) -> Dec__Value rev 1
  emits []
  tests
    dec_dist_gt(left = d"5.5", right = d"2.5") => Ok(value = d"3.0")
    dec_dist_lt(left = d"2.5", right = d"5.5") => Ok(value = d"3.0")
    dec_dist_eq(left = d"2.5", right = d"2.5") => Ok(value = d"0.0")
=
  match left >= right
    true => Ok(value = left - right)
    false => Ok(value = right - left)

fn dec__square(value: dec) -> Dec__Value rev 1
  emits []
  tests
    dec_sq_pos(value = d"4.0") => Ok(value = d"16.0")
    dec_sq_neg(value = d"-4.0") => Ok(value = d"16.0")
    dec_sq_frac(value = d"1.5") => Ok(value = d"2.25")
=
  Ok(value = value * value)

fn dec__pow_from(base: dec, exponent: int) -> Dec__Value rev 1
  decreases exponent
  emits []
  tests
    dec_pow_from_zero(base = d"2.5", exponent = 0) => Ok(value = d"1.0")
    dec_pow_from_two(base = d"1.5", exponent = 2) => Ok(value = d"2.25")
=
  match exponent <= 0
    true => Ok(value = d"1.0")
    false => match call dec__pow_from(base, exponent - 1)
      on Ok r => Ok(value = base * r.value)

fn dec__pow(base: dec, exponent: int) -> Dec__Value rev 1
  emits [math.negative_exponent]
  tests
    dec_pow_zero_exp(base = d"2.5", exponent = 0) => Ok(value = d"1.0")
    dec_pow_pos(base = d"1.5", exponent = 2) => Ok(value = d"2.25")
    dec_pow_neg(base = d"1.5", exponent = -1) => math.negative_exponent(exponent = -1)
=
  match exponent >= 0
    true => match call dec__pow_from(base, exponent)
      on Ok r => Ok(value = r.value)
    false => math.negative_exponent(exponent = exponent)

fn dec__lerp(start: dec, end: dec, fraction: dec) -> Dec__Value rev 1
  emits [math.dec_out_of_range]
  tests
    lerp_zero(start = d"10.0", end = d"20.0", fraction = d"0.0") => Ok(value = d"10.0")
    lerp_one(start = d"10.0", end = d"20.0", fraction = d"1.0") => Ok(value = d"20.0")
    lerp_mid(start = d"10.0", end = d"20.0", fraction = d"0.5") => Ok(value = d"15.0")
    lerp_below(start = d"10.0", end = d"20.0", fraction = d"-0.5") => math.dec_out_of_range(value = d"-0.5", lower = d"0.0", upper = d"1.0")
    lerp_above(start = d"10.0", end = d"20.0", fraction = d"1.5") => math.dec_out_of_range(value = d"1.5", lower = d"0.0", upper = d"1.0")
=
  match fraction >= d"0.0"
    true => match fraction <= d"1.0"
      true => Ok(value = start + (end - start) * fraction)
      false => math.dec_out_of_range(value = fraction, lower = d"0.0", upper = d"1.0")
    false => math.dec_out_of_range(value = fraction, lower = d"0.0", upper = d"1.0")

fn convert__bool_to_str(value: bool) -> Str__Value rev 1
  emits []
  tests
    b2s_t(value = true) => Ok(value = "true")
    b2s_f(value = false) => Ok(value = "false")
=
  match value
    true => Ok(value = "true")
    false => Ok(value = "false")

fn convert__str_to_bool(value: str) -> Bool__Value rev 1
  emits [convert.invalid_boolean]
  tests
    s2b_t(value = "true") => Ok(value = true)
    s2b_f(value = "false") => Ok(value = false)
    s2b_bogus(value = "yes") => convert.invalid_boolean(value = "yes")
=
  match value
    "true" => Ok(value = true)
    "false" => Ok(value = false)
    _ => convert.invalid_boolean(value = value)

fn convert__bool_to_int(value: bool) -> Int__Value rev 1
  emits []
  tests
    b2i_t(value = true) => Ok(value = 1)
    b2i_f(value = false) => Ok(value = 0)
=
  match value
    true => Ok(value = 1)
    false => Ok(value = 0)

fn convert__int_to_bool(value: int) -> Bool__Value rev 1
  emits [convert.invalid_boolean_encoding]
  tests
    i2b_zero(value = 0) => Ok(value = false)
    i2b_one(value = 1) => Ok(value = true)
    i2b_two(value = 2) => convert.invalid_boolean_encoding(value = 2)
=
  match value == 0
    true => Ok(value = false)
    false => match value == 1
      true => Ok(value = true)
      false => convert.invalid_boolean_encoding(value = value)

fn convert__bool_to_dec(value: bool) -> Dec__Value rev 1
  emits []
  tests
    b2d_t(value = true) => Ok(value = d"1.0")
    b2d_f(value = false) => Ok(value = d"0.0")
=
  match value
    true => Ok(value = d"1.0")
    false => Ok(value = d"0.0")

fn convert__dec_to_bool(value: dec) -> Bool__Value rev 1
  emits [convert.invalid_dec_encoding]
  tests
    d2b_zero(value = d"0.0") => Ok(value = false)
    d2b_one(value = d"1.0") => Ok(value = true)
    d2b_two(value = d"2.0") => convert.invalid_dec_encoding(value = d"2.0")
=
  match value == d"0.0"
    true => Ok(value = false)
    false => match value == d"1.0"
      true => Ok(value = true)
      false => convert.invalid_dec_encoding(value = value)

fn backoff__delay(attempt: int, base_ms: int, cap_ms: int) -> Int__Value rev 1
  emits [math.negative_input]
  tests
    backoff_zero(attempt = 0, base_ms = 100, cap_ms = 1000) => Ok(value = 100)
    backoff_grows(attempt = 2, base_ms = 100, cap_ms = 1000) => Ok(value = 400)
    backoff_capped_product(attempt = 4, base_ms = 100, cap_ms = 1000) => Ok(value = 1000)
    backoff_capped_attempt(attempt = 31, base_ms = 100, cap_ms = 1000) => Ok(value = 1000)
    backoff_negative_attempt(attempt = -1, base_ms = 100, cap_ms = 1000) => math.negative_input(value = -1)
    backoff_negative_base(attempt = 1, base_ms = -5, cap_ms = 1000) => math.negative_input(value = -5)
    backoff_negative_cap(attempt = 1, base_ms = 100, cap_ms = -7) => math.negative_input(value = -7)
=
  match base_ms >= 0
    true => match cap_ms >= 0
      true => match attempt >= 0
        true => match attempt <= 30
          true => match call int__pow_from(2, attempt)
            on Ok p => match base_ms * p.value <= cap_ms
              true => Ok(value = base_ms * p.value)
              false => Ok(value = cap_ms)
          false => Ok(value = cap_ms)
        false => math.negative_input(value = attempt)
      false => math.negative_input(value = cap_ms)
    false => math.negative_input(value = base_ms)

// Shape notes, kept with the program, not in a second file.
// 1. Termination and cost are separate claims. int__pow_from ends for
//    every non-negative exponent by the decreases proof, while
//    backoff__delay caps attempts at 30 so builds stay cheap. The cap
//    is a cost policy at the call site, not part of the power proof.
// 2. Recursion never hides an error arm. fallible recursion splits in
//    two: a total helper with no emits under the guard, and a checked
//    entry that rejects negatives before delegating.
// 3. String order in compare__str is byte order on the wire encoding.
//    It is deterministic, not Unicode aware. Grapheme or collation
//    aware comparison waits on the Text layer and pinned data.
