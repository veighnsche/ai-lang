// std/scalars/scalars.can — row 2 of the standard-library program.
// Monomorphic boolean logic, three-way comparisons, selection,
// predicates, integer and decimal fundamentals, decimal observation
// (parts), bounded arithmetic, exact power and recurrence helpers,
// the pure NOW conversions, and a bounded backoff delay that reuses
// the power helper.
// Every function returns a named success record. Bool answers use
// Bool__Value, three-way comparisons use Int__Value with exactly -1,
// 0, or 1, and false compares before true. Names follow the brief
// verbatim (std__int__abs and friends): the R3 verb class admits
// hierarchical separators — see issue 5.
// All calls are same-file locals and execute. No externs, no state.

mod scalars
  provides [std__bool__not, std__bool__and, std__bool__or, std__bool__xor, std__bool__implies, std__bool__equivalent, std__compare__int, std__compare__dec, std__compare__str, std__compare__bool, std__select__int, std__select__bool, std__select__str, std__select__dec, std__int__is_zero, std__int__is_positive, std__int__is_negative, std__int__in_closed_range, std__int__in_open_range, std__dec__is_zero, std__dec__is_positive, std__dec__is_negative, std__dec__in_closed_range, std__dec__in_open_range, std__int__abs, std__int__negate, std__int__sign, std__int__min, std__int__max, std__int__clamp, std__int__distance, std__int__square, std__int__pow_from, std__int__pow, std__int__add_bounded, std__int__subtract_bounded, std__int__multiply_bounded, std__int__factorial_from, std__int__factorial, std__int__sum_from, std__int__sum_to, std__dec__abs, std__dec__negate, std__dec__sign, std__dec__min, std__dec__max, std__dec__clamp, std__dec__distance, std__dec__square, std__dec__pow_from, std__dec__pow, std__dec__lerp, std__convert__bool_to_str, std__convert__str_to_bool, std__convert__bool_to_int, std__convert__int_to_bool, std__convert__bool_to_dec, std__convert__dec_to_bool, std__convert__int_to_str_from, std__convert__int_to_str, std__convert__str_to_int_from, std__convert__str_to_int, std__convert__str_to_dec_from, std__convert__str_to_dec, std__convert__int_to_dec, std__convert__int_to_dec_from, std__dec__scale_by_power_of_ten, std__dec__scale_by_power_of_ten_from, std__dec__from_parts, std__dec__parts, std__dec__strip_from, std__dec__truncate, std__dec__floor, std__dec__ceil, std__dec__strip257_from, std__dec__divide_exact, std__dec__divide_round_half_even_result, std__dec__divide_round_half_even, std__dec__round_half_even, std__convert__dec_to_str, std__convert__dec_to_int_exact, std__dec__sqrt_exact, std__int__binomial, std__int__binomial_from, std__int__is_prime, std__int__is_prime_from, std__int__next_power_of_two, std__int__next_power_of_two_pow2, std__int__next_power_of_two_from, std__int__sqrt_floor, std__int__sqrt_floor_search, std__int__gcd, std__int__gcd_euclid, std__int__lcm, std__backoff__delay, Int__Value, Dec__Value, Str__Value, Bool__Value, Int__Root, Dec__Parts, Dec__Strip, Dec__Factors, Dec__Rounded, Dec__RoundedQuotient]
  uses []
  emits [math.invalid_bounds, math.out_of_range, math.dec_invalid_bounds, math.dec_out_of_range, math.negative_input, math.nonpositive_input, math.negative_exponent, math.invalid_count, math.negative_scale, math.dec_zero_divisor, math.nonterminating_decimal, math.dec_negative_input, math.nonrepresentable_result, convert.invalid_boolean, convert.fractional_value, convert.invalid_boolean_encoding, convert.invalid_dec_encoding, convert.invalid_integer, convert.invalid_decimal]

error math.invalid_bounds(lower: int, upper: int)
error math.out_of_range(value: int, lower: int, upper: int)
error math.dec_invalid_bounds(lower: dec, upper: dec)
error math.dec_out_of_range(value: dec, lower: dec, upper: dec)
error math.negative_input(value: int)
error math.nonpositive_input(value: int)
error math.negative_exponent(exponent: int)
error math.invalid_count(n: int, k: int)
error math.negative_scale(scale: int)
error math.dec_zero_divisor(divisor: dec)
error math.nonterminating_decimal(dividend: dec, divisor: dec)
error math.dec_negative_input(value: dec)
error math.nonrepresentable_result(value: dec)
error convert.fractional_value(value: dec)
error convert.invalid_boolean(value: str)
error convert.invalid_integer(value: str)
error convert.invalid_decimal(value: str)
error convert.invalid_boolean_encoding(value: int)
error convert.invalid_dec_encoding(value: dec)

type Int__Value rev 1 (
  value: int
)

type Dec__Value rev 1 (
  value: dec
)

type Str__Value rev 1 (
  value: str
)

type Bool__Value rev 1 (
  value: bool
)

type Int__Root rev 1 (
  root: int
  remainder: int
)

type Dec__Parts rev 1 (
  coefficient: int
  scale: int
)

type Dec__Strip rev 1 (
  stripped: int
  exact: bool
)

type Dec__Factors rev 1 (
  rest: int
  twos: int
  fives: int
)

type Dec__Rounded rev 1 (
  value: dec
  discarded: dec
)

type Dec__RoundedQuotient rev 1 (
  value: dec
  remainder: dec
)

fn std__bool__not(value: bool) -> Bool__Value rev 1
  emits []
  tests
    not_true(true) => Ok(value = false)
    not_false(false) => Ok(value = true)
  match value
    true => Ok(value = false)
    false => Ok(value = true)

fn std__bool__and(left: bool, right: bool) -> Bool__Value rev 1
  emits []
  tests
    and_tt(true, true) => Ok(value = true)
    and_tf(true, false) => Ok(value = false)
    and_ft(false, true) => Ok(value = false)
    and_ff(false, false) => Ok(value = false)
  match left, right
    true, true => Ok(value = true)
    true, false => Ok(value = false)
    false, _ => Ok(value = false)

fn std__bool__or(left: bool, right: bool) -> Bool__Value rev 1
  emits []
  tests
    or_tt(true, true) => Ok(value = true)
    or_tf(true, false) => Ok(value = true)
    or_ft(false, true) => Ok(value = true)
    or_ff(false, false) => Ok(value = false)
  match left, right
    true, _ => Ok(value = true)
    false, true => Ok(value = true)
    false, false => Ok(value = false)

fn std__bool__xor(left: bool, right: bool) -> Bool__Value rev 1
  emits []
  tests
    xor_tt(true, true) => Ok(value = false)
    xor_tf(true, false) => Ok(value = true)
    xor_ft(false, true) => Ok(value = true)
    xor_ff(false, false) => Ok(value = false)
  match left, right
    true, true => Ok(value = false)
    true, false => Ok(value = true)
    false, true => Ok(value = true)
    false, false => Ok(value = false)

fn std__bool__implies(left: bool, right: bool) -> Bool__Value rev 1
  emits []
  tests
    imp_tt(true, true) => Ok(value = true)
    imp_tf(true, false) => Ok(value = false)
    imp_ft(false, true) => Ok(value = true)
    imp_ff(false, false) => Ok(value = true)
  match left, right
    true, true => Ok(value = true)
    true, false => Ok(value = false)
    false, _ => Ok(value = true)

fn std__bool__equivalent(left: bool, right: bool) -> Bool__Value rev 1
  emits []
  tests
    equiv_tt(true, true) => Ok(value = true)
    equiv_tf(true, false) => Ok(value = false)
    equiv_ft(false, true) => Ok(value = false)
    equiv_ff(false, false) => Ok(value = true)
  match left, right
    true, true => Ok(value = true)
    true, false => Ok(value = false)
    false, true => Ok(value = false)
    false, false => Ok(value = true)

fn std__compare__int(left: int, right: int) -> Int__Value rev 1
  emits []
  tests
    cmp_int_eq(4, 4) => Ok(value = 0)
    cmp_int_gt(5, 4) => Ok(value = 1)
    cmp_int_lt(3, 4) => Ok(value = -1)
  match left == right, left >= right
    true, _ => Ok(value = 0)
    false, true => Ok(value = 1)
    false, false => Ok(value = -1)

fn std__compare__dec(left: dec, right: dec) -> Int__Value rev 1
  emits []
  tests
    cmp_dec_eq(d"1.5", d"1.5") => Ok(value = 0)
    cmp_dec_gt(d"1.6", d"1.5") => Ok(value = 1)
    cmp_dec_lt(d"1.4", d"1.5") => Ok(value = -1)
  match left == right, left >= right
    true, _ => Ok(value = 0)
    false, true => Ok(value = 1)
    false, false => Ok(value = -1)

fn std__compare__str(left: str, right: str) -> Int__Value rev 1
  emits []
  tests
    cmp_str_eq("a", "a") => Ok(value = 0)
    cmp_str_gt("b", "a") => Ok(value = 1)
    cmp_str_lt("a", "b") => Ok(value = -1)
  match left == right, left >= right
    true, _ => Ok(value = 0)
    false, true => Ok(value = 1)
    false, false => Ok(value = -1)

fn std__compare__bool(left: bool, right: bool) -> Int__Value rev 1
  emits []
  tests
    cmp_bool_tt(true, true) => Ok(value = 0)
    cmp_bool_ff(false, false) => Ok(value = 0)
    cmp_bool_tf(true, false) => Ok(value = 1)
    cmp_bool_ft(false, true) => Ok(value = -1)
  match left == right, left
    true, _ => Ok(value = 0)
    false, true => Ok(value = 1)
    false, false => Ok(value = -1)

fn std__select__int(condition: bool, when_true: int, when_false: int) -> Int__Value rev 1
  emits []
  tests
    sel_int_t(true, 1, 2) => Ok(value = 1)
    sel_int_f(false, 1, 2) => Ok(value = 2)
  match condition
    true => Ok(value = when_true)
    false => Ok(value = when_false)

fn std__select__bool(condition: bool, when_true: bool, when_false: bool) -> Bool__Value rev 1
  emits []
  tests
    sel_bool_t(true, true, false) => Ok(value = true)
    sel_bool_f(false, true, false) => Ok(value = false)
  match condition
    true => Ok(value = when_true)
    false => Ok(value = when_false)

fn std__select__str(condition: bool, when_true: str, when_false: str) -> Str__Value rev 1
  emits []
  tests
    sel_str_t(true, "a", "b") => Ok(value = "a")
    sel_str_f(false, "a", "b") => Ok(value = "b")
  match condition
    true => Ok(value = when_true)
    false => Ok(value = when_false)

fn std__select__dec(condition: bool, when_true: dec, when_false: dec) -> Dec__Value rev 1
  emits []
  tests
    sel_dec_t(true, d"1.5", d"2.5") => Ok(value = d"1.5")
    sel_dec_f(false, d"1.5", d"2.5") => Ok(value = d"2.5")
  match condition
    true => Ok(value = when_true)
    false => Ok(value = when_false)

fn std__int__is_zero(value: int) -> Bool__Value rev 1
  emits []
  tests
    is_zero_z(0) => Ok(value = true)
    is_zero_p(3) => Ok(value = false)
    is_zero_n(-3) => Ok(value = false)
  match value == 0
    true => Ok(value = true)
    false => Ok(value = false)

fn std__int__is_positive(value: int) -> Bool__Value rev 1
  emits []
  tests
    is_pos_z(0) => Ok(value = false)
    is_pos_p(3) => Ok(value = true)
    is_pos_n(-3) => Ok(value = false)
  match value == 0, value >= 0
    true, _ => Ok(value = false)
    false, true => Ok(value = true)
    false, false => Ok(value = false)

fn std__int__is_negative(value: int) -> Bool__Value rev 1
  emits []
  tests
    is_neg_z(0) => Ok(value = false)
    is_neg_p(3) => Ok(value = false)
    is_neg_n(-3) => Ok(value = true)
  match value == 0, value <= 0
    true, _ => Ok(value = false)
    false, true => Ok(value = true)
    false, false => Ok(value = false)

fn std__int__in_closed_range(value: int, lower: int, upper: int) -> Bool__Value rev 1
  emits [math.invalid_bounds]
  tests
    closed_in(5, 0, 10) => Ok(value = true)
    closed_low_edge(0, 0, 10) => Ok(value = true)
    closed_high_edge(10, 0, 10) => Ok(value = true)
    closed_below(-1, 0, 10) => Ok(value = false)
    closed_above(11, 0, 10) => Ok(value = false)
    closed_bad(5, 10, 0) => math.invalid_bounds(lower = 10, upper = 0)
  match lower <= upper, value >= lower, value <= upper
    true, true, true => Ok(value = true)
    true, true, false => Ok(value = false)
    true, false, _ => Ok(value = false)
    false, _, _ => math.invalid_bounds(lower = lower, upper = upper)

fn std__int__in_open_range(value: int, lower: int, upper: int) -> Bool__Value rev 1
  emits [math.invalid_bounds]
  tests
    open_in(5, 0, 10) => Ok(value = true)
    open_low_edge(0, 0, 10) => Ok(value = false)
    open_high_edge(10, 0, 10) => Ok(value = false)
    open_below(-1, 0, 10) => Ok(value = false)
    open_above(11, 0, 10) => Ok(value = false)
    open_bad(5, 10, 0) => math.invalid_bounds(lower = 10, upper = 0)
  match lower <= upper, value <= lower, value >= upper
    true, true, _ => Ok(value = false)
    true, false, true => Ok(value = false)
    true, false, false => Ok(value = true)
    false, _, _ => math.invalid_bounds(lower = lower, upper = upper)

fn std__dec__is_zero(value: dec) -> Bool__Value rev 1
  emits []
  tests
    dec_zero_z(d"0.0") => Ok(value = true)
    dec_zero_p(d"1.5") => Ok(value = false)
    dec_zero_n(d"-1.5") => Ok(value = false)
  match value == d"0.0"
    true => Ok(value = true)
    false => Ok(value = false)

fn std__dec__is_positive(value: dec) -> Bool__Value rev 1
  emits []
  tests
    dec_pos_z(d"0.0") => Ok(value = false)
    dec_pos_p(d"1.5") => Ok(value = true)
    dec_pos_n(d"-1.5") => Ok(value = false)
  match value == d"0.0", value >= d"0.0"
    true, _ => Ok(value = false)
    false, true => Ok(value = true)
    false, false => Ok(value = false)

fn std__dec__is_negative(value: dec) -> Bool__Value rev 1
  emits []
  tests
    dec_neg_z(d"0.0") => Ok(value = false)
    dec_neg_p(d"1.5") => Ok(value = false)
    dec_neg_n(d"-1.5") => Ok(value = true)
  match value == d"0.0", value <= d"0.0"
    true, _ => Ok(value = false)
    false, true => Ok(value = true)
    false, false => Ok(value = false)

fn std__dec__in_closed_range(value: dec, lower: dec, upper: dec) -> Bool__Value rev 1
  emits [math.dec_invalid_bounds]
  tests
    dec_closed_in(d"5.0", d"0.0", d"10.0") => Ok(value = true)
    dec_closed_below(d"-0.5", d"0.0", d"10.0") => Ok(value = false)
    dec_closed_above(d"10.5", d"0.0", d"10.0") => Ok(value = false)
    dec_closed_bad(d"5.0", d"10.0", d"0.0") => math.dec_invalid_bounds(lower = d"10.0", upper = d"0.0")
  match lower <= upper, value >= lower, value <= upper
    true, true, true => Ok(value = true)
    true, true, false => Ok(value = false)
    true, false, _ => Ok(value = false)
    false, _, _ => math.dec_invalid_bounds(lower = lower, upper = upper)

fn std__dec__in_open_range(value: dec, lower: dec, upper: dec) -> Bool__Value rev 1
  emits [math.dec_invalid_bounds]
  tests
    dec_open_in(d"5.0", d"0.0", d"10.0") => Ok(value = true)
    dec_open_edge(d"0.0", d"0.0", d"10.0") => Ok(value = false)
    dec_open_high(d"10.0", d"0.0", d"10.0") => Ok(value = false)
    dec_open_above(d"10.5", d"0.0", d"10.0") => Ok(value = false)
    dec_open_bad(d"5.0", d"10.0", d"0.0") => math.dec_invalid_bounds(lower = d"10.0", upper = d"0.0")
  match lower <= upper, value <= lower, value >= upper
    true, true, _ => Ok(value = false)
    true, false, true => Ok(value = false)
    true, false, false => Ok(value = true)
    false, _, _ => math.dec_invalid_bounds(lower = lower, upper = upper)

fn std__int__abs(value: int) -> Int__Value rev 1
  emits []
  tests
    abs_neg(-3) => Ok(value = 3)
    abs_pos(3) => Ok(value = 3)
    abs_zero(0) => Ok(value = 0)
  match value >= 0
    true => Ok(value = value)
    false => Ok(value = -value)

fn std__int__negate(value: int) -> Int__Value rev 1
  emits []
  tests
    neg_pos(3) => Ok(value = -3)
    neg_neg(-3) => Ok(value = 3)
    neg_zero(0) => Ok(value = 0)
  Ok(value = -value)

fn std__int__sign(value: int) -> Int__Value rev 1
  emits []
  tests
    sign_zero(0) => Ok(value = 0)
    sign_pos(3) => Ok(value = 1)
    sign_neg(-3) => Ok(value = -1)
  match value == 0, value >= 0
    true, _ => Ok(value = 0)
    false, true => Ok(value = 1)
    false, false => Ok(value = -1)

fn std__int__min(left: int, right: int) -> Int__Value rev 1
  emits []
  tests
    min_lt(3, 4) => Ok(value = 3)
    min_gt(5, 4) => Ok(value = 4)
    min_eq(4, 4) => Ok(value = 4)
  match left <= right
    true => Ok(value = left)
    false => Ok(value = right)

fn std__int__max(left: int, right: int) -> Int__Value rev 1
  emits []
  tests
    max_lt(3, 4) => Ok(value = 4)
    max_gt(5, 4) => Ok(value = 5)
    max_eq(4, 4) => Ok(value = 4)
  match left >= right
    true => Ok(value = left)
    false => Ok(value = right)

fn std__int__clamp(value: int, lower: int, upper: int) -> Int__Value rev 1
  emits [math.invalid_bounds]
  tests
    clamp_in(5, 0, 10) => Ok(value = 5)
    clamp_low(-3, 0, 10) => Ok(value = 0)
    clamp_high(14, 0, 10) => Ok(value = 10)
    clamp_bad(5, 10, 0) => math.invalid_bounds(lower = 10, upper = 0)
  match lower <= upper, value >= lower, value <= upper
    true, true, true => Ok(value = value)
    true, true, false => Ok(value = upper)
    true, false, _ => Ok(value = lower)
    false, _, _ => math.invalid_bounds(lower = lower, upper = upper)

fn std__int__distance(left: int, right: int) -> Int__Value rev 1
  emits []
  tests
    dist_gt(5, 2) => Ok(value = 3)
    dist_lt(2, 5) => Ok(value = 3)
    dist_eq(4, 4) => Ok(value = 0)
  match left >= right
    true => Ok(value = left - right)
    false => Ok(value = right - left)

fn std__int__square(value: int) -> Int__Value rev 1
  emits []
  tests
    sq_pos(4) => Ok(value = 16)
    sq_neg(-4) => Ok(value = 16)
    sq_zero(0) => Ok(value = 0)
  Ok(value = value * value)

fn std__int__pow_from(base: int, exponent: int) -> Int__Value rev 1
  decreases exponent
  emits []
  tests
    pow_from_zero(5, 0) => Ok(value = 1)
    pow_from_three(2, 3) => Ok(value = 8)
  match exponent <= 0
    true => Ok(value = 1)
    false => match call std__int__pow_from(base, exponent - 1)
      on Ok r => Ok(value = base * r.value)

fn std__int__pow(base: int, exponent: int) -> Int__Value rev 1
  emits [math.negative_exponent]
  tests
    pow_zero_exp(5, 0) => Ok(value = 1)
    pow_pos(2, 3) => Ok(value = 8)
    pow_zero_zero(0, 0) => Ok(value = 1)
    pow_neg(2, -1) => math.negative_exponent(exponent = -1)
  match exponent >= 0
    true => match call std__int__pow_from(base, exponent)
      on Ok r => Ok(value = r.value)
    false => math.negative_exponent(exponent = exponent)

fn std__int__add_bounded(left: int, right: int, lower: int, upper: int) -> Int__Value rev 1
  emits [math.invalid_bounds, math.out_of_range]
  tests
    add_ok(3, 4, 0, 10) => Ok(value = 7)
    add_low(-3, -4, 0, 10) => math.out_of_range(value = -7, lower = 0, upper = 10)
    add_high(6, 7, 0, 10) => math.out_of_range(value = 13, lower = 0, upper = 10)
    add_bad(1, 1, 10, 0) => math.invalid_bounds(lower = 10, upper = 0)
  match lower <= upper, left + right >= lower, left + right <= upper
    true, true, true => Ok(value = left + right)
    true, true, false => math.out_of_range(value = left + right, lower = lower, upper = upper)
    true, false, _ => math.out_of_range(value = left + right, lower = lower, upper = upper)
    false, _, _ => math.invalid_bounds(lower = lower, upper = upper)

fn std__int__subtract_bounded(left: int, right: int, lower: int, upper: int) -> Int__Value rev 1
  emits [math.invalid_bounds, math.out_of_range]
  tests
    sub_ok(9, 4, 0, 10) => Ok(value = 5)
    sub_low(2, 9, 0, 10) => math.out_of_range(value = -7, lower = 0, upper = 10)
    sub_high(20, 3, 0, 10) => math.out_of_range(value = 17, lower = 0, upper = 10)
    sub_bad(1, 1, 10, 0) => math.invalid_bounds(lower = 10, upper = 0)
  match lower <= upper, left - right >= lower, left - right <= upper
    true, true, true => Ok(value = left - right)
    true, true, false => math.out_of_range(value = left - right, lower = lower, upper = upper)
    true, false, _ => math.out_of_range(value = left - right, lower = lower, upper = upper)
    false, _, _ => math.invalid_bounds(lower = lower, upper = upper)

fn std__int__multiply_bounded(left: int, right: int, lower: int, upper: int) -> Int__Value rev 1
  emits [math.invalid_bounds, math.out_of_range]
  tests
    mul_ok(3, 4, 0, 20) => Ok(value = 12)
    mul_low(-3, 4, 0, 20) => math.out_of_range(value = -12, lower = 0, upper = 20)
    mul_high(6, 7, 0, 20) => math.out_of_range(value = 42, lower = 0, upper = 20)
    mul_bad(1, 1, 10, 0) => math.invalid_bounds(lower = 10, upper = 0)
  match lower <= upper, left * right >= lower, left * right <= upper
    true, true, true => Ok(value = left * right)
    true, true, false => math.out_of_range(value = left * right, lower = lower, upper = upper)
    true, false, _ => math.out_of_range(value = left * right, lower = lower, upper = upper)
    false, _, _ => math.invalid_bounds(lower = lower, upper = upper)

fn std__int__factorial_from(value: int) -> Int__Value rev 1
  decreases value
  emits []
  tests
    fact_from_zero(0) => Ok(value = 1)
    fact_from_three(3) => Ok(value = 6)
  match value <= 0
    true => Ok(value = 1)
    false => match call std__int__factorial_from(value - 1)
      on Ok r => Ok(value = value * r.value)

fn std__int__factorial(value: int) -> Int__Value rev 1
  emits [math.negative_input]
  tests
    fact_zero(0) => Ok(value = 1)
    fact_five(5) => Ok(value = 120)
    fact_neg(-2) => math.negative_input(value = -2)
  match value >= 0
    true => match call std__int__factorial_from(value)
      on Ok r => Ok(value = r.value)
    false => math.negative_input(value = value)

fn std__int__sum_from(upper: int) -> Int__Value rev 1
  decreases upper
  emits []
  tests
    sum_from_zero(0) => Ok(value = 0)
    sum_from_four(4) => Ok(value = 10)
  match upper <= 0
    true => Ok(value = 0)
    false => match call std__int__sum_from(upper - 1)
      on Ok r => Ok(value = upper + r.value)

fn std__int__sum_to(upper: int) -> Int__Value rev 1
  emits [math.negative_input]
  tests
    sum_zero(0) => Ok(value = 0)
    sum_four(4) => Ok(value = 10)
    sum_neg(-2) => math.negative_input(value = -2)
  match upper >= 0
    true => match call std__int__sum_from(upper)
      on Ok r => Ok(value = r.value)
    false => math.negative_input(value = upper)

fn std__int__binomial_from(n: int, k: int, i: int, num: int, den: int) -> Int__Value rev 1
  decreases i
  emits []
  tests
    bin_from_done(5, 2, 0, 20, 2) => Ok(value = 10)
    bin_from_step(5, 2, 2, 1, 1) => Ok(value = 10)
  match i <= 0
    true => Ok(value = num / den)
    false => match call std__int__binomial_from(n, k, i - 1, num * (n - k + i), den * i)
      on Ok r => Ok(value = r.value)

fn std__int__binomial(n: int, k: int) -> Int__Value rev 1
  emits [math.invalid_count]
  tests
    choose(5, 2) => Ok(value = 10)
    full(6, 6) => Ok(value = 1)
    none(5, 0) => Ok(value = 1)
    zero_zero(0, 0) => Ok(value = 1)
    neg_k(5, -1) => math.invalid_count(n = 5, k = -1)
    k_too_big(3, 5) => math.invalid_count(n = 3, k = 5)
  match k >= 0, k <= n
    true, true => match call std__int__binomial_from(n, k, k, 1, 1)
      on Ok r => Ok(value = r.value)
    true, false => math.invalid_count(n = n, k = k)
    false, _ => math.invalid_count(n = n, k = k)

fn std__int__is_prime_from(value: int, e: int) -> Bool__Value rev 1
  decreases e
  emits []
  tests
    prime_from_two(2, 0) => Ok(value = true)
    prime_from_nine(9, 7) => Ok(value = false)
    prime_from_three(3, 1) => Ok(value = true)
  match e <= 0
    true => Ok(value = true)
    false => match value % (e + 1) == 0
      true => Ok(value = false)
      false => match call std__int__is_prime_from(value, e - 1)
        on Ok r => Ok(value = r.value)

fn std__int__is_prime(value: int) -> Bool__Value rev 1
  emits []
  tests
    two(2) => Ok(value = true)
    three(3) => Ok(value = true)
    four(4) => Ok(value = false)
    nine(9) => Ok(value = false)
    one(1) => Ok(value = false)
    zero(0) => Ok(value = false)
    negative(-5) => Ok(value = false)
  match value >= 2
    true => match call std__int__is_prime_from(value, value - 2)
      on Ok r => Ok(value = r.value)
    false => Ok(value = false)

fn std__int__next_power_of_two_pow2(e: int) -> Int__Value rev 1
  decreases e
  emits []
  tests
    pow2_zero(0) => Ok(value = 1)
    pow2_three(3) => Ok(value = 8)
  match e <= 0
    true => Ok(value = 1)
    false => match call std__int__next_power_of_two_pow2(e - 1)
      on Ok r => Ok(value = 2 * r.value)

fn std__int__next_power_of_two_from(value: int, e: int, best: int) -> Int__Value rev 1
  decreases e
  emits []
  tests
    npot_from_one(1, 0, 2) => Ok(value = 1)
    npot_from_five(5, 0, 8) => Ok(value = 8)
    npot_from_step(5, 3, 32) => Ok(value = 8)
    npot_from_keep(5, 2, 8) => Ok(value = 8)
  match e <= 0
    true => match 1 >= value
      true => Ok(value = 1)
      false => Ok(value = best)
    false => match call std__int__next_power_of_two_pow2(e)
      on Ok t => match t.value >= value
        true => match call std__int__next_power_of_two_from(value, e - 1, t.value)
          on Ok r => Ok(value = r.value)
        false => match call std__int__next_power_of_two_from(value, e - 1, best)
          on Ok r => Ok(value = r.value)

fn std__int__next_power_of_two(value: int) -> Int__Value rev 1
  emits [math.nonpositive_input]
  tests
    npot_one(1) => Ok(value = 1)
    npot_five(5) => Ok(value = 8)
    npot_sixteen(16) => Ok(value = 16)
    npot_zero(0) => math.nonpositive_input(value = 0)
    npot_negative(-3) => math.nonpositive_input(value = -3)
  match value >= 1
    true => match call std__int__next_power_of_two_from(value, value, 1)
      on Ok r => Ok(value = r.value)
    false => math.nonpositive_input(value = value)

fn std__int__sqrt_floor_search(value: int, lo: int, hi: int) -> Int__Value rev 1
  decreases lo, hi by narrowing
  emits []
  tests
    search_ten(10, 0, 11) => Ok(value = 3)
    search_exact(9, 3, 4) => Ok(value = 3)
    search_nine(9, 0, 10) => Ok(value = 3)
  match (hi - lo) <= 1
    true => Ok(value = lo)
    false => match ((lo + hi) / 2) * ((lo + hi) / 2) <= value
      true => match call std__int__sqrt_floor_search(value, (lo + hi) / 2, hi)
        on Ok r => Ok(value = r.value)
      false => match call std__int__sqrt_floor_search(value, lo, (lo + hi) / 2)
        on Ok r => Ok(value = r.value)

fn std__int__sqrt_floor(value: int) -> Int__Root rev 1
  emits [math.negative_input]
  tests
    sqrt_zero(0) => Ok(root = 0, remainder = 0)
    sqrt_one(1) => Ok(root = 1, remainder = 0)
    sqrt_four(4) => Ok(root = 2, remainder = 0)
    sqrt_ten(10) => Ok(root = 3, remainder = 1)
    sqrt_neg(-4) => math.negative_input(value = -4)
  match value >= 0
    true => match call std__int__sqrt_floor_search(value, 0, value + 1)
      on Ok r => Ok(root = r.value, remainder = value - r.value * r.value)
    false => math.negative_input(value = value)

fn std__int__gcd_euclid(a: int, b: int) -> Int__Value rev 1
  decreases a, b by euclid
  emits []
  tests
    euclid_basic(12, 8) => Ok(value = 4)
    euclid_coprime(8, 9) => Ok(value = 1)
    euclid_zero_b(5, 0) => Ok(value = 5)
  match b <= 0
    true => Ok(value = a)
    false => match call std__int__gcd_euclid(b, a % b)
      on Ok r => Ok(value = r.value)

fn std__int__gcd(left: int, right: int) -> Int__Value rev 1
  emits []
  tests
    gcd_basic(12, 8) => Ok(value = 4)
    gcd_coprime(8, 9) => Ok(value = 1)
    gcd_zero_left(0, 5) => Ok(value = 5)
    gcd_zero_right(5, 0) => Ok(value = 5)
    gcd_zero_zero(0, 0) => Ok(value = 0)
    gcd_negative(-12, 8) => Ok(value = 4)
    gcd_equal(7, 7) => Ok(value = 7)
  match call std__int__abs(left)
    on Ok a => match call std__int__abs(right)
      on Ok b => match call std__int__gcd_euclid(a.value, b.value)
        on Ok r => Ok(value = r.value)

fn std__int__lcm(left: int, right: int) -> Int__Value rev 1
  emits []
  tests
    lcm_basic(4, 6) => Ok(value = 12)
    lcm_zero_left(0, 5) => Ok(value = 0)
    lcm_zero_right(5, 0) => Ok(value = 0)
    lcm_equal(7, 7) => Ok(value = 7)
    lcm_negative(-4, 6) => Ok(value = 12)
  match left == 0, right == 0
    true, _ => Ok(value = 0)
    false, true => Ok(value = 0)
    false, false => match call std__int__gcd(left, right)
      on Ok g => match call std__int__abs(left)
        on Ok a => match call std__int__abs(right)
          on Ok b => Ok(value = a.value * b.value / g.value)

fn std__dec__abs(value: dec) -> Dec__Value rev 1
  emits []
  tests
    dec_abs_neg(d"-2.5") => Ok(value = d"2.5")
    dec_abs_pos(d"2.5") => Ok(value = d"2.5")
    dec_abs_zero(d"0.0") => Ok(value = d"0.0")
  match value >= d"0.0"
    true => Ok(value = value)
    false => Ok(value = d"0.0" - value)

fn std__dec__negate(value: dec) -> Dec__Value rev 1
  emits []
  tests
    dec_neg_pos(d"2.5") => Ok(value = d"-2.5")
    dec_neg_neg(d"-2.5") => Ok(value = d"2.5")
    dec_neg_zero(d"0.0") => Ok(value = d"0.0")
  Ok(value = d"0.0" - value)

fn std__dec__sign(value: dec) -> Int__Value rev 1
  emits []
  tests
    dec_sign_zero(d"0.0") => Ok(value = 0)
    dec_sign_pos(d"2.5") => Ok(value = 1)
    dec_sign_neg(d"-2.5") => Ok(value = -1)
  match value == d"0.0", value >= d"0.0"
    true, _ => Ok(value = 0)
    false, true => Ok(value = 1)
    false, false => Ok(value = -1)

fn std__dec__min(left: dec, right: dec) -> Dec__Value rev 1
  emits []
  tests
    dec_min_lt(d"1.5", d"2.5") => Ok(value = d"1.5")
    dec_min_gt(d"3.5", d"2.5") => Ok(value = d"2.5")
    dec_min_eq(d"2.5", d"2.5") => Ok(value = d"2.5")
  match left <= right
    true => Ok(value = left)
    false => Ok(value = right)

fn std__dec__max(left: dec, right: dec) -> Dec__Value rev 1
  emits []
  tests
    dec_max_lt(d"1.5", d"2.5") => Ok(value = d"2.5")
    dec_max_gt(d"3.5", d"2.5") => Ok(value = d"3.5")
    dec_max_eq(d"2.5", d"2.5") => Ok(value = d"2.5")
  match left >= right
    true => Ok(value = left)
    false => Ok(value = right)

fn std__dec__clamp(value: dec, lower: dec, upper: dec) -> Dec__Value rev 1
  emits [math.dec_invalid_bounds]
  tests
    dec_clamp_in(d"5.0", d"0.0", d"10.0") => Ok(value = d"5.0")
    dec_clamp_low(d"-3.0", d"0.0", d"10.0") => Ok(value = d"0.0")
    dec_clamp_high(d"14.0", d"0.0", d"10.0") => Ok(value = d"10.0")
    dec_clamp_bad(d"5.0", d"10.0", d"0.0") => math.dec_invalid_bounds(lower = d"10.0", upper = d"0.0")
  match lower <= upper, value >= lower, value <= upper
    true, true, true => Ok(value = value)
    true, true, false => Ok(value = upper)
    true, false, _ => Ok(value = lower)
    false, _, _ => math.dec_invalid_bounds(lower = lower, upper = upper)

fn std__dec__distance(left: dec, right: dec) -> Dec__Value rev 1
  emits []
  tests
    dec_dist_gt(d"5.5", d"2.5") => Ok(value = d"3.0")
    dec_dist_lt(d"2.5", d"5.5") => Ok(value = d"3.0")
    dec_dist_eq(d"2.5", d"2.5") => Ok(value = d"0.0")
  match left >= right
    true => Ok(value = left - right)
    false => Ok(value = right - left)

fn std__dec__square(value: dec) -> Dec__Value rev 1
  emits []
  tests
    dec_sq_pos(d"4.0") => Ok(value = d"16.0")
    dec_sq_neg(d"-4.0") => Ok(value = d"16.0")
    dec_sq_frac(d"1.5") => Ok(value = d"2.25")
  Ok(value = value * value)

fn std__dec__pow_from(base: dec, exponent: int) -> Dec__Value rev 1
  decreases exponent
  emits []
  tests
    dec_pow_from_zero(d"2.5", 0) => Ok(value = d"1.0")
    dec_pow_from_two(d"1.5", 2) => Ok(value = d"2.25")
  match exponent <= 0
    true => Ok(value = d"1.0")
    false => match call std__dec__pow_from(base, exponent - 1)
      on Ok r => Ok(value = base * r.value)

fn std__dec__pow(base: dec, exponent: int) -> Dec__Value rev 1
  emits [math.negative_exponent]
  tests
    dec_pow_zero_exp(d"2.5", 0) => Ok(value = d"1.0")
    dec_pow_pos(d"1.5", 2) => Ok(value = d"2.25")
    dec_pow_neg(d"1.5", -1) => math.negative_exponent(exponent = -1)
  match exponent >= 0
    true => match call std__dec__pow_from(base, exponent)
      on Ok r => Ok(value = r.value)
    false => math.negative_exponent(exponent = exponent)

fn std__dec__lerp(start: dec, end: dec, fraction: dec) -> Dec__Value rev 1
  emits [math.dec_out_of_range]
  tests
    lerp_zero(d"10.0", d"20.0", d"0.0") => Ok(value = d"10.0")
    lerp_one(d"10.0", d"20.0", d"1.0") => Ok(value = d"20.0")
    lerp_mid(d"10.0", d"20.0", d"0.5") => Ok(value = d"15.0")
    lerp_below(d"10.0", d"20.0", d"-0.5") => math.dec_out_of_range(value = d"-0.5", lower = d"0.0", upper = d"1.0")
    lerp_above(d"10.0", d"20.0", d"1.5") => math.dec_out_of_range(value = d"1.5", lower = d"0.0", upper = d"1.0")
  match fraction >= d"0.0", fraction <= d"1.0"
    true, true => Ok(value = start + (end - start) * fraction)
    true, false => math.dec_out_of_range(value = fraction, lower = d"0.0", upper = d"1.0")
    false, _ => math.dec_out_of_range(value = fraction, lower = d"0.0", upper = d"1.0")

fn std__dec__scale_by_power_of_ten_from(value: dec, e: int, factor: dec) -> Dec__Value rev 1
  decreases e
  emits []
  tests
    scale_from_zero_e(d"1.5", 0, d"10.0") => Ok(value = d"1.5")
    scale_from_two(d"1.5", 2, d"10.0") => Ok(value = d"150.0")
    scale_from_down(d"150.0", 2, d"0.1") => Ok(value = d"1.5")
  match e <= 0
    true => Ok(value = value)
    false => match call std__dec__scale_by_power_of_ten_from(value * factor, e - 1, factor)
      on Ok r => Ok(value = r.value)

fn std__dec__scale_by_power_of_ten(value: dec, exponent: int) -> Dec__Value rev 1
  emits []
  tests
    scale_up(d"1.5", 2) => Ok(value = d"150.0")
    scale_same(d"1.5", 0) => Ok(value = d"1.5")
    scale_down(d"150.0", -2) => Ok(value = d"1.5")
    scale_down_neg(d"-2.5", -1) => Ok(value = d"-0.25")
  match exponent >= 0
    true => match call std__dec__scale_by_power_of_ten_from(value, exponent, d"10.0")
      on Ok r => Ok(value = r.value)
    false => match call std__dec__scale_by_power_of_ten_from(value, -exponent, d"0.1")
      on Ok r => Ok(value = r.value)

fn std__dec__from_parts(coefficient: int, scale: int) -> Dec__Value rev 1
  emits [math.negative_scale]
  tests
    parts_cents(25, 2) => Ok(value = d"0.25")
    parts_units(7, 0) => Ok(value = d"7.0")
    parts_neg(-5, 1) => Ok(value = d"-0.5")
    parts_neg_scale(3, -1) => math.negative_scale(scale = -1)
  match scale >= 0
    true => match call std__convert__int_to_dec(coefficient)
      on Ok whole => match call std__dec__scale_by_power_of_ten(whole.value, -scale)
        on Ok moved => Ok(value = moved.value)
    false => math.negative_scale(scale = scale)

fn std__dec__parts(value: dec) -> Dec__Parts rev 1
  emits []
  tests
    parts_whole(d"7.0") => Ok(coefficient = 70, scale = 1)
    parts_cents(d"0.25") => Ok(coefficient = 25, scale = 2)
    parts_neg(d"-0.5") => Ok(coefficient = -5, scale = 1)
    parts_trailing(d"12.340") => Ok(coefficient = 1234, scale = 2)
    parts_zero(d"0.00") => Ok(coefficient = 0, scale = 1)
    parts_neg_zero(d"-0.0") => Ok(coefficient = 0, scale = 1)
    parts_hundreds(d"100.0") => Ok(coefficient = 1000, scale = 1)
    parts_big(d"123456789.123456789") => Ok(coefficient = 123456789123456789, scale = 9)
  match call dec__parts(value)
    on Ok p => Ok(coefficient = p.coefficient, scale = p.scale)

fn std__dec__strip_from(remaining: int, current: int, exact: bool) -> Dec__Strip rev 1
  decreases remaining
  emits []
  tests
    strip_done(0, 27, true) => Ok(stripped = 27, exact = true)
    strip_done_neg(0, -5, true) => Ok(stripped = -5, exact = true)
    strip_step(1, 27, true) => Ok(stripped = 2, exact = false)
    strip_exact_kept(1, 20, true) => Ok(stripped = 2, exact = true)
    strip_neg(1, -27, true) => Ok(stripped = -3, exact = false)
    strip_already_inexact(2, 27, false) => Ok(stripped = 0, exact = false)
  match remaining <= 0
    true => Ok(stripped = current, exact = exact)
    false => match current % 10 == 0
      true => match call std__dec__strip_from(remaining - 1, current / 10, exact)
        on Ok r => Ok(stripped = r.stripped, exact = r.exact)
      false => match call std__dec__strip_from(remaining - 1, current / 10, false)
        on Ok r => Ok(stripped = r.stripped, exact = r.exact)

fn std__dec__truncate(value: dec) -> Dec__Value rev 1
  emits []
  tests
    trunc_pos(d"2.7") => Ok(value = d"2.0")
    trunc_neg(d"-2.7") => Ok(value = d"-2.0")
    trunc_neg_frac(d"-0.5") => Ok(value = d"0.0")
    trunc_exact(d"2.0") => Ok(value = d"2.0")
    trunc_exact_neg(d"-2.0") => Ok(value = d"-2.0")
    trunc_multi(d"123.456") => Ok(value = d"123.0")
    trunc_multi_neg(d"-123.456") => Ok(value = d"-123.0")
    trunc_zero(d"0.0") => Ok(value = d"0.0")
  match call std__dec__parts(value)
    on Ok p => match call std__dec__strip_from(p.scale, p.coefficient, true)
      on Ok s => match s.exact
        true => match call std__convert__int_to_dec(s.stripped)
          on Ok whole => Ok(value = whole.value)
        false => match s.stripped >= 0
          true => match call std__convert__int_to_dec(s.stripped)
            on Ok whole => Ok(value = whole.value)
          false => match call std__convert__int_to_dec(s.stripped + 1)
            on Ok whole => Ok(value = whole.value)

fn std__dec__floor(value: dec) -> Dec__Value rev 1
  emits []
  tests
    floor_pos(d"2.7") => Ok(value = d"2.0")
    floor_neg(d"-2.7") => Ok(value = d"-3.0")
    floor_neg_frac(d"-0.5") => Ok(value = d"-1.0")
    floor_exact(d"2.0") => Ok(value = d"2.0")
    floor_exact_neg(d"-2.0") => Ok(value = d"-2.0")
    floor_multi(d"123.456") => Ok(value = d"123.0")
    floor_zero(d"0.0") => Ok(value = d"0.0")
  match call std__dec__parts(value)
    on Ok p => match call std__dec__strip_from(p.scale, p.coefficient, true)
      on Ok s => match call std__convert__int_to_dec(s.stripped)
        on Ok whole => Ok(value = whole.value)

fn std__dec__ceil(value: dec) -> Dec__Value rev 1
  emits []
  tests
    ceil_pos(d"2.7") => Ok(value = d"3.0")
    ceil_neg(d"-2.7") => Ok(value = d"-2.0")
    ceil_frac(d"0.5") => Ok(value = d"1.0")
    ceil_neg_frac(d"-0.5") => Ok(value = d"0.0")
    ceil_exact(d"2.0") => Ok(value = d"2.0")
    ceil_exact_neg(d"-2.0") => Ok(value = d"-2.0")
    ceil_multi(d"123.456") => Ok(value = d"124.0")
    ceil_zero(d"0.0") => Ok(value = d"0.0")
  match call std__dec__parts(value)
    on Ok p => match call std__dec__strip_from(p.scale, p.coefficient, true)
      on Ok s => match s.exact
        true => match call std__convert__int_to_dec(s.stripped)
          on Ok whole => Ok(value = whole.value)
        false => match call std__convert__int_to_dec(s.stripped + 1)
          on Ok whole => Ok(value = whole.value)

fn std__dec__strip257_from(fuel: int, current: int, twos: int, fives: int) -> Dec__Factors rev 1
  decreases fuel
  emits []
  tests
    factors_done(5, 1, 0, 0) => Ok(rest = 1, twos = 0, fives = 0)
    factors_fuel_out(0, 6, 0, 0) => Ok(rest = 6, twos = 0, fives = 0)
    factors_two(4, 12, 0, 0) => Ok(rest = 3, twos = 2, fives = 0)
    factors_five(3, 25, 0, 0) => Ok(rest = 1, twos = 0, fives = 2)
    factors_mixed(6, 40, 0, 0) => Ok(rest = 1, twos = 3, fives = 1)
    factors_odd(4, 7, 0, 0) => Ok(rest = 7, twos = 0, fives = 0)
  match fuel <= 0
    true => Ok(rest = current, twos = twos, fives = fives)
    false => match current == 1
      true => Ok(rest = 1, twos = twos, fives = fives)
      false => match current % 2 == 0
        true => match call std__dec__strip257_from(fuel - 1, current / 2, twos + 1, fives)
          on Ok r => Ok(rest = r.rest, twos = r.twos, fives = r.fives)
        false => match current % 5 == 0
          true => match call std__dec__strip257_from(fuel - 1, current / 5, twos, fives + 1)
            on Ok r => Ok(rest = r.rest, twos = r.twos, fives = r.fives)
          false => Ok(rest = current, twos = twos, fives = fives)

fn std__dec__divide_exact(dividend: dec, divisor: dec) -> Dec__Value rev 1
  emits [math.dec_zero_divisor, math.nonterminating_decimal]
  tests
    div_exact_basic(d"7.0", d"2.0") => Ok(value = d"3.5")
    div_exact_eighth(d"1.0", d"8.0") => Ok(value = d"0.125")
    div_exact_whole(d"6.0", d"3.0") => Ok(value = d"2.0")
    div_exact_scaled(d"0.3", d"0.2") => Ok(value = d"1.5")
    div_exact_neg_num(d"-7.0", d"2.0") => Ok(value = d"-3.5")
    div_exact_neg_den(d"7.0", d"-2.0") => Ok(value = d"-3.5")
    div_exact_neg_both(d"-7.0", d"-2.0") => Ok(value = d"3.5")
    div_exact_zero_num(d"0.0", d"5.0") => Ok(value = d"0.0")
    div_exact_zero_den(d"5.0", d"0.0") => math.dec_zero_divisor(divisor = d"0.0")
    div_exact_third(d"1.0", d"3.0") => math.nonterminating_decimal(dividend = d"1.0", divisor = d"3.0")
    div_exact_sixth(d"1.0", d"6.0") => math.nonterminating_decimal(dividend = d"1.0", divisor = d"6.0")
    div_exact_seventh(d"1.0", d"7.0") => math.nonterminating_decimal(dividend = d"1.0", divisor = d"7.0")
  match call std__dec__parts(divisor)
    on Ok d => match d.coefficient == 0
      true => math.dec_zero_divisor(divisor = divisor)
      false => match chain
        call std__dec__parts(dividend) as n
        call std__int__pow_from(10, d.scale) as pds
        call std__int__pow_from(10, n.scale) as pns
        call std__int__abs(n.coefficient * pns.value) as an
        call std__int__abs(d.coefficient * pds.value) as ad
        call std__int__gcd(an.value, ad.value) as g
        call std__dec__strip257_from(ad.value / g.value, ad.value / g.value, 0, 0) as f when f.rest == 1
        call std__int__max(f.twos, f.fives) as m
        call std__int__pow_from(10, m.value) as p10
        call std__convert__int_to_dec((an.value / g.value) * (p10.value / (ad.value / g.value))) as qi
        call std__dec__scale_by_power_of_ten(qi.value, -m.value) as q
        then match (n.coefficient * pns.value) < 0, (d.coefficient * pds.value) < 0
          true, true => Ok(value = q.value)
          true, false => Ok(value = q.value * d"-1.0")
          false, true => Ok(value = q.value * d"-1.0")
          false, false => Ok(value = q.value)
        else math.nonterminating_decimal(dividend = dividend, divisor = divisor)

fn std__dec__round_half_even(value: dec, scale: int) -> Dec__Rounded rev 1
  emits [math.negative_scale]
  tests
    round_even_tie(d"2.5", 0) => Ok(value = d"2.0", discarded = d"0.5")
    round_odd_tie(d"3.5", 0) => Ok(value = d"4.0", discarded = d"-0.5")
    round_up(d"2.7", 0) => Ok(value = d"3.0", discarded = d"-0.3")
    round_down(d"2.3", 0) => Ok(value = d"2.0", discarded = d"0.3")
    round_neg_tie(d"-2.5", 0) => Ok(value = d"-2.0", discarded = d"-0.5")
    round_neg_tie_odd(d"-3.5", 0) => Ok(value = d"-4.0", discarded = d"0.5")
    round_neg_up(d"-2.7", 0) => Ok(value = d"-3.0", discarded = d"0.3")
    round_neg_down(d"-2.3", 0) => Ok(value = d"-2.0", discarded = d"-0.3")
    round_multi(d"12.345", 1) => Ok(value = d"12.3", discarded = d"0.045")
    round_wider_scale(d"2.7", 2) => Ok(value = d"2.7", discarded = d"0.0")
    round_zero(d"0.0", 0) => Ok(value = d"0.0", discarded = d"0.0")
    round_half_up(d"0.5", 0) => Ok(value = d"0.0", discarded = d"0.5")
    round_neg_scale(d"2.7", -1) => math.negative_scale(scale = -1)
  match scale >= 0
    true => match chain
      call std__dec__parts(value) as p when p.scale > scale
      call std__int__pow_from(10, p.scale - scale) as pd
      call std__int__abs(p.coefficient) as a
      then match (a.value % pd.value) * 2 == pd.value, (a.value / pd.value) % 2 == 0, (a.value % pd.value) * 2 > pd.value
        true, true, _ => match call std__convert__int_to_dec(a.value / pd.value)
          on Ok qi => match call std__dec__scale_by_power_of_ten(qi.value, 0 - scale)
            on Ok q => match value < d"0.0"
              true => Ok(value = q.value * d"-1.0", discarded = value - (q.value * d"-1.0"))
              false => Ok(value = q.value, discarded = value - q.value)
        true, false, _ => match call std__convert__int_to_dec(a.value / pd.value + 1)
          on Ok qi => match call std__dec__scale_by_power_of_ten(qi.value, 0 - scale)
            on Ok q => match value < d"0.0"
              true => Ok(value = q.value * d"-1.0", discarded = value - (q.value * d"-1.0"))
              false => Ok(value = q.value, discarded = value - q.value)
        false, _, true => match call std__convert__int_to_dec(a.value / pd.value + 1)
          on Ok qi => match call std__dec__scale_by_power_of_ten(qi.value, 0 - scale)
            on Ok q => match value < d"0.0"
              true => Ok(value = q.value * d"-1.0", discarded = value - (q.value * d"-1.0"))
              false => Ok(value = q.value, discarded = value - q.value)
        false, _, false => match call std__convert__int_to_dec(a.value / pd.value)
          on Ok qi => match call std__dec__scale_by_power_of_ten(qi.value, 0 - scale)
            on Ok q => match value < d"0.0"
              true => Ok(value = q.value * d"-1.0", discarded = value - (q.value * d"-1.0"))
              false => Ok(value = q.value, discarded = value - q.value)
      else Ok(value = value, discarded = d"0.0")
    false => math.negative_scale(scale = scale)

fn std__dec__divide_round_half_even_result(qm: int, scale: int, num: int, den: int, dividend: dec, divisor: dec) -> Dec__RoundedQuotient rev 1
  emits []
  tests
    div_result_pos(35, 1, 700, 200, d"7.0", d"2.0") => Ok(value = d"3.5", remainder = d"0.0")
    div_result_neg_num(35, 1, -700, 200, d"-7.0", d"2.0") => Ok(value = d"-3.5", remainder = d"0.0")
    div_result_neg_den(35, 1, 700, -200, d"7.0", d"-2.0") => Ok(value = d"-3.5", remainder = d"0.0")
    div_result_neg_both(35, 1, -700, -200, d"-7.0", d"-2.0") => Ok(value = d"3.5", remainder = d"0.0")
  match call std__convert__int_to_dec(qm)
    on Ok qi => match call std__dec__scale_by_power_of_ten(qi.value, -scale)
      on Ok q => match num < 0, den < 0
        true, true => Ok(value = q.value, remainder = dividend - divisor * q.value)
        true, false => Ok(value = q.value * d"-1.0", remainder = dividend - divisor * (q.value * d"-1.0"))
        false, true => Ok(value = q.value * d"-1.0", remainder = dividend - divisor * (q.value * d"-1.0"))
        false, false => Ok(value = q.value, remainder = dividend - divisor * q.value)

fn std__dec__divide_round_half_even(dividend: dec, divisor: dec, scale: int) -> Dec__RoundedQuotient rev 1
  emits [math.dec_zero_divisor, math.negative_scale]
  tests
    div_round_basic(d"7.0", d"2.0", 1) => Ok(value = d"3.5", remainder = d"0.0")
    div_round_third(d"1.0", d"3.0", 2) => Ok(value = d"0.33", remainder = d"0.01")
    div_round_tie_even(d"2.5", d"1.0", 0) => Ok(value = d"2.0", remainder = d"0.5")
    div_round_tie_odd(d"3.5", d"1.0", 0) => Ok(value = d"4.0", remainder = d"-0.5")
    div_round_up(d"2.7", d"1.0", 0) => Ok(value = d"3.0", remainder = d"-0.3")
    div_round_down(d"2.3", d"1.0", 0) => Ok(value = d"2.0", remainder = d"0.3")
    div_round_neg_num(d"-7.0", d"2.0", 1) => Ok(value = d"-3.5", remainder = d"0.0")
    div_round_neg_den(d"7.0", d"-2.0", 1) => Ok(value = d"-3.5", remainder = d"0.0")
    div_round_neg_both(d"-7.0", d"-2.0", 1) => Ok(value = d"3.5", remainder = d"0.0")
    div_round_zero_num(d"0.0", d"5.0", 1) => Ok(value = d"0.0", remainder = d"0.0")
    div_round_zero_den(d"5.0", d"0.0", 1) => math.dec_zero_divisor(divisor = d"0.0")
    div_round_neg_scale(d"1.0", d"2.0", -1) => math.negative_scale(scale = -1)
    div_round_zero_neg_scale(d"5.0", d"0.0", -1) => math.dec_zero_divisor(divisor = d"0.0")
  match call std__dec__parts(divisor)
    on Ok d => match d.coefficient == 0
      true => math.dec_zero_divisor(divisor = divisor)
      false => match scale >= 0
        true => match call std__dec__parts(dividend)
          on Ok n => match call std__int__pow_from(10, d.scale)
            on Ok pds => match call std__int__pow_from(10, n.scale)
              on Ok pns => match call std__int__abs(n.coefficient * pns.value)
                on Ok an => match call std__int__abs(d.coefficient * pds.value)
                  on Ok ad => match call std__int__pow_from(10, scale)
                    on Ok psc => match (an.value * psc.value) % ad.value * 2 == ad.value, (an.value * psc.value) / ad.value % 2 == 0, (an.value * psc.value) % ad.value * 2 > ad.value
                      true, true, _ => match call std__dec__divide_round_half_even_result((an.value * psc.value) / ad.value, scale, n.coefficient * pns.value, d.coefficient * pds.value, dividend, divisor)
                        on Ok r => Ok(value = r.value, remainder = r.remainder)
                      true, false, _ => match call std__dec__divide_round_half_even_result((an.value * psc.value) / ad.value + 1, scale, n.coefficient * pns.value, d.coefficient * pds.value, dividend, divisor)
                        on Ok r => Ok(value = r.value, remainder = r.remainder)
                      false, _, true => match call std__dec__divide_round_half_even_result((an.value * psc.value) / ad.value + 1, scale, n.coefficient * pns.value, d.coefficient * pds.value, dividend, divisor)
                        on Ok r => Ok(value = r.value, remainder = r.remainder)
                      false, _, false => match call std__dec__divide_round_half_even_result((an.value * psc.value) / ad.value, scale, n.coefficient * pns.value, d.coefficient * pds.value, dividend, divisor)
                        on Ok r => Ok(value = r.value, remainder = r.remainder)
        false => math.negative_scale(scale = scale)

fn std__convert__dec_to_str(value: dec) -> Str__Value rev 1
  emits []
  tests
    s2s_simple(d"12.34") => Ok(value = "12.34")
    s2s_cents(d"0.25") => Ok(value = "0.25")
    s2s_neg(d"-0.5") => Ok(value = "-0.5")
    s2s_units(d"7.0") => Ok(value = "7.0")
    s2s_zero(d"0.0") => Ok(value = "0.0")
    s2s_hundreds(d"100.0") => Ok(value = "100.0")
    s2s_pad(d"0.05") => Ok(value = "0.05")
    s2s_large(d"999.99") => Ok(value = "999.99")
  match call std__dec__parts(value)
    on Ok p => match call std__int__abs(p.coefficient)
      on Ok a => match call std__int__pow_from(10, p.scale)
        on Ok p10 => match call std__convert__int_to_str(a.value / p10.value)
          on Ok ip => match call std__convert__int_to_str(a.value % p10.value + p10.value)
            on Ok fp => match p.coefficient < 0
              true => Ok(value = "-" + ip.value + "." + fp.value[1:p.scale + 1])
              false => Ok(value = ip.value + "." + fp.value[1:p.scale + 1])

fn std__convert__dec_to_int_exact(value: dec) -> Int__Value rev 1
  emits [convert.fractional_value]
  tests
    s2i_whole(d"7.0") => Ok(value = 7)
    s2i_neg_whole(d"-7.0") => Ok(value = -7)
    s2i_zero(d"0.0") => Ok(value = 0)
    s2i_hundreds(d"100.0") => Ok(value = 100)
    s2i_frac(d"2.5") => convert.fractional_value(value = d"2.5")
    s2i_neg_frac(d"-2.5") => convert.fractional_value(value = d"-2.5")
    s2i_cents(d"0.25") => convert.fractional_value(value = d"0.25")
  match call std__dec__parts(value)
    on Ok p => match call std__dec__strip_from(p.scale, p.coefficient, true)
      on Ok s => match s.exact
        true => Ok(value = s.stripped)
        false => convert.fractional_value(value = value)

fn std__dec__sqrt_exact(value: dec) -> Dec__Value rev 1
  emits [math.dec_negative_input, math.nonrepresentable_result]
  tests
    sqrt_exact_whole(d"4.0") => Ok(value = d"2.0")
    sqrt_exact_frac(d"2.25") => Ok(value = d"1.5")
    sqrt_exact_small(d"0.25") => Ok(value = d"0.5")
    sqrt_exact_zero(d"0.0") => Ok(value = d"0.0")
    sqrt_exact_even_refuse(d"2.26") => math.nonrepresentable_result(value = d"2.26")
    sqrt_exact_odd_refuse(d"2.0") => math.nonrepresentable_result(value = d"2.0")
    sqrt_exact_neg(d"-4.0") => math.dec_negative_input(value = d"-4.0")
  match call std__dec__parts(value)
    on Ok p => match p.coefficient < 0
      true => math.dec_negative_input(value = value)
      false => match p.scale % 2 == 0
        true => match chain
          call std__int__sqrt_floor_search(p.coefficient, 0, p.coefficient + 1) as r when p.coefficient - r.value * r.value == 0
          call std__convert__int_to_dec(r.value) as qi
          call std__dec__scale_by_power_of_ten(qi.value, -(p.scale / 2)) as q
          then Ok(value = q.value)
          else math.nonrepresentable_result(value = value)
        false => match chain
          call std__int__sqrt_floor_search(p.coefficient * 10, 0, p.coefficient * 10 + 1) as r when p.coefficient * 10 - r.value * r.value == 0
          call std__convert__int_to_dec(r.value) as qi
          call std__dec__scale_by_power_of_ten(qi.value, -((p.scale + 1) / 2)) as q
          then Ok(value = q.value)
          else math.nonrepresentable_result(value = value)

fn std__convert__bool_to_str(value: bool) -> Str__Value rev 1
  emits []
  tests
    b2s_t(true) => Ok(value = "true")
    b2s_f(false) => Ok(value = "false")
  match value
    true => Ok(value = "true")
    false => Ok(value = "false")

fn std__convert__str_to_bool(value: str) -> Bool__Value rev 1
  emits [convert.invalid_boolean]
  tests
    s2b_t("true") => Ok(value = true)
    s2b_f("false") => Ok(value = false)
    s2b_bogus("yes") => convert.invalid_boolean(value = "yes")
  match value
    "true" => Ok(value = true)
    "false" => Ok(value = false)
    _ => convert.invalid_boolean(value = value)

fn std__convert__bool_to_int(value: bool) -> Int__Value rev 1
  emits []
  tests
    b2i_t(true) => Ok(value = 1)
    b2i_f(false) => Ok(value = 0)
  match value
    true => Ok(value = 1)
    false => Ok(value = 0)

fn std__convert__int_to_bool(value: int) -> Bool__Value rev 1
  emits [convert.invalid_boolean_encoding]
  tests
    i2b_zero(0) => Ok(value = false)
    i2b_one(1) => Ok(value = true)
    i2b_two(2) => convert.invalid_boolean_encoding(value = 2)
  match value == 0, value == 1
    true, _ => Ok(value = false)
    false, true => Ok(value = true)
    false, false => convert.invalid_boolean_encoding(value = value)

fn std__convert__bool_to_dec(value: bool) -> Dec__Value rev 1
  emits []
  tests
    b2d_t(true) => Ok(value = d"1.0")
    b2d_f(false) => Ok(value = d"0.0")
  match value
    true => Ok(value = d"1.0")
    false => Ok(value = d"0.0")

fn std__convert__dec_to_bool(value: dec) -> Bool__Value rev 1
  emits [convert.invalid_dec_encoding]
  tests
    d2b_zero(d"0.0") => Ok(value = false)
    d2b_one(d"1.0") => Ok(value = true)
    d2b_two(d"2.0") => convert.invalid_dec_encoding(value = d"2.0")
  match value == d"0.0"
    true => Ok(value = false)
    false => match value == d"1.0"
      true => Ok(value = true)
      false => convert.invalid_dec_encoding(value = value)

fn std__convert__int_to_dec_from(m: int, acc: dec, step: dec) -> Dec__Value rev 1
  decreases m
  emits []
  tests
    from_zero(0, d"0.0", d"1.0") => Ok(value = d"0.0")
    from_two(2, d"0.0", d"1.0") => Ok(value = d"2.0")
    from_neg_step(2, d"0.0", d"-1.0") => Ok(value = d"-2.0")
  match m <= 0
    true => Ok(value = acc)
    false => match call std__convert__int_to_dec_from(m - 1, acc + step, step)
      on Ok r => Ok(value = r.value)

fn std__convert__int_to_str_from(n: int, acc: str, m: int) -> Str__Value rev 1
  decreases m
  emits []
  tests
    str_from_fuel_out(5, "x", 0) => Ok(value = "x")
    str_from_digit(5, "", 6) => Ok(value = "5")
    str_from_multi(42, "", 3) => Ok(value = "42")
  match m <= 0
    true => Ok(value = acc)
    false => match n <= 9
      true => Ok(value = "0123456789"[n:n + 1] + acc)
      false => match call std__convert__int_to_str_from(n / 10, "0123456789"[n % 10:n % 10 + 1] + acc, m - 1)
        on Ok r => Ok(value = r.value)

fn std__convert__int_to_str(value: int) -> Str__Value rev 1
  emits []
  tests
    i2s_zero(0) => Ok(value = "0")
    i2s_pos(42) => Ok(value = "42")
    i2s_thousand(1000) => Ok(value = "1000")
    i2s_neg(-7) => Ok(value = "-7")
  match value < 0
    true => match call std__convert__int_to_str_from(-value, "", -value + 1)
      on Ok r => Ok(value = "-" + r.value)
    false => match call std__convert__int_to_str_from(value, "", value + 1)
      on Ok r => Ok(value = r.value)

fn std__convert__str_to_int_from(orig: str, value: str, pos: int, acc: int, n: int) -> Int__Value rev 1
  decreases n
  emits [convert.invalid_integer]
  tests
    sti_done("42", "42", 2, 42, 0) => Ok(value = 42)
    sti_step("42", "42", 0, 0, 2) => Ok(value = 42)
    sti_bad_high("1a", "1a", 1, 1, 1) => convert.invalid_integer(value = "1a")
    sti_bad_low("1-2", "1-2", 1, 1, 2) => convert.invalid_integer(value = "1-2")
  match n <= 0
    true => Ok(value = acc)
    false => match value[pos] >= 48
      true => match value[pos] <= 57
        true => match call std__convert__str_to_int_from(orig, value, pos + 1, acc * 10 + (value[pos] - 48), n - 1)
          on convert.invalid_integer e => forward e
          on Ok r => Ok(value = r.value)
        false => convert.invalid_integer(value = orig)
      false => convert.invalid_integer(value = orig)

fn std__convert__str_to_int(value: str) -> Int__Value rev 1
  emits [convert.invalid_integer]
  tests
    s2i_zero("0") => Ok(value = 0)
    s2i_pos("42") => Ok(value = 42)
    s2i_neg("-7") => Ok(value = -7)
    s2i_empty("") => convert.invalid_integer(value = "")
    s2i_bare_minus("-") => convert.invalid_integer(value = "-")
    s2i_bad("12a") => convert.invalid_integer(value = "12a")
    s2i_neg_bad("-1a") => convert.invalid_integer(value = "-1a")
  match #value == 0
    true => convert.invalid_integer(value = value)
    false => match value[0:1] == "-"
      true => match #value >= 2
        true => match call std__convert__str_to_int_from(value, value, 1, 0, #value - 1)
          on convert.invalid_integer e => forward e
          on Ok r => Ok(value = -r.value)
        false => convert.invalid_integer(value = value)
      false => match call std__convert__str_to_int_from(value, value, 0, 0, #value)
        on convert.invalid_integer e => forward e
        on Ok r => Ok(value = r.value)

fn std__convert__str_to_dec_from(orig: str, value: str, pos: int, coeff: int, scale: int, dot: int, n: int) -> Dec__Value rev 1
  decreases n
  emits [convert.invalid_decimal]
  tests
    std_done_int("42", "42", 2, 42, 0, 0, 0) => Ok(value = d"42.0")
    std_done_frac("1.5", "1.5", 3, 15, 1, 1, 0) => Ok(value = d"1.5")
    std_trailing_dot("1.", "1.", 2, 1, 0, 1, 0) => convert.invalid_decimal(value = "1.")
    std_step_int("42", "42", 0, 0, 0, 0, 2) => Ok(value = d"42.0")
    std_step_frac("1.5", "1.5", 2, 1, 0, 1, 1) => Ok(value = d"1.5")
    std_step_dot("1.5", "1.5", 1, 1, 0, 0, 2) => Ok(value = d"1.5")
    std_double_dot("1.2.3", "1.2.3", 3, 12, 1, 1, 2) => convert.invalid_decimal(value = "1.2.3")
    std_bad_high("12a", "12a", 2, 12, 0, 0, 1) => convert.invalid_decimal(value = "12a")
    std_bad_low("1-2", "1-2", 1, 1, 0, 0, 2) => convert.invalid_decimal(value = "1-2")
  match n <= 0
    true => match dot == 0
      true => match call std__convert__int_to_dec(coeff)
        on Ok whole => Ok(value = whole.value)
      false => match scale == 0
        true => convert.invalid_decimal(value = orig)
        false => match call std__convert__int_to_dec(coeff)
          on Ok whole => match call std__dec__scale_by_power_of_ten(whole.value, -scale)
            on Ok moved => Ok(value = moved.value)
    false => match value[pos:pos + 1] == "."
      true => match dot == 0
        true => match call std__convert__str_to_dec_from(orig, value, pos + 1, coeff, scale, 1, n - 1)
          on convert.invalid_decimal e => forward e
          on Ok r => Ok(value = r.value)
        false => convert.invalid_decimal(value = orig)
      false => match value[pos] >= 48
        true => match value[pos] <= 57
          true => match dot == 0
            true => match call std__convert__str_to_dec_from(orig, value, pos + 1, coeff * 10 + (value[pos] - 48), scale, dot, n - 1)
              on convert.invalid_decimal e => forward e
              on Ok r => Ok(value = r.value)
            false => match call std__convert__str_to_dec_from(orig, value, pos + 1, coeff * 10 + (value[pos] - 48), scale + 1, dot, n - 1)
              on convert.invalid_decimal e => forward e
              on Ok r => Ok(value = r.value)
          false => convert.invalid_decimal(value = orig)
        false => convert.invalid_decimal(value = orig)

fn std__convert__str_to_dec(value: str) -> Dec__Value rev 1
  emits [convert.invalid_decimal]
  tests
    s2d_zero("0") => Ok(value = d"0.0")
    s2d_int("42") => Ok(value = d"42.0")
    s2d_neg("-7") => Ok(value = d"-7.0")
    s2d_frac("1.5") => Ok(value = d"1.5")
    s2d_neg_frac("-0.5") => Ok(value = d"-0.5")
    s2d_lead_dot(".5") => Ok(value = d"0.5")
    s2d_lead_dot_neg("-.5") => Ok(value = d"-0.5")
    s2d_empty("") => convert.invalid_decimal(value = "")
    s2d_bare_minus("-") => convert.invalid_decimal(value = "-")
    s2d_double_dot("1.2.3") => convert.invalid_decimal(value = "1.2.3")
    s2d_bad("12a") => convert.invalid_decimal(value = "12a")
    s2d_neg_bad("-12a") => convert.invalid_decimal(value = "-12a")
    s2d_trailing_dot("1.") => convert.invalid_decimal(value = "1.")
  match #value == 0
    true => convert.invalid_decimal(value = value)
    false => match value[0:1] == "-"
      true => match #value >= 2
        true => match call std__convert__str_to_dec_from(value, value, 1, 0, 0, 0, #value - 1)
          on convert.invalid_decimal e => forward e
          on Ok r => Ok(value = d"0.0" - r.value)
        false => convert.invalid_decimal(value = value)
      false => match call std__convert__str_to_dec_from(value, value, 0, 0, 0, 0, #value)
        on convert.invalid_decimal e => forward e
        on Ok r => Ok(value = r.value)

fn std__convert__int_to_dec(value: int) -> Dec__Value rev 1
  emits []
  tests
    i2d_zero(0) => Ok(value = d"0.0")
    i2d_pos(3) => Ok(value = d"3.0")
    i2d_neg(-2) => Ok(value = d"-2.0")
  match value >= 0
    true => match call std__convert__int_to_dec_from(value, d"0.0", d"1.0")
      on Ok r => Ok(value = r.value)
    false => match call std__convert__int_to_dec_from(-value, d"0.0", d"-1.0")
      on Ok r => Ok(value = r.value)

fn std__backoff__delay(attempt: int, base_ms: int, cap_ms: int) -> Int__Value rev 1
  emits [math.negative_input]
  tests
    backoff_zero(0, 100, 1000) => Ok(value = 100)
    backoff_grows(2, 100, 1000) => Ok(value = 400)
    backoff_capped_product(4, 100, 1000) => Ok(value = 1000)
    backoff_capped_attempt(31, 100, 1000) => Ok(value = 1000)
    backoff_negative_attempt(-1, 100, 1000) => math.negative_input(value = -1)
    backoff_negative_base(1, -5, 1000) => math.negative_input(value = -5)
    backoff_negative_cap(1, 100, -7) => math.negative_input(value = -7)
  match base_ms >= 0, cap_ms >= 0, attempt >= 0, attempt <= 30
    true, true, true, true => match call std__int__pow_from(2, attempt)
      on Ok p => match base_ms * p.value <= cap_ms
        true => Ok(value = base_ms * p.value)
        false => Ok(value = cap_ms)
    true, true, true, false => Ok(value = cap_ms)
    true, true, false, _ => math.negative_input(value = attempt)
    true, false, _, _ => math.negative_input(value = cap_ms)
    false, _, _, _ => math.negative_input(value = base_ms)

// Shape notes, kept with the program, not in a second file.
// 1. Termination and cost are separate claims. std__int__pow_from ends for
//    every non-negative exponent by the decreases proof, while
//    std__backoff__delay caps attempts at 30 so builds stay cheap. The cap
//    is a cost policy at the call site, not part of the power proof.
// 2. Recursion never hides an error arm. fallible recursion splits in
//    two: a total helper with no emits under the guard, and a checked
//    entry that rejects negatives before delegating.
// 3. String order in std__compare__str is byte order on the wire encoding.
//    It is deterministic, not Unicode aware. Grapheme or collation
//    aware comparison waits on the Text layer and pinned data.
