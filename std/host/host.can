// std/host/host.can — the host shelf: explicit foreign observations
// behind uses-pinned externs (b02). Wall time is an observation, not
// a pure value; monotonic ticks never silently substitute wall time.
// Time points are millis ints (JEV instant_repr millis_int 0.97):
// millis since the Unix epoch for wall, millis since an
// unspecified origin for monotonic. Sub-millisecond precision is
// out of scope for v1. Decision tables script the externs; the
// host implementations in host.externs.ts are a separate
// obligation, executed by TestStdHostNodeSmoke.

mod host
  provides [std__clock__wall_now, std__clock__monotonic_now, std__random__bytes, std__hash__digest, Clock__Instant, Clock__MonotonicTick, Random__Bytes, Hash__Digest, Hash__Profile, host__wall_now, host__mono_now, host__rand_bytes, host__hash_digest]
  uses []
  emits [clock.unavailable, random.invalid_count, random.unavailable, hash.unsupported_profile, hash.unavailable]

error clock.unavailable()
error random.invalid_count()
error random.unavailable()
error hash.unsupported_profile()
error hash.unavailable()

type Clock__Instant rev 1 (
  millis: int
)

type Clock__MonotonicTick rev 1 (
  millis: int
)

brand Hash__Profile is str rev 1

type Random__Bytes rev 1 (
  bytes: Bytes
)

type Hash__Digest rev 1 (
  bytes: Bytes
)

extern host__wall_now() -> Clock__Instant rev 1
  emits [clock.unavailable]

extern host__mono_now() -> Clock__MonotonicTick rev 1
  emits [clock.unavailable]

extern host__rand_bytes(count: int) -> Random__Bytes rev 1
  emits [random.invalid_count, random.unavailable]

extern host__hash_digest(data: Bytes, profile: Hash__Profile) -> Hash__Digest rev 1
  emits [hash.unsupported_profile, hash.unavailable]

fn std__clock__wall_now() -> Clock__Instant rev 1
  emits [clock.unavailable]
  tests
    ok() => Ok(1726920000000)
    down() => clock.unavailable()
  match call host__wall_now()
    given
      ok => [exchange args () outcome Ok(1726920000000)]
      down => [exchange args () outcome clock.unavailable()]
    on clock.unavailable _ => clock.unavailable()
    on Ok t => Ok(t.millis)

fn std__clock__monotonic_now() -> Clock__MonotonicTick rev 1
  emits [clock.unavailable]
  tests
    ok() => Ok(9000)
    down() => clock.unavailable()
  match call host__mono_now()
    given
      ok => [exchange args () outcome Ok(9000)]
      down => [exchange args () outcome clock.unavailable()]
    on clock.unavailable _ => clock.unavailable()
    on Ok t => Ok(t.millis)

// Negative counts reject deterministically in Can; the host owns
// the upper bound (1048576 bytes) and reports invalid_count past
// it, so both invalid_count sources stay reachable and tested.
fn std__random__bytes(count: int) -> Random__Bytes rev 1
  emits [random.invalid_count, random.unavailable]
  tests
    ok(4) => Ok(Bytes(Seq<int>[1, 2, 3, 4]))
    negative(-1) => random.invalid_count()
    capped(2000000) => random.invalid_count()
    down(4) => random.unavailable()
  match count < 0
    true => random.invalid_count()
    false => match call host__rand_bytes(count)
      given
        ok => [exchange args (count = 4) outcome Ok(Bytes(Seq<int>[1, 2, 3, 4]))]
        capped => [exchange args (count = 2000000) outcome random.invalid_count()]
        down => [exchange args (count = 4) outcome random.unavailable()]
      on random.invalid_count _ => random.invalid_count()
      on random.unavailable _ => random.unavailable()
      on Ok r => Ok(r.bytes)

fn std__hash__digest(data: Bytes, profile: Hash__Profile) -> Hash__Digest rev 1
  emits [hash.unsupported_profile, hash.unavailable]
  tests
    sha(Bytes(Seq<int>[97, 98, 99]), seal Hash__Profile("sha256")) => Ok(Bytes(Seq<int>[186, 120, 22, 191, 143, 1, 207, 234, 65, 65, 64, 222, 93, 174, 34, 35, 176, 3, 97, 163, 150, 23, 122, 156, 180, 16, 255, 97, 242, 0, 21, 173]))
    unknown(Bytes(Seq<int>[97]), seal Hash__Profile("md5")) => hash.unsupported_profile()
    down(Bytes(Seq<int>[97]), seal Hash__Profile("sha256")) => hash.unavailable()
  match call host__hash_digest(data, profile)
    given
      sha => [exchange args (data = Bytes(Seq<int>[97, 98, 99]), profile = seal Hash__Profile("sha256")) outcome Ok(Bytes(Seq<int>[186, 120, 22, 191, 143, 1, 207, 234, 65, 65, 64, 222, 93, 174, 34, 35, 176, 3, 97, 163, 150, 23, 122, 156, 180, 16, 255, 97, 242, 0, 21, 173]))]
      unknown => [exchange args (data = Bytes(Seq<int>[97]), profile = seal Hash__Profile("md5")) outcome hash.unsupported_profile()]
      down => [exchange args (data = Bytes(Seq<int>[97]), profile = seal Hash__Profile("sha256")) outcome hash.unavailable()]
    on hash.unsupported_profile _ => hash.unsupported_profile()
    on hash.unavailable _ => hash.unavailable()
    on Ok d => Ok(d.bytes)
