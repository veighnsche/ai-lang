// schema/asset-approval: construction-time authorization for external assets.
//
// An ApprovedAsset is an opaque witness minted ONLY in this file, and only
// when an untrusted request matches an exact entry in an explicitly supplied
// registry snapshot under an explicitly supplied policy handle. See
// docs/a83-astra-schema.md: content digest AND permitted HTTPS origin, exact
// URL entry, one SHA-384 profile, HTTPS-only transport, exact pins,
// non-transitive single-role grants.
//
// What this file does NOT do: fetch anything, verify signatures, supply a
// clock, or choose the governing policy. Snapshot, policy handle, site, head
// sequence, and time arrive as explicit values; their PROVENANCE (which
// snapshot is current, which policy governs, what time it is) belongs to the
// deployment acceptance workflow (S4 in the slice plan). Tests therefore pass
// fixture snapshots explicitly: a sealed success-shaped value alone never
// approves. Minting a policy handle (schema__policy__admit) is not authority.
//
// Shape checks validate the REQUEST side only: a request that passes shape
// but matches no entry still rejects, and a matching entry inherits the
// request's validated form through exact equality. No input is ever repaired.
// NUL is rejected with the single lookup error below (never stripped); the
// tail_nul and token_nul rows carry literal NUL bytes, invisible in
// editors (verify with tr -d -c '\000' | wc -c, expect exactly 2).
// tail_ctrl and tail_del carry literal 0x01 and 0x7F bytes the same way.
// Do not normalize any of them away.

mod schema
  provides [schema__role__check, schema__url__prefix, schema__url__ws, schema__url__tail_check, schema__token__check, schema__tokens__check, schema__digest__char, schema__digest__tail, schema__digest__check, schema__entry__matches, schema__snapshot__scan, schema__snapshot__entry_at, schema__revoked__entry_at, schema__revoked__contains, schema__policy__admit, schema__asset__approve, schema__asset__recheck, Schema__AssetRequest, Schema__Site, Schema__RegistryEntry, Schema__Revoked, Schema__RegistrySnapshot, Schema__AssetPolicy, Schema__ApprovedAsset, Schema__ApprovalResult, Schema__PolicyResult, Schema__BoolResult, Schema__EntryResult, Schema__RevokedResult, Schema__ScanResult, schema__SNAP_OK, schema__SNAP_STALE, schema__SNAP_JS, schema__SNAP_EMPTY, schema__ENTRY_CSS, schema__REQ_CSS, schema__REQ_A, schema__SITE_HOME, schema__SITE_ADMIN, schema__SITE_P, schema__POLICY_PROD]
  uses []
  emits [schema.asset_not_approved]

error schema.asset_not_approved(asset: Schema__AssetRequest)

// Untrusted identifying data: no authority. A caller body builds this as a
// plain record (brands would be unsealable-by-construction here: bodies
// cannot mint foreign brands, and the request must be buildable anywhere).
type Schema__AssetRequest rev 1 (
  id: str,
  revision: str,
  url: str,
  digest: str,
  role: str
)

// Exact resolved source call site, as plain identifying data. Compiler
// certification of the node (never a caller-supplied name) is S4.
type Schema__Site rev 1 (
  program: str,
  module: str,
  function: str
)

// One exact approval: immutable asset identity + revision fixes one URL,
// digest, role, consuming site, and validity interval. Upper bound exclusive.
type Schema__RegistryEntry rev 1 (
  id: str,
  revision: str,
  url: str,
  digest: str,
  role: str,
  program: str,
  module: str,
  function: str,
  not_before: int,
  not_after: int
)

// Retained revocation record: removal never deletes audit history, and a
// revoked revision cannot be resurrected by replaying an old snapshot (the
// snapshot is only usable at the accepted head sequence).
type Schema__Revoked rev 1 (
  id: str,
  revision: str
)

// Externally accepted immutable snapshot, taken as a value (never ambient
// state: a state cell would be poisonable from inside). The policy field is
// the opaque handle itself, so approval checks policy agreement by brand
// equality without ever inspecting policy contents.
type Schema__RegistrySnapshot rev 1 (
  program: str,
  policy: Schema__AssetPolicy,
  sequence: int,
  entries: Seq<Schema__RegistryEntry>,
  revoked: Seq<Schema__Revoked>
)

// Opaque handle to the authoritative policy selected for this program's
// construction session. Passing the handle does not select the policy:
// the builder verifies it against the snapshot's recorded handle.
brand Schema__AssetPolicy is str rev 1

// Opaque, immutable approval witness: the approved request plus its policy,
// registry, site, and validity bindings, sealed into one canonical string.
// The string is never parsed back (an S4 recheck recomputes it from supplied
// values and compares whole, checking the snapshot sequence separately since
// integers have no string form here); the "|" separators are framing, not a
// format. No ordinary constructor, record reconstruction, or string
// conversion can manufacture this brand: only this file's bodies seal it,
// and only on the exact-match path.
brand Schema__ApprovedAsset is str rev 1

type Schema__ApprovalResult rev 1 (
  approval: Schema__ApprovedAsset
)

type Schema__PolicyResult rev 1 (
  policy: Schema__AssetPolicy
)

type Schema__BoolResult rev 1 (
  value: bool
)

type Schema__EntryResult rev 1 (
  entry: Schema__RegistryEntry
)

type Schema__RevokedResult rev 1 (
  entry: Schema__Revoked
)

type Schema__ScanResult rev 1 (
  first: int,
  count: int
)

// Shared decision-table fixtures: closed record, sequence, and
// seal constants naming the values rows repeat. Single-use hostile
// shapes (quote, control, conflict, revoked, wrong-digest) stay
// inline where the bytes are the point.
const schema__SNAP_OK: Schema__RegistrySnapshot rev 1 = Schema__RegistrySnapshot(program = "shop", policy = seal Schema__AssetPolicy("shop|prod"), sequence = 7, entries = Seq<Schema__RegistryEntry>[Schema__RegistryEntry(id = "app-css", revision = "1.0.0", url = "https://cdn.example/app.css", digest = "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", role = "stylesheet", program = "shop", module = "pages", function = "home", not_before = 100, not_after = 200)], revoked = Seq<Schema__Revoked>[])
const schema__SNAP_STALE: Schema__RegistrySnapshot rev 1 = Schema__RegistrySnapshot(program = "shop", policy = seal Schema__AssetPolicy("shop|prod"), sequence = 6, entries = Seq<Schema__RegistryEntry>[Schema__RegistryEntry(id = "app-css", revision = "1.0.0", url = "https://cdn.example/app.css", digest = "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", role = "stylesheet", program = "shop", module = "pages", function = "home", not_before = 100, not_after = 200)], revoked = Seq<Schema__Revoked>[])
const schema__SNAP_JS: Schema__RegistrySnapshot rev 1 = Schema__RegistrySnapshot(program = "shop", policy = seal Schema__AssetPolicy("shop|prod"), sequence = 7, entries = Seq<Schema__RegistryEntry>[Schema__RegistryEntry(id = "app-js", revision = "2.0.0", url = "https://cdn.example/app.js", digest = "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", role = "script", program = "shop", module = "pages", function = "home", not_before = 100, not_after = 200)], revoked = Seq<Schema__Revoked>[])
const schema__SNAP_EMPTY: Schema__RegistrySnapshot rev 1 = Schema__RegistrySnapshot(program = "shop", policy = seal Schema__AssetPolicy("shop|prod"), sequence = 7, entries = Seq<Schema__RegistryEntry>[], revoked = Seq<Schema__Revoked>[])
const schema__ENTRY_CSS: Schema__RegistryEntry rev 1 = Schema__RegistryEntry(id = "app-css", revision = "1.0.0", url = "https://cdn.example/app.css", digest = "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", role = "stylesheet", program = "shop", module = "pages", function = "home", not_before = 100, not_after = 200)
const schema__REQ_CSS: Schema__AssetRequest rev 1 = Schema__AssetRequest(id = "app-css", revision = "1.0.0", url = "https://cdn.example/app.css", digest = "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", role = "stylesheet")
const schema__REQ_A: Schema__AssetRequest rev 1 = Schema__AssetRequest(id = "a", revision = "1", url = "https://h/a", digest = "d", role = "stylesheet")
const schema__SITE_HOME: Schema__Site rev 1 = Schema__Site(program = "shop", module = "pages", function = "home")
const schema__SITE_ADMIN: Schema__Site rev 1 = Schema__Site(program = "shop", module = "admin", function = "home")
const schema__SITE_P: Schema__Site rev 1 = Schema__Site(program = "p", module = "m", function = "f")
const schema__POLICY_PROD: Schema__AssetPolicy rev 1 = seal Schema__AssetPolicy("shop|prod")

// The minimum roles are external stylesheet and external classic script.
// Module scripts, workers, preload uses, and other modes are not aliases.
fn schema__role__check(role: str) -> Schema__BoolResult rev 1
  emits []
  tests
    role_stylesheet(role = "stylesheet") => Ok(value = true)
    role_script(role = "script") => Ok(value = true)
    role_module(role = "module") => Ok(value = false)
    role_worker(role = "worker") => Ok(value = false)
    role_preload(role = "preload") => Ok(value = false)
    role_empty(role = "") => Ok(value = false)
    role_upper(role = "Stylesheet") => Ok(value = false)
=
  match role
    "stylesheet" => Ok(value = true)
    "script" => Ok(value = true)
    _ => Ok(value = false)

// Absolute-HTTPS gate: exactly lowercase https, nothing else present or
// absent. Uppercase HTTPS is a spelling rejection, not a transport claim;
// a colon that is not a scheme token earns failure here, never a scheme pass.
fn schema__url__prefix(url: str) -> Schema__BoolResult rev 1
  emits []
  tests
    prefix_ok(url = "https://cdn.example/app.css") => Ok(value = true)
    prefix_bare(url = "https://") => Ok(value = true)
    prefix_http(url = "http://cdn.example/app.css") => Ok(value = false)
    prefix_upper(url = "HTTPS://cdn.example/app.css") => Ok(value = false)
    prefix_short(url = "https:/") => Ok(value = false)
    prefix_empty(url = "") => Ok(value = false)
    prefix_relative(url = "/app.css") => Ok(value = false)
    prefix_protocol_relative(url = "//cdn.example/app.css") => Ok(value = false)
    prefix_data(url = "data:text/css,hi") => Ok(value = false)
=
  match #url < 8
    true => Ok(value = false)
    false => match url[0:8] == "https://"
      true => Ok(value = true)
      false => Ok(value = false)

// ASCII-whitespace classifier for the URL tail (TAB LF FF CR SPACE, codes
// 9 10 12 13 32). NUL is not whitespace anywhere in this file: it is
// rejected by its own arm in the tail worker, never folded in here.
fn schema__url__ws(code: int) -> Schema__BoolResult rev 1
  emits []
  tests
    ws_tab(code = 9) => Ok(value = true)
    ws_lf(code = 10) => Ok(value = true)
    ws_ff(code = 12) => Ok(value = true)
    ws_cr(code = 13) => Ok(value = true)
    ws_space(code = 32) => Ok(value = true)
    ws_nul(code = 0) => Ok(value = false)
    ws_slash(code = 47) => Ok(value = false)
    ws_letter(code = 97) => Ok(value = false)
=
  match code == 9
    true => Ok(value = true)
    false => match code == 10
      true => Ok(value = true)
      false => match code == 12
        true => Ok(value = true)
        false => match code == 13
          true => Ok(value = true)
          false => match code == 32
            true => Ok(value = true)
            false => Ok(value = false)

// URL tail scan: no NUL, no other C0 control, no DEL, no fragment, no
// backslash, no ASCII whitespace, no userinfo (@ before the first /),
// and no quote or angle characters (' " < >). The quotes and angles are
// excluded for the fixed single-quoted sink embedding: a ' in an approved
// URL would break out of the href/src attribute, and " < > ride out with
// it as noncanonical input; & rides along as exact-entry-bound query
// content (retrieval fidelity, not construction structure). Query strings
// ride along (bound by the exact entry); @ after the first / rides along
// as path content. The scan starts in-authority; the first / ends the
// authority section. The whole URL is scanned (the https:// prefix is
// inert under these rules), so approval checks one shape, not a slice
// of one.
fn schema__url__tail_check(s: str, n: int, in_authority: bool) -> Schema__BoolResult rev 1
  decreases n
  emits []
  tests
    tail_empty(s = "", n = 0, in_authority = true) => Ok(value = true)
    tail_zero_budget(s = "/a", n = 0, in_authority = true) => Ok(value = true)
    tail_plain(s = "ab", n = 2, in_authority = false) => Ok(value = true)
    tail_path_query(s = "/a.css?v=2", n = 10, in_authority = false) => Ok(value = true)
    tail_authority_flip(s = "h/a@b", n = 5, in_authority = true) => Ok(value = true)
    tail_at_path(s = "/a@b", n = 4, in_authority = false) => Ok(value = true)
    tail_fragment(s = "/a#b", n = 4, in_authority = false) => Ok(value = false)
    tail_userinfo(s = "u@h/a", n = 5, in_authority = true) => Ok(value = false)
    tail_space(s = "/a b", n = 4, in_authority = false) => Ok(value = false)
    tail_pipe(s = "/a|b", n = 4, in_authority = false) => Ok(value = false)
    tail_backslash(s = "/a\b", n = 4, in_authority = false) => Ok(value = false)
    tail_squote(s = "/a'b", n = 4, in_authority = false) => Ok(value = false)
    tail_dquote(s = e"/a\"b", n = 4, in_authority = false) => Ok(value = false)
    tail_angle_open(s = "/a<b", n = 4, in_authority = false) => Ok(value = false)
    tail_angle_close(s = "/a>b", n = 4, in_authority = false) => Ok(value = false)
    tail_nul(s = "/a␀b", n = 4, in_authority = false) => Ok(value = false)
    tail_ctrl(s = "/ab", n = 4, in_authority = false) => Ok(value = false)
    tail_del(s = "/ab", n = 4, in_authority = false) => Ok(value = false)
=
  match n <= 0
    true => Ok(value = true)
    false => match s[0]
      0 | 35 | 92 | 124 | 34 | 39 | 60 | 62 | 127 => Ok(value = false)
      _ => match s[0] < 32
        true => Ok(value = false)
        false => match call schema__url__ws(s[0])
          on Ok w => match w.value
            true => Ok(value = false)
            false => match s[0] == 64
              true => match in_authority
                true => Ok(value = false)
                false => match call schema__url__tail_check(s[1:#s], n - 1, in_authority)
                  on Ok r => Ok(value = r.value)
              false => match s[0] == 47
                true => match call schema__url__tail_check(s[1:#s], n - 1, false)
                  on Ok r => Ok(value = r.value)
                false => match call schema__url__tail_check(s[1:#s], n - 1, in_authority)
                  on Ok r => Ok(value = r.value)

// Separator-safe token scan: identifiers, revisions, and site fields must
// carry no NUL and no "|" (code 124). The witness canonical string joins
// its eight fields with "|" for the S2 projection kernel; a field holding
// the separator would make the split ambiguous, so approval refuses it.
// The digest alphabet already excludes both; the closed role gate cannot
// produce them; the URL tail rejects them above.
fn schema__token__check(s: str, n: int) -> Schema__BoolResult rev 1
  decreases n
  emits []
  tests
    token_empty(s = "", n = 0) => Ok(value = true)
    token_zero_budget(s = "ab", n = 0) => Ok(value = true)
    token_clean(s = "1.0.0", n = 5) => Ok(value = true)
    token_pipe(s = "a|b", n = 3) => Ok(value = false)
    token_nul(s = "a␀b", n = 3) => Ok(value = false)
=
  match n <= 0
    true => Ok(value = true)
    false => match s[0]
      0 | 124 => Ok(value = false)
      _ => match call schema__token__check(s[1:#s], n - 1)
        on Ok r => Ok(value = r.value)

// All five free-text bindings must be separator-safe: a pipe smuggled in
// any one of them breaks the witness framing, so one function checks all
// five and approval calls it once.
fn schema__tokens__check(id: str, revision: str, site: Schema__Site) -> Schema__BoolResult rev 1
  emits []
  tests
    tokens_clean(id = "app-css", revision = "1.0.0", site = schema__SITE_HOME) => Ok(value = true)
    tokens_bad_id(id = "a|b", revision = "1.0.0", site = schema__SITE_HOME) => Ok(value = false)
    tokens_bad_revision(id = "app-css", revision = "1|0", site = schema__SITE_HOME) => Ok(value = false)
    tokens_bad_program(id = "app-css", revision = "1.0.0", site = Schema__Site(program = "sh|op", module = "pages", function = "home")) => Ok(value = false)
    tokens_bad_module(id = "app-css", revision = "1.0.0", site = Schema__Site(program = "shop", module = "pa|ges", function = "home")) => Ok(value = false)
    tokens_bad_function(id = "app-css", revision = "1.0.0", site = Schema__Site(program = "shop", module = "pages", function = "ho|me")) => Ok(value = false)
=
  match call schema__token__check(id, #id)
    on Ok a => match a.value
      true => match call schema__token__check(revision, #revision)
        on Ok b => match b.value
          true => match call schema__token__check(site.program, #site.program)
            on Ok c => match c.value
              true => match call schema__token__check(site.module, #site.module)
                on Ok d => match d.value
                  true => match call schema__token__check(site.function, #site.function)
                    on Ok e => Ok(value = e.value)
                  false => Ok(value = false)
              false => Ok(value = false)
          false => Ok(value = false)
      false => Ok(value = false)

// SRI digest alphabet: standard base64 plus padding. One arm carries the
// three symbols and the three ranges; the wildcard rejects. Every range
// edge and every neighbor just outside a range is witnessed below.
fn schema__digest__char(code: int) -> Schema__BoolResult rev 1
  emits []
  tests
    char_plus(code = 43) => Ok(value = true)
    char_slash(code = 47) => Ok(value = true)
    char_equals(code = 61) => Ok(value = true)
    char_digit(code = 48) => Ok(value = true)
    char_upper(code = 65) => Ok(value = true)
    char_lower(code = 97) => Ok(value = true)
    char_dash(code = 45) => Ok(value = false)
    char_colon(code = 58) => Ok(value = false)
    char_space(code = 32) => Ok(value = false)
    char_digit_nine(code = 57) => Ok(value = true)
    char_upper_z(code = 90) => Ok(value = true)
    char_lower_z(code = 122) => Ok(value = true)
    char_above_upper(code = 91) => Ok(value = false)
    char_above_lower(code = 123) => Ok(value = false)
=
  match code
    43 | 47 | 61 | 48..57 | 65..90 | 97..122 => Ok(value = true)
    _ => Ok(value = false)

// Digest tail scan: every scalar must clear the alphabet worker.
fn schema__digest__tail(s: str, n: int) -> Schema__BoolResult rev 1
  decreases n
  emits []
  tests
    dtail_empty(s = "", n = 0) => Ok(value = true)
    dtail_zero_budget(s = "AB", n = 0) => Ok(value = true)
    dtail_good(s = "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", n = 64) => Ok(value = true)
    dtail_bad(s = "AAAAAAAAAAAA-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", n = 64) => Ok(value = false)
=
  match n <= 0
    true => Ok(value = true)
    false => match call schema__digest__char(s[0])
      on Ok c => match c.value
        true => match call schema__digest__tail(s[1:#s], n - 1)
          on Ok r => Ok(value = r.value)
        false => Ok(value = false)

// First integrity profile: exactly one SHA-384 digest in canonical SRI
// form ("sha384-" plus 64 base64 scalars; 48 bytes need no padding, but the
// alphabet admits it). Multiple digests, other algorithms, and bare hex are
// rejected: the entry carries one digest and the request must name it.
fn schema__digest__check(digest: str) -> Schema__BoolResult rev 1
  emits []
  tests
    digest_good(digest = "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA") => Ok(value = true)
    digest_short(digest = "sha384-AAAA") => Ok(value = false)
    digest_empty(digest = "") => Ok(value = false)
    digest_sha256(digest = "sha256-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA") => Ok(value = false)
    digest_bare(digest = "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA") => Ok(value = false)
    digest_badchar(digest = "sha384-AAAAAAAAAAAA-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA") => Ok(value = false)
=
  match #digest == 71
    true => match digest[0:7] == "sha384-"
      true => match call schema__digest__tail(digest[7:#digest], 64)
        on Ok r => Ok(value = r.value)
      false => Ok(value = false)
    false => Ok(value = false)

// One entry matches when every bound field agrees exactly: asset identity,
// revision, URL, digest, role, and the consuming site. No approximate
// lookup, no substitution, no first-match-wins here (counting is the scan's
// job). File extensions, hostnames, and digest equality never substitute
// for a role or site grant: each is its own conjunct.
fn schema__entry__matches(entry: Schema__RegistryEntry, request: Schema__AssetRequest, site: Schema__Site) -> Schema__BoolResult rev 1
  emits []
  tests
    entry_hit(entry = schema__ENTRY_CSS, request = schema__REQ_CSS, site = schema__SITE_HOME) => Ok(value = true)
    entry_url_miss(entry = schema__ENTRY_CSS, request = Schema__AssetRequest(id = "app-css", revision = "1.0.0", url = "https://cdn.example/other.css", digest = "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", role = "stylesheet"), site = schema__SITE_HOME) => Ok(value = false)
    entry_site_miss(entry = schema__ENTRY_CSS, request = schema__REQ_CSS, site = schema__SITE_ADMIN) => Ok(value = false)
=
  match entry.id == request.id, entry.revision == request.revision, entry.url == request.url, entry.digest == request.digest, entry.role == request.role, entry.program == site.program, entry.module == site.module, entry.function == site.function
    true, true, true, true, true, true, true, true => Ok(value = true)
    _, _, _, _, _, _, _, _ => Ok(value = false)

// Snapshot scan: counts exact matches and remembers the first one's index.
// Exactly one match is usable; zero is unapproved and two is a conflicting
// snapshot (rejected downstream with the same indistinguishable shape, so
// rejection rows never oracle how many entries exist). first is meaningful
// only when count is 1; when count is 0 it is the terminal position.
fn schema__snapshot__scan(entries: Seq<Schema__RegistryEntry>, request: Schema__AssetRequest, site: Schema__Site, position: int, fuel: int) -> Schema__ScanResult rev 1
  decreases fuel
  emits []
  tests
    scan_zero_fuel(entries = Seq<Schema__RegistryEntry>[Schema__RegistryEntry(id = "a", revision = "1", url = "https://h/a", digest = "d", role = "stylesheet", program = "p", module = "m", function = "f", not_before = 0, not_after = 9)], request = schema__REQ_A, site = schema__SITE_P, position = 0, fuel = 0) => Ok(first = 0, count = 0)
    scan_empty(entries = Seq<Schema__RegistryEntry>[], request = schema__REQ_A, site = schema__SITE_P, position = 0, fuel = 1) => Ok(first = 0, count = 0)
    scan_single(entries = Seq<Schema__RegistryEntry>[Schema__RegistryEntry(id = "a", revision = "1", url = "https://h/a", digest = "d", role = "stylesheet", program = "p", module = "m", function = "f", not_before = 0, not_after = 9)], request = schema__REQ_A, site = schema__SITE_P, position = 0, fuel = 2) => Ok(first = 0, count = 1)
    scan_nomatch(entries = Seq<Schema__RegistryEntry>[Schema__RegistryEntry(id = "b", revision = "1", url = "https://h/b", digest = "d", role = "stylesheet", program = "p", module = "m", function = "f", not_before = 0, not_after = 9)], request = schema__REQ_A, site = schema__SITE_P, position = 0, fuel = 2) => Ok(first = 1, count = 0)
    scan_conflict(entries = Seq<Schema__RegistryEntry>[Schema__RegistryEntry(id = "a", revision = "1", url = "https://h/a", digest = "d", role = "stylesheet", program = "p", module = "m", function = "f", not_before = 0, not_after = 9), Schema__RegistryEntry(id = "a", revision = "1", url = "https://h/a", digest = "d", role = "stylesheet", program = "p", module = "m", function = "f", not_before = 0, not_after = 9)], request = schema__REQ_A, site = schema__SITE_P, position = 0, fuel = 3) => Ok(first = 0, count = 2)
=
  match fuel <= 0
    true => Ok(first = position, count = 0)
    false => match position < #entries
      true => match call schema__snapshot__entry_at(entries, position)
        on Ok at => match call schema__entry__matches(at.entry, request, site)
          on Ok m => match m.value
            true => match call schema__snapshot__scan(entries, request, site, position + 1, fuel - 1)
              on Ok rest => Ok(first = position, count = rest.count + 1)
            false => match call schema__snapshot__scan(entries, request, site, position + 1, fuel - 1)
              on Ok rest => Ok(first = rest.first, count = rest.count)
      false => Ok(first = position, count = 0)

fn schema__snapshot__entry_at(entries: Seq<Schema__RegistryEntry>, position: int) -> Schema__EntryResult rev 1
  emits []
  tests
    entry_at_first(entries = Seq<Schema__RegistryEntry>[Schema__RegistryEntry(id = "a", revision = "1", url = "https://h/a", digest = "d", role = "stylesheet", program = "p", module = "m", function = "f", not_before = 0, not_after = 9), Schema__RegistryEntry(id = "b", revision = "1", url = "https://h/b", digest = "d", role = "stylesheet", program = "p", module = "m", function = "f", not_before = 0, not_after = 9)], position = 1) => Ok(entry = Schema__RegistryEntry(id = "b", revision = "1", url = "https://h/b", digest = "d", role = "stylesheet", program = "p", module = "m", function = "f", not_before = 0, not_after = 9))
=
  Ok(entry = entries[position])

// Revocation membership: a retained revocation for this exact id+revision
// kills the approval however valid the entry looks. The walk carries no
// entry data outward: hit or miss only.
fn schema__revoked__contains(revoked: Seq<Schema__Revoked>, id: str, revision: str, position: int, fuel: int) -> Schema__BoolResult rev 1
  decreases fuel
  emits []
  tests
    revoked_zero_fuel(revoked = Seq<Schema__Revoked>[Schema__Revoked(id = "a", revision = "1")], id = "a", revision = "1", position = 0, fuel = 0) => Ok(value = false)
    revoked_empty(revoked = Seq<Schema__Revoked>[], id = "a", revision = "1", position = 0, fuel = 1) => Ok(value = false)
    revoked_hit(revoked = Seq<Schema__Revoked>[Schema__Revoked(id = "b", revision = "2"), Schema__Revoked(id = "a", revision = "1")], id = "a", revision = "1", position = 0, fuel = 3) => Ok(value = true)
    revoked_miss(revoked = Seq<Schema__Revoked>[Schema__Revoked(id = "b", revision = "2")], id = "a", revision = "1", position = 0, fuel = 2) => Ok(value = false)
=
  match fuel <= 0
    true => Ok(value = false)
    false => match position < #revoked
      true => match call schema__revoked__entry_at(revoked, position)
        on Ok at => match at.entry.id == id, at.entry.revision == revision
          true, true => Ok(value = true)
          _, _ => match call schema__revoked__contains(revoked, id, revision, position + 1, fuel - 1)
            on Ok r => Ok(value = r.value)
      false => Ok(value = false)

fn schema__revoked__entry_at(revoked: Seq<Schema__Revoked>, position: int) -> Schema__RevokedResult rev 1
  emits []
  tests
    revoked_at_first(revoked = Seq<Schema__Revoked>[Schema__Revoked(id = "a", revision = "1")], position = 0) => Ok(entry = Schema__Revoked(id = "a", revision = "1"))
=
  Ok(entry = revoked[position])

// Policy handle minting. This proves nothing: the handle is evidence of the
// governing policy only when the acceptance workflow binds it (S4), and the
// snapshot carries the expected handle for brand-equality comparison.
// A self-minted handle plus a self-built snapshot passes only the fixture
// context it was built for, never production acceptance.

// Re-verification: re-runs authorization over the supplied values and
// requires the presented witness to equal the freshly minted one. The
// witness carries no snapshot sequence (integers have no string form
// here), so currency is enforced on the SUPPLIED snapshot
// (sequence == head), not historically on the witness: a replay under
// identical bindings and a current snapshot re-verifies, while any
// rotation (new revision or digest), revocation, expiry, or context
// change fails closed. Rotation-by-repinning is the revocation story;
// the witness never outlives its bindings.
fn schema__asset__recheck(request: Schema__AssetRequest, snapshot: Schema__RegistrySnapshot, policy: Schema__AssetPolicy, site: Schema__Site, head: int, t: int, asset: Schema__ApprovedAsset) -> Schema__BoolResult rev 1
  emits [schema.asset_not_approved]
  tests
    recheck_ok(request = schema__REQ_CSS, snapshot = schema__SNAP_OK, policy = schema__POLICY_PROD, site = schema__SITE_HOME, head = 7, t = 150, asset = seal Schema__ApprovedAsset("app-css|1.0.0|https://cdn.example/app.css|sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA|stylesheet|shop|pages|home")) => Ok(value = true)
    recheck_tampered(request = schema__REQ_CSS, snapshot = schema__SNAP_OK, policy = schema__POLICY_PROD, site = schema__SITE_HOME, head = 7, t = 150, asset = seal Schema__ApprovedAsset("app-css|1.0.0|https://cdn.example/app.css|sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA|script|shop|pages|home")) => schema.asset_not_approved(asset = schema__REQ_CSS)
    recheck_mixed_policy(request = schema__REQ_CSS, snapshot = schema__SNAP_OK, policy = seal Schema__AssetPolicy("shop|dev"), site = schema__SITE_HOME, head = 7, t = 150, asset = seal Schema__ApprovedAsset("app-css|1.0.0|https://cdn.example/app.css|sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA|stylesheet|shop|pages|home")) => schema.asset_not_approved(asset = schema__REQ_CSS)
    recheck_wrong_site(request = schema__REQ_CSS, snapshot = schema__SNAP_OK, policy = schema__POLICY_PROD, site = schema__SITE_ADMIN, head = 7, t = 150, asset = seal Schema__ApprovedAsset("app-css|1.0.0|https://cdn.example/app.css|sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA|stylesheet|shop|pages|home")) => schema.asset_not_approved(asset = schema__REQ_CSS)
    recheck_stale(request = schema__REQ_CSS, snapshot = schema__SNAP_STALE, policy = schema__POLICY_PROD, site = schema__SITE_HOME, head = 7, t = 150, asset = seal Schema__ApprovedAsset("app-css|1.0.0|https://cdn.example/app.css|sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA|stylesheet|shop|pages|home")) => schema.asset_not_approved(asset = schema__REQ_CSS)
=
  match call schema__asset__approve(request, snapshot, policy, site, head, t)
    on Ok a => match a.approval == asset
      true => Ok(value = true)
      false => schema.asset_not_approved(asset = request)
    on schema.asset_not_approved e => schema.asset_not_approved(asset = e.asset)

fn schema__policy__admit(program: str, policy: str) -> Schema__PolicyResult rev 1
  emits []
  tests
    admit_prod(program = "shop", policy = "prod") => Ok(policy = seal Schema__AssetPolicy("shop|prod"))
    admit_dev(program = "shop", policy = "dev") => Ok(policy = seal Schema__AssetPolicy("shop|dev"))
=
  Ok(policy = seal Schema__AssetPolicy(program + "|" + policy))

// Construction-time authorization: the single gate that mints ApprovedAsset.
// The chain is ordered cheapest-first (role, URL shape, digest form) but the
// order is observationally irrelevant: every failure below yields the same
// kind carrying the original request, so rows never oracle which check
// fired, how many entries exist, or what the registry expected. Exactly one
// matching entry, unrevoked, within its validity interval, under the
// snapshot's own recorded policy handle, at the accepted head sequence:
// anything else is not approval.
fn schema__asset__approve(request: Schema__AssetRequest, snapshot: Schema__RegistrySnapshot, policy: Schema__AssetPolicy, site: Schema__Site, head: int, t: int) -> Schema__ApprovalResult rev 1
  emits [schema.asset_not_approved]
  tests
    approve_ok(request = schema__REQ_CSS, snapshot = schema__SNAP_OK, policy = schema__POLICY_PROD, site = schema__SITE_HOME, head = 7, t = 150) => Ok(approval = seal Schema__ApprovedAsset("app-css|1.0.0|https://cdn.example/app.css|sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA|stylesheet|shop|pages|home"))
    approve_ok_script(request = Schema__AssetRequest(id = "app-js", revision = "2.0.0", url = "https://cdn.example/app.js", digest = "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", role = "script"), snapshot = schema__SNAP_JS, policy = schema__POLICY_PROD, site = schema__SITE_HOME, head = 7, t = 150) => Ok(approval = seal Schema__ApprovedAsset("app-js|2.0.0|https://cdn.example/app.js|sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA|script|shop|pages|home"))
    approve_lower_edge(request = schema__REQ_CSS, snapshot = schema__SNAP_OK, policy = schema__POLICY_PROD, site = schema__SITE_HOME, head = 7, t = 100) => Ok(approval = seal Schema__ApprovedAsset("app-css|1.0.0|https://cdn.example/app.css|sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA|stylesheet|shop|pages|home"))
    approve_inner_upper(request = schema__REQ_CSS, snapshot = schema__SNAP_OK, policy = schema__POLICY_PROD, site = schema__SITE_HOME, head = 7, t = 199) => Ok(approval = seal Schema__ApprovedAsset("app-css|1.0.0|https://cdn.example/app.css|sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA|stylesheet|shop|pages|home"))
    approve_unknown_role(request = Schema__AssetRequest(id = "app-css", revision = "1.0.0", url = "https://cdn.example/app.css", digest = "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", role = "module"), snapshot = schema__SNAP_OK, policy = schema__POLICY_PROD, site = schema__SITE_HOME, head = 7, t = 150) => schema.asset_not_approved(asset = Schema__AssetRequest(id = "app-css", revision = "1.0.0", url = "https://cdn.example/app.css", digest = "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", role = "module"))
    approve_http(request = Schema__AssetRequest(id = "app-css", revision = "1.0.0", url = "http://cdn.example/app.css", digest = "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", role = "stylesheet"), snapshot = schema__SNAP_EMPTY, policy = schema__POLICY_PROD, site = schema__SITE_HOME, head = 7, t = 150) => schema.asset_not_approved(asset = Schema__AssetRequest(id = "app-css", revision = "1.0.0", url = "http://cdn.example/app.css", digest = "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", role = "stylesheet"))
    approve_fragment(request = Schema__AssetRequest(id = "app-css", revision = "1.0.0", url = "https://cdn.example/app.css#x", digest = "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", role = "stylesheet"), snapshot = schema__SNAP_EMPTY, policy = schema__POLICY_PROD, site = schema__SITE_HOME, head = 7, t = 150) => schema.asset_not_approved(asset = Schema__AssetRequest(id = "app-css", revision = "1.0.0", url = "https://cdn.example/app.css#x", digest = "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", role = "stylesheet"))
    approve_userinfo(request = Schema__AssetRequest(id = "app-css", revision = "1.0.0", url = "https://user@cdn.example/app.css", digest = "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", role = "stylesheet"), snapshot = schema__SNAP_EMPTY, policy = schema__POLICY_PROD, site = schema__SITE_HOME, head = 7, t = 150) => schema.asset_not_approved(asset = Schema__AssetRequest(id = "app-css", revision = "1.0.0", url = "https://user@cdn.example/app.css", digest = "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", role = "stylesheet"))
    approve_bad_token(request = Schema__AssetRequest(id = "a|b", revision = "1.0.0", url = "https://cdn.example/app.css", digest = "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", role = "stylesheet"), snapshot = schema__SNAP_EMPTY, policy = schema__POLICY_PROD, site = schema__SITE_HOME, head = 7, t = 150) => schema.asset_not_approved(asset = Schema__AssetRequest(id = "a|b", revision = "1.0.0", url = "https://cdn.example/app.css", digest = "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", role = "stylesheet"))
    approve_quote_url(request = Schema__AssetRequest(id = "app-css", revision = "1.0.0", url = "https://cdn.example/a'b.css", digest = "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", role = "stylesheet"), snapshot = Schema__RegistrySnapshot(program = "shop", policy = schema__POLICY_PROD, sequence = 7, entries = Seq<Schema__RegistryEntry>[Schema__RegistryEntry(id = "app-css", revision = "1.0.0", url = "https://cdn.example/a'b.css", digest = "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", role = "stylesheet", program = "shop", module = "pages", function = "home", not_before = 100, not_after = 200)], revoked = Seq<Schema__Revoked>[]), policy = schema__POLICY_PROD, site = schema__SITE_HOME, head = 7, t = 150) => schema.asset_not_approved(asset = Schema__AssetRequest(id = "app-css", revision = "1.0.0", url = "https://cdn.example/a'b.css", digest = "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", role = "stylesheet"))
    approve_control_url(request = Schema__AssetRequest(id = "app-css", revision = "1.0.0", url = "https://cdn.example/ab.css", digest = "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", role = "stylesheet"), snapshot = Schema__RegistrySnapshot(program = "shop", policy = schema__POLICY_PROD, sequence = 7, entries = Seq<Schema__RegistryEntry>[Schema__RegistryEntry(id = "app-css", revision = "1.0.0", url = "https://cdn.example/ab.css", digest = "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", role = "stylesheet", program = "shop", module = "pages", function = "home", not_before = 100, not_after = 200)], revoked = Seq<Schema__Revoked>[]), policy = schema__POLICY_PROD, site = schema__SITE_HOME, head = 7, t = 150) => schema.asset_not_approved(asset = Schema__AssetRequest(id = "app-css", revision = "1.0.0", url = "https://cdn.example/ab.css", digest = "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", role = "stylesheet"))
    approve_bad_digest(request = Schema__AssetRequest(id = "app-css", revision = "1.0.0", url = "https://cdn.example/app.css", digest = "sha256-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", role = "stylesheet"), snapshot = schema__SNAP_EMPTY, policy = schema__POLICY_PROD, site = schema__SITE_HOME, head = 7, t = 150) => schema.asset_not_approved(asset = Schema__AssetRequest(id = "app-css", revision = "1.0.0", url = "https://cdn.example/app.css", digest = "sha256-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", role = "stylesheet"))
    approve_policy_mismatch(request = schema__REQ_CSS, snapshot = schema__SNAP_OK, policy = seal Schema__AssetPolicy("shop|dev"), site = schema__SITE_HOME, head = 7, t = 150) => schema.asset_not_approved(asset = schema__REQ_CSS)
    approve_program_mismatch(request = schema__REQ_CSS, snapshot = schema__SNAP_OK, policy = schema__POLICY_PROD, site = Schema__Site(program = "blog", module = "pages", function = "home"), head = 7, t = 150) => schema.asset_not_approved(asset = schema__REQ_CSS)
    approve_stale_sequence(request = schema__REQ_CSS, snapshot = schema__SNAP_STALE, policy = schema__POLICY_PROD, site = schema__SITE_HOME, head = 7, t = 150) => schema.asset_not_approved(asset = schema__REQ_CSS)
    approve_unknown_url(request = Schema__AssetRequest(id = "evil", revision = "9.9.9", url = "https://evil.example/x.js", digest = "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", role = "script"), snapshot = schema__SNAP_OK, policy = schema__POLICY_PROD, site = schema__SITE_HOME, head = 7, t = 150) => schema.asset_not_approved(asset = Schema__AssetRequest(id = "evil", revision = "9.9.9", url = "https://evil.example/x.js", digest = "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", role = "script"))
    approve_wrong_digest(request = Schema__AssetRequest(id = "app-css", revision = "1.0.0", url = "https://cdn.example/app.css", digest = "sha384-BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB", role = "stylesheet"), snapshot = schema__SNAP_OK, policy = schema__POLICY_PROD, site = schema__SITE_HOME, head = 7, t = 150) => schema.asset_not_approved(asset = Schema__AssetRequest(id = "app-css", revision = "1.0.0", url = "https://cdn.example/app.css", digest = "sha384-BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB", role = "stylesheet"))
    approve_role_mismatch(request = Schema__AssetRequest(id = "app-css", revision = "1.0.0", url = "https://cdn.example/app.css", digest = "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", role = "script"), snapshot = schema__SNAP_OK, policy = schema__POLICY_PROD, site = schema__SITE_HOME, head = 7, t = 150) => schema.asset_not_approved(asset = Schema__AssetRequest(id = "app-css", revision = "1.0.0", url = "https://cdn.example/app.css", digest = "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", role = "script"))
    approve_site_mismatch(request = schema__REQ_CSS, snapshot = schema__SNAP_OK, policy = schema__POLICY_PROD, site = schema__SITE_ADMIN, head = 7, t = 150) => schema.asset_not_approved(asset = schema__REQ_CSS)
    approve_revoked(request = schema__REQ_CSS, snapshot = Schema__RegistrySnapshot(program = "shop", policy = schema__POLICY_PROD, sequence = 8, entries = Seq<Schema__RegistryEntry>[schema__ENTRY_CSS], revoked = Seq<Schema__Revoked>[Schema__Revoked(id = "app-css", revision = "1.0.0")]), policy = schema__POLICY_PROD, site = schema__SITE_HOME, head = 8, t = 150) => schema.asset_not_approved(asset = schema__REQ_CSS)
    approve_expired(request = schema__REQ_CSS, snapshot = schema__SNAP_OK, policy = schema__POLICY_PROD, site = schema__SITE_HOME, head = 7, t = 200) => schema.asset_not_approved(asset = schema__REQ_CSS)
    approve_not_yet(request = schema__REQ_CSS, snapshot = schema__SNAP_OK, policy = schema__POLICY_PROD, site = schema__SITE_HOME, head = 7, t = 99) => schema.asset_not_approved(asset = schema__REQ_CSS)
    approve_no_transitive(request = Schema__AssetRequest(id = "app-chunk", revision = "2.0.0", url = "https://cdn.example/chunk.js", digest = "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", role = "script"), snapshot = schema__SNAP_JS, policy = schema__POLICY_PROD, site = schema__SITE_HOME, head = 7, t = 150) => schema.asset_not_approved(asset = Schema__AssetRequest(id = "app-chunk", revision = "2.0.0", url = "https://cdn.example/chunk.js", digest = "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", role = "script"))
    approve_conflict(request = schema__REQ_CSS, snapshot = Schema__RegistrySnapshot(program = "shop", policy = schema__POLICY_PROD, sequence = 7, entries = Seq<Schema__RegistryEntry>[schema__ENTRY_CSS, schema__ENTRY_CSS], revoked = Seq<Schema__Revoked>[]), policy = schema__POLICY_PROD, site = schema__SITE_HOME, head = 7, t = 150) => schema.asset_not_approved(asset = schema__REQ_CSS)
=
  match snapshot.policy == policy and snapshot.program == site.program and snapshot.sequence == head
    true => match chain
      call schema__role__check(request.role) as rc when rc.value
      call schema__url__prefix(request.url) as pc when pc.value
      call schema__url__tail_check(request.url, #request.url, true) as tc when tc.value
      call schema__tokens__check(request.id, request.revision, site) as tk when tk.value
      call schema__digest__check(request.digest) as dc when dc.value
      call schema__snapshot__scan(snapshot.entries, request, site, 0, #snapshot.entries + 1) as sc when sc.count == 1
      call schema__snapshot__entry_at(snapshot.entries, sc.first) as found
      call schema__revoked__contains(snapshot.revoked, found.entry.id, found.entry.revision, 0, #snapshot.revoked + 1) as rv when not rv.value
      then match found.entry.not_before <= t, t < found.entry.not_after
        true, true => Ok(approval = seal Schema__ApprovedAsset(request.id + "|" + request.revision + "|" + request.url + "|" + request.digest + "|" + request.role + "|" + site.program + "|" + site.module + "|" + site.function))
        _, _ => schema.asset_not_approved(asset = request)
      else schema.asset_not_approved(asset = request)
    false => schema.asset_not_approved(asset = request)
