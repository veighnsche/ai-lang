// schema/asset-approval: construction-time authorization for external assets.
//
// An ApprovedAsset is an opaque witness minted ONLY in this file, and only
// when an untrusted request matches an exact entry in an explicitly supplied
// registry snapshot under an explicitly supplied policy handle. See
// docs/a83-astra-schema.md: content digest AND permitted HTTPS origin, exact
// URL entry, one SHA-384 profile, HTTPS-only transport, exact pins,
// non-transitive single-role grants.
//
// What this file does NOT do: fetch anything, verify signatures, supply a
// clock, or choose the governing policy. Snapshot, policy handle, site, head
// sequence, and time arrive as explicit values; their PROVENANCE (which
// snapshot is current, which policy governs, what time it is) belongs to the
// deployment acceptance workflow (S4 in the slice plan). Tests therefore pass
// fixture snapshots explicitly: a sealed success-shaped value alone never
// approves. Minting a policy handle (schema__policy__admit) is not authority.
//
// Shape checks validate the REQUEST side only: a request that passes shape
// but matches no entry still rejects, and a matching entry inherits the
// request's validated form through exact equality. No input is ever repaired.
// NUL is rejected with the single lookup error below (never stripped); the
// tail_nul and token_nul rows carry literal NUL bytes, invisible in
// editors (verify with tr -d -c '\000' | wc -c, expect exactly 2).
// tail_ctrl and tail_del carry literal 0x01 and 0x7F bytes the same way.
// Do not normalize any of them away.

mod schema
  provides [schema__role__check, schema__url__prefix, schema__url__ws, schema__url__tail_check, schema__token__check, schema__tokens__check, schema__digest__char, schema__digest__tail, schema__digest__check, schema__entry__matches, schema__snapshot__scan, schema__snapshot__entry_at, schema__revoked__entry_at, schema__revoked__contains, schema__policy__admit, schema__asset__approve, schema__asset__recheck, Schema__AssetRequest, Schema__Site, Schema__RegistryEntry, Schema__Revoked, Schema__RegistrySnapshot, Schema__AssetPolicy, Schema__ApprovedAsset, Schema__ApprovalResult, Schema__PolicyResult, Schema__BoolResult, Schema__EntryResult, Schema__RevokedResult, Schema__ScanResult, schema__SNAP_OK, schema__SNAP_STALE, schema__SNAP_JS, schema__SNAP_EMPTY, schema__ENTRY_CSS, schema__REQ_CSS, schema__REQ_A, schema__SITE_HOME, schema__SITE_ADMIN, schema__SITE_P, schema__POLICY_PROD]
  uses []
  emits [schema.asset_not_approved]

error schema.asset_not_approved(asset: Schema__AssetRequest)

// Untrusted identifying data: no authority. A caller body builds this as a
// plain record (brands would be unsealable-by-construction here: bodies
// cannot mint foreign brands, and the request must be buildable anywhere).
type Schema__AssetRequest rev 1 (
  id: str,
  revision: str,
  url: str,
  digest: str,
  role: str
)

// Exact resolved source call site, as plain identifying data. Compiler
// certification of the node (never a caller-supplied name) is S4.
type Schema__Site rev 1 (
  program: str,
  module: str,
  function: str
)

// One exact approval: immutable asset identity + revision fixes one URL,
// digest, role, consuming site, and validity interval. Upper bound exclusive.
type Schema__RegistryEntry rev 1 (
  id: str,
  revision: str,
  url: str,
  digest: str,
  role: str,
  program: str,
  module: str,
  function: str,
  not_before: int,
  not_after: int
)

// Retained revocation record: removal never deletes audit history, and a
// revoked revision cannot be resurrected by replaying an old snapshot (the
// snapshot is only usable at the accepted head sequence).
type Schema__Revoked rev 1 (
  id: str,
  revision: str
)

// Externally accepted immutable snapshot, taken as a value (never ambient
// state: a state cell would be poisonable from inside). The policy field is
// the opaque handle itself, so approval checks policy agreement by brand
// equality without ever inspecting policy contents.
type Schema__RegistrySnapshot rev 1 (
  program: str,
  policy: Schema__AssetPolicy,
  sequence: int,
  entries: Seq<Schema__RegistryEntry>,
  revoked: Seq<Schema__Revoked>
)

// Opaque handle to the authoritative policy selected for this program's
// construction session. Passing the handle does not select the policy:
// the builder verifies it against the snapshot's recorded handle.
brand Schema__AssetPolicy is str rev 1

// Opaque, immutable approval witness: the approved request plus its policy,
// registry, site, and validity bindings, sealed into one canonical string.
// The string is never parsed back (an S4 recheck recomputes it from supplied
// values and compares whole, checking the snapshot sequence separately since
// integers have no string form here); the "|" separators are framing, not a
// format. No ordinary constructor, record reconstruction, or string
// conversion can manufacture this brand: only this file's bodies seal it,
// and only on the exact-match path.
brand Schema__ApprovedAsset is str rev 1

type Schema__ApprovalResult rev 1 (
  approval: Schema__ApprovedAsset
)

type Schema__PolicyResult rev 1 (
  policy: Schema__AssetPolicy
)

type Schema__BoolResult rev 1 (
  value: bool
)

type Schema__EntryResult rev 1 (
  entry: Schema__RegistryEntry
)

type Schema__RevokedResult rev 1 (
  entry: Schema__Revoked
)

type Schema__ScanResult rev 1 (
  first: int,
  count: int
)

// Shared decision-table fixtures: closed record, sequence, and
// seal constants naming the values rows repeat. Single-use hostile
// shapes (quote, control, conflict, revoked, wrong-digest) stay
// inline where the bytes are the point.
const schema__SNAP_OK: Schema__RegistrySnapshot rev 1 = Schema__RegistrySnapshot(program = "shop", policy = seal Schema__AssetPolicy("shop|prod"), sequence = 7, entries = Seq<Schema__RegistryEntry>[Schema__RegistryEntry(id = "app-css", revision = "1.0.0", url = "https://cdn.example/app.css", digest = "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", role = "stylesheet", program = "shop", module = "pages", function = "home", not_before = 100, not_after = 200)], revoked = Seq<Schema__Revoked>[])
const schema__SNAP_STALE: Schema__RegistrySnapshot rev 1 = Schema__RegistrySnapshot(program = "shop", policy = seal Schema__AssetPolicy("shop|prod"), sequence = 6, entries = Seq<Schema__RegistryEntry>[Schema__RegistryEntry(id = "app-css", revision = "1.0.0", url = "https://cdn.example/app.css", digest = "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", role = "stylesheet", program = "shop", module = "pages", function = "home", not_before = 100, not_after = 200)], revoked = Seq<Schema__Revoked>[])
const schema__SNAP_JS: Schema__RegistrySnapshot rev 1 = Schema__RegistrySnapshot(program = "shop", policy = seal Schema__AssetPolicy("shop|prod"), sequence = 7, entries = Seq<Schema__RegistryEntry>[Schema__RegistryEntry(id = "app-js", revision = "2.0.0", url = "https://cdn.example/app.js", digest = "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", role = "script", program = "shop", module = "pages", function = "home", not_before = 100, not_after = 200)], revoked = Seq<Schema__Revoked>[])
const schema__SNAP_EMPTY: Schema__RegistrySnapshot rev 1 = Schema__RegistrySnapshot(program = "shop", policy = seal Schema__AssetPolicy("shop|prod"), sequence = 7, entries = Seq<Schema__RegistryEntry>[], revoked = Seq<Schema__Revoked>[])
const schema__ENTRY_CSS: Schema__RegistryEntry rev 1 = Schema__RegistryEntry(id = "app-css", revision = "1.0.0", url = "https://cdn.example/app.css", digest = "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", role = "stylesheet", program = "shop", module = "pages", function = "home", not_before = 100, not_after = 200)
const schema__REQ_CSS: Schema__AssetRequest rev 1 = Schema__AssetRequest(id = "app-css", revision = "1.0.0", url = "https://cdn.example/app.css", digest = "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", role = "stylesheet")
const schema__REQ_A: Schema__AssetRequest rev 1 = Schema__AssetRequest(id = "a", revision = "1", url = "https://h/a", digest = "d", role = "stylesheet")
const schema__SITE_HOME: Schema__Site rev 1 = Schema__Site(program = "shop", module = "pages", function = "home")
const schema__SITE_ADMIN: Schema__Site rev 1 = Schema__Site(program = "shop", module = "admin", function = "home")
const schema__SITE_P: Schema__Site rev 1 = Schema__Site(program = "p", module = "m", function = "f")
const schema__POLICY_PROD: Schema__AssetPolicy rev 1 = seal Schema__AssetPolicy("shop|prod")

// The minimum roles are external stylesheet and external classic script.
// Module scripts, workers, preload uses, and other modes are not aliases.
fn schema__role__check(role: str) -> Schema__BoolResult rev 1
  emits []
  tests
    role_stylesheet("stylesheet") => Ok(true)
    role_script("script") => Ok(true)
    role_module("module") => Ok(false)
    role_worker("worker") => Ok(false)
    role_preload("preload") => Ok(false)
    role_empty("") => Ok(false)
    role_upper("Stylesheet") => Ok(false)
  match role
    "stylesheet" | "script" => Ok(true)
    _ => Ok(false)

// Absolute-HTTPS gate: exactly lowercase https, nothing else present or
// absent. Uppercase HTTPS is a spelling rejection, not a transport claim;
// a colon that is not a scheme token earns failure here, never a scheme pass.
fn schema__url__prefix(url: str) -> Schema__BoolResult rev 1
  emits []
  tests
    prefix_ok("https://cdn.example/app.css") => Ok(true)
    prefix_bare("https://") => Ok(true)
    prefix_http("http://cdn.example/app.css") => Ok(false)
    prefix_upper("HTTPS://cdn.example/app.css") => Ok(false)
    prefix_short("https:/") => Ok(false)
    prefix_empty("") => Ok(false)
    prefix_relative("/app.css") => Ok(false)
    prefix_protocol_relative("//cdn.example/app.css") => Ok(false)
    prefix_data("data:text/css,hi") => Ok(false)
  match #url < 8
    true => Ok(false)
    false => match url[0:8] == "https://"
      true => Ok(true)
      false => Ok(false)

// ASCII-whitespace set: TAB LF FF CR SPACE, codes 9 10 12 13 32.
// The tail worker folds these codes into its C0 reject arm (0..31
// plus 32) instead of calling here; this function names the set and
// witnesses each code. NUL is not whitespace anywhere in this file:
// the tail's range arm rejects it, never folded in here.
fn schema__url__ws(code: int) -> Schema__BoolResult rev 1
  emits []
  tests
    ws_tab(9) => Ok(true)
    ws_lf(10) => Ok(true)
    ws_ff(12) => Ok(true)
    ws_cr(13) => Ok(true)
    ws_space(32) => Ok(true)
    ws_nul(0) => Ok(false)
    ws_slash(47) => Ok(false)
    ws_letter(97) => Ok(false)
  match code
    9 | 10 | 12 | 13 | 32 => Ok(true)
    _ => Ok(false)

// URL tail scan: no NUL, no other C0 control, no DEL, no fragment, no
// backslash, no ASCII whitespace, no userinfo (@ before the first /),
// and no quote or angle characters (' " < >). One range-or arm rejects
// NUL, C0 (whitespace folded in), DEL, and the symbol set; @-in-authority
// rejects through a boolean conjunct and the /-flip threads through the
// recursive call's authority argument.
// The quotes and angles are
// excluded for the fixed single-quoted sink embedding: a ' in an approved
// URL would break out of the href/src attribute, and " < > ride out with
// it as noncanonical input; & rides along as exact-entry-bound query
// content (retrieval fidelity, not construction structure). Query strings
// ride along (bound by the exact entry); @ after the first / rides along
// as path content. The scan starts in-authority; the first / ends the
// authority section. The whole URL is scanned (the https:// prefix is
// inert under these rules), so approval checks one shape, not a slice
// of one.
fn schema__url__tail_check(s: str, n: int, in_authority: bool) -> Schema__BoolResult rev 1
  decreases n
  emits []
  tests
    tail_empty("", 0, true) => Ok(true)
    tail_zero_budget("/a", 0, true) => Ok(true)
    tail_plain("ab", 2, false) => Ok(true)
    tail_path_query("/a.css?v=2", 10, false) => Ok(true)
    tail_authority_flip("h/a@b", 5, true) => Ok(true)
    tail_at_path("/a@b", 4, false) => Ok(true)
    tail_fragment("/a#b", 4, false) => Ok(false)
    tail_userinfo("u@h/a", 5, true) => Ok(false)
    tail_space("/a b", 4, false) => Ok(false)
    tail_pipe("/a|b", 4, false) => Ok(false)
    tail_backslash("/a\b", 4, false) => Ok(false)
    tail_squote("/a'b", 4, false) => Ok(false)
    tail_dquote(e"/a\"b", 4, false) => Ok(false)
    tail_angle_open("/a<b", 4, false) => Ok(false)
    tail_angle_close("/a>b", 4, false) => Ok(false)
    tail_nul("/a␀b", 4, false) => Ok(false)
    tail_ctrl("/ab", 4, false) => Ok(false)
    tail_del("/ab", 4, false) => Ok(false)
  match n <= 0
    true => Ok(true)
    false => match s[0]
      0..31 | 32 | 34 | 35 | 39 | 60 | 62 | 92 | 124 | 127 => Ok(false)
      _ => match s[0] == 64 and in_authority
        true => Ok(false)
        false => match call schema__url__tail_check(s[1:#s], n - 1, not (s[0] == 47) and in_authority)
          on Ok r => Ok(r.value)

// Separator-safe token scan: identifiers, revisions, and site fields must
// carry no NUL and no "|" (code 124). The witness canonical string joins
// its eight fields with "|" for the S2 projection kernel; a field holding
// the separator would make the split ambiguous, so approval refuses it.
// The digest alphabet already excludes both; the closed role gate cannot
// produce them; the URL tail rejects them above.
fn schema__token__check(s: str, n: int) -> Schema__BoolResult rev 1
  decreases n
  emits []
  tests
    token_empty("", 0) => Ok(true)
    token_zero_budget("ab", 0) => Ok(true)
    token_clean("1.0.0", 5) => Ok(true)
    token_pipe("a|b", 3) => Ok(false)
    token_nul("a␀b", 3) => Ok(false)
  match n <= 0
    true => Ok(true)
    false => match s[0]
      0 | 124 => Ok(false)
      _ => match call schema__token__check(s[1:#s], n - 1)
        on Ok r => Ok(r.value)

// All five free-text bindings must be separator-safe: a pipe smuggled in
// any one of them breaks the witness framing, so one function checks all
// five and approval calls it once.
fn schema__tokens__check(id: str, revision: str, site: Schema__Site) -> Schema__BoolResult rev 1
  emits []
  tests
    tokens_clean("app-css", "1.0.0", schema__SITE_HOME) => Ok(true)
    tokens_bad_id("a|b", "1.0.0", schema__SITE_HOME) => Ok(false)
    tokens_bad_revision("app-css", "1|0", schema__SITE_HOME) => Ok(false)
    tokens_bad_program("app-css", "1.0.0", Schema__Site("sh|op", "pages", "home")) => Ok(false)
    tokens_bad_module("app-css", "1.0.0", Schema__Site("shop", "pa|ges", "home")) => Ok(false)
    tokens_bad_function("app-css", "1.0.0", Schema__Site("shop", "pages", "ho|me")) => Ok(false)
  match chain
    call schema__token__check(id, #id) as a when a.value
    call schema__token__check(revision, #revision) as b when b.value
    call schema__token__check(site.program, #site.program) as c when c.value
    call schema__token__check(site.module, #site.module) as d when d.value
    call schema__token__check(site.function, #site.function) as e
    then Ok(value = e.value)
    else Ok(value = false)

// SRI digest alphabet: standard base64 plus padding. One arm carries the
// three symbols and the three ranges; the wildcard rejects. Every range
// edge and every neighbor just outside a range is witnessed below.
fn schema__digest__char(code: int) -> Schema__BoolResult rev 1
  emits []
  tests
    char_plus(43) => Ok(true)
    char_slash(47) => Ok(true)
    char_equals(61) => Ok(true)
    char_digit(48) => Ok(true)
    char_upper(65) => Ok(true)
    char_lower(97) => Ok(true)
    char_dash(45) => Ok(false)
    char_colon(58) => Ok(false)
    char_space(32) => Ok(false)
    char_digit_nine(57) => Ok(true)
    char_upper_z(90) => Ok(true)
    char_lower_z(122) => Ok(true)
    char_above_upper(91) => Ok(false)
    char_above_lower(123) => Ok(false)
  match code
    43 | 47 | 61 | 48..57 | 65..90 | 97..122 => Ok(true)
    _ => Ok(false)

// Digest tail scan: every scalar must clear the alphabet worker.
fn schema__digest__tail(s: str, n: int) -> Schema__BoolResult rev 1
  decreases n
  emits []
  tests
    dtail_empty("", 0) => Ok(true)
    dtail_zero_budget("AB", 0) => Ok(true)
    dtail_good("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", 64) => Ok(true)
    dtail_bad("AAAAAAAAAAAA-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", 64) => Ok(false)
  match n <= 0
    true => Ok(true)
    false => match chain
      call schema__digest__char(s[0]) as c when c.value
      call schema__digest__tail(s[1:#s], n - 1) as r
      then Ok(value = r.value)
      else Ok(value = false)

// First integrity profile: exactly one SHA-384 digest in canonical SRI
// form ("sha384-" plus 64 base64 scalars; 48 bytes need no padding, but the
// alphabet admits it). Multiple digests, other algorithms, and bare hex are
// rejected: the entry carries one digest and the request must name it.
fn schema__digest__check(digest: str) -> Schema__BoolResult rev 1
  emits []
  tests
    digest_good("sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA") => Ok(true)
    digest_short("sha384-AAAA") => Ok(false)
    digest_empty("") => Ok(false)
    digest_sha256("sha256-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA") => Ok(false)
    digest_bare("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA") => Ok(false)
    digest_badchar("sha384-AAAAAAAAAAAA-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA") => Ok(false)
  match #digest == 71
    true => match digest[0:7] == "sha384-"
      true => match call schema__digest__tail(digest[7:#digest], 64)
        on Ok r => Ok(r.value)
      false => Ok(false)
    false => Ok(false)

// One entry matches when every bound field agrees exactly: asset identity,
// revision, URL, digest, role, and the consuming site. No approximate
// lookup, no substitution, no first-match-wins here (counting is the scan's
// job). File extensions, hostnames, and digest equality never substitute
// for a role or site grant: each is its own conjunct.
fn schema__entry__matches(entry: Schema__RegistryEntry, request: Schema__AssetRequest, site: Schema__Site) -> Schema__BoolResult rev 1
  emits []
  tests
    entry_hit(schema__ENTRY_CSS, schema__REQ_CSS, schema__SITE_HOME) => Ok(true)
    entry_url_miss(schema__ENTRY_CSS, Schema__AssetRequest("app-css", "1.0.0", "https://cdn.example/other.css", "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "stylesheet"), schema__SITE_HOME) => Ok(false)
    entry_site_miss(schema__ENTRY_CSS, schema__REQ_CSS, schema__SITE_ADMIN) => Ok(false)
  match entry.id == request.id, entry.revision == request.revision, entry.url == request.url, entry.digest == request.digest, entry.role == request.role, entry.program == site.program, entry.module == site.module, entry.function == site.function
    true, true, true, true, true, true, true, true => Ok(true)
    _, _, _, _, _, _, _, _ => Ok(false)

// Snapshot scan: counts exact matches and remembers the first one's index.
// Exactly one match is usable; zero is unapproved and two is a conflicting
// snapshot (rejected downstream with the same indistinguishable shape, so
// rejection rows never oracle how many entries exist). first is meaningful
// only when count is 1; when count is 0 it is the terminal position.
fn schema__snapshot__scan(entries: Seq<Schema__RegistryEntry>, request: Schema__AssetRequest, site: Schema__Site, position: int, fuel: int) -> Schema__ScanResult rev 1
  decreases fuel
  emits []
  tests
    scan_zero_fuel(Seq<Schema__RegistryEntry>[Schema__RegistryEntry("a", "1", "https://h/a", "d", "stylesheet", "p", "m", "f", 0, 9)], schema__REQ_A, schema__SITE_P, 0, 0) => Ok(0, 0)
    scan_empty(Seq<Schema__RegistryEntry>[], schema__REQ_A, schema__SITE_P, 0, 1) => Ok(0, 0)
    scan_single(Seq<Schema__RegistryEntry>[Schema__RegistryEntry("a", "1", "https://h/a", "d", "stylesheet", "p", "m", "f", 0, 9)], schema__REQ_A, schema__SITE_P, 0, 2) => Ok(0, 1)
    scan_nomatch(Seq<Schema__RegistryEntry>[Schema__RegistryEntry("b", "1", "https://h/b", "d", "stylesheet", "p", "m", "f", 0, 9)], schema__REQ_A, schema__SITE_P, 0, 2) => Ok(1, 0)
    scan_conflict(Seq<Schema__RegistryEntry>[Schema__RegistryEntry("a", "1", "https://h/a", "d", "stylesheet", "p", "m", "f", 0, 9), Schema__RegistryEntry("a", "1", "https://h/a", "d", "stylesheet", "p", "m", "f", 0, 9)], schema__REQ_A, schema__SITE_P, 0, 3) => Ok(0, 2)
  match fuel <= 0
    true => Ok(position, 0)
    false => match position < #entries
      true => match call schema__snapshot__entry_at(entries, position)
        on Ok at => match call schema__entry__matches(at.entry, request, site)
          on Ok m => match m.value
            true => match call schema__snapshot__scan(entries, request, site, position + 1, fuel - 1)
              on Ok rest => Ok(position, rest.count + 1)
            false => match call schema__snapshot__scan(entries, request, site, position + 1, fuel - 1)
              on Ok rest => Ok(rest.first, rest.count)
      false => Ok(position, 0)

fn schema__snapshot__entry_at(entries: Seq<Schema__RegistryEntry>, position: int) -> Schema__EntryResult rev 1
  emits []
  tests
    entry_at_first(Seq<Schema__RegistryEntry>[Schema__RegistryEntry("a", "1", "https://h/a", "d", "stylesheet", "p", "m", "f", 0, 9), Schema__RegistryEntry("b", "1", "https://h/b", "d", "stylesheet", "p", "m", "f", 0, 9)], 1) => Ok(Schema__RegistryEntry("b", "1", "https://h/b", "d", "stylesheet", "p", "m", "f", 0, 9))
  Ok(entries[position])

// Revocation membership: a retained revocation for this exact id+revision
// kills the approval however valid the entry looks. The walk carries no
// entry data outward: hit or miss only.
fn schema__revoked__contains(revoked: Seq<Schema__Revoked>, id: str, revision: str, position: int, fuel: int) -> Schema__BoolResult rev 1
  decreases fuel
  emits []
  tests
    revoked_zero_fuel(Seq<Schema__Revoked>[Schema__Revoked("a", "1")], "a", "1", 0, 0) => Ok(false)
    revoked_empty(Seq<Schema__Revoked>[], "a", "1", 0, 1) => Ok(false)
    revoked_hit(Seq<Schema__Revoked>[Schema__Revoked("b", "2"), Schema__Revoked("a", "1")], "a", "1", 0, 3) => Ok(true)
    revoked_miss(Seq<Schema__Revoked>[Schema__Revoked("b", "2")], "a", "1", 0, 2) => Ok(false)
  match fuel <= 0
    true => Ok(false)
    false => match position < #revoked
      true => match call schema__revoked__entry_at(revoked, position)
        on Ok at => match at.entry.id == id, at.entry.revision == revision
          true, true => Ok(true)
          _, _ => match call schema__revoked__contains(revoked, id, revision, position + 1, fuel - 1)
            on Ok r => Ok(r.value)
      false => Ok(false)

fn schema__revoked__entry_at(revoked: Seq<Schema__Revoked>, position: int) -> Schema__RevokedResult rev 1
  emits []
  tests
    revoked_at_first(Seq<Schema__Revoked>[Schema__Revoked("a", "1")], 0) => Ok(Schema__Revoked("a", "1"))
  Ok(revoked[position])

// Policy handle minting. This proves nothing: the handle is evidence of the
// governing policy only when the acceptance workflow binds it (S4), and the
// snapshot carries the expected handle for brand-equality comparison.
// A self-minted handle plus a self-built snapshot passes only the fixture
// context it was built for, never production acceptance.

// Re-verification: re-runs authorization over the supplied values and
// requires the presented witness to equal the freshly minted one. The
// witness carries no snapshot sequence (integers have no string form
// here), so currency is enforced on the SUPPLIED snapshot
// (sequence == head), not historically on the witness: a replay under
// identical bindings and a current snapshot re-verifies, while any
// rotation (new revision or digest), revocation, expiry, or context
// change fails closed. Rotation-by-repinning is the revocation story;
// the witness never outlives its bindings.
fn schema__asset__recheck(request: Schema__AssetRequest, snapshot: Schema__RegistrySnapshot, policy: Schema__AssetPolicy, site: Schema__Site, head: int, t: int, asset: Schema__ApprovedAsset) -> Schema__BoolResult rev 1
  emits [schema.asset_not_approved]
  tests
    recheck_ok(schema__REQ_CSS, schema__SNAP_OK, schema__POLICY_PROD, schema__SITE_HOME, 7, 150, seal Schema__ApprovedAsset("app-css|1.0.0|https://cdn.example/app.css|sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA|stylesheet|shop|pages|home")) => Ok(true)
    recheck_tampered(schema__REQ_CSS, schema__SNAP_OK, schema__POLICY_PROD, schema__SITE_HOME, 7, 150, seal Schema__ApprovedAsset("app-css|1.0.0|https://cdn.example/app.css|sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA|script|shop|pages|home")) => schema.asset_not_approved(schema__REQ_CSS)
    recheck_mixed_policy(schema__REQ_CSS, schema__SNAP_OK, seal Schema__AssetPolicy("shop|dev"), schema__SITE_HOME, 7, 150, seal Schema__ApprovedAsset("app-css|1.0.0|https://cdn.example/app.css|sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA|stylesheet|shop|pages|home")) => schema.asset_not_approved(schema__REQ_CSS)
    recheck_wrong_site(schema__REQ_CSS, schema__SNAP_OK, schema__POLICY_PROD, schema__SITE_ADMIN, 7, 150, seal Schema__ApprovedAsset("app-css|1.0.0|https://cdn.example/app.css|sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA|stylesheet|shop|pages|home")) => schema.asset_not_approved(schema__REQ_CSS)
    recheck_stale(schema__REQ_CSS, schema__SNAP_STALE, schema__POLICY_PROD, schema__SITE_HOME, 7, 150, seal Schema__ApprovedAsset("app-css|1.0.0|https://cdn.example/app.css|sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA|stylesheet|shop|pages|home")) => schema.asset_not_approved(schema__REQ_CSS)
  match call schema__asset__approve(request, snapshot, policy, site, head, t)
    on Ok a => match a.approval == asset
      true => Ok(true)
      false => schema.asset_not_approved(request)
    on schema.asset_not_approved e => forward e

fn schema__policy__admit(program: str, policy: str) -> Schema__PolicyResult rev 1
  emits []
  tests
    admit_prod("shop", "prod") => Ok(seal Schema__AssetPolicy("shop|prod"))
    admit_dev("shop", "dev") => Ok(seal Schema__AssetPolicy("shop|dev"))
  Ok(seal Schema__AssetPolicy(program + "|" + policy))

// Construction-time authorization: the single gate that mints ApprovedAsset.
// The chain is ordered cheapest-first (role, URL shape, digest form) but the
// order is observationally irrelevant: every failure below yields the same
// kind carrying the original request, so rows never oracle which check
// fired, how many entries exist, or what the registry expected. Exactly one
// matching entry, unrevoked, within its validity interval, under the
// snapshot's own recorded policy handle, at the accepted head sequence:
// anything else is not approval.
fn schema__asset__approve(request: Schema__AssetRequest, snapshot: Schema__RegistrySnapshot, policy: Schema__AssetPolicy, site: Schema__Site, head: int, t: int) -> Schema__ApprovalResult rev 1
  emits [schema.asset_not_approved]
  tests
    approve_ok(schema__REQ_CSS, schema__SNAP_OK, schema__POLICY_PROD, schema__SITE_HOME, 7, 150) => Ok(seal Schema__ApprovedAsset("app-css|1.0.0|https://cdn.example/app.css|sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA|stylesheet|shop|pages|home"))
    approve_ok_script(Schema__AssetRequest("app-js", "2.0.0", "https://cdn.example/app.js", "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "script"), schema__SNAP_JS, schema__POLICY_PROD, schema__SITE_HOME, 7, 150) => Ok(seal Schema__ApprovedAsset("app-js|2.0.0|https://cdn.example/app.js|sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA|script|shop|pages|home"))
    approve_lower_edge(schema__REQ_CSS, schema__SNAP_OK, schema__POLICY_PROD, schema__SITE_HOME, 7, 100) => Ok(seal Schema__ApprovedAsset("app-css|1.0.0|https://cdn.example/app.css|sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA|stylesheet|shop|pages|home"))
    approve_inner_upper(schema__REQ_CSS, schema__SNAP_OK, schema__POLICY_PROD, schema__SITE_HOME, 7, 199) => Ok(seal Schema__ApprovedAsset("app-css|1.0.0|https://cdn.example/app.css|sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA|stylesheet|shop|pages|home"))
    approve_unknown_role(Schema__AssetRequest("app-css", "1.0.0", "https://cdn.example/app.css", "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "module"), schema__SNAP_OK, schema__POLICY_PROD, schema__SITE_HOME, 7, 150) => schema.asset_not_approved(Schema__AssetRequest("app-css", "1.0.0", "https://cdn.example/app.css", "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "module"))
    approve_http(Schema__AssetRequest("app-css", "1.0.0", "http://cdn.example/app.css", "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "stylesheet"), schema__SNAP_EMPTY, schema__POLICY_PROD, schema__SITE_HOME, 7, 150) => schema.asset_not_approved(Schema__AssetRequest("app-css", "1.0.0", "http://cdn.example/app.css", "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "stylesheet"))
    approve_fragment(Schema__AssetRequest("app-css", "1.0.0", "https://cdn.example/app.css#x", "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "stylesheet"), schema__SNAP_EMPTY, schema__POLICY_PROD, schema__SITE_HOME, 7, 150) => schema.asset_not_approved(Schema__AssetRequest("app-css", "1.0.0", "https://cdn.example/app.css#x", "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "stylesheet"))
    approve_userinfo(Schema__AssetRequest("app-css", "1.0.0", "https://user@cdn.example/app.css", "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "stylesheet"), schema__SNAP_EMPTY, schema__POLICY_PROD, schema__SITE_HOME, 7, 150) => schema.asset_not_approved(Schema__AssetRequest("app-css", "1.0.0", "https://user@cdn.example/app.css", "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "stylesheet"))
    approve_bad_token(Schema__AssetRequest("a|b", "1.0.0", "https://cdn.example/app.css", "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "stylesheet"), schema__SNAP_EMPTY, schema__POLICY_PROD, schema__SITE_HOME, 7, 150) => schema.asset_not_approved(Schema__AssetRequest("a|b", "1.0.0", "https://cdn.example/app.css", "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "stylesheet"))
    approve_quote_url(Schema__AssetRequest("app-css", "1.0.0", "https://cdn.example/a'b.css", "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "stylesheet"), Schema__RegistrySnapshot("shop", schema__POLICY_PROD, 7, Seq<Schema__RegistryEntry>[Schema__RegistryEntry("app-css", "1.0.0", "https://cdn.example/a'b.css", "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "stylesheet", "shop", "pages", "home", 100, 200)], Seq<Schema__Revoked>[]), schema__POLICY_PROD, schema__SITE_HOME, 7, 150) => schema.asset_not_approved(Schema__AssetRequest("app-css", "1.0.0", "https://cdn.example/a'b.css", "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "stylesheet"))
    approve_control_url(Schema__AssetRequest("app-css", "1.0.0", "https://cdn.example/ab.css", "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "stylesheet"), Schema__RegistrySnapshot("shop", schema__POLICY_PROD, 7, Seq<Schema__RegistryEntry>[Schema__RegistryEntry("app-css", "1.0.0", "https://cdn.example/ab.css", "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "stylesheet", "shop", "pages", "home", 100, 200)], Seq<Schema__Revoked>[]), schema__POLICY_PROD, schema__SITE_HOME, 7, 150) => schema.asset_not_approved(Schema__AssetRequest("app-css", "1.0.0", "https://cdn.example/ab.css", "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "stylesheet"))
    approve_bad_digest(Schema__AssetRequest("app-css", "1.0.0", "https://cdn.example/app.css", "sha256-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "stylesheet"), schema__SNAP_EMPTY, schema__POLICY_PROD, schema__SITE_HOME, 7, 150) => schema.asset_not_approved(Schema__AssetRequest("app-css", "1.0.0", "https://cdn.example/app.css", "sha256-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "stylesheet"))
    approve_policy_mismatch(schema__REQ_CSS, schema__SNAP_OK, seal Schema__AssetPolicy("shop|dev"), schema__SITE_HOME, 7, 150) => schema.asset_not_approved(schema__REQ_CSS)
    approve_program_mismatch(schema__REQ_CSS, schema__SNAP_OK, schema__POLICY_PROD, Schema__Site("blog", "pages", "home"), 7, 150) => schema.asset_not_approved(schema__REQ_CSS)
    approve_stale_sequence(schema__REQ_CSS, schema__SNAP_STALE, schema__POLICY_PROD, schema__SITE_HOME, 7, 150) => schema.asset_not_approved(schema__REQ_CSS)
    approve_unknown_url(Schema__AssetRequest("evil", "9.9.9", "https://evil.example/x.js", "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "script"), schema__SNAP_OK, schema__POLICY_PROD, schema__SITE_HOME, 7, 150) => schema.asset_not_approved(Schema__AssetRequest("evil", "9.9.9", "https://evil.example/x.js", "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "script"))
    approve_wrong_digest(Schema__AssetRequest("app-css", "1.0.0", "https://cdn.example/app.css", "sha384-BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB", "stylesheet"), schema__SNAP_OK, schema__POLICY_PROD, schema__SITE_HOME, 7, 150) => schema.asset_not_approved(Schema__AssetRequest("app-css", "1.0.0", "https://cdn.example/app.css", "sha384-BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB", "stylesheet"))
    approve_role_mismatch(Schema__AssetRequest("app-css", "1.0.0", "https://cdn.example/app.css", "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "script"), schema__SNAP_OK, schema__POLICY_PROD, schema__SITE_HOME, 7, 150) => schema.asset_not_approved(Schema__AssetRequest("app-css", "1.0.0", "https://cdn.example/app.css", "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "script"))
    approve_site_mismatch(schema__REQ_CSS, schema__SNAP_OK, schema__POLICY_PROD, schema__SITE_ADMIN, 7, 150) => schema.asset_not_approved(schema__REQ_CSS)
    approve_revoked(schema__REQ_CSS, Schema__RegistrySnapshot("shop", schema__POLICY_PROD, 8, Seq<Schema__RegistryEntry>[schema__ENTRY_CSS], Seq<Schema__Revoked>[Schema__Revoked("app-css", "1.0.0")]), schema__POLICY_PROD, schema__SITE_HOME, 8, 150) => schema.asset_not_approved(schema__REQ_CSS)
    approve_expired(schema__REQ_CSS, schema__SNAP_OK, schema__POLICY_PROD, schema__SITE_HOME, 7, 200) => schema.asset_not_approved(schema__REQ_CSS)
    approve_not_yet(schema__REQ_CSS, schema__SNAP_OK, schema__POLICY_PROD, schema__SITE_HOME, 7, 99) => schema.asset_not_approved(schema__REQ_CSS)
    approve_no_transitive(Schema__AssetRequest("app-chunk", "2.0.0", "https://cdn.example/chunk.js", "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "script"), schema__SNAP_JS, schema__POLICY_PROD, schema__SITE_HOME, 7, 150) => schema.asset_not_approved(Schema__AssetRequest("app-chunk", "2.0.0", "https://cdn.example/chunk.js", "sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "script"))
    approve_conflict(schema__REQ_CSS, Schema__RegistrySnapshot("shop", schema__POLICY_PROD, 7, Seq<Schema__RegistryEntry>[schema__ENTRY_CSS, schema__ENTRY_CSS], Seq<Schema__Revoked>[]), schema__POLICY_PROD, schema__SITE_HOME, 7, 150) => schema.asset_not_approved(schema__REQ_CSS)
  match snapshot.policy == policy and snapshot.program == site.program and snapshot.sequence == head
    true => match chain
      call schema__role__check(request.role) as rc when rc.value
      call schema__url__prefix(request.url) as pc when pc.value
      call schema__url__tail_check(request.url, #request.url, true) as tc when tc.value
      call schema__tokens__check(request.id, request.revision, site) as tk when tk.value
      call schema__digest__check(request.digest) as dc when dc.value
      call schema__snapshot__scan(snapshot.entries, request, site, 0, #snapshot.entries + 1) as sc when sc.count == 1
      call schema__snapshot__entry_at(snapshot.entries, sc.first) as found
      call schema__revoked__contains(snapshot.revoked, found.entry.id, found.entry.revision, 0, #snapshot.revoked + 1) as rv when not rv.value
      then match found.entry.not_before <= t, t < found.entry.not_after
        true, true => Ok(approval = seal Schema__ApprovedAsset(request.id + "|" + request.revision + "|" + request.url + "|" + request.digest + "|" + request.role + "|" + site.program + "|" + site.module + "|" + site.function))
        _, _ => schema.asset_not_approved(asset = request)
      else schema.asset_not_approved(asset = request)
    false => schema.asset_not_approved(request)
