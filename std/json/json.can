  match fuel <= 0
    true => json.invalid_syntax("fuel exhausted")
    false => match call std__json__parse_ws_skip(text, pos)
      on Ok w => match #stack == 0
        true => match call std__json__parse_head(text, w.value)
          on Ok h => match h.tag
            on Json__HeadBrace _ => forward call std__json__parse_step(text, w.value + 1, fuel - 1, stack + Json__PFrame(Json__PObjFirst(), Seq<Json__Doc>[], Seq<Json__Field>[], Seq<str>[], "", "", Json__Null(), Seq<Json__Field>[], Seq<str>[]))
