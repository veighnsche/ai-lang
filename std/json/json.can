fn std__json__dec__encode_apply(value: dec, enc: Fn<dec, Json__Doc, []>) -> Json__Doc rev 1
  emits []
  tests
    frac(d"12.34", fnref std__json__dec__encode()) => Ok(Json__Num("12.34"))
  match invoke enc with value
    on Ok d => Ok(d.value)

fn std__json__dec__decode_apply(value: Json__Value, dec: Fn<Json__Value, Dec__Value, [json.numeric_out_of_range, json.schema_mismatch]>) -> Dec__Value rev 1
  emits [json.schema_mismatch, json.numeric_out_of_range]
  tests
    num(Json__Num("1.5"), fnref std__json__dec__decode()) => Ok(d"1.5")
    bad(Json__Num("1.2.3"), fnref std__json__dec__decode()) => json.numeric_out_of_range("1.2.3")
    mistype(Json__Str("a"), fnref std__json__dec__decode()) => json.schema_mismatch("want dec, got str")
  match invoke dec with value
    on Ok r => Ok(r.value)
    on json.schema_mismatch e => forward e
    on json.numeric_out_of_range e => forward e

fn std__json__int__encode_value(value: int, schema: Json__IntSchema) -> Json__Doc rev 1
  emits []
  tests
    zero(0, Json__IntSchema(fnref std__json__int__encode(), fnref std__json__int__decode())) => Ok(Json__Num("0"))
    neg(-7, Json__IntSchema(fnref std__json__int__encode(), fnref std__json__int__decode())) => Ok(Json__Num("-7"))
  match call std__json__int__encode_apply(value, schema.encode)
    on Ok d => Ok(d.value)

