              on json.invalid_syntax e => forward e
            on Json__HeadNum _ => forward call std__json__parse_step(text, w.value, fuel - 1, stack + Json__PFrame(Json__PNumAcc(), Seq<Json__Doc>[], Seq<Json__Field>[], Seq<str>[], "", "", Json__Null(), Seq<Json__Field>[], Seq<str>[]))
            on Json__HeadBad _ => json.invalid_syntax("unexpected char")
            on Json__HeadEof _ => json.invalid_syntax("unexpected end")
        false => match stack[#stack - 1].tag
          on Json__PArrFirst _ => match call std__json__parse_head(text, w.value)
            on Ok h => match h.tag
              on Json__HeadBrace _ => forward call std__json__parse_step(text, w.value + 1, fuel - 1, stack + Json__PFrame(Json__PObjFirst(), Seq<Json__Doc>[], Seq<Json__Field>[], Seq<str>[], "", "", Json__Null(), Seq<Json__Field>[], Seq<str>[]))
              on Json__HeadBracket _ => forward call std__json__parse_step(text, w.value + 1, fuel - 1, stack + Json__PFrame(Json__PArrFirst(), Seq<Json__Doc>[], Seq<Json__Field>[], Seq<str>[], "", "", Json__Null(), Seq<Json__Field>[], Seq<str>[]))
              on Json__HeadStr _ => forward call std__json__parse_step(text, w.value + 1, fuel - 1, stack + Json__PFrame(Json__PStrVal(), Seq<Json__Doc>[], Seq<Json__Field>[], Seq<str>[], "", "", Json__Null(), Seq<Json__Field>[], Seq<str>[]))
              on Json__HeadLit _ => match call std__json__parse_literal(text, w.value)
                on Ok l => match call std__json__parse_pop(stack)
                  on Ok pf => forward call std__json__parse_step(text, l.next, fuel - 1, pf.frames + Json__PFrame(Json__PArrNext(), stack[#stack - 1].items + Json__Doc(l.val), Seq<Json__Field>[], Seq<str>[], "", "", Json__Null(), Seq<Json__Field>[], Seq<str>[]))
                on json.invalid_syntax e => forward e
              on Json__HeadNum _ => forward call std__json__parse_step(text, w.value, fuel - 1, stack + Json__PFrame(Json__PNumAcc(), Seq<Json__Doc>[], Seq<Json__Field>[], Seq<str>[], "", "", Json__Null(), Seq<Json__Field>[], Seq<str>[]))
              on Json__HeadBad _ => match text[w.value] == 93
                true => match call std__json__parse_pop(stack)
                  on Ok pf => match call std__json__parse_attach(pf.frames, Json__Arr(stack[#stack - 1].items))
                    on Ok a => forward call std__json__parse_step(text, w.value + 1, fuel - 1, a.frames)
                    on json.invalid_syntax e => forward e
                false => json.invalid_syntax("unexpected char")
              on Json__HeadEof _ => json.invalid_syntax("unexpected end")
          on Json__PArrVal _ => match call std__json__parse_head(text, w.value)
            on Ok h => match h.tag
              on Json__HeadBrace _ => forward call std__json__parse_step(text, w.value + 1, fuel - 1, stack + Json__PFrame(Json__PObjFirst(), Seq<Json__Doc>[], Seq<Json__Field>[], Seq<str>[], "", "", Json__Null(), Seq<Json__Field>[], Seq<str>[]))
              on Json__HeadBracket _ => forward call std__json__parse_step(text, w.value + 1, fuel - 1, stack + Json__PFrame(Json__PArrFirst(), Seq<Json__Doc>[], Seq<Json__Field>[], Seq<str>[], "", "", Json__Null(), Seq<Json__Field>[], Seq<str>[]))
              on Json__HeadStr _ => forward call std__json__parse_step(text, w.value + 1, fuel - 1, stack + Json__PFrame(Json__PStrVal(), Seq<Json__Doc>[], Seq<Json__Field>[], Seq<str>[], "", "", Json__Null(), Seq<Json__Field>[], Seq<str>[]))
