    on Ok d => Ok(d.value)

fn std__json__bool__decode_apply(value: Json__Value, dec: Fn<Json__Value, Bool__Value, [json.schema_mismatch]>) -> Bool__Value rev 1
  emits [json.schema_mismatch]
  tests
    b(Json__Bool(true), fnref std__json__bool__decode()) => Ok(true)
    mistype(Json__Str("a"), fnref std__json__bool__decode()) => json.schema_mismatch("want bool, got str")
