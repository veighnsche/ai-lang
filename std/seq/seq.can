// std/seq/seq.can — roadmap order 6: immutable ordered sequences
// over explicit element types. Construction is empty, singleton,
// append, and concat; observation is length, checked get, and
// half-open slice (same rule as text slicing). The language
// rejects bare-Seq returns, so every sequence result travels in
// Seq__Values<T> and every element in Seq__Item<T>. Higher-order
// traversal (map/filter/fold/all/any/find) takes total callbacks
// over data-only heads; every worker visits left to right, and
// all/any/find stop at the first decisive element. Sort and
// unique follow with ordering/equality contracts.

mod seq
  provides [std__seq__empty, std__seq__singleton, std__seq__length, std__seq__get, std__seq__append, std__seq__concat_from, std__seq__concat, std__seq__slice_from, std__seq__slice, std__seq__test_double, std__seq__test_length, std__seq__test_is_even, std__seq__test_nonempty, std__seq__test_add, std__seq__test_concat, std__seq__map_from, std__seq__map, std__seq__filter_from, std__seq__filter, std__seq__fold_from, std__seq__fold, std__seq__all_from, std__seq__all, std__seq__any_from, std__seq__any, std__seq__find_from, std__seq__find, Int__Value, Seq__Values, Seq__Item, Bool__Value, Seq__FoldStep]
  uses []
  emits [sequence.index_out_of_range, sequence.invalid_slice, sequence.not_found]

error sequence.index_out_of_range(index: int)
error sequence.invalid_slice(start: int, end: int)
error sequence.not_found()

type Int__Value rev 1 (
  value: int
)

type Seq__Values<T> rev 1 (
  values: Seq<T>
)

type Seq__Item<T> rev 1 (
  item: T
)

type Bool__Value rev 1 (
  value: bool
)

type Seq__FoldStep<A, T> rev 1 (
  acc: A
  elem: T
)

fn std__seq__empty<T>() -> Seq__Values<T> rev 1
  emits []
  tests
    ints<T=int>() => Ok(Seq<int>[])
    strs<T=str>() => Ok(Seq<str>[])
  Ok(Seq<T>[])

fn std__seq__singleton<T>(value: T) -> Seq__Values<T> rev 1
  emits []
  tests
    int<T=int>(5) => Ok(Seq<int>[5])
    str<T=str>("a") => Ok(Seq<str>["a"])
  Ok(Seq<T>[value])

fn std__seq__length<T>(values: Seq<T>) -> Int__Value rev 1
  emits []
  tests
    empty_int<T=int>(Seq<int>[]) => Ok(0)
    three_int<T=int>(Seq<int>[1, 2, 3]) => Ok(3)
    one_str<T=str>(Seq<str>["a"]) => Ok(1)
  Ok(#values)

fn std__seq__get<T>(values: Seq<T>, index: int) -> Seq__Item<T> rev 1
  emits [sequence.index_out_of_range]
  tests
    first<T=int>(Seq<int>[7, 8], 0) => Ok(7)
    last<T=int>(Seq<int>[7, 8], 1) => Ok(8)
    neg<T=int>(Seq<int>[7, 8], -1) => sequence.index_out_of_range(-1)
    past_end<T=int>(Seq<int>[7, 8], 2) => sequence.index_out_of_range(2)
    empty<T=int>(Seq<int>[], 0) => sequence.index_out_of_range(0)
    str<T=str>(Seq<str>["a", "b"], 1) => Ok("b")
    str_neg<T=str>(Seq<str>["a"], -1) => sequence.index_out_of_range(-1)
    str_past<T=str>(Seq<str>["a"], 1) => sequence.index_out_of_range(1)
  match index < 0, index >= #values
    true, _ => sequence.index_out_of_range(index)
    _, true => sequence.index_out_of_range(index)
    false, false => Ok(values[index])

fn std__seq__append<T>(values: Seq<T>, item: T) -> Seq__Values<T> rev 1
  emits []
  tests
    onto_empty<T=int>(Seq<int>[], 1) => Ok(Seq<int>[1])
    onto_two<T=int>(Seq<int>[1, 2], 3) => Ok(Seq<int>[1, 2, 3])
    str<T=str>(Seq<str>["a"], "b") => Ok(Seq<str>["a", "b"])
  Ok(values + item)

fn std__seq__concat_from<T>(left: Seq<T>, right: Seq<T>, pos: int, n: int, acc: Seq<T>) -> Seq__Values<T> rev 1
  decreases n
  emits []
  tests
    done<T=int>(Seq<int>[1], Seq<int>[2], 1, 0, Seq<int>[1, 2]) => Ok(Seq<int>[1, 2])
    over<T=int>(Seq<int>[1], Seq<int>[2], 5, 2, Seq<int>[1]) => Ok(Seq<int>[1])
    step<T=int>(Seq<int>[1], Seq<int>[2, 3], 0, 2, Seq<int>[1]) => Ok(Seq<int>[1, 2, 3])
    str<T=str>(Seq<str>["a"], Seq<str>["b"], 0, 1, Seq<str>["a"]) => Ok(Seq<str>["a", "b"])
    str_done<T=str>(Seq<str>["a"], Seq<str>["b"], 1, 0, Seq<str>["a", "b"]) => Ok(Seq<str>["a", "b"])
    str_over<T=str>(Seq<str>["a"], Seq<str>["b"], 5, 1, Seq<str>["a"]) => Ok(Seq<str>["a"])
  match n <= 0
    true => Ok(acc)
    false => match pos < #right
      true => match call std__seq__concat_from<T>(left, right, pos + 1, n - 1, acc + right[pos])
        on Ok r => Ok(r.values)
      false => Ok(acc)

fn std__seq__concat<T>(left: Seq<T>, right: Seq<T>) -> Seq__Values<T> rev 1
  emits []
  tests
    both_empty<T=int>(Seq<int>[], Seq<int>[]) => Ok(Seq<int>[])
    left_empty<T=int>(Seq<int>[], Seq<int>[1, 2]) => Ok(Seq<int>[1, 2])
    right_empty<T=int>(Seq<int>[1], Seq<int>[]) => Ok(Seq<int>[1])
    two_and_two<T=int>(Seq<int>[1, 2], Seq<int>[3, 4]) => Ok(Seq<int>[1, 2, 3, 4])
    str<T=str>(Seq<str>["a"], Seq<str>["b", "c"]) => Ok(Seq<str>["a", "b", "c"])
  match call std__seq__concat_from<T>(left, right, 0, #right, left)
    on Ok r => Ok(r.values)

fn std__seq__slice_from<T>(values: Seq<T>, end: int, pos: int, n: int, acc: Seq<T>) -> Seq__Values<T> rev 1
  decreases n
  emits []
  tests
    done<T=int>(Seq<int>[1, 2, 3], 3, 3, 0, Seq<int>[2, 3]) => Ok(Seq<int>[2, 3])
    over<T=int>(Seq<int>[1], 9, 5, 2, Seq<int>[]) => Ok(Seq<int>[])
    step<T=int>(Seq<int>[1, 2, 3], 2, 0, 2, Seq<int>[]) => Ok(Seq<int>[1, 2])
    str<T=str>(Seq<str>["a", "b"], 1, 0, 1, Seq<str>[]) => Ok(Seq<str>["a"])
    str_done<T=str>(Seq<str>["a", "b"], 2, 2, 0, Seq<str>["a", "b"]) => Ok(Seq<str>["a", "b"])
    str_over<T=str>(Seq<str>["a"], 9, 5, 1, Seq<str>[]) => Ok(Seq<str>[])
  match n <= 0
    true => Ok(acc)
    false => match pos < end, pos < #values
      true, true => match call std__seq__slice_from<T>(values, end, pos + 1, n - 1, acc + values[pos])
        on Ok r => Ok(r.values)
      _, _ => Ok(acc)

fn std__seq__slice<T>(values: Seq<T>, start: int, end: int) -> Seq__Values<T> rev 1
  emits [sequence.invalid_slice]
  tests
    whole<T=int>(Seq<int>[1, 2, 3], 0, 3) => Ok(Seq<int>[1, 2, 3])
    middle<T=int>(Seq<int>[1, 2, 3], 1, 2) => Ok(Seq<int>[2])
    empty_mid<T=int>(Seq<int>[1, 2, 3], 2, 2) => Ok(Seq<int>[])
    neg_start<T=int>(Seq<int>[1, 2, 3], -1, 2) => sequence.invalid_slice(-1, 2)
    reversed<T=int>(Seq<int>[1, 2, 3], 2, 1) => sequence.invalid_slice(2, 1)
    past_end<T=int>(Seq<int>[1, 2, 3], 0, 4) => sequence.invalid_slice(0, 4)
    str<T=str>(Seq<str>["a", "b", "c"], 0, 2) => Ok(Seq<str>["a", "b"])
    str_neg<T=str>(Seq<str>["a"], -1, 1) => sequence.invalid_slice(-1, 1)
    str_rev<T=str>(Seq<str>["a"], 1, 0) => sequence.invalid_slice(1, 0)
    str_past<T=str>(Seq<str>["a"], 0, 2) => sequence.invalid_slice(0, 2)
  match start < 0, start > end, end > #values
    true, _, _ => sequence.invalid_slice(start, end)
    _, true, _ => sequence.invalid_slice(start, end)
    _, _, true => sequence.invalid_slice(start, end)
    false, false, false => match call std__seq__slice_from<T>(values, end, start, end - start, Seq<T>[])
      on Ok r => Ok(r.values)

fn std__seq__test_double(x: int) -> Seq__Item<int> rev 1
  emits []
  tests
    two(3) => Ok(6)
  Ok(x + x)

fn std__seq__test_length(s: str) -> Seq__Item<int> rev 1
  emits []
  tests
    word("bb") => Ok(2)
  Ok(#s)

fn std__seq__test_is_even(x: int) -> Bool__Value rev 1
  emits []
  tests
    four(4) => Ok(true)
  Ok(x % 2 == 0)

fn std__seq__test_nonempty(s: str) -> Bool__Value rev 1
  emits []
  tests
    word("a") => Ok(true)
  Ok(#s > 0)

fn std__seq__test_add(step: Seq__FoldStep<int, int>) -> Seq__Item<int> rev 1
  emits []
  tests
    sum(Seq__FoldStep<int, int>(10, 3)) => Ok(13)
  Ok(step.acc + step.elem)

fn std__seq__test_concat(step: Seq__FoldStep<str, str>) -> Seq__Item<str> rev 1
  emits []
  tests
    cat(Seq__FoldStep<str, str>("s", "a")) => Ok("sa")
  Ok(step.acc + step.elem)

fn std__seq__map_from<T, U>(values: Seq<T>, f: Fn<T, Seq__Item<U>, []>, pos: int, n: int, acc: Seq<U>) -> Seq__Values<U> rev 1
  decreases n
  emits []
  tests
    done<T=int, U=int>(Seq<int>[1], fnref std__seq__test_double(), 1, 0, Seq<int>[2]) => Ok(Seq<int>[2])
    over<T=int, U=int>(Seq<int>[1], fnref std__seq__test_double(), 5, 2, Seq<int>[2]) => Ok(Seq<int>[2])
    step<T=int, U=int>(Seq<int>[1, 2], fnref std__seq__test_double(), 0, 2, Seq<int>[]) => Ok(Seq<int>[2, 4])
    str_step<T=str, U=int>(Seq<str>["a", "bb"], fnref std__seq__test_length(), 0, 2, Seq<int>[]) => Ok(Seq<int>[1, 2])
    str_over<T=str, U=int>(Seq<str>["a"], fnref std__seq__test_length(), 5, 1, Seq<int>[7]) => Ok(Seq<int>[7])
  match n <= 0
    true => Ok(acc)
    false => match pos < #values
      true => match invoke f with values[pos]
        on Ok r => match call std__seq__map_from<T, U>(values, f, pos + 1, n - 1, acc + r.item)
          on Ok s => Ok(s.values)
      false => Ok(acc)

fn std__seq__map<T, U>(values: Seq<T>, f: Fn<T, Seq__Item<U>, []>) -> Seq__Values<U> rev 1
  emits []
  tests
    empty<T=int, U=int>(Seq<int>[], fnref std__seq__test_double()) => Ok(Seq<int>[])
    two<T=int, U=int>(Seq<int>[1, 2], fnref std__seq__test_double()) => Ok(Seq<int>[2, 4])
    words<T=str, U=int>(Seq<str>["a", "bb"], fnref std__seq__test_length()) => Ok(Seq<int>[1, 2])
  match call std__seq__map_from<T, U>(values, f, 0, #values, Seq<U>[])
    on Ok r => Ok(r.values)

fn std__seq__filter_from<T>(values: Seq<T>, p: Fn<T, Bool__Value, []>, pos: int, n: int, acc: Seq<T>) -> Seq__Values<T> rev 1
  decreases n
  emits []
  tests
    done<T=int>(Seq<int>[1], fnref std__seq__test_is_even(), 1, 0, Seq<int>[2]) => Ok(Seq<int>[2])
    over<T=int>(Seq<int>[1], fnref std__seq__test_is_even(), 5, 2, Seq<int>[2]) => Ok(Seq<int>[2])
    keep<T=int>(Seq<int>[1, 2], fnref std__seq__test_is_even(), 0, 2, Seq<int>[]) => Ok(Seq<int>[2])
    drop<T=int>(Seq<int>[1, 3], fnref std__seq__test_is_even(), 0, 2, Seq<int>[]) => Ok(Seq<int>[])
    str_keep<T=str>(Seq<str>["a"], fnref std__seq__test_nonempty(), 0, 1, Seq<str>[]) => Ok(Seq<str>["a"])
    str_drop<T=str>(Seq<str>[""], fnref std__seq__test_nonempty(), 0, 1, Seq<str>[]) => Ok(Seq<str>[])
    str_over<T=str>(Seq<str>["a"], fnref std__seq__test_nonempty(), 5, 1, Seq<str>["q"]) => Ok(Seq<str>["q"])
  match n <= 0
    true => Ok(acc)
    false => match pos < #values
      true => match invoke p with values[pos]
        on Ok r => match r.value
          true => match call std__seq__filter_from<T>(values, p, pos + 1, n - 1, acc + values[pos])
            on Ok s => Ok(s.values)
          false => match call std__seq__filter_from<T>(values, p, pos + 1, n - 1, acc)
            on Ok s => Ok(s.values)
      false => Ok(acc)

fn std__seq__filter<T>(values: Seq<T>, p: Fn<T, Bool__Value, []>) -> Seq__Values<T> rev 1
  emits []
  tests
    empty<T=int>(Seq<int>[], fnref std__seq__test_is_even()) => Ok(Seq<int>[])
    mixed<T=int>(Seq<int>[1, 2, 3], fnref std__seq__test_is_even()) => Ok(Seq<int>[2])
    words<T=str>(Seq<str>["a", "", "bb"], fnref std__seq__test_nonempty()) => Ok(Seq<str>["a", "bb"])
  match call std__seq__filter_from<T>(values, p, 0, #values, Seq<T>[])
    on Ok r => Ok(r.values)

fn std__seq__fold_from<T, A>(values: Seq<T>, step: Fn<Seq__FoldStep<A, T>, Seq__Item<A>, []>, pos: int, n: int, acc: A) -> Seq__Item<A> rev 1
  decreases n
  emits []
  tests
    done<T=int, A=int>(Seq<int>[1], fnref std__seq__test_add(), 1, 0, 5) => Ok(5)
    over<T=int, A=int>(Seq<int>[1], fnref std__seq__test_add(), 5, 2, 5) => Ok(5)
    step<T=int, A=int>(Seq<int>[1, 2], fnref std__seq__test_add(), 0, 2, 10) => Ok(13)
    str_step<T=str, A=str>(Seq<str>["a", "b"], fnref std__seq__test_concat(), 0, 2, "s") => Ok("sab")
    str_over<T=str, A=str>(Seq<str>["a"], fnref std__seq__test_concat(), 5, 1, "s") => Ok("s")
  match n <= 0
    true => Ok(acc)
    false => match pos < #values
      true => match invoke step with Seq__FoldStep<A, T>(acc, values[pos])
        on Ok r => match call std__seq__fold_from<T, A>(values, step, pos + 1, n - 1, r.item)
          on Ok s => Ok(s.item)
      false => Ok(acc)

fn std__seq__fold<T, A>(values: Seq<T>, initial: A, step: Fn<Seq__FoldStep<A, T>, Seq__Item<A>, []>) -> Seq__Item<A> rev 1
  emits []
  tests
    empty<T=int, A=int>(Seq<int>[], 7, fnref std__seq__test_add()) => Ok(7)
    sum<T=int, A=int>(Seq<int>[1, 2], 10, fnref std__seq__test_add()) => Ok(13)
    words<T=str, A=str>(Seq<str>["a", "b"], "s", fnref std__seq__test_concat()) => Ok("sab")
  match call std__seq__fold_from<T, A>(values, step, 0, #values, initial)
    on Ok r => Ok(r.item)

fn std__seq__all_from<T>(values: Seq<T>, p: Fn<T, Bool__Value, []>, pos: int, n: int) -> Bool__Value rev 1
  decreases n
  emits []
  tests
    done<T=int>(Seq<int>[1], fnref std__seq__test_is_even(), 1, 0) => Ok(true)
    over<T=int>(Seq<int>[1], fnref std__seq__test_is_even(), 5, 2) => Ok(true)
    holds<T=int>(Seq<int>[2, 4], fnref std__seq__test_is_even(), 0, 2) => Ok(true)
    short<T=int>(Seq<int>[2, 3], fnref std__seq__test_is_even(), 0, 2) => Ok(false)
    str_holds<T=str>(Seq<str>["a", "b"], fnref std__seq__test_nonempty(), 0, 2) => Ok(true)
    str_short<T=str>(Seq<str>["a", ""], fnref std__seq__test_nonempty(), 0, 2) => Ok(false)
    str_over<T=str>(Seq<str>["a"], fnref std__seq__test_nonempty(), 5, 1) => Ok(true)
  match n <= 0
    true => Ok(true)
    false => match pos < #values
      true => match invoke p with values[pos]
        on Ok r => match r.value
          true => match call std__seq__all_from<T>(values, p, pos + 1, n - 1)
            on Ok s => Ok(s.value)
          false => Ok(false)
      false => Ok(true)

fn std__seq__all<T>(values: Seq<T>, p: Fn<T, Bool__Value, []>) -> Bool__Value rev 1
  emits []
  tests
    empty<T=int>(Seq<int>[], fnref std__seq__test_is_even()) => Ok(true)
    holds<T=int>(Seq<int>[2, 4], fnref std__seq__test_is_even()) => Ok(true)
    short<T=int>(Seq<int>[2, 3], fnref std__seq__test_is_even()) => Ok(false)
  match call std__seq__all_from<T>(values, p, 0, #values)
    on Ok r => Ok(r.value)

fn std__seq__any_from<T>(values: Seq<T>, p: Fn<T, Bool__Value, []>, pos: int, n: int) -> Bool__Value rev 1
  decreases n
  emits []
  tests
    done<T=int>(Seq<int>[1], fnref std__seq__test_is_even(), 1, 0) => Ok(false)
    over<T=int>(Seq<int>[1], fnref std__seq__test_is_even(), 5, 2) => Ok(false)
    hit<T=int>(Seq<int>[1, 2], fnref std__seq__test_is_even(), 0, 2) => Ok(true)
    miss<T=int>(Seq<int>[1, 3], fnref std__seq__test_is_even(), 0, 2) => Ok(false)
    str_hit<T=str>(Seq<str>["", "a"], fnref std__seq__test_nonempty(), 0, 2) => Ok(true)
    str_miss<T=str>(Seq<str>[""], fnref std__seq__test_nonempty(), 0, 1) => Ok(false)
    str_over<T=str>(Seq<str>["a"], fnref std__seq__test_nonempty(), 5, 1) => Ok(false)
  match n <= 0
    true => Ok(false)
    false => match pos < #values
      true => match invoke p with values[pos]
        on Ok r => match r.value
          true => Ok(true)
          false => match call std__seq__any_from<T>(values, p, pos + 1, n - 1)
            on Ok s => Ok(s.value)
      false => Ok(false)

fn std__seq__any<T>(values: Seq<T>, p: Fn<T, Bool__Value, []>) -> Bool__Value rev 1
  emits []
  tests
    empty<T=int>(Seq<int>[], fnref std__seq__test_is_even()) => Ok(false)
    hit<T=int>(Seq<int>[1, 2], fnref std__seq__test_is_even()) => Ok(true)
    miss<T=int>(Seq<int>[1, 3], fnref std__seq__test_is_even()) => Ok(false)
  match call std__seq__any_from<T>(values, p, 0, #values)
    on Ok r => Ok(r.value)

fn std__seq__find_from<T>(values: Seq<T>, p: Fn<T, Bool__Value, []>, pos: int, n: int) -> Seq__Item<T> rev 1
  decreases n
  emits [sequence.not_found]
  tests
    done<T=int>(Seq<int>[1], fnref std__seq__test_is_even(), 1, 0) => sequence.not_found()
    over<T=int>(Seq<int>[1], fnref std__seq__test_is_even(), 5, 2) => sequence.not_found()
    found<T=int>(Seq<int>[1, 2], fnref std__seq__test_is_even(), 0, 2) => Ok(2)
    miss<T=int>(Seq<int>[1, 3], fnref std__seq__test_is_even(), 0, 2) => sequence.not_found()
    str_found<T=str>(Seq<str>["", "a"], fnref std__seq__test_nonempty(), 0, 2) => Ok("a")
    str_miss<T=str>(Seq<str>[""], fnref std__seq__test_nonempty(), 0, 1) => sequence.not_found()
    str_over<T=str>(Seq<str>["a"], fnref std__seq__test_nonempty(), 5, 1) => sequence.not_found()
  match n <= 0
    true => sequence.not_found()
    false => match pos < #values
      true => match invoke p with values[pos]
        on Ok r => match r.value
          true => Ok(values[pos])
          false => match call std__seq__find_from<T>(values, p, pos + 1, n - 1)
            on Ok s => Ok(s.item)
            on sequence.not_found _ => sequence.not_found()
      false => sequence.not_found()

fn std__seq__find<T>(values: Seq<T>, p: Fn<T, Bool__Value, []>) -> Seq__Item<T> rev 1
  emits [sequence.not_found]
  tests
    hit<T=int>(Seq<int>[1, 2], fnref std__seq__test_is_even()) => Ok(2)
    miss<T=int>(Seq<int>[1, 3], fnref std__seq__test_is_even()) => sequence.not_found()
    str_hit<T=str>(Seq<str>["", "a"], fnref std__seq__test_nonempty()) => Ok("a")
  match call std__seq__find_from<T>(values, p, 0, #values)
    on Ok r => Ok(r.item)
    on sequence.not_found _ => sequence.not_found()
