// std/ascii/ascii.ail — row 1 of the a78 gap closures: named ASCII
// scalar bounds shared across stdlib. URL scheme tokens, authority
// checks, and every future ASCII classifier compare against these
// names instead of magic code points, so bounds stay greppable and
// a bound change is one pinned rev bump, never a hunt.
// Z is uppercase (90); lowercase z needs marking and reads SMALL_Z.
// The ASCII predicates (is_digit, is_alpha, is_alnum) live beside
// these constants and arrive with the boolean-operator slice, which
// needs them for its probe row.

mod ascii
  provides [std__ascii__A, std__ascii__AT, std__ascii__BACKTICK, std__ascii__COLON, std__ascii__DOT, std__ascii__HASH, std__ascii__MINUS, std__ascii__NINE, std__ascii__PLUS, std__ascii__QUESTION, std__ascii__SLASH, std__ascii__SMALL_A, std__ascii__SMALL_Z, std__ascii__Z, std__ascii__ZERO, std__ascii__is_digit, std__ascii__is_alpha, std__ascii__is_alnum]
  uses [Bool__Value@1]
  emits []

const std__ascii__HASH: int rev 1 = 35

const std__ascii__PLUS: int rev 1 = 43

const std__ascii__MINUS: int rev 1 = 45

const std__ascii__DOT: int rev 1 = 46

const std__ascii__SLASH: int rev 1 = 47

const std__ascii__ZERO: int rev 1 = 48

const std__ascii__NINE: int rev 1 = 57

const std__ascii__COLON: int rev 1 = 58

const std__ascii__QUESTION: int rev 1 = 63

const std__ascii__AT: int rev 1 = 64

const std__ascii__A: int rev 1 = 65

const std__ascii__Z: int rev 1 = 90

const std__ascii__BACKTICK: int rev 1 = 96

const std__ascii__SMALL_A: int rev 1 = 97

const std__ascii__SMALL_Z: int rev 1 = 122

fn std__ascii__is_digit(code: int) -> Bool__Value rev 1
  emits []
  tests
    digit_zero(code = 48) => Ok(value = true)
    digit_five(code = 53) => Ok(value = true)
    digit_nine(code = 57) => Ok(value = true)
    below_digits(code = 47) => Ok(value = false)
    above_digits(code = 58) => Ok(value = false)
=
  Ok(value = (code >= std__ascii__ZERO) and (code <= std__ascii__NINE))

fn std__ascii__is_alpha(code: int) -> Bool__Value rev 1
  emits []
  tests
    upper_a(code = 65) => Ok(value = true)
    upper_z(code = 90) => Ok(value = true)
    lower_a(code = 97) => Ok(value = true)
    lower_z(code = 122) => Ok(value = true)
    below_upper(code = 64) => Ok(value = false)
    above_upper(code = 91) => Ok(value = false)
    below_lower(code = 96) => Ok(value = false)
    above_lower(code = 123) => Ok(value = false)
=
  Ok(value = ((code >= std__ascii__SMALL_A) and (code <= std__ascii__SMALL_Z)) or ((code >= std__ascii__A) and (code <= std__ascii__Z)))

fn std__ascii__is_alnum(code: int) -> Bool__Value rev 1
  emits []
  tests
    alnum_digit(code = 53) => Ok(value = true)
    alnum_lower(code = 109) => Ok(value = true)
    alnum_upper(code = 77) => Ok(value = true)
    alnum_underscore(code = 95) => Ok(value = false)
    alnum_space(code = 32) => Ok(value = false)
=
  match call std__ascii__is_alpha(code)
    on Ok a => match call std__ascii__is_digit(code)
      on Ok d => Ok(value = a.value or d.value)
