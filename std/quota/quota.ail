// std/quota/quota.ail — row 1 of the standard-library program.
// Monomorphic scalar validation plus a quota counter that reuses it.
// Every helper here is a same-file local, so every call below executes
// its body. Cross-file reuse stays scripted until the Order 0 linkage
// amendment lands, which is why the validators live in this file
// instead of being imported. See docs/v13-stdlib.md.
// A validator returns the accepted value or a producer-owned typed
// error. It never clamps, trims, or supplies a default.

mod quota
  provides [quota__consume, quota__usage, std__validate__require, std__validate__int_range, std__validate__int_positive, std__validate__int_nonnegative, std__validate__dec_range, std__validate__dec_positive, std__validate__dec_nonnegative, std__validate__str_nonempty, std__validate__str_length, std__validate__exclusive_pair, Quota__Usage, Validate__Pass, Int__Value, Dec__Value, Str__Value]
  uses []
  emits [validation.failed, validation.invalid_bounds, validation.out_of_range, validation.not_positive, validation.negative_value, validation.dec_invalid_bounds, validation.dec_out_of_range, validation.dec_not_positive, validation.dec_negative_value, validation.invalid_length, validation.empty_value, validation.exclusive_choice]

state Quota__used: int = 0

error validation.failed(field: str, rule: str)
error validation.invalid_bounds(lower: int, upper: int)
error validation.out_of_range(value: int, lower: int, upper: int)
error validation.not_positive(value: int)
error validation.negative_value(value: int)
error validation.dec_invalid_bounds(lower: dec, upper: dec)
error validation.dec_out_of_range(value: dec, lower: dec, upper: dec)
error validation.dec_not_positive(value: dec)
error validation.dec_negative_value(value: dec)
error validation.invalid_length(value: str, minimum: int, maximum: int)
error validation.empty_value(value: str)
error validation.exclusive_choice()

type Quota__Usage rev 1 (
  used: int
  remaining: int
)

type Validate__Pass rev 1 (
)

type Int__Value rev 1 (
  value: int
)

type Dec__Value rev 1 (
  value: dec
)

type Str__Value rev 1 (
  value: str
)

fn std__validate__require(condition: bool, field: str, rule: str) -> Validate__Pass rev 1
  emits [validation.failed]
  tests
    pass(condition = true, field = "quota", rule = "nonnegative") => Ok()
    fail(condition = false, field = "quota", rule = "nonnegative") => validation.failed(field = "quota", rule = "nonnegative")
=
  match condition
    true => Ok()
    false => validation.failed(field = field, rule = rule)

fn std__validate__int_range(value: int, lower: int, upper: int) -> Int__Value rev 1
  emits [validation.invalid_bounds, validation.out_of_range]
  tests
    inside(value = 5, lower = 0, upper = 10) => Ok(value = 5)
    at_lower(value = 0, lower = 0, upper = 10) => Ok(value = 0)
    at_upper(value = 10, lower = 0, upper = 10) => Ok(value = 10)
    below(value = -1, lower = 0, upper = 10) => validation.out_of_range(value = -1, lower = 0, upper = 10)
    above(value = 11, lower = 0, upper = 10) => validation.out_of_range(value = 11, lower = 0, upper = 10)
    bad_bounds(value = 5, lower = 10, upper = 0) => validation.invalid_bounds(lower = 10, upper = 0)
=
  match lower <= upper
    true => match value >= lower
      true => match value <= upper
        true => Ok(value = value)
        false => validation.out_of_range(value = value, lower = lower, upper = upper)
      false => validation.out_of_range(value = value, lower = lower, upper = upper)
    false => validation.invalid_bounds(lower = lower, upper = upper)

fn std__validate__int_nonnegative(value: int) -> Int__Value rev 1
  emits [validation.negative_value]
  tests
    zero(value = 0) => Ok(value = 0)
    positive(value = 4) => Ok(value = 4)
    negative(value = -1) => validation.negative_value(value = -1)
=
  match value >= 0
    true => Ok(value = value)
    false => validation.negative_value(value = value)

fn std__validate__int_positive(value: int) -> Int__Value rev 1
  emits [validation.not_positive]
  tests
    positive(value = 3) => Ok(value = 3)
    zero(value = 0) => validation.not_positive(value = 0)
    negative(value = -2) => validation.not_positive(value = -2)
=
  match value > 0
    true => Ok(value = value)
    false => validation.not_positive(value = value)

fn std__validate__dec_range(value: dec, lower: dec, upper: dec) -> Dec__Value rev 1
  emits [validation.dec_invalid_bounds, validation.dec_out_of_range]
  tests
    inside(value = d"5.0", lower = d"0.0", upper = d"10.0") => Ok(value = d"5.0")
    at_lower(value = d"0.0", lower = d"0.0", upper = d"10.0") => Ok(value = d"0.0")
    at_upper(value = d"10.0", lower = d"0.0", upper = d"10.0") => Ok(value = d"10.0")
    below(value = d"-0.5", lower = d"0.0", upper = d"10.0") => validation.dec_out_of_range(value = d"-0.5", lower = d"0.0", upper = d"10.0")
    above(value = d"10.5", lower = d"0.0", upper = d"10.0") => validation.dec_out_of_range(value = d"10.5", lower = d"0.0", upper = d"10.0")
    bad_bounds(value = d"5.0", lower = d"10.0", upper = d"0.0") => validation.dec_invalid_bounds(lower = d"10.0", upper = d"0.0")
=
  match lower <= upper
    true => match value >= lower
      true => match value <= upper
        true => Ok(value = value)
        false => validation.dec_out_of_range(value = value, lower = lower, upper = upper)
      false => validation.dec_out_of_range(value = value, lower = lower, upper = upper)
    false => validation.dec_invalid_bounds(lower = lower, upper = upper)

fn std__validate__dec_positive(value: dec) -> Dec__Value rev 1
  emits [validation.dec_not_positive]
  tests
    positive(value = d"0.5") => Ok(value = d"0.5")
    zero(value = d"0.0") => validation.dec_not_positive(value = d"0.0")
    negative(value = d"-2.0") => validation.dec_not_positive(value = d"-2.0")
=
  match value > d"0.0"
    true => Ok(value = value)
    false => validation.dec_not_positive(value = value)

fn std__validate__dec_nonnegative(value: dec) -> Dec__Value rev 1
  emits [validation.dec_negative_value]
  tests
    zero(value = d"0.0") => Ok(value = d"0.0")
    positive(value = d"4.0") => Ok(value = d"4.0")
    negative(value = d"-1.0") => validation.dec_negative_value(value = d"-1.0")
=
  match value >= d"0.0"
    true => Ok(value = value)
    false => validation.dec_negative_value(value = value)

fn std__validate__str_length(value: str, minimum: int, maximum: int) -> Str__Value rev 1
  emits [validation.invalid_bounds, validation.invalid_length]
  tests
    length_ok(value = "abc", minimum = 1, maximum = 5) => Ok(value = "abc")
    length_at_min(value = "a", minimum = 1, maximum = 5) => Ok(value = "a")
    length_at_max(value = "abcde", minimum = 1, maximum = 5) => Ok(value = "abcde")
    length_short(value = "ab", minimum = 3, maximum = 5) => validation.invalid_length(value = "ab", minimum = 3, maximum = 5)
    length_long(value = "abcdef", minimum = 1, maximum = 5) => validation.invalid_length(value = "abcdef", minimum = 1, maximum = 5)
    length_bad_bounds(value = "abc", minimum = 5, maximum = 1) => validation.invalid_bounds(lower = 5, upper = 1)
=
  match minimum <= maximum
    true => match #value >= minimum
      true => match #value <= maximum
        true => Ok(value = value)
        false => validation.invalid_length(value = value, minimum = minimum, maximum = maximum)
      false => validation.invalid_length(value = value, minimum = minimum, maximum = maximum)
    false => validation.invalid_bounds(lower = minimum, upper = maximum)

fn std__validate__str_nonempty(value: str) -> Str__Value rev 1
  emits [validation.empty_value]
  tests
    nonempty(value = "u_01") => Ok(value = "u_01")
    empty(value = "") => validation.empty_value(value = "")
=
  match value
    "" => validation.empty_value(value = value)
    _ => Ok(value = value)

fn std__validate__exclusive_pair(left: bool, right: bool) -> Validate__Pass rev 1
  emits [validation.exclusive_choice]
  tests
    neither(left = false, right = false) => validation.exclusive_choice()
    left_only(left = true, right = false) => Ok()
    right_only(left = false, right = true) => Ok()
    both(left = true, right = true) => validation.exclusive_choice()
=
  match left
    true => match right
      true => validation.exclusive_choice()
      false => Ok()
    false => match right
      true => Ok()
      false => validation.exclusive_choice()

fn quota__consume(amount: int, quota: int) -> Quota__Usage rev 1
  effects [Quota__used.read, Quota__used.write]
  emits [validation.negative_value, validation.invalid_bounds, validation.out_of_range]
  tests
    first(amount = 3, quota = 10) => Ok(used = 3, remaining = 7)
    exact(amount = 10, quota = 10) => Ok(used = 10, remaining = 0)
    over(amount = 11, quota = 10) => validation.out_of_range(value = 11, lower = 0, upper = 10)
    negative(amount = -2, quota = 10) => validation.negative_value(value = -2)
    bad_quota(amount = 1, quota = -1) => validation.invalid_bounds(lower = 0, upper = -1)
=
  match call state__get(Quota__used)
    on Ok s => match call std__validate__int_nonnegative(amount)
      on validation.negative_value _ => validation.negative_value(value = amount)
      on Ok _ => match call std__validate__int_range(s.value + amount, 0, quota)
        on validation.invalid_bounds _ => validation.invalid_bounds(lower = 0, upper = quota)
        on validation.out_of_range _ => validation.out_of_range(value = s.value + amount, lower = 0, upper = quota)
        on Ok checked => match call state__put(Quota__used, checked.value)
          on Ok _ => Ok(used = checked.value, remaining = quota - checked.value)

fn quota__usage(quota: int) -> Quota__Usage rev 1
  effects [Quota__used.read]
  emits [validation.negative_value]
  tests
    fresh(quota = 10) => Ok(used = 0, remaining = 10)
    negative_quota(quota = -1) => validation.negative_value(value = -1)
=
  match call state__get(Quota__used)
    on Ok s => match call std__validate__int_nonnegative(quota)
      on validation.negative_value _ => validation.negative_value(value = quota)
      on Ok _ => Ok(used = s.value, remaining = quota - s.value)

// Shape notes, kept with the program, not in a second file.
// 1. Validators take values and return them. Callers keep ownership of
//    the policy: quota__consume checks the exact new total, so a stored
//    total can never drift past quota without failing closed.
// 2. Every test starts from init, so first and exact agree on nothing:
//    each row builds used from zero, which the tables show directly.
// 3. Bounds are inclusive and reversed bounds fail. No silent swap.
