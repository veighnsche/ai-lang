// std/quota/quota.can — row 1 of the standard-library program.
// Monomorphic scalar validation plus a quota counter that reuses it.
// Every helper here is a same-file local, so every call below executes
// its body. Cross-file reuse stays scripted until the Order 0 linkage
// amendment lands, which is why the validators live in this file
// instead of being imported. See docs/a13-stdlib.md.
// A validator returns the accepted value or a producer-owned typed
// error. It never clamps, trims, or supplies a default.

mod quota
  provides [quota__consume, quota__usage, std__validate__require, std__validate__int_range, std__validate__int_positive, std__validate__int_nonnegative, std__validate__dec_range, std__validate__dec_positive, std__validate__dec_nonnegative, std__validate__str_nonempty, std__validate__str_length, std__validate__exclusive_pair, std__validate__str_one_of_from, std__validate__str_one_of, std__validate__length_check, std__validate__range_check, std__validate__membership_check, std__validate__all_from, std__validate__all_push, std__validate__all, Validate__Length, Validate__Range, Validate__Membership, Validate__Outcome, Validate__Failure, Validate__Failures, Validate__Report, quota__request__validate, quota__request__admit, quota__envelope__validate, Quota__Usage, Validate__Pass, Int__Value, Dec__Value, Str__Value, Quota__Request, Quota__RequestSchema, Quota__RequestValue, Quota__Envelope, Quota__EnvelopeValue]
  uses [std__convert__int_to_str@1]
  emits [validation.failed, validation.invalid_bounds, validation.out_of_range, validation.not_positive, validation.negative_value, validation.dec_invalid_bounds, validation.dec_out_of_range, validation.dec_not_positive, validation.dec_negative_value, validation.invalid_length, validation.empty_value, validation.exclusive_choice, validation.not_allowed, validation.schema_violation]

state Quota__used: int = 0

error validation.failed(field: str, rule: str)
error validation.invalid_bounds(lower: int, upper: int)
error validation.out_of_range(value: int, lower: int, upper: int)
error validation.not_positive(value: int)
error validation.negative_value(value: int)
error validation.dec_invalid_bounds(lower: dec, upper: dec)
error validation.dec_out_of_range(value: dec, lower: dec, upper: dec)
error validation.dec_not_positive(value: dec)
error validation.dec_negative_value(value: dec)
error validation.invalid_length(value: str, minimum: int, maximum: int)
error validation.empty_value(value: str)
error validation.exclusive_choice()
error validation.not_allowed(value: str)
error validation.schema_violation(path: str, rule: str, value: str)

type Quota__Usage rev 1 (
  used: int
  remaining: int
)

type Validate__Pass rev 1 (
)

type Int__Value rev 1 (
  value: int
)

type Dec__Value rev 1 (
  value: dec
)

type Str__Value rev 1 (
  value: str
)

// S2 closed constraint descriptors (docs/a91-schema-s2-design.md):
// one revisioned record per exhibited constraint kind. path is the
// frozen data path on violation; tag builds the policy-token infix
// ("schema." + tag + "_bounds"). Both are plain strings pinned per
// consumer by decision tables, never validated against a universe.
type Validate__Length rev 1 (
  path: str
  tag: str
  minimum: int
  maximum: int
)

type Validate__Range rev 1 (
  path: str
  tag: str
  lower: int
  upper: int
)

type Validate__Membership rev 1 (
  path: str
  allowed: Seq<str>
)

// validate__all evidence records (roadmap 1.5): outcomes are data,
// not values — each check is an already-evaluated verdict triple.
// _all folds them into a report, failures in input order.
type Validate__Outcome rev 1 (
  passed: bool
  path: str
  rule: str
  detail: str
)

type Validate__Failure rev 1 (
  path: str
  rule: str
  detail: str
)

type Validate__Report rev 1 (
  passed: bool
  failures: Seq<Validate__Failure>
)

// Accumulator carrier: the grammar has no seq[i].field, so the
// indexed outcome travels whole into _push and its fields are
// read there; the folded failures return wrapped.
type Validate__Failures rev 1 (
  values: Seq<Validate__Failure>
)

type Quota__Request rev 1 (
  label: str
  amount: int
  mode: str
)

type Quota__RequestSchema rev 1 (
  label_minimum: int
  label_maximum: int
  amount_lower: int
  amount_upper: int
  allowed_modes: Seq<str>
)

type Quota__RequestValue rev 1 (
  value: Quota__Request
)

type Quota__Envelope rev 1 (
  request: Quota__Request
)

type Quota__EnvelopeValue rev 1 (
  value: Quota__Envelope
)

fn std__validate__require(condition: bool, field: str, rule: str) -> Validate__Pass rev 1
  emits [validation.failed]
  tests
    pass(true, "quota", "nonnegative") => Ok()
    fail(false, "quota", "nonnegative") => validation.failed("quota", "nonnegative")
  match condition
    true => Ok()
    false => validation.failed(field, rule)

fn std__validate__int_range(value: int, lower: int, upper: int) -> Int__Value rev 1
  emits [validation.invalid_bounds, validation.out_of_range]
  tests
    inside(5, 0, 10) => Ok(5)
    at_lower(0, 0, 10) => Ok(0)
    at_upper(10, 0, 10) => Ok(10)
    below(-1, 0, 10) => validation.out_of_range(-1, 0, 10)
    above(11, 0, 10) => validation.out_of_range(11, 0, 10)
    bad_bounds(5, 10, 0) => validation.invalid_bounds(10, 0)
  match lower <= upper, value >= lower, value <= upper
    true, true, true => Ok(value)
    true, true, false => validation.out_of_range(value, lower, upper)
    true, false, _ => validation.out_of_range(value, lower, upper)
    false, _, _ => validation.invalid_bounds(lower, upper)

fn std__validate__int_nonnegative(value: int) -> Int__Value rev 1
  emits [validation.negative_value]
  tests
    zero(0) => Ok(0)
    positive(4) => Ok(4)
    negative(-1) => validation.negative_value(-1)
  match value >= 0
    true => Ok(value)
    false => validation.negative_value(value)

fn std__validate__int_positive(value: int) -> Int__Value rev 1
  emits [validation.not_positive]
  tests
    positive(3) => Ok(3)
    zero(0) => validation.not_positive(0)
    negative(-2) => validation.not_positive(-2)
  match value > 0
    true => Ok(value)
    false => validation.not_positive(value)

fn std__validate__dec_range(value: dec, lower: dec, upper: dec) -> Dec__Value rev 1
  emits [validation.dec_invalid_bounds, validation.dec_out_of_range]
  tests
    inside(d"5.0", d"0.0", d"10.0") => Ok(d"5.0")
    at_lower(d"0.0", d"0.0", d"10.0") => Ok(d"0.0")
    at_upper(d"10.0", d"0.0", d"10.0") => Ok(d"10.0")
    below(d"-0.5", d"0.0", d"10.0") => validation.dec_out_of_range(d"-0.5", d"0.0", d"10.0")
    above(d"10.5", d"0.0", d"10.0") => validation.dec_out_of_range(d"10.5", d"0.0", d"10.0")
    bad_bounds(d"5.0", d"10.0", d"0.0") => validation.dec_invalid_bounds(d"10.0", d"0.0")
  match lower <= upper, value >= lower, value <= upper
    true, true, true => Ok(value)
    true, true, false => validation.dec_out_of_range(value, lower, upper)
    true, false, _ => validation.dec_out_of_range(value, lower, upper)
    false, _, _ => validation.dec_invalid_bounds(lower, upper)

fn std__validate__dec_positive(value: dec) -> Dec__Value rev 1
  emits [validation.dec_not_positive]
  tests
    positive(d"0.5") => Ok(d"0.5")
    zero(d"0.0") => validation.dec_not_positive(d"0.0")
    negative(d"-2.0") => validation.dec_not_positive(d"-2.0")
  match value > d"0.0"
    true => Ok(value)
    false => validation.dec_not_positive(value)

fn std__validate__dec_nonnegative(value: dec) -> Dec__Value rev 1
  emits [validation.dec_negative_value]
  tests
    zero(d"0.0") => Ok(d"0.0")
    positive(d"4.0") => Ok(d"4.0")
    negative(d"-1.0") => validation.dec_negative_value(d"-1.0")
  match value >= d"0.0"
    true => Ok(value)
    false => validation.dec_negative_value(value)

fn std__validate__str_length(value: str, minimum: int, maximum: int) -> Str__Value rev 1
  emits [validation.invalid_bounds, validation.invalid_length]
  tests
    length_ok("abc", 1, 5) => Ok("abc")
    length_at_min("a", 1, 5) => Ok("a")
    length_at_max("abcde", 1, 5) => Ok("abcde")
    length_short("ab", 3, 5) => validation.invalid_length("ab", 3, 5)
    length_long("abcdef", 1, 5) => validation.invalid_length("abcdef", 1, 5)
    length_bad_bounds("abc", 5, 1) => validation.invalid_bounds(5, 1)
  match minimum <= maximum, #value >= minimum, #value <= maximum
    true, true, true => Ok(value)
    true, true, false => validation.invalid_length(value, minimum, maximum)
    true, false, _ => validation.invalid_length(value, minimum, maximum)
    false, _, _ => validation.invalid_bounds(minimum, maximum)

fn std__validate__str_nonempty(value: str) -> Str__Value rev 1
  emits [validation.empty_value]
  tests
    nonempty("u_01") => Ok("u_01")
    empty("") => validation.empty_value("")
  match value
    "" => validation.empty_value(value)
    _ => Ok(value)

fn std__validate__exclusive_pair(left: bool, right: bool) -> Validate__Pass rev 1
  emits [validation.exclusive_choice]
  tests
    neither(false, false) => validation.exclusive_choice()
    left_only(true, false) => Ok()
    right_only(false, true) => Ok()
    both(true, true) => validation.exclusive_choice()
  match left, right
    true, true => validation.exclusive_choice()
    true, false => Ok()
    false, true => Ok()
    false, false => validation.exclusive_choice()

fn std__validate__str_one_of_from(value: str, allowed: Seq<str>, pos: int, n: int) -> Str__Value rev 1
  decreases n
  emits [validation.not_allowed]
  tests
    exhausted("z", Seq<str>["a", "b"], 0, 0) => validation.not_allowed("z")
    over("a", Seq<str>["a"], 5, 2) => validation.not_allowed("a")
    immediate("a", Seq<str>["a", "b"], 0, 2) => Ok("a")
    later("b", Seq<str>["a", "b"], 0, 2) => Ok("b")
    miss("z", Seq<str>["a", "b"], 0, 2) => validation.not_allowed("z")
  match n <= 0
    true => validation.not_allowed(value)
    false => match pos < #allowed
      true => match allowed[pos] == value
        true => Ok(value)
        false => match call std__validate__str_one_of_from(value, allowed, pos + 1, n - 1)
          on validation.not_allowed e => forward e
          on Ok r => Ok(r.value)
      false => validation.not_allowed(value)

fn std__validate__str_one_of(value: str, allowed: Seq<str>) -> Str__Value rev 1
  emits [validation.not_allowed]
  tests
    empty_allowed("a", Seq<str>[]) => validation.not_allowed("a")
    singleton_hit("a", Seq<str>["a"]) => Ok("a")
    singleton_miss("b", Seq<str>["a"]) => validation.not_allowed("b")
    first("a", Seq<str>["a", "b", "c"]) => Ok("a")
    middle("b", Seq<str>["a", "b", "c"]) => Ok("b")
    last("c", Seq<str>["a", "b", "c"]) => Ok("c")
    absent("z", Seq<str>["a", "b", "c"]) => validation.not_allowed("z")
    dup_hit("a", Seq<str>["a", "a"]) => Ok("a")
    dup_miss("z", Seq<str>["a", "a"]) => validation.not_allowed("z")
    case("Batch", Seq<str>["batch"]) => validation.not_allowed("Batch")
    unicode("世界", Seq<str>["héllo", "世界"]) => Ok("世界")
    unicode_miss("世界x", Seq<str>["héllo", "世界"]) => validation.not_allowed("世界x")
    empty_value("", Seq<str>["", "a"]) => Ok("")
    empty_value_miss("", Seq<str>["a"]) => validation.not_allowed("")
  match call std__validate__str_one_of_from(value, allowed, 0, #allowed)
    on validation.not_allowed e => forward e
    on Ok r => Ok(r.value)

// S2 closed check operations: one constraint in, frozen triple out.
// Each op owns its producer call, its malformed-policy detection,
// and its violation construction, so consumers bind checks to
// fields without rewriting reconstruction arms, converter
// scripts, or token formats. Producer binders stay `_`; only Ok
// binders are read. Fail-fast within an op is frozen below;
// ordering across checks stays each consumer's chain.
fn std__validate__length_check(value: str, constraint: Validate__Length) -> Str__Value rev 1
  emits [validation.schema_violation]
  tests
    len_ok("Ada", Validate__Length("guest", "guest", 1, 24)) => Ok("Ada")
    len_short("", Validate__Length("guest", "guest", 1, 24)) => validation.schema_violation("guest", "str.length_scalars", "")
    len_long("abcdefghijklmnopqrstuvwxy", Validate__Length("guest", "guest", 1, 24)) => validation.schema_violation("guest", "str.length_scalars", "abcdefghijklmnopqrstuvwxy")
    len_min_negative("Ada", Validate__Length("guest", "guest", -1, 24)) => validation.schema_violation("", "schema.guest_minimum", "-1")
    len_min_negative_beats_data("", Validate__Length("guest", "guest", -1, 24)) => validation.schema_violation("", "schema.guest_minimum", "-1")
    len_bounds("Ada", Validate__Length("guest", "guest", 5, 1)) => validation.schema_violation("", "schema.guest_bounds", "minimum=5;maximum=1")
    len_other_path("", Validate__Length("label", "label", 1, 12)) => validation.schema_violation("label", "str.length_scalars", "")
    len_other_bounds("Ada", Validate__Length("label", "label", 5, 1)) => validation.schema_violation("", "schema.label_bounds", "minimum=5;maximum=1")
    len_bigint_bounds("Ada", Validate__Length("guest", "guest", 9007199254740993, 1)) => validation.schema_violation("", "schema.guest_bounds", "minimum=9007199254740993;maximum=1")
  match constraint.minimum >= 0
    true => match call std__validate__str_length(value, constraint.minimum, constraint.maximum)
      on validation.invalid_bounds _ => match call std__convert__int_to_str(constraint.minimum)
        given
          len_bounds => [exchange args (value = 5) outcome Ok("5")]
          len_other_bounds => [exchange args (value = 5) outcome Ok("5")]
          len_bigint_bounds => [exchange args (value = 9007199254740993) outcome Ok("9007199254740993")]
          label_bounds => [exchange args (value = 5) outcome Ok("5")]
          env_root => [exchange args (value = 5) outcome Ok("5")]
        on Ok lo => match call std__convert__int_to_str(constraint.maximum)
          given
            len_bounds => [exchange args (value = 1) outcome Ok("1")]
            len_other_bounds => [exchange args (value = 1) outcome Ok("1")]
            len_bigint_bounds => [exchange args (value = 1) outcome Ok("1")]
            label_bounds => [exchange args (value = 1) outcome Ok("1")]
            env_root => [exchange args (value = 1) outcome Ok("1")]
          on Ok hi => validation.schema_violation("", "schema." + constraint.tag + "_bounds", "minimum=" + lo.value + ";maximum=" + hi.value)
      on validation.invalid_length _ => validation.schema_violation(constraint.path, "str.length_scalars", value)
      on Ok v => Ok(v.value)
    false => match call std__convert__int_to_str(constraint.minimum)
      given
        len_min_negative => [exchange args (value = -1) outcome Ok("-1")]
        len_min_negative_beats_data => [exchange args (value = -1) outcome Ok("-1")]
        label_min_negative => [exchange args (value = -1) outcome Ok("-1")]
      on Ok r => validation.schema_violation("", "schema." + constraint.tag + "_minimum", r.value)

fn std__validate__range_check(value: int, constraint: Validate__Range) -> Int__Value rev 1
  emits [validation.schema_violation]
  tests
    range_ok(3, Validate__Range("party", "party", 1, 8)) => Ok(3)
    range_below(0, Validate__Range("party", "party", 1, 8)) => validation.schema_violation("party", "int.closed_range", "0")
    range_above(9, Validate__Range("party", "party", 1, 8)) => validation.schema_violation("party", "int.closed_range", "9")
    range_bounds(3, Validate__Range("party", "party", 8, 1)) => validation.schema_violation("", "schema.party_bounds", "lower=8;upper=1")
    range_other_path(11, Validate__Range("amount", "amount", 1, 10)) => validation.schema_violation("amount", "int.closed_range", "11")
    range_other_bounds(5, Validate__Range("amount", "amount", 10, 0)) => validation.schema_violation("", "schema.amount_bounds", "lower=10;upper=0")
    range_bigint(-9007199254740993, Validate__Range("party", "party", 1, 8)) => validation.schema_violation("party", "int.closed_range", "-9007199254740993")
  match call std__validate__int_range(value, constraint.lower, constraint.upper)
    on validation.invalid_bounds _ => match call std__convert__int_to_str(constraint.lower)
      given
        range_bounds => [exchange args (value = 8) outcome Ok("8")]
        range_other_bounds => [exchange args (value = 10) outcome Ok("10")]
        amount_bounds => [exchange args (value = 10) outcome Ok("10")]
      on Ok lo => match call std__convert__int_to_str(constraint.upper)
        given
          range_bounds => [exchange args (value = 1) outcome Ok("1")]
          range_other_bounds => [exchange args (value = 0) outcome Ok("0")]
          amount_bounds => [exchange args (value = 0) outcome Ok("0")]
        on Ok hi => validation.schema_violation("", "schema." + constraint.tag + "_bounds", "lower=" + lo.value + ";upper=" + hi.value)
    on validation.out_of_range _ => match call std__convert__int_to_str(value)
      given
        range_below => [exchange args (value = 0) outcome Ok("0")]
        range_above => [exchange args (value = 9) outcome Ok("9")]
        range_other_path => [exchange args (value = 11) outcome Ok("11")]
        range_bigint => [exchange args (value = -9007199254740993) outcome Ok("-9007199254740993")]
        amount_below => [exchange args (value = 0) outcome Ok("0")]
        amount_above => [exchange args (value = 11) outcome Ok("11")]
        amount_beats_mode => [exchange args (value = 99) outcome Ok("99")]
        bigint => [exchange args (value = -9007199254740993) outcome Ok("-9007199254740993")]
        env_rendered => [exchange args (value = 11) outcome Ok("11")]
      on Ok r => validation.schema_violation(constraint.path, "int.closed_range", r.value)
    on Ok v => Ok(v.value)

fn std__validate__membership_check(value: str, constraint: Validate__Membership) -> Str__Value rev 1
  emits [validation.schema_violation]
  tests
    member_ok("dinner", Validate__Membership("slot", Seq<str>["lunch", "dinner"])) => Ok("dinner")
    member_bad("brunch", Validate__Membership("slot", Seq<str>["lunch", "dinner"])) => validation.schema_violation("slot", "str.one_of", "brunch")
    member_empty_allowed("dinner", Validate__Membership("slot", Seq<str>[])) => validation.schema_violation("slot", "str.one_of", "dinner")
    member_other_path("admin", Validate__Membership("mode", Seq<str>["interactive", "batch"])) => validation.schema_violation("mode", "str.one_of", "admin")
    member_case("Dinner", Validate__Membership("slot", Seq<str>["lunch", "dinner"])) => validation.schema_violation("slot", "str.one_of", "Dinner")
  match call std__validate__str_one_of(value, constraint.allowed)
    on validation.not_allowed _ => validation.schema_violation(constraint.path, "str.one_of", value)
    on Ok v => Ok(v.value)

fn std__validate__all_from(checks: Seq<Validate__Outcome>, pos: int, n: int, acc: Seq<Validate__Failure>) -> Validate__Report rev 1
  decreases n
  emits []
  tests
    done_empty(Seq<Validate__Outcome>[], 0, 0, Seq<Validate__Failure>[]) => Ok(true, Seq<Validate__Failure>[])
    done_kept(Seq<Validate__Outcome>[], 0, 0, Seq<Validate__Failure>[Validate__Failure("a", "r", "d")]) => Ok(false, Seq<Validate__Failure>[Validate__Failure("a", "r", "d")])
    over(Seq<Validate__Outcome>[Validate__Outcome(true, "a", "r", "d")], 5, 2, Seq<Validate__Failure>[]) => Ok(true, Seq<Validate__Failure>[])
    pass_one(Seq<Validate__Outcome>[Validate__Outcome(true, "a", "r", "d")], 0, 1, Seq<Validate__Failure>[]) => Ok(true, Seq<Validate__Failure>[])
    fail_one(Seq<Validate__Outcome>[Validate__Outcome(false, "a", "r", "d")], 0, 1, Seq<Validate__Failure>[]) => Ok(false, Seq<Validate__Failure>[Validate__Failure("a", "r", "d")])
    fail_then_pass(Seq<Validate__Outcome>[Validate__Outcome(false, "a", "r1", "d1"), Validate__Outcome(true, "b", "r2", "d2")], 0, 2, Seq<Validate__Failure>[]) => Ok(false, Seq<Validate__Failure>[Validate__Failure("a", "r1", "d1")])
  match n <= 0
    true => Ok(#acc == 0, acc)
    false => match pos < #checks
      true => match call std__validate__all_push(checks[pos], acc)
        on Ok p => match call std__validate__all_from(checks, pos + 1, n - 1, p.values)
          on Ok r => Ok(r.passed, r.failures)
      false => Ok(#acc == 0, acc)

fn std__validate__all_push(current: Validate__Outcome, acc: Seq<Validate__Failure>) -> Validate__Failures rev 1
  emits []
  tests
    keep(Validate__Outcome(true, "a", "r", "d"), Seq<Validate__Failure>[]) => Ok(Seq<Validate__Failure>[])
    keep_nonempty(Validate__Outcome(true, "b", "r2", "d2"), Seq<Validate__Failure>[Validate__Failure("a", "r1", "d1")]) => Ok(Seq<Validate__Failure>[Validate__Failure("a", "r1", "d1")])
    push(Validate__Outcome(false, "a", "r", "d"), Seq<Validate__Failure>[]) => Ok(Seq<Validate__Failure>[Validate__Failure("a", "r", "d")])
    push_appends(Validate__Outcome(false, "b", "r2", "d2"), Seq<Validate__Failure>[Validate__Failure("a", "r1", "d1")]) => Ok(Seq<Validate__Failure>[Validate__Failure("a", "r1", "d1"), Validate__Failure("b", "r2", "d2")])
  match current.passed
    true => Ok(acc)
    false => Ok(acc + Validate__Failure(current.path, current.rule, current.detail))

fn std__validate__all(checks: Seq<Validate__Outcome>) -> Validate__Report rev 1
  emits []
  tests
    empty(Seq<Validate__Outcome>[]) => Ok(true, Seq<Validate__Failure>[])
    all_pass(Seq<Validate__Outcome>[Validate__Outcome(true, "a", "r1", "d1"), Validate__Outcome(true, "b", "r2", "d2")]) => Ok(true, Seq<Validate__Failure>[])
    one_fails(Seq<Validate__Outcome>[Validate__Outcome(true, "a", "r1", "d1"), Validate__Outcome(false, "b", "r2", "d2")]) => Ok(false, Seq<Validate__Failure>[Validate__Failure("b", "r2", "d2")])
    order_kept(Seq<Validate__Outcome>[Validate__Outcome(false, "b", "r2", "d2"), Validate__Outcome(true, "a", "r1", "d1"), Validate__Outcome(false, "c", "r3", "d3")]) => Ok(false, Seq<Validate__Failure>[Validate__Failure("b", "r2", "d2"), Validate__Failure("c", "r3", "d3")])
    all_fail(Seq<Validate__Outcome>[Validate__Outcome(false, "a", "r1", "d1"), Validate__Outcome(false, "b", "r2", "d2")]) => Ok(false, Seq<Validate__Failure>[Validate__Failure("a", "r1", "d1"), Validate__Failure("b", "r2", "d2")])
  match call std__validate__all_from(checks, 0, #checks, Seq<Validate__Failure>[])
    on Ok r => Ok(r.passed, r.failures)

fn quota__request__validate(request: Quota__Request, schema: Quota__RequestSchema) -> Quota__RequestValue rev 1
  emits [validation.schema_violation]
  tests
    ok(Quota__Request("Ada", 5, "batch"), Quota__RequestSchema(1, 12, 1, 10, Seq<str>["interactive", "batch"])) => Ok(Quota__Request("Ada", 5, "batch"))
    label_short(Quota__Request("", 5, "batch"), Quota__RequestSchema(1, 12, 1, 10, Seq<str>["interactive", "batch"])) => validation.schema_violation("label", "str.length_scalars", "")
    label_long(Quota__Request("abcdefghijklm", 5, "batch"), Quota__RequestSchema(1, 12, 1, 10, Seq<str>["interactive", "batch"])) => validation.schema_violation("label", "str.length_scalars", "abcdefghijklm")
    label_min_negative(Quota__Request("Ada", 5, "batch"), Quota__RequestSchema(-1, 12, 1, 10, Seq<str>["interactive", "batch"])) => validation.schema_violation("", "schema.label_minimum", "-1")
    label_bounds(Quota__Request("Ada", 5, "batch"), Quota__RequestSchema(5, 1, 1, 10, Seq<str>["interactive", "batch"])) => validation.schema_violation("", "schema.label_bounds", "minimum=5;maximum=1")
    amount_below(Quota__Request("Ada", 0, "batch"), Quota__RequestSchema(1, 12, 1, 10, Seq<str>["interactive", "batch"])) => validation.schema_violation("amount", "int.closed_range", "0")
    amount_above(Quota__Request("Ada", 11, "batch"), Quota__RequestSchema(1, 12, 1, 10, Seq<str>["interactive", "batch"])) => validation.schema_violation("amount", "int.closed_range", "11")
    amount_bounds(Quota__Request("Ada", 5, "batch"), Quota__RequestSchema(1, 12, 10, 0, Seq<str>["interactive", "batch"])) => validation.schema_violation("", "schema.amount_bounds", "lower=10;upper=0")
    mode_bad(Quota__Request("Ada", 5, "admin"), Quota__RequestSchema(1, 12, 1, 10, Seq<str>["interactive", "batch"])) => validation.schema_violation("mode", "str.one_of", "admin")
    label_beats_policy(Quota__Request("", 5, "batch"), Quota__RequestSchema(1, 12, 10, 0, Seq<str>["interactive", "batch"])) => validation.schema_violation("label", "str.length_scalars", "")
    label_beats_amount(Quota__Request("", 99, "batch"), Quota__RequestSchema(1, 12, 1, 10, Seq<str>["interactive", "batch"])) => validation.schema_violation("label", "str.length_scalars", "")
    amount_beats_mode(Quota__Request("Ada", 99, "admin"), Quota__RequestSchema(1, 12, 1, 10, Seq<str>["interactive", "batch"])) => validation.schema_violation("amount", "int.closed_range", "99")
    label_min_edge(Quota__Request("A", 5, "batch"), Quota__RequestSchema(1, 12, 1, 10, Seq<str>["interactive", "batch"])) => Ok(Quota__Request("A", 5, "batch"))
    label_max_edge(Quota__Request("abcdefghijkl", 5, "batch"), Quota__RequestSchema(1, 12, 1, 10, Seq<str>["interactive", "batch"])) => Ok(Quota__Request("abcdefghijkl", 5, "batch"))
    amount_low_edge(Quota__Request("Ada", 1, "batch"), Quota__RequestSchema(1, 12, 1, 10, Seq<str>["interactive", "batch"])) => Ok(Quota__Request("Ada", 1, "batch"))
    amount_high_edge(Quota__Request("Ada", 10, "batch"), Quota__RequestSchema(1, 12, 1, 10, Seq<str>["interactive", "batch"])) => Ok(Quota__Request("Ada", 10, "batch"))
    unicode_ok(Quota__Request("héllo世界ab12", 5, "batch"), Quota__RequestSchema(1, 12, 1, 10, Seq<str>["interactive", "batch"])) => Ok(Quota__Request("héllo世界ab12", 5, "batch"))
    bigint(Quota__Request("Ada", -9007199254740993, "batch"), Quota__RequestSchema(1, 12, 1, 10, Seq<str>["interactive", "batch"])) => validation.schema_violation("amount", "int.closed_range", "-9007199254740993")
    modes_empty(Quota__Request("Ada", 5, "batch"), Quota__RequestSchema(1, 12, 1, 10, Seq<str>[])) => validation.schema_violation("mode", "str.one_of", "batch")
    mode_case(Quota__Request("Ada", 5, "Batch"), Quota__RequestSchema(1, 12, 1, 10, Seq<str>["interactive", "batch"])) => validation.schema_violation("mode", "str.one_of", "Batch")
    ws_preserved(Quota__Request(" ab ", 5, "batch"), Quota__RequestSchema(1, 12, 1, 10, Seq<str>["interactive", "batch"])) => Ok(Quota__Request(" ab ", 5, "batch"))
  // Migrated onto the S2a closed checks (docs/a92-schema-s2b-call.md):
  // one check per field, outcomes forwarded unchanged. Same-file
  // calls, so no `given` scripts remain in this body. Field order
  // and every expectation above are unchanged.
  match call std__validate__length_check(request.label, Validate__Length("label", "label", schema.label_minimum, schema.label_maximum))
    on validation.schema_violation e => forward e
    on Ok _ => match call std__validate__range_check(request.amount, Validate__Range("amount", "amount", schema.amount_lower, schema.amount_upper))
      on validation.schema_violation e => forward e
      on Ok _ => match call std__validate__membership_check(request.mode, Validate__Membership("mode", schema.allowed_modes))
        on validation.schema_violation e => forward e
        on Ok _ => Ok(request)

fn quota__request__admit(request: Quota__Request, schema: Quota__RequestSchema, quota: int) -> Quota__Usage rev 1
  effects [Quota__used.read, Quota__used.write]
  emits [validation.schema_violation, validation.negative_value, validation.invalid_bounds, validation.out_of_range]
  tests
    admitted(Quota__Request("Ada", 3, "batch"), Quota__RequestSchema(1, 12, 1, 10, Seq<str>["interactive", "batch"]), 10) => Ok(3, 7)
    rejected(Quota__Request("", 3, "batch"), Quota__RequestSchema(1, 12, 1, 10, Seq<str>["interactive", "batch"]), 10) => validation.schema_violation("label", "str.length_scalars", "")
    over(Quota__Request("Ada", 10, "batch"), Quota__RequestSchema(1, 12, 1, 10, Seq<str>["interactive", "batch"]), 5) => validation.out_of_range(10, 0, 5)
    bad_quota(Quota__Request("Ada", 5, "batch"), Quota__RequestSchema(1, 12, 1, 10, Seq<str>["interactive", "batch"]), -1) => validation.invalid_bounds(0, -1)
    negative(Quota__Request("Ada", -2, "batch"), Quota__RequestSchema(1, 12, -5, 10, Seq<str>["interactive", "batch"]), 10) => validation.negative_value(-2)
  match call quota__request__validate(request, schema)
    on validation.schema_violation e => forward e
    on Ok v => match call quota__consume(v.value.amount, quota)
      on validation.negative_value e => forward e
      on validation.invalid_bounds e => forward e
      on validation.out_of_range e => forward e
      on Ok u => Ok(u.used, u.remaining)

fn quota__envelope__validate(envelope: Quota__Envelope, schema: Quota__RequestSchema) -> Quota__EnvelopeValue rev 1
  emits [validation.schema_violation]
  tests
    env_ok(Quota__Envelope(Quota__Request("Ada", 5, "batch")), Quota__RequestSchema(1, 12, 1, 10, Seq<str>["interactive", "batch"])) => Ok(Quota__Envelope(Quota__Request("Ada", 5, "batch")))
    env_root(Quota__Envelope(Quota__Request("Ada", 5, "batch")), Quota__RequestSchema(5, 1, 1, 10, Seq<str>["interactive", "batch"])) => validation.schema_violation("request", "schema.label_bounds", "minimum=5;maximum=1")
    env_field(Quota__Envelope(Quota__Request("", 5, "batch")), Quota__RequestSchema(1, 12, 1, 10, Seq<str>["interactive", "batch"])) => validation.schema_violation("request.label", "str.length_scalars", "")
    env_rendered(Quota__Envelope(Quota__Request("Ada", 11, "batch")), Quota__RequestSchema(1, 12, 1, 10, Seq<str>["interactive", "batch"])) => validation.schema_violation("request.amount", "int.closed_range", "11")
    env_member(Quota__Envelope(Quota__Request("Ada", 5, "admin")), Quota__RequestSchema(1, 12, 1, 10, Seq<str>["interactive", "batch"])) => validation.schema_violation("request.mode", "str.one_of", "admin")
  match call quota__request__validate(envelope.request, schema)
    on validation.schema_violation e => match e.path == ""
      true => validation.schema_violation("request", e.rule, e.value)
      false => validation.schema_violation("request." + e.path, e.rule, e.value)
    on Ok _ => Ok(envelope)

fn quota__consume(amount: int, quota: int) -> Quota__Usage rev 1
  effects [Quota__used.read, Quota__used.write]
  emits [validation.negative_value, validation.invalid_bounds, validation.out_of_range]
  tests
    first(3, 10) => Ok(3, 7)
    exact(10, 10) => Ok(10, 0)
    over(11, 10) => validation.out_of_range(11, 0, 10)
    negative(-2, 10) => validation.negative_value(-2)
    bad_quota(1, -1) => validation.invalid_bounds(0, -1)
  match chain
    call state__get(Quota__used) as s
    call std__validate__int_nonnegative(amount) as _
    then match call std__validate__int_range(s.value + amount, 0, quota)
      on validation.invalid_bounds _ => validation.invalid_bounds(lower = 0, upper = quota)
      on validation.out_of_range _ => validation.out_of_range(value = s.value + amount, lower = 0, upper = quota)
      on Ok checked => match call state__put(Quota__used, checked.value)
        on Ok _ => Ok(used = checked.value, remaining = quota - checked.value)
    else validation.negative_value(value = amount)

fn quota__usage(quota: int) -> Quota__Usage rev 1
  effects [Quota__used.read]
  emits [validation.negative_value]
  tests
    fresh(10) => Ok(0, 10)
    negative_quota(-1) => validation.negative_value(-1)
  match chain
    call state__get(Quota__used) as s
    call std__validate__int_nonnegative(quota) as _
    then Ok(used = s.value, remaining = quota - s.value)
    else validation.negative_value(value = quota)

// Shape notes, kept with the program, not in a second file.
// 1. Validators take values and return them. Callers keep ownership of
//    the policy: quota__consume checks the exact new total, so a stored
//    total can never drift past quota without failing closed.
// 2. Every test starts from init, so first and exact agree on nothing:
//    each row builds used from zero, which the tables show directly.
// 3. Bounds are inclusive and reversed bounds fail. No silent swap.
