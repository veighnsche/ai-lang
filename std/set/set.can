// std/set/set.can — roadmap order 6: sets with explicit ordering.
// Members keep first-occurrence order; union appends only absent
// members, intersection and difference preserve the left order.
// Equality is per-instance ==, the same contract maps share.

mod set
  provides [std__set__contains, std__set__has_from, std__set__union_from, std__set__union, std__set__intersection_from, std__set__intersection, std__set__difference_from, std__set__difference, Bool__Value, Set__Members]
  uses []
  emits []

type Bool__Value rev 1 (
  value: bool
)

type Set__Members<T> rev 1 (
  members: Seq<T>
)

fn std__set__has_from<T>(members: Seq<T>, value: T, pos: int, n: int) -> Bool__Value rev 1
  decreases n
  emits []
  tests
    done<T=int>(Seq<int>[1], 9, 1, 0) => Ok(false)
    over<T=int>(Seq<int>[1], 9, 5, 2) => Ok(false)
    hit<T=int>(Seq<int>[1, 2], 2, 0, 2) => Ok(true)
    miss<T=int>(Seq<int>[1], 9, 0, 1) => Ok(false)
    str_hit<T=str>(Seq<str>["a"], "a", 0, 1) => Ok(true)
    str_miss<T=str>(Seq<str>["a"], "z", 0, 1) => Ok(false)
    str_over<T=str>(Seq<str>["a"], "z", 5, 1) => Ok(false)
  match n <= 0
    true => Ok(false)
    false => match pos < #members
      true => match members[pos] == value
        true => Ok(true)
        false => match call std__set__has_from<T>(members, value, pos + 1, n - 1)
          on Ok r => Ok(r.value)
      false => Ok(false)

fn std__set__contains<T>(set: Set__Members<T>, value: T) -> Bool__Value rev 1
  emits []
  tests
    yes<T=int>(Set__Members<int>(Seq<int>[1, 2]), 2) => Ok(true)
    no<T=int>(Set__Members<int>(Seq<int>[1]), 9) => Ok(false)
    empty<T=int>(Set__Members<int>(Seq<int>[]), 1) => Ok(false)
    str_yes<T=str>(Set__Members<str>(Seq<str>["a"]), "a") => Ok(true)
    str_no<T=str>(Set__Members<str>(Seq<str>["a"]), "z") => Ok(false)
  match call std__set__has_from<T>(set.members, value, 0, #set.members)
    on Ok r => Ok(r.value)

fn std__set__union_from<T>(right: Seq<T>, pos: int, n: int, acc: Seq<T>) -> Set__Members<T> rev 1
  decreases n
  emits []
  tests
    done<T=int>(Seq<int>[2], 1, 0, Seq<int>[1, 2]) => Ok(Seq<int>[1, 2])
    over<T=int>(Seq<int>[2], 5, 2, Seq<int>[1]) => Ok(Seq<int>[1])
    adds<T=int>(Seq<int>[2, 3], 0, 2, Seq<int>[1]) => Ok(Seq<int>[1, 2, 3])
    skips<T=int>(Seq<int>[1, 3], 0, 2, Seq<int>[1]) => Ok(Seq<int>[1, 3])
    str_add<T=str>(Seq<str>["b"], 0, 1, Seq<str>["a"]) => Ok(Seq<str>["a", "b"])
    str_skip<T=str>(Seq<str>["a"], 0, 1, Seq<str>["a"]) => Ok(Seq<str>["a"])
    str_over<T=str>(Seq<str>["b"], 5, 1, Seq<str>["a"]) => Ok(Seq<str>["a"])
    str_done<T=str>(Seq<str>["b"], 1, 0, Seq<str>["a", "b"]) => Ok(Seq<str>["a", "b"])
  match n <= 0
    true => Ok(acc)
    false => match pos < #right
      true => match call std__set__has_from<T>(acc, right[pos], 0, #acc)
        on Ok h => match h.value
          true => match call std__set__union_from<T>(right, pos + 1, n - 1, acc)
            on Ok r => Ok(r.members)
          false => match call std__set__union_from<T>(right, pos + 1, n - 1, acc + right[pos])
            on Ok r => Ok(r.members)
      false => Ok(acc)

fn std__set__union<T>(left: Set__Members<T>, right: Set__Members<T>) -> Set__Members<T> rev 1
  emits []
  tests
    disjoint<T=int>(Set__Members<int>(Seq<int>[1]), Set__Members<int>(Seq<int>[2])) => Ok(Seq<int>[1, 2])
    overlap<T=int>(Set__Members<int>(Seq<int>[1, 2]), Set__Members<int>(Seq<int>[2, 3])) => Ok(Seq<int>[1, 2, 3])
    left_empty<T=int>(Set__Members<int>(Seq<int>[]), Set__Members<int>(Seq<int>[2])) => Ok(Seq<int>[2])
    right_empty<T=int>(Set__Members<int>(Seq<int>[1]), Set__Members<int>(Seq<int>[])) => Ok(Seq<int>[1])
    str<T=str>(Set__Members<str>(Seq<str>["a"]), Set__Members<str>(Seq<str>["b"])) => Ok(Seq<str>["a", "b"])
  match call std__set__union_from<T>(right.members, 0, #right.members, left.members)
    on Ok r => Ok(r.members)

fn std__set__intersection_from<T>(left: Seq<T>, right: Seq<T>, pos: int, n: int, acc: Seq<T>) -> Set__Members<T> rev 1
  decreases n
  emits []
  tests
    done<T=int>(Seq<int>[1, 2], Seq<int>[2], 2, 0, Seq<int>[2]) => Ok(Seq<int>[2])
    over<T=int>(Seq<int>[1], Seq<int>[2], 5, 2, Seq<int>[]) => Ok(Seq<int>[])
    keeps<T=int>(Seq<int>[1, 2], Seq<int>[2, 3], 0, 2, Seq<int>[]) => Ok(Seq<int>[2])
    drops<T=int>(Seq<int>[1, 2], Seq<int>[9], 0, 2, Seq<int>[]) => Ok(Seq<int>[])
    str_keep<T=str>(Seq<str>["a", "b"], Seq<str>["b"], 0, 2, Seq<str>[]) => Ok(Seq<str>["b"])
    str_drop<T=str>(Seq<str>["a"], Seq<str>["z"], 0, 1, Seq<str>[]) => Ok(Seq<str>[])
    str_over<T=str>(Seq<str>["a"], Seq<str>["b"], 5, 1, Seq<str>[]) => Ok(Seq<str>[])
    str_done<T=str>(Seq<str>["a"], Seq<str>["a"], 1, 0, Seq<str>["a"]) => Ok(Seq<str>["a"])
  match n <= 0
    true => Ok(acc)
    false => match pos < #left
      true => match call std__set__has_from<T>(right, left[pos], 0, #right)
        on Ok h => match h.value
          true => match call std__set__intersection_from<T>(left, right, pos + 1, n - 1, acc + left[pos])
            on Ok r => Ok(r.members)
          false => match call std__set__intersection_from<T>(left, right, pos + 1, n - 1, acc)
            on Ok r => Ok(r.members)
      false => Ok(acc)

fn std__set__intersection<T>(left: Set__Members<T>, right: Set__Members<T>) -> Set__Members<T> rev 1
  emits []
  tests
    some<T=int>(Set__Members<int>(Seq<int>[1, 2]), Set__Members<int>(Seq<int>[2, 3])) => Ok(Seq<int>[2])
    none<T=int>(Set__Members<int>(Seq<int>[1]), Set__Members<int>(Seq<int>[2])) => Ok(Seq<int>[])
    all<T=int>(Set__Members<int>(Seq<int>[1]), Set__Members<int>(Seq<int>[1, 2])) => Ok(Seq<int>[1])
    str<T=str>(Set__Members<str>(Seq<str>["a", "b"]), Set__Members<str>(Seq<str>["b"])) => Ok(Seq<str>["b"])
  match call std__set__intersection_from<T>(left.members, right.members, 0, #left.members, Seq<T>[])
    on Ok r => Ok(r.members)

fn std__set__difference_from<T>(left: Seq<T>, right: Seq<T>, pos: int, n: int, acc: Seq<T>) -> Set__Members<T> rev 1
  decreases n
  emits []
  tests
    done<T=int>(Seq<int>[1, 2], Seq<int>[2], 2, 0, Seq<int>[1]) => Ok(Seq<int>[1])
    over<T=int>(Seq<int>[1], Seq<int>[2], 5, 2, Seq<int>[]) => Ok(Seq<int>[])
    keeps<T=int>(Seq<int>[1, 2], Seq<int>[2, 3], 0, 2, Seq<int>[]) => Ok(Seq<int>[1])
    drops<T=int>(Seq<int>[1, 2], Seq<int>[1, 2], 0, 2, Seq<int>[]) => Ok(Seq<int>[])
    str_keep<T=str>(Seq<str>["a", "b"], Seq<str>["b"], 0, 2, Seq<str>[]) => Ok(Seq<str>["a"])
    str_drop<T=str>(Seq<str>["a"], Seq<str>["a"], 0, 1, Seq<str>[]) => Ok(Seq<str>[])
    str_over<T=str>(Seq<str>["a"], Seq<str>["b"], 5, 1, Seq<str>[]) => Ok(Seq<str>[])
    str_done<T=str>(Seq<str>["a"], Seq<str>["b"], 1, 0, Seq<str>["a"]) => Ok(Seq<str>["a"])
  match n <= 0
    true => Ok(acc)
    false => match pos < #left
      true => match call std__set__has_from<T>(right, left[pos], 0, #right)
        on Ok h => match h.value
          true => match call std__set__difference_from<T>(left, right, pos + 1, n - 1, acc)
            on Ok r => Ok(r.members)
          false => match call std__set__difference_from<T>(left, right, pos + 1, n - 1, acc + left[pos])
            on Ok r => Ok(r.members)
      false => Ok(acc)

fn std__set__difference<T>(left: Set__Members<T>, right: Set__Members<T>) -> Set__Members<T> rev 1
  emits []
  tests
    some<T=int>(Set__Members<int>(Seq<int>[1, 2]), Set__Members<int>(Seq<int>[2, 3])) => Ok(Seq<int>[1])
    none_left<T=int>(Set__Members<int>(Seq<int>[1]), Set__Members<int>(Seq<int>[1])) => Ok(Seq<int>[])
    all_left<T=int>(Set__Members<int>(Seq<int>[1]), Set__Members<int>(Seq<int>[2])) => Ok(Seq<int>[1])
    str<T=str>(Set__Members<str>(Seq<str>["a", "b"]), Set__Members<str>(Seq<str>["b"])) => Ok(Seq<str>["a"])
  match call std__set__difference_from<T>(left.members, right.members, 0, #left.members, Seq<T>[])
    on Ok r => Ok(r.members)
