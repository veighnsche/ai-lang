// html/text: constructor-controlled brands. Raw strings enter
// Html__Text only through html__text__escape, one explicit gate;
// the brand erases to string at runtime and flows opaquely (never
// inspected, only passed to brand-typed params). The escape worker
// consumes from the front (upper_ascii precedent): no index
// arithmetic, no out-of-range shape past the n bound.
//
// Html__Safe is a serialized fragment admissible at the library's
// supported ordinary HTML child-fragment boundaries. It grants no
// authority for script, style, attribute, or URL contexts: text such
// as alert(1) never becomes suitable script content by promotion.
// Promotion is relabeling, not re-encoding: erase(node(t)) = erase(t).

mod html
  provides [html__text__escape_from, html__text__escape, html__text__node, html__attribute__name, Html__Text, Html__Escaped, Html__TextResult, Html__Safe, Html__SafeResult, Html__TextAttributeName, Html__NameResult]
  uses []
  emits [html.invalid_attribute_name]

error html.invalid_attribute_name(value: str)

brand Html__Text is str rev 1

brand Html__Safe is str rev 1 seals_from [Html__Text]

type Html__Escaped rev 1 (
  value: str
)

type Html__TextResult rev 1 (
  text: Html__Text
)

type Html__SafeResult rev 1 (
  safe: Html__Safe
)

fn html__text__escape_from(s: str, acc: str, n: int) -> Html__Escaped rev 1
  decreases n
  emits []
  tests
    escape_from_empty(s = "", acc = "q", n = 0) => Ok(value = "q")
    escape_from_plain(s = "hi", acc = "", n = 2) => Ok(value = "hi")
    escape_from_amp(s = "a&b", acc = "", n = 3) => Ok(value = "a&amp;b")
    escape_from_lt(s = "<p>", acc = "", n = 3) => Ok(value = "&lt;p&gt;")
    escape_from_all(s = "<>&", acc = ">", n = 3) => Ok(value = ">&lt;&gt;&amp;")
    escape_from_astral(s = "𝌆x", acc = "", n = 2) => Ok(value = "𝌆x")
=
  match n <= 0
    true => Ok(value = acc)
    false => match s[0:1] == "&"
      true => match call html__text__escape_from(s[1:#s], acc + "&amp;", n - 1)
        on Ok r => Ok(value = r.value)
      false => match s[0:1] == "<"
        true => match call html__text__escape_from(s[1:#s], acc + "&lt;", n - 1)
          on Ok r => Ok(value = r.value)
        false => match s[0:1] == ">"
          true => match call html__text__escape_from(s[1:#s], acc + "&gt;", n - 1)
            on Ok r => Ok(value = r.value)
          false => match call html__text__escape_from(s[1:#s], acc + s[0:1], n - 1)
            on Ok r => Ok(value = r.value)

fn html__text__escape(raw: str) -> Html__TextResult rev 1
  emits []
  tests
    escape_plain(raw = "hi") => Ok(text = seal Html__Text("hi"))
    escape_empty(raw = "") => Ok(text = seal Html__Text(""))
    escape_amp(raw = "a&b") => Ok(text = seal Html__Text("a&amp;b"))
    escape_tags(raw = "<p>") => Ok(text = seal Html__Text("&lt;p&gt;"))
    escape_mixed(raw = "a<b&c>d") => Ok(text = seal Html__Text("a&lt;b&amp;c&gt;d"))
    escape_astral(raw = "𝌆") => Ok(text = seal Html__Text("𝌆"))
=
  match call html__text__escape_from(raw, "", #raw)
    on Ok r => Ok(text = seal Html__Text(r.value))

fn html__text__node(text: Html__Text) -> Html__SafeResult rev 1
  emits []
  tests
    node_empty(text = seal Html__Text("")) => Ok(safe = seal Html__Safe(""))
    node_plain(text = seal Html__Text("hi")) => Ok(safe = seal Html__Safe("hi"))
    node_escaped(text = seal Html__Text("a&amp;b")) => Ok(safe = seal Html__Safe("a&amp;b"))
    node_tags(text = seal Html__Text("&lt;p&gt;")) => Ok(safe = seal Html__Safe("&lt;p&gt;"))
    node_entities(text = seal Html__Text("&amp;lt;")) => Ok(safe = seal Html__Safe("&amp;lt;"))
    node_astral(text = seal Html__Text("𝌆")) => Ok(safe = seal Html__Safe("𝌆"))
=
  Ok(safe = seal Html__Safe(text))

// html/attribute: the name gate. Html__TextAttributeName contains
// exactly the canonical names approved by this library revision for
// the ordinary quoted-text attribute-value constructor — narrower
// than "a valid HTML attribute name." Membership admits one spelling
// per name; anything else is API rejection, not a claim of HTML
// invalidity. id/class are excluded (specialized constructors own
// them); srcdoc/meta-content are excluded (wrong value context);
// DOM-clobbering names need no separate rule here because added
// names require their own justification, but "text-valued" is never
// advertised as "incapable of affecting application behavior."

brand Html__TextAttributeName is str rev 1

type Html__NameResult rev 1 (
  name: Html__TextAttributeName
)

fn html__attribute__name(value: str) -> Html__NameResult rev 1
  emits [html.invalid_attribute_name]
  tests
    name_title(value = "title") => Ok(name = seal Html__TextAttributeName("title"))
    name_upper(value = "TITLE") => html.invalid_attribute_name(value = "TITLE")
    name_mixed(value = "Title") => html.invalid_attribute_name(value = "Title")
    name_href(value = "href") => html.invalid_attribute_name(value = "href")
    name_href_upper(value = "HREF") => html.invalid_attribute_name(value = "HREF")
    name_href_mixed(value = "hReF") => html.invalid_attribute_name(value = "hReF")
    name_onclick(value = "onclick") => html.invalid_attribute_name(value = "onclick")
    name_onclick_upper(value = "OnClick") => html.invalid_attribute_name(value = "OnClick")
    name_style(value = "style") => html.invalid_attribute_name(value = "style")
    name_style_upper(value = "STYLE") => html.invalid_attribute_name(value = "STYLE")
    name_srcdoc(value = "srcdoc") => html.invalid_attribute_name(value = "srcdoc")
    name_id(value = "id") => html.invalid_attribute_name(value = "id")
    name_class(value = "class") => html.invalid_attribute_name(value = "class")
    name_empty(value = "") => html.invalid_attribute_name(value = "")
    name_padded_left(value = " title") => html.invalid_attribute_name(value = " title")
    name_padded_right(value = "title ") => html.invalid_attribute_name(value = "title ")
    name_compound(value = "title onclick") => html.invalid_attribute_name(value = "title onclick")
    name_equals(value = "title=") => html.invalid_attribute_name(value = "title=")
    name_unlisted(value = "data-count") => html.invalid_attribute_name(value = "data-count")
    name_lookalike(value = "titlé") => html.invalid_attribute_name(value = "titlé")
=
  match value
    "title" => Ok(name = seal Html__TextAttributeName("title"))
    _ => html.invalid_attribute_name(value = value)
