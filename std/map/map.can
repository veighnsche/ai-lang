// std/map/map.can — roadmap order 6: insertion-ordered maps with
// generic keys and values. A map IS its ordered entries: one
// Seq<Map__Pair<K,V>> (b04 nesting); reads project entries[i].key
// and entries[i].val (b03). Replace keeps position; remove closes
// ranks. Presence is always explicit: insert never overwrites,
// replace/remove never invent. Errors are payloadless: error
// payloads cannot be generic, so no key travels on absent/exists.

mod map
  provides [std__map__get, std__map__index_from, std__map__insert, std__map__replace_from, std__map__replace, std__map__remove_from, std__map__remove, std__map__entries, Int__Value, Map__Pair, Map, Map__Item]
  uses []
  emits [map.key_absent, map.key_exists]

error map.key_absent()
error map.key_exists()

type Int__Value rev 1 (
  value: int
)

type Map__Pair<K, V> rev 1 (
  key: K
  val: V
)

type Map<K, V> rev 1 (
  entries: Seq<Map__Pair<K, V>>
)

type Map__Item<V> rev 1 (
  item: V
)

fn std__map__index_from<K, V>(map: Map<K, V>, key: K, pos: int, n: int) -> Int__Value rev 1
  decreases n
  emits []
  tests
    done<K=str, V=int>(Map<str, int>(Seq<Map__Pair<str, int>>[Map__Pair<str, int>("a", 1)]), "z", 1, 0) => Ok(-1)
    over<K=str, V=int>(Map<str, int>(Seq<Map__Pair<str, int>>[Map__Pair<str, int>("a", 1)]), "z", 5, 2) => Ok(-1)
    hit_first<K=str, V=int>(Map<str, int>(Seq<Map__Pair<str, int>>[Map__Pair<str, int>("a", 1), Map__Pair<str, int>("b", 2)]), "a", 0, 2) => Ok(0)
    hit_later<K=str, V=int>(Map<str, int>(Seq<Map__Pair<str, int>>[Map__Pair<str, int>("a", 1), Map__Pair<str, int>("b", 2)]), "b", 0, 2) => Ok(1)
    miss<K=str, V=int>(Map<str, int>(Seq<Map__Pair<str, int>>[Map__Pair<str, int>("a", 1)]), "z", 0, 1) => Ok(-1)
    int_hit<K=int, V=str>(Map<int, str>(Seq<Map__Pair<int, str>>[Map__Pair<int, str>(1, "x")]), 1, 0, 1) => Ok(0)
    int_miss<K=int, V=str>(Map<int, str>(Seq<Map__Pair<int, str>>[Map__Pair<int, str>(1, "x")]), 2, 0, 1) => Ok(-1)
    int_over<K=int, V=str>(Map<int, str>(Seq<Map__Pair<int, str>>[Map__Pair<int, str>(1, "x")]), 2, 5, 1) => Ok(-1)
  match n <= 0
    true => Ok(-1)
    false => match pos < #map.entries
      true => match map.entries[pos].key == key
        true => Ok(pos)
        false => match call std__map__index_from<K, V>(map, key, pos + 1, n - 1)
          on Ok r => Ok(r.value)
      false => Ok(-1)

fn std__map__get<K, V>(map: Map<K, V>, key: K) -> Map__Item<V> rev 1
  emits [map.key_absent]
  tests
    hit_first<K=str, V=int>(Map<str, int>(Seq<Map__Pair<str, int>>[Map__Pair<str, int>("a", 1), Map__Pair<str, int>("b", 2)]), "a") => Ok(1)
    hit_last<K=str, V=int>(Map<str, int>(Seq<Map__Pair<str, int>>[Map__Pair<str, int>("a", 1), Map__Pair<str, int>("b", 2)]), "b") => Ok(2)
    miss<K=str, V=int>(Map<str, int>(Seq<Map__Pair<str, int>>[Map__Pair<str, int>("a", 1)]), "z") => map.key_absent()
    empty<K=str, V=int>(Map<str, int>(Seq<Map__Pair<str, int>>[]), "a") => map.key_absent()
    int_hit<K=int, V=str>(Map<int, str>(Seq<Map__Pair<int, str>>[Map__Pair<int, str>(1, "x")]), 1) => Ok("x")
    int_miss<K=int, V=str>(Map<int, str>(Seq<Map__Pair<int, str>>[Map__Pair<int, str>(1, "x")]), 2) => map.key_absent()
  match call std__map__index_from<K, V>(map, key, 0, #map.entries)
    on Ok i => match i.value < 0
      true => map.key_absent()
      false => Ok(map.entries[i.value].val)

fn std__map__insert<K, V>(map: Map<K, V>, key: K, value: V) -> Map<K, V> rev 1
  emits [map.key_exists]
  tests
    into_empty<K=str, V=int>(Map<str, int>(Seq<Map__Pair<str, int>>[]), "a", 1) => Ok(Seq<Map__Pair<str, int>>[Map__Pair<str, int>("a", 1)])
    append_new<K=str, V=int>(Map<str, int>(Seq<Map__Pair<str, int>>[Map__Pair<str, int>("a", 1)]), "b", 2) => Ok(Seq<Map__Pair<str, int>>[Map__Pair<str, int>("a", 1), Map__Pair<str, int>("b", 2)])
    exists<K=str, V=int>(Map<str, int>(Seq<Map__Pair<str, int>>[Map__Pair<str, int>("a", 1)]), "a", 9) => map.key_exists()
    int_new<K=int, V=str>(Map<int, str>(Seq<Map__Pair<int, str>>[]), 1, "x") => Ok(Seq<Map__Pair<int, str>>[Map__Pair<int, str>(1, "x")])
    int_exists<K=int, V=str>(Map<int, str>(Seq<Map__Pair<int, str>>[Map__Pair<int, str>(1, "x")]), 1, "y") => map.key_exists()
  match call std__map__index_from<K, V>(map, key, 0, #map.entries)
    on Ok i => match i.value < 0
      true => Ok(map.entries + Map__Pair<K, V>(key, value))
      false => map.key_exists()

fn std__map__replace_from<K, V>(map: Map<K, V>, key: K, value: V, pos: int, n: int, acc: Seq<Map__Pair<K, V>>) -> Map<K, V> rev 1
  decreases n
  emits []
  tests
    done<K=str, V=int>(Map<str, int>(Seq<Map__Pair<str, int>>[Map__Pair<str, int>("a", 1)]), "a", 9, 1, 0, Seq<Map__Pair<str, int>>[Map__Pair<str, int>("a", 9)]) => Ok(Seq<Map__Pair<str, int>>[Map__Pair<str, int>("a", 9)])
    over<K=str, V=int>(Map<str, int>(Seq<Map__Pair<str, int>>[Map__Pair<str, int>("a", 1)]), "a", 9, 5, 2, Seq<Map__Pair<str, int>>[]) => Ok(Seq<Map__Pair<str, int>>[])
    swap_first<K=str, V=int>(Map<str, int>(Seq<Map__Pair<str, int>>[Map__Pair<str, int>("a", 1), Map__Pair<str, int>("b", 2)]), "a", 9, 0, 2, Seq<Map__Pair<str, int>>[]) => Ok(Seq<Map__Pair<str, int>>[Map__Pair<str, int>("a", 9), Map__Pair<str, int>("b", 2)])
    swap_later<K=str, V=int>(Map<str, int>(Seq<Map__Pair<str, int>>[Map__Pair<str, int>("a", 1), Map__Pair<str, int>("b", 2)]), "b", 9, 0, 2, Seq<Map__Pair<str, int>>[]) => Ok(Seq<Map__Pair<str, int>>[Map__Pair<str, int>("a", 1), Map__Pair<str, int>("b", 9)])
    int_swap<K=int, V=str>(Map<int, str>(Seq<Map__Pair<int, str>>[Map__Pair<int, str>(1, "x")]), 1, "w", 0, 1, Seq<Map__Pair<int, str>>[]) => Ok(Seq<Map__Pair<int, str>>[Map__Pair<int, str>(1, "w")])
    int_skip<K=int, V=str>(Map<int, str>(Seq<Map__Pair<int, str>>[Map__Pair<int, str>(1, "x"), Map__Pair<int, str>(2, "y")]), 2, "w", 0, 2, Seq<Map__Pair<int, str>>[]) => Ok(Seq<Map__Pair<int, str>>[Map__Pair<int, str>(1, "x"), Map__Pair<int, str>(2, "w")])
    int_over<K=int, V=str>(Map<int, str>(Seq<Map__Pair<int, str>>[Map__Pair<int, str>(1, "x")]), 1, "w", 5, 1, Seq<Map__Pair<int, str>>[]) => Ok(Seq<Map__Pair<int, str>>[])
  match n <= 0
    true => Ok(acc)
    false => match pos < #map.entries
      true => match map.entries[pos].key == key
        true => match call std__map__replace_from<K, V>(map, key, value, pos + 1, n - 1, acc + Map__Pair<K, V>(key, value))
          on Ok r => Ok(r.entries)
        false => match call std__map__replace_from<K, V>(map, key, value, pos + 1, n - 1, acc + map.entries[pos])
          on Ok r => Ok(r.entries)
      false => Ok(acc)

fn std__map__replace<K, V>(map: Map<K, V>, key: K, value: V) -> Map<K, V> rev 1
  emits [map.key_absent]
  tests
    ok_first<K=str, V=int>(Map<str, int>(Seq<Map__Pair<str, int>>[Map__Pair<str, int>("a", 1), Map__Pair<str, int>("b", 2)]), "a", 9) => Ok(Seq<Map__Pair<str, int>>[Map__Pair<str, int>("a", 9), Map__Pair<str, int>("b", 2)])
    ok_last<K=str, V=int>(Map<str, int>(Seq<Map__Pair<str, int>>[Map__Pair<str, int>("a", 1), Map__Pair<str, int>("b", 2)]), "b", 9) => Ok(Seq<Map__Pair<str, int>>[Map__Pair<str, int>("a", 1), Map__Pair<str, int>("b", 9)])
    absent<K=str, V=int>(Map<str, int>(Seq<Map__Pair<str, int>>[Map__Pair<str, int>("a", 1)]), "z", 9) => map.key_absent()
    int_ok<K=int, V=str>(Map<int, str>(Seq<Map__Pair<int, str>>[Map__Pair<int, str>(1, "x")]), 1, "w") => Ok(Seq<Map__Pair<int, str>>[Map__Pair<int, str>(1, "w")])
    int_absent<K=int, V=str>(Map<int, str>(Seq<Map__Pair<int, str>>[Map__Pair<int, str>(1, "x")]), 2, "w") => map.key_absent()
  match call std__map__index_from<K, V>(map, key, 0, #map.entries)
    on Ok i => match i.value < 0
      true => map.key_absent()
      false => match call std__map__replace_from<K, V>(map, key, value, 0, #map.entries, Seq<Map__Pair<K, V>>[])
        on Ok r => Ok(r.entries)

fn std__map__remove_from<K, V>(map: Map<K, V>, key: K, pos: int, n: int, acc: Seq<Map__Pair<K, V>>) -> Map<K, V> rev 1
  decreases n
  emits []
  tests
    done<K=str, V=int>(Map<str, int>(Seq<Map__Pair<str, int>>[Map__Pair<str, int>("a", 1)]), "a", 1, 0, Seq<Map__Pair<str, int>>[]) => Ok(Seq<Map__Pair<str, int>>[])
    over<K=str, V=int>(Map<str, int>(Seq<Map__Pair<str, int>>[Map__Pair<str, int>("a", 1)]), "a", 5, 2, Seq<Map__Pair<str, int>>[]) => Ok(Seq<Map__Pair<str, int>>[])
    drop_first<K=str, V=int>(Map<str, int>(Seq<Map__Pair<str, int>>[Map__Pair<str, int>("a", 1), Map__Pair<str, int>("b", 2)]), "a", 0, 2, Seq<Map__Pair<str, int>>[]) => Ok(Seq<Map__Pair<str, int>>[Map__Pair<str, int>("b", 2)])
    drop_later<K=str, V=int>(Map<str, int>(Seq<Map__Pair<str, int>>[Map__Pair<str, int>("a", 1), Map__Pair<str, int>("b", 2)]), "b", 0, 2, Seq<Map__Pair<str, int>>[]) => Ok(Seq<Map__Pair<str, int>>[Map__Pair<str, int>("a", 1)])
    int_drop<K=int, V=str>(Map<int, str>(Seq<Map__Pair<int, str>>[Map__Pair<int, str>(1, "x"), Map__Pair<int, str>(2, "y")]), 1, 0, 2, Seq<Map__Pair<int, str>>[]) => Ok(Seq<Map__Pair<int, str>>[Map__Pair<int, str>(2, "y")])
    int_over<K=int, V=str>(Map<int, str>(Seq<Map__Pair<int, str>>[Map__Pair<int, str>(1, "x")]), 1, 5, 1, Seq<Map__Pair<int, str>>[]) => Ok(Seq<Map__Pair<int, str>>[])
  match n <= 0
    true => Ok(acc)
    false => match pos < #map.entries
      true => match map.entries[pos].key == key
        true => match call std__map__remove_from<K, V>(map, key, pos + 1, n - 1, acc)
          on Ok r => Ok(r.entries)
        false => match call std__map__remove_from<K, V>(map, key, pos + 1, n - 1, acc + map.entries[pos])
          on Ok r => Ok(r.entries)
      false => Ok(acc)

fn std__map__remove<K, V>(map: Map<K, V>, key: K) -> Map<K, V> rev 1
  emits [map.key_absent]
  tests
    ok_first<K=str, V=int>(Map<str, int>(Seq<Map__Pair<str, int>>[Map__Pair<str, int>("a", 1), Map__Pair<str, int>("b", 2)]), "a") => Ok(Seq<Map__Pair<str, int>>[Map__Pair<str, int>("b", 2)])
    ok_last<K=str, V=int>(Map<str, int>(Seq<Map__Pair<str, int>>[Map__Pair<str, int>("a", 1), Map__Pair<str, int>("b", 2)]), "b") => Ok(Seq<Map__Pair<str, int>>[Map__Pair<str, int>("a", 1)])
    absent<K=str, V=int>(Map<str, int>(Seq<Map__Pair<str, int>>[Map__Pair<str, int>("a", 1)]), "z") => map.key_absent()
    int_ok<K=int, V=str>(Map<int, str>(Seq<Map__Pair<int, str>>[Map__Pair<int, str>(1, "x"), Map__Pair<int, str>(2, "y")]), 1) => Ok(Seq<Map__Pair<int, str>>[Map__Pair<int, str>(2, "y")])
    int_absent<K=int, V=str>(Map<int, str>(Seq<Map__Pair<int, str>>[Map__Pair<int, str>(1, "x")]), 2) => map.key_absent()
  match call std__map__index_from<K, V>(map, key, 0, #map.entries)
    on Ok i => match i.value < 0
      true => map.key_absent()
      false => match call std__map__remove_from<K, V>(map, key, 0, #map.entries, Seq<Map__Pair<K, V>>[])
        on Ok r => Ok(r.entries)

fn std__map__entries<K, V>(map: Map<K, V>) -> Map<K, V> rev 1
  emits []
  tests
    empty<K=str, V=int>(Map<str, int>(Seq<Map__Pair<str, int>>[])) => Ok(Seq<Map__Pair<str, int>>[])
    two<K=str, V=int>(Map<str, int>(Seq<Map__Pair<str, int>>[Map__Pair<str, int>("a", 1), Map__Pair<str, int>("b", 2)])) => Ok(Seq<Map__Pair<str, int>>[Map__Pair<str, int>("a", 1), Map__Pair<str, int>("b", 2)])
    one<K=int, V=str>(Map<int, str>(Seq<Map__Pair<int, str>>[Map__Pair<int, str>(1, "x")])) => Ok(Seq<Map__Pair<int, str>>[Map__Pair<int, str>(1, "x")])
  Ok(map.entries)
