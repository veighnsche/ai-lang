// fizzbuzz/fizzbuzz.ail — FizzBuzz as one flat two-slot match (a28):
// divisibility by 3 and by 5 selects the word while the number rides
// along untouched, so no digit renderer is needed. (Rendering an int
// as text is recursion behind a helper — see std__convert__int_to_str
// — kept out here so every arm stays directly witnessed by its own
// table row under the test-per-arm law, a03.)

mod fizz
  provides [fizz__label, Fizz__Label]
  uses []
  emits []

type Fizz__Label rev 1 (
  word: str
  n: int
)

fn fizz__label(n: int) -> Fizz__Label rev 1
  emits []
  tests
    fizzbuzz(n = 15) => Ok(word = "FizzBuzz", n = 15)
    fizzbuzz_zero(n = 0) => Ok(word = "FizzBuzz", n = 0)
    fizz(n = 3) => Ok(word = "Fizz", n = 3)
    buzz(n = 5) => Ok(word = "Buzz", n = 5)
    plain(n = 7) => Ok(word = "", n = 7)
    plain_two_digits(n = 41) => Ok(word = "", n = 41)
=
  match n % 3 == 0, n % 5 == 0
    true, true => Ok(word = "FizzBuzz", n = n)
    true, false => Ok(word = "Fizz", n = n)
    false, true => Ok(word = "Buzz", n = n)
    false, false => Ok(word = "", n = n)
