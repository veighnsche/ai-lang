// sketches/reserve/reserve.can — S2 second consumer: a dinner-reservation
// desk admitting requests against a program-owned policy. Independent
// program from the quota pilot (different domain, different policy
// values), but a genuine client of the same shared scalar validators
// and canonical converter: the S2 question is what binding and
// interpretation work repeats per record that shared calls do not
// remove, so nothing here is vendored.
// A validator returns the accepted value or the frozen violation
// triple. It never clamps, trims, or supplies a default.

mod reserve
  provides [reserve__request__validate, reserve__request__admit, Reserve__Request, Reserve__RequestSchema, Reserve__RequestValue, Reserve__Confirmation]
  uses [std__validate__str_length@1, std__validate__int_range@1, std__validate__str_one_of@1, std__convert__int_to_str@1]
  emits [validation.schema_violation]

error validation.schema_violation(path: str, rule: str, value: str)
error validation.invalid_bounds(lower: int, upper: int)
error validation.invalid_length(value: str, minimum: int, maximum: int)
error validation.out_of_range(value: int, lower: int, upper: int)
error validation.not_allowed(value: str)

type Reserve__Request rev 1 (
  guest: str
  party: int
  slot: str
)

type Reserve__RequestSchema rev 1 (
  guest_minimum: int
  guest_maximum: int
  party_lower: int
  party_upper: int
  allowed_slots: Seq<str>
)

type Reserve__RequestValue rev 1 (
  value: Reserve__Request
)

type Reserve__Confirmation rev 1 (
  guest: str
  party: int
  slot: str
)

// Fail-fast order mirrors the quota pilot: minimum-nonnegative,
// then length (with invalid-bounds), then range (with
// invalid-bounds), then membership. Producer binders stay `_`
// (S1a amendment 2: reading a matched binder's fields counts as
// raising that kind); violation payloads reconstruct from this
// function's own inputs plus canonical integer renders.
fn reserve__request__validate(request: Reserve__Request, schema: Reserve__RequestSchema) -> Reserve__RequestValue rev 1
  emits [validation.schema_violation]
  tests
    ok(Reserve__Request("Ada", 3, "dinner"), Reserve__RequestSchema(1, 24, 1, 8, Seq<str>["lunch", "dinner"])) => Ok(Reserve__Request("Ada", 3, "dinner"))
    guest_short(Reserve__Request("", 3, "dinner"), Reserve__RequestSchema(1, 24, 1, 8, Seq<str>["lunch", "dinner"])) => validation.schema_violation("guest", "str.length_scalars", "")
    guest_long(Reserve__Request("abcdefghijklmnopqrstuvwxy", 3, "dinner"), Reserve__RequestSchema(1, 24, 1, 8, Seq<str>["lunch", "dinner"])) => validation.schema_violation("guest", "str.length_scalars", "abcdefghijklmnopqrstuvwxy")
    guest_min_negative(Reserve__Request("Ada", 3, "dinner"), Reserve__RequestSchema(-1, 24, 1, 8, Seq<str>["lunch", "dinner"])) => validation.schema_violation("", "schema.guest_minimum", "-1")
    guest_bounds(Reserve__Request("Ada", 3, "dinner"), Reserve__RequestSchema(5, 1, 1, 8, Seq<str>["lunch", "dinner"])) => validation.schema_violation("", "schema.guest_bounds", "minimum=5;maximum=1")
    party_below(Reserve__Request("Ada", 0, "dinner"), Reserve__RequestSchema(1, 24, 1, 8, Seq<str>["lunch", "dinner"])) => validation.schema_violation("party", "int.closed_range", "0")
    party_above(Reserve__Request("Ada", 9, "dinner"), Reserve__RequestSchema(1, 24, 1, 8, Seq<str>["lunch", "dinner"])) => validation.schema_violation("party", "int.closed_range", "9")
    party_bounds(Reserve__Request("Ada", 3, "dinner"), Reserve__RequestSchema(1, 24, 8, 1, Seq<str>["lunch", "dinner"])) => validation.schema_violation("", "schema.party_bounds", "lower=8;upper=1")
    slot_bad(Reserve__Request("Ada", 3, "brunch"), Reserve__RequestSchema(1, 24, 1, 8, Seq<str>["lunch", "dinner"])) => validation.schema_violation("slot", "str.one_of", "brunch")
    guest_beats_policy(Reserve__Request("", 3, "dinner"), Reserve__RequestSchema(1, 24, 8, 1, Seq<str>["lunch", "dinner"])) => validation.schema_violation("guest", "str.length_scalars", "")
    guest_beats_party(Reserve__Request("", 99, "dinner"), Reserve__RequestSchema(1, 24, 1, 8, Seq<str>["lunch", "dinner"])) => validation.schema_violation("guest", "str.length_scalars", "")
    party_beats_slot(Reserve__Request("Ada", 99, "brunch"), Reserve__RequestSchema(1, 24, 1, 8, Seq<str>["lunch", "dinner"])) => validation.schema_violation("party", "int.closed_range", "99")
    guest_min_edge(Reserve__Request("A", 3, "dinner"), Reserve__RequestSchema(1, 24, 1, 8, Seq<str>["lunch", "dinner"])) => Ok(Reserve__Request("A", 3, "dinner"))
    guest_max_edge(Reserve__Request("abcdefghijklmnopqrstuvwx", 3, "dinner"), Reserve__RequestSchema(1, 24, 1, 8, Seq<str>["lunch", "dinner"])) => Ok(Reserve__Request("abcdefghijklmnopqrstuvwx", 3, "dinner"))
    party_low_edge(Reserve__Request("Ada", 1, "dinner"), Reserve__RequestSchema(1, 24, 1, 8, Seq<str>["lunch", "dinner"])) => Ok(Reserve__Request("Ada", 1, "dinner"))
    party_high_edge(Reserve__Request("Ada", 8, "dinner"), Reserve__RequestSchema(1, 24, 1, 8, Seq<str>["lunch", "dinner"])) => Ok(Reserve__Request("Ada", 8, "dinner"))
    unicode_ok(Reserve__Request("héllo世界ab12", 3, "dinner"), Reserve__RequestSchema(1, 24, 1, 8, Seq<str>["lunch", "dinner"])) => Ok(Reserve__Request("héllo世界ab12", 3, "dinner"))
    bigint(Reserve__Request("Ada", -9007199254740993, "dinner"), Reserve__RequestSchema(1, 24, 1, 8, Seq<str>["lunch", "dinner"])) => validation.schema_violation("party", "int.closed_range", "-9007199254740993")
    slots_empty(Reserve__Request("Ada", 3, "dinner"), Reserve__RequestSchema(1, 24, 1, 8, Seq<str>[])) => validation.schema_violation("slot", "str.one_of", "dinner")
    slot_case(Reserve__Request("Ada", 3, "Dinner"), Reserve__RequestSchema(1, 24, 1, 8, Seq<str>["lunch", "dinner"])) => validation.schema_violation("slot", "str.one_of", "Dinner")
    ws_preserved(Reserve__Request(" ab ", 3, "dinner"), Reserve__RequestSchema(1, 24, 1, 8, Seq<str>["lunch", "dinner"])) => Ok(Reserve__Request(" ab ", 3, "dinner"))
  match schema.guest_minimum >= 0
    true => match call std__validate__str_length(request.guest, schema.guest_minimum, schema.guest_maximum)
      given
        ok => [exchange args (value = "Ada", minimum = 1, maximum = 24) outcome Ok("Ada")]
        guest_short => [exchange args (value = "", minimum = 1, maximum = 24) outcome validation.invalid_length(value = "", minimum = 1, maximum = 24)]
        guest_long => [exchange args (value = "abcdefghijklmnopqrstuvwxy", minimum = 1, maximum = 24) outcome validation.invalid_length(value = "abcdefghijklmnopqrstuvwxy", minimum = 1, maximum = 24)]
        guest_bounds => [exchange args (value = "Ada", minimum = 5, maximum = 1) outcome validation.invalid_bounds(lower = 5, upper = 1)]
        party_below => [exchange args (value = "Ada", minimum = 1, maximum = 24) outcome Ok("Ada")]
        party_above => [exchange args (value = "Ada", minimum = 1, maximum = 24) outcome Ok("Ada")]
        party_bounds => [exchange args (value = "Ada", minimum = 1, maximum = 24) outcome Ok("Ada")]
        slot_bad => [exchange args (value = "Ada", minimum = 1, maximum = 24) outcome Ok("Ada")]
        guest_beats_policy => [exchange args (value = "", minimum = 1, maximum = 24) outcome validation.invalid_length(value = "", minimum = 1, maximum = 24)]
        guest_beats_party => [exchange args (value = "", minimum = 1, maximum = 24) outcome validation.invalid_length(value = "", minimum = 1, maximum = 24)]
        party_beats_slot => [exchange args (value = "Ada", minimum = 1, maximum = 24) outcome Ok("Ada")]
        guest_min_edge => [exchange args (value = "A", minimum = 1, maximum = 24) outcome Ok("A")]
        guest_max_edge => [exchange args (value = "abcdefghijklmnopqrstuvwx", minimum = 1, maximum = 24) outcome Ok("abcdefghijklmnopqrstuvwx")]
        party_low_edge => [exchange args (value = "Ada", minimum = 1, maximum = 24) outcome Ok("Ada")]
        party_high_edge => [exchange args (value = "Ada", minimum = 1, maximum = 24) outcome Ok("Ada")]
        unicode_ok => [exchange args (value = "héllo世界ab12", minimum = 1, maximum = 24) outcome Ok("héllo世界ab12")]
        bigint => [exchange args (value = "Ada", minimum = 1, maximum = 24) outcome Ok("Ada")]
        slots_empty => [exchange args (value = "Ada", minimum = 1, maximum = 24) outcome Ok("Ada")]
        slot_case => [exchange args (value = "Ada", minimum = 1, maximum = 24) outcome Ok("Ada")]
        ws_preserved => [exchange args (value = " ab ", minimum = 1, maximum = 24) outcome Ok(" ab ")]
        admitted => [exchange args (value = "Ada", minimum = 1, maximum = 24) outcome Ok("Ada")]
        rejected => [exchange args (value = "", minimum = 1, maximum = 24) outcome validation.invalid_length(value = "", minimum = 1, maximum = 24)]
      on validation.invalid_bounds _ => match call std__convert__int_to_str(schema.guest_minimum)
        given
          guest_bounds => [exchange args (value = 5) outcome Ok("5")]
        on Ok lo => match call std__convert__int_to_str(schema.guest_maximum)
          given
            guest_bounds => [exchange args (value = 1) outcome Ok("1")]
          on Ok hi => validation.schema_violation("", "schema.guest_bounds", "minimum=" + lo.value + ";maximum=" + hi.value)
      on validation.invalid_length _ => validation.schema_violation("guest", "str.length_scalars", request.guest)
      on Ok _ => match call std__validate__int_range(request.party, schema.party_lower, schema.party_upper)
        given
          ok => [exchange args (value = 3, lower = 1, upper = 8) outcome Ok(3)]
          party_below => [exchange args (value = 0, lower = 1, upper = 8) outcome validation.out_of_range(value = 0, lower = 1, upper = 8)]
          party_above => [exchange args (value = 9, lower = 1, upper = 8) outcome validation.out_of_range(value = 9, lower = 1, upper = 8)]
          party_bounds => [exchange args (value = 3, lower = 8, upper = 1) outcome validation.invalid_bounds(lower = 8, upper = 1)]
          slot_bad => [exchange args (value = 3, lower = 1, upper = 8) outcome Ok(3)]
          party_beats_slot => [exchange args (value = 99, lower = 1, upper = 8) outcome validation.out_of_range(value = 99, lower = 1, upper = 8)]
          guest_min_edge => [exchange args (value = 3, lower = 1, upper = 8) outcome Ok(3)]
          guest_max_edge => [exchange args (value = 3, lower = 1, upper = 8) outcome Ok(3)]
          party_low_edge => [exchange args (value = 1, lower = 1, upper = 8) outcome Ok(1)]
          party_high_edge => [exchange args (value = 8, lower = 1, upper = 8) outcome Ok(8)]
          unicode_ok => [exchange args (value = 3, lower = 1, upper = 8) outcome Ok(3)]
          bigint => [exchange args (value = -9007199254740993, lower = 1, upper = 8) outcome validation.out_of_range(value = -9007199254740993, lower = 1, upper = 8)]
          slots_empty => [exchange args (value = 3, lower = 1, upper = 8) outcome Ok(3)]
          slot_case => [exchange args (value = 3, lower = 1, upper = 8) outcome Ok(3)]
          ws_preserved => [exchange args (value = 3, lower = 1, upper = 8) outcome Ok(3)]
          admitted => [exchange args (value = 3, lower = 1, upper = 8) outcome Ok(3)]
        on validation.invalid_bounds _ => match call std__convert__int_to_str(schema.party_lower)
          given
            party_bounds => [exchange args (value = 8) outcome Ok("8")]
          on Ok lo => match call std__convert__int_to_str(schema.party_upper)
            given
              party_bounds => [exchange args (value = 1) outcome Ok("1")]
            on Ok hi => validation.schema_violation("", "schema.party_bounds", "lower=" + lo.value + ";upper=" + hi.value)
        on validation.out_of_range _ => match call std__convert__int_to_str(request.party)
          given
            party_below => [exchange args (value = 0) outcome Ok("0")]
            party_above => [exchange args (value = 9) outcome Ok("9")]
            party_beats_slot => [exchange args (value = 99) outcome Ok("99")]
            bigint => [exchange args (value = -9007199254740993) outcome Ok("-9007199254740993")]
          on Ok r => validation.schema_violation("party", "int.closed_range", r.value)
        on Ok _ => match call std__validate__str_one_of(request.slot, schema.allowed_slots)
          given
            ok => [exchange args (value = "dinner", allowed = Seq<str>["lunch", "dinner"]) outcome Ok("dinner")]
            slot_bad => [exchange args (value = "brunch", allowed = Seq<str>["lunch", "dinner"]) outcome validation.not_allowed(value = "brunch")]
            guest_min_edge => [exchange args (value = "dinner", allowed = Seq<str>["lunch", "dinner"]) outcome Ok("dinner")]
            guest_max_edge => [exchange args (value = "dinner", allowed = Seq<str>["lunch", "dinner"]) outcome Ok("dinner")]
            party_low_edge => [exchange args (value = "dinner", allowed = Seq<str>["lunch", "dinner"]) outcome Ok("dinner")]
            party_high_edge => [exchange args (value = "dinner", allowed = Seq<str>["lunch", "dinner"]) outcome Ok("dinner")]
            unicode_ok => [exchange args (value = "dinner", allowed = Seq<str>["lunch", "dinner"]) outcome Ok("dinner")]
            slots_empty => [exchange args (value = "dinner", allowed = Seq<str>[]) outcome validation.not_allowed(value = "dinner")]
            slot_case => [exchange args (value = "Dinner", allowed = Seq<str>["lunch", "dinner"]) outcome validation.not_allowed(value = "Dinner")]
            ws_preserved => [exchange args (value = "dinner", allowed = Seq<str>["lunch", "dinner"]) outcome Ok("dinner")]
            admitted => [exchange args (value = "dinner", allowed = Seq<str>["lunch", "dinner"]) outcome Ok("dinner")]
          on validation.not_allowed _ => validation.schema_violation("slot", "str.one_of", request.slot)
          on Ok _ => Ok(request)
    false => match call std__convert__int_to_str(schema.guest_minimum)
      given
        guest_min_negative => [exchange args (value = -1) outcome Ok("-1")]
      on Ok r => validation.schema_violation("", "schema.guest_minimum", r.value)

// Admission stays pure: a rejected request never reaches
// confirmation, and the whole path executes under linked-pure
// evaluation with no script fallback for the admit step itself.
fn reserve__request__admit(request: Reserve__Request, schema: Reserve__RequestSchema) -> Reserve__Confirmation rev 1
  emits [validation.schema_violation]
  tests
    admitted(Reserve__Request("Ada", 3, "dinner"), Reserve__RequestSchema(1, 24, 1, 8, Seq<str>["lunch", "dinner"])) => Ok("Ada", 3, "dinner")
    rejected(Reserve__Request("", 3, "dinner"), Reserve__RequestSchema(1, 24, 1, 8, Seq<str>["lunch", "dinner"])) => validation.schema_violation("guest", "str.length_scalars", "")
  match call reserve__request__validate(request, schema)
    on validation.schema_violation e => forward e
    on Ok v => Ok(v.value.guest, v.value.party, v.value.slot)
