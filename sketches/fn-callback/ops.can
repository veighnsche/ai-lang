mod ops
  provides [ops__divmod, ops__bump, Ops__Quot, Ops__Dec]
  uses []
  emits [ops.zero_divisor]

error ops.zero_divisor(detail: str)

type Ops__Quot rev 1 (
  quotient: int
  remainder: int
)

type Ops__Dec rev 1 (
  value: dec
)

fn ops__divmod(divisor: int, dividend: int) -> Ops__Quot rev 1
  emits [ops.zero_divisor]
  tests
    d(3, 7) => Ok(2, 1)
    dz(0, 7) => ops.zero_divisor("zero")
  match divisor
    on 0 => ops.zero_divisor("zero")
    on _ => Ok(dividend / divisor, dividend % divisor)

fn ops__bump(step: dec, x: dec) -> Ops__Dec rev 1
  emits []
  tests
    b(d"0.5", d"1.0") => Ok(d"1.5")
  Ok(x + step)
