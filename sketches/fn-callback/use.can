mod use
  provides [use__bind, use__run, use__go, use__binddec, use__rundec, Use__Cb, Use__CbDec]
  uses [ops__divmod@1, ops__bump@1]
  emits []

type Use__Cb rev 1 (
  cb: Fn<int, Ops__Quot, [ops.zero_divisor]>
)

type Use__CbDec rev 1 (
  cb: Fn<dec, Ops__Dec, []>
)

fn use__bind(d: int) -> Use__Cb rev 1
  emits []
  tests
    bind(3) => Ok(fnref ops__divmod(divisor = 3))
  Ok(fnref ops__divmod(divisor = d))

fn use__run(cb: Fn<int, Ops__Quot, [ops.zero_divisor]>, n: int) -> Ops__Quot rev 1
  emits []
  tests
    run(fnref ops__divmod(divisor = 3), 7) => Ok(2, 1)
    runz(fnref ops__divmod(divisor = 0), 7) => Ok(0, 0)
  match invoke cb with n
    on Ok r => Ok(r.quotient, r.remainder)
    on ops.zero_divisor _ => Ok(0, 0)

fn use__go(d: int, n: int) -> Ops__Quot rev 1
  emits []
  tests
    go(3, 7) => Ok(2, 1)
    goz(0, 7) => Ok(0, 0)
  match call use__bind(d)
    on Ok h => match call use__run(h.cb, n)
      on Ok r => Ok(r.quotient, r.remainder)

fn use__binddec(s: dec) -> Use__CbDec rev 1
  emits []
  tests
    bindd(d"0.5") => Ok(fnref ops__bump(step = d"0.5"))
  Ok(fnref ops__bump(step = s))

fn use__rundec(cb: Fn<dec, Ops__Dec, []>, x: dec) -> Ops__Dec rev 1
  emits []
  tests
    rund(fnref ops__bump(step = d"0.5"), d"1.0") => Ok(d"1.5")
  match invoke cb with x
    on Ok r => Ok(r.value)
