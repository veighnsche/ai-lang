// sketches/host-clock/clock.can — first shared-extern consumer: a
// wall-clock read through the pinned std host wrapper (b02). The
// call scripts like any foreign call; the host owns the millis.

mod clockdemo
  provides [clockdemo__read_millis, Clockdemo__Seen]
  uses [std__clock__wall_now@1]
  emits [clock.unavailable]

type Clockdemo__Seen rev 1 (
  millis: int
)

fn clockdemo__read_millis() -> Clockdemo__Seen rev 1
  emits [clock.unavailable]
  tests
    ok() => Ok(1726920000000)
    down() => clock.unavailable()
  match call std__clock__wall_now()
    given
      ok => [exchange args () outcome Ok(1726920000000)]
      down => [exchange args () outcome clock.unavailable()]
    on clock.unavailable _ => clock.unavailable()
    on Ok t => Ok(t.millis)
