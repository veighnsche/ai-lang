// sketches/lint-errors/ladder.can — pure ladder over different
// scrutinees. Valid, passing, modcheck-clean; the nest is a
// lint error (fold into a multi-scrutinee table with don't-care
// slots). Guarded, impure, and call-carrying nests would stay
// nested; this is none of those.
mod ladder
  provides [ladder__signs, Ladder__Value]
  uses []
  emits []

type Ladder__Value rev 1 (
  value: int
)

fn ladder__signs(a: int, b: int) -> Ladder__Value rev 1
  emits []
  tests
    neg_any(-1, 9) => Ok(value = 0)
    pos_neg(1, -2) => Ok(value = 1)
    pos_pos(1, 2) => Ok(value = 2)
  match a < 0
    true => Ok(value = 0)
    false => match b < 0
      true => Ok(value = 1)
      false => Ok(value = 2)
