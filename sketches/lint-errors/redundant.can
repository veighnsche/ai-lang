// sketches/lint-errors/redundant.can — named arguments sitting in
// their own parameter slots. Valid, passing, modcheck-clean; every
// named arg below is a lint error (redundant argument name).
// Reordered names stay legal: they do work positional cannot.
mod redundant
  provides [redundant__sub, redundant__id, Redundant__Value]
  uses []
  emits []

type Redundant__Value rev 1 (
  value: int
)

fn redundant__sub(left: int, right: int) -> Redundant__Value rev 1
  emits []
  tests
    ordered(left = 5, right = 8) => Ok(value = -3)
    mixed(5, right = 8) => Ok(value = -3)
    reordered(right = 8, left = 5) => Ok(value = -3)
=
  match call redundant__id(value = left)
    on Ok r => Ok(value = r.value - right)

fn redundant__id(value: int) -> Redundant__Value rev 1
  emits []
  tests
    one(value = 1) => Ok(value = 1)
=
  Ok(value = value)
