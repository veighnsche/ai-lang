// sketches/lint-errors/ranges.can — contiguous int ranges with
// one outcome. Valid, passing, modcheck-clean; the pair is a
// lint error (join into one range). The gapped range and the
// wildcard stay: gaps cannot spell, wildcards stay separate.
mod ranges
  provides [ranges__classify, Ranges__Value]
  uses []
  emits []

type Ranges__Value rev 1 (
  value: int
)

fn ranges__classify(value: int) -> Ranges__Value rev 1
  emits []
  tests
    low(2) => Ok(1)
    mid(5) => Ok(1)
    high(9) => Ok(2)
    other(0) => Ok(0)
  match value
    1..3 => Ok(1)
    4..6 => Ok(1)
    8..9 => Ok(2)
    _ => Ok(0)
