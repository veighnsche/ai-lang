// sketches/lint-errors/chain.can — two sequential calls sharing
// one failure outcome. Valid, passing, modcheck-clean; the
// ladder is a lint error (chainable ladder: rewrite as match
// chain). Constant failure payloads keep this file to one rule;
// relay-shaped payloads would add relay findings (see relay.can).
// The step decrements so each test takes a different arm: two
// runs both calls, one fails the second, zero fails the first.
mod chain
  provides [chain__go, chain__step, Chain__Value]
  uses []
  emits [chain.failed]

error chain.failed(value: int)

type Chain__Value rev 1 (
  value: int
)

fn chain__step(value: int) -> Chain__Value rev 1
  emits [chain.failed]
  tests
    ok(1) => Ok(value = 0)
    bad(0) => chain.failed(value = 0)
  match value == 0
    true => chain.failed(value = value)
    false => Ok(value = value - 1)

fn chain__go(value: int) -> Chain__Value rev 1
  emits [chain.failed]
  tests
    two(2) => Ok(value = 0)
    one(1) => chain.failed(value = 0)
    zero(0) => chain.failed(value = 0)
  match call chain__step(value)
    on Ok a => match call chain__step(a.value)
      on Ok b => Ok(value = b.value)
      on chain.failed e => chain.failed(value = 0)
    on chain.failed e => chain.failed(value = 0)
