// sketches/lint-errors/stale.can — a given key naming a test
// that cannot reach the call. Valid, passing, modcheck-clean;
// the stale row is a lint error (unreached key: delete the
// row). The solo test belongs to a fn that never calls the
// scripted fn, so its script never selects. Own-test keys
// select normally and stay silent.
mod stale
  provides [stale__go, stale__other, Stale__Doc, net__fetch]
  uses []
  emits [net.down, stale.empty]

error net.down()
error stale.empty()

type Stale__Doc rev 1 (
  body: str
)

extern net__fetch() -> Stale__Doc rev 1
  emits [net.down]

fn stale__go() -> Stale__Doc rev 1
  emits [stale.empty]
  tests
    ok() => Ok("hi")
    down() => stale.empty()
  match call net__fetch()
    given
      ok => [exchange args () outcome Ok("hi")]
      down => [exchange args () outcome net.down()]
      solo => [exchange args () outcome net.down()]
    on net.down _ => stale.empty()
    on Ok d => Ok(d.body)

fn stale__other() -> Stale__Doc rev 1
  emits [stale.empty]
  tests
    solo() => stale.empty()
  stale.empty()
