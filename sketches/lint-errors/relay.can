// sketches/lint-errors/relay.can — an error arm rebuilding its
// own kind field-for-field from its binder. Valid, passing,
// modcheck-clean; the handwritten form is a lint error (write
// forward e). The remapped arm stays handwritten: different
// payload, different spelling needed. The step raises both
// kinds so each go arm executes.
mod relay
  provides [relay__go, relay__step, Relay__Value]
  uses []
  emits [relay.failed, relay.other]

error relay.failed(value: int)
error relay.other(value: int, note: str)

type Relay__Value rev 1 (
  value: int
)

fn relay__step(value: int) -> Relay__Value rev 1
  emits [relay.failed, relay.other]
  tests
    ok(1) => Ok(value = 1)
    bad(0) => relay.failed(value = 0)
    neg(-1) => relay.other(value = -1, note = "neg")
  match value == 0
    true => relay.failed(value = value)
    false => match value < 0
      true => relay.other(value = value, note = "neg")
      false => Ok(value = value)

fn relay__go(value: int) -> Relay__Value rev 1
  emits [relay.failed, relay.other]
  tests
    ok(1) => Ok(value = 1)
    bad(0) => relay.failed(value = 0)
    neg(-1) => relay.other(value = -1, note = "kept")
  match call relay__step(value)
    on Ok a => Ok(value = a.value)
    on relay.failed e => relay.failed(value = e.value)
    on relay.other e => relay.other(value = e.value, note = "kept")
