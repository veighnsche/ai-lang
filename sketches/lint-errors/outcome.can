// sketches/lint-errors/outcome.can — a match that decides
// nothing: every arm yields one expression over a pure
// scrutinee. Valid, passing, modcheck-clean; the match is a
// lint error (drop the match). A faulting scrutinee would keep
// its match; this one cannot fault.
mod outcome
  provides [outcome__zero, Outcome__Value]
  uses []
  emits []

type Outcome__Value rev 1 (
  value: int
)

fn outcome__zero(value: int) -> Outcome__Value rev 1
  emits []
  tests
    pos(1) => Ok(value = 0)
    neg(-1) => Ok(value = 0)
  match value < 0
    true => Ok(value = 0)
    false => Ok(value = 0)
