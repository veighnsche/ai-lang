// sketches/lint-errors/relaycall.can — a call match forwarding
// every outcome. Valid, passing, modcheck-clean; the relay is
// a lint error (rewrite as forward call). Rebuilding arms,
// given tables, and foreign callees would stay matches; these
// are none of those.
mod relaycall
  provides [relaycall__go, relaycall__work, Relaycall__Out, Relaycall__Work]
  uses []
  emits [relaycall.bad]

error relaycall.bad(value: str)

type Relaycall__Out rev 1 (
  value: str
)

type Relaycall__Work rev 1 (
  value: str
)

fn relaycall__work(v: str) -> Relaycall__Work rev 1
  emits [relaycall.bad]
  tests
    w("x") => Ok(value = "x")
    u("b") => relaycall.bad(value = "b")
  match v == "b"
    true => relaycall.bad(value = v)
    false => Ok(value = v)

fn relaycall__go(x: str) -> Relaycall__Out rev 1
  emits [relaycall.bad]
  tests
    ok("a") => Ok(value = "a")
    bad("b") => relaycall.bad(value = "b")
  match call relaycall__work(x)
    on Ok r => forward r
    on relaycall.bad e => forward e
