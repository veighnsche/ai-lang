mod pick
  provides [Pick__Value, pick__choose, pick__identity, pick__checked, pick__relay, pick__relay_generic]
  uses []
  emits [pick.denied]

error pick.denied(value: int)

variant Pick__Value<T> rev 1 (
  case Some(value: T)
  case None()
)

fn pick__choose<T>(present: bool, value: T) -> Pick__Value<T> rev 1
  emits []
  tests
    some_int<T=int>(true, 7) => Ok(Pick__Some<int>(7))
    none_int<T=int>(false, 7) => Ok(Pick__None<int>())
    some_str<T=str>(true, "a") => Ok(value = Pick__Some<str>("a"))
    none_str<T=str>(false, "a") => Ok(Pick__None<str>())
  match present
    true => Ok(Pick__Some<T>(value))
    false => Ok(Pick__None<T>())

fn pick__identity<T>(value: Pick__Value<T>) -> Pick__Value<T> rev 1
  emits []
  tests
    some_int<T=int>(Pick__Some<int>(7)) => Ok(Pick__Some<int>(7))
    none_int<T=int>(Pick__None<int>()) => Ok(Pick__None<int>())
    some_str<T=str>(Pick__Some<str>("a")) => Ok(Pick__Some<str>("a"))
    none_str<T=str>(Pick__None<str>()) => Ok(Pick__None<str>())
  Ok(value)

fn pick__checked(value: int) -> Pick__Value<int> rev 1
  emits [pick.denied]
  tests
    some(7) => Ok(Pick__Some<int>(7))
    none(0) => Ok(Pick__None<int>())
    denied(-1) => pick.denied(-1)
  match value < 0, value == 0
    true, _ => pick.denied(value)
    false, true => Ok(Pick__None<int>())
    false, false => Ok(Pick__Some<int>(value))

fn pick__relay(value: int) -> Pick__Value<int> rev 1
  emits [pick.denied]
  tests
    some(7) => Ok(Pick__Some<int>(7))
    none(0) => Ok(Pick__None<int>())
    denied(-1) => pick.denied(-1)
  match value
    _ => forward call pick__checked(value)

fn pick__relay_generic<T>(present: bool, value: T) -> Pick__Value<T> rev 1
  emits []
  tests
    some_int<T=int>(true, 7) => Ok(Pick__Some<int>(7))
    none_int<T=int>(false, 7) => Ok(Pick__None<int>())
    some_str<T=str>(true, "a") => Ok(Pick__Some<str>("a"))
    none_str<T=str>(false, "a") => Ok(Pick__None<str>())
  match call pick__choose<T>(present, value)
    on Ok r => forward r
