mod use
  provides [use__label, use__relay, use__recover, Use__Text]
  uses [Pick__Value@1, pick__checked@1]
  emits [pick.denied]

type Use__Text rev 1 (
  value: str
)

fn use__label(value: int) -> Use__Text rev 1
  emits []
  tests
    some(7) => Ok("present")
    none(0) => Ok("absent")
    denied(-1) => Ok("denied")
  match call pick__checked(value)
    given
      some => [exchange args (value = 7) outcome Ok(Pick__Some<int>(7))]
      none => [exchange args (value = 0) outcome Ok(Pick__None<int>())]
      denied => [exchange args (value = -1) outcome pick.denied(-1)]
    on Ok r => match r.value
      on Pick__Some<int> s => Ok("present")
      on Pick__None<int> _ => Ok("absent")
    on pick.denied e => Ok("denied")

fn use__relay(value: int) -> Pick__Value<int> rev 1
  emits [pick.denied]
  tests
    some(7) => Ok(Pick__Some<int>(7))
    none(0) => Ok(Pick__None<int>())
    denied(-1) => pick.denied(-1)
  match call pick__checked(value)
    given
      some => [exchange args (value = 7) outcome Ok(Pick__Some<int>(7))]
      none => [exchange args (value = 0) outcome Ok(Pick__None<int>())]
      denied => [exchange args (value = -1) outcome pick.denied(-1)]
    on Ok r => forward r
    on pick.denied e => forward e

fn use__recover(value: int) -> Pick__Value<int> rev 1
  emits []
  tests
    some(7) => Ok(Pick__Some<int>(7))
    none(0) => Ok(Pick__None<int>())
    denied(-1) => Ok(Pick__None<int>())
  match call pick__checked(value)
    given
      some => [exchange args (value = 7) outcome Ok(Pick__Some<int>(7))]
      none => [exchange args (value = 0) outcome Ok(Pick__None<int>())]
      denied => [exchange args (value = -1) outcome pick.denied(-1)]
    on Ok r => Ok(r.value)
    on pick.denied e => Ok(Pick__None<int>())
