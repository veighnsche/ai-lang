mod use
  provides [Use__Bound, Use__Number, use__bind, use__apply, use__number, use__checked, use__recover, use__go]
  uses [Choice__Value@1, choice__choose@1, choice__checked@1]
  emits [choice.denied]

type Use__Bound<T> rev 1 (
  cb: Fn<T, Choice__Value<T>, []>
)

type Use__Number rev 1 (
  value: int
)

fn use__bind<T>(present: bool) -> Use__Bound<T> rev 1
  emits []
  tests
    some_int<T=int>(true) => Ok(fnref choice__choose<int>(present = true))
    none_int<T=int>(false) => Ok(fnref choice__choose<int>(present = false))
    some_str<T=str>(true) => Ok(fnref choice__choose<str>(present = true))
    none_str<T=str>(false) => Ok(fnref choice__choose<str>(present = false))
  Ok(fnref choice__choose<T>(present = present))

fn use__apply<T>(cb: Fn<T, Choice__Value<T>, []>, value: T) -> Choice__Value<T> rev 1
  emits []
  tests
    some_int<T=int>(fnref choice__choose<int>(present = true), 7) => Ok(Choice__Some<int>(7))
    none_int<T=int>(fnref choice__choose<int>(present = false), 7) => Ok(Choice__None<int>())
    some_str<T=str>(fnref choice__choose<str>(present = true), "a") => Ok(Choice__Some<str>("a"))
    none_str<T=str>(fnref choice__choose<str>(present = false), "a") => Ok(Choice__None<str>())
  match invoke cb with value
    on Ok r => forward r

fn use__number(cb: Fn<int, Choice__Value<int>, [choice.denied]>, value: int) -> Use__Number rev 1
  emits []
  tests
    some(fnref choice__checked(), 7) => Ok(7)
    none(fnref choice__checked(), 0) => Ok(0)
    denied(fnref choice__checked(), -1) => Ok(-1)
  match invoke cb with value
    on Ok r => match r.value
      on Choice__Some<int> s => Ok(s.value)
      on Choice__None<int> _ => Ok(0)
    on choice.denied e => Ok(-1)

fn use__checked(cb: Fn<int, Choice__Value<int>, [choice.denied]>, value: int) -> Choice__Value<int> rev 1
  emits [choice.denied]
  tests
    some(fnref choice__checked(), 7) => Ok(Choice__Some<int>(7))
    none(fnref choice__checked(), 0) => Ok(Choice__None<int>())
    denied(fnref choice__checked(), -1) => choice.denied(-1)
  match invoke cb with value
    on Ok r => forward r
    on choice.denied e => forward e

fn use__recover(cb: Fn<int, Choice__Value<int>, [choice.denied]>, value: int) -> Choice__Value<int> rev 1
  emits []
  tests
    some(fnref choice__checked(), 7) => Ok(Choice__Some<int>(7))
    none(fnref choice__checked(), 0) => Ok(Choice__None<int>())
    denied(fnref choice__checked(), -1) => Ok(Choice__None<int>())
  match invoke cb with value
    on Ok r => Ok(r.value)
    on choice.denied e => Ok(Choice__None<int>())

fn use__go(present: bool, value: int) -> Choice__Value<int> rev 1
  emits []
  tests
    some(true, 7) => Ok(Choice__Some<int>(7))
    none(false, 7) => Ok(Choice__None<int>())
  match call use__bind<int>(present)
    on Ok bound => match call use__apply<int>(bound.cb, value)
      on Ok r => forward r
