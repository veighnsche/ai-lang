mod choice
  provides [Choice__Value, choice__choose, choice__checked]
  uses []
  emits [choice.denied]

error choice.denied(value: int)

variant Choice__Value<T> rev 1 (
  case Some(value: T)
  case None()
)

fn choice__choose<T>(present: bool, value: T) -> Choice__Value<T> rev 1
  emits []
  tests
    some_int<T=int>(true, 7) => Ok(Choice__Some<int>(7))
    none_int<T=int>(false, 7) => Ok(Choice__None<int>())
    some_str<T=str>(true, "a") => Ok(Choice__Some<str>("a"))
    none_str<T=str>(false, "a") => Ok(Choice__None<str>())
  match present
    true => Ok(Choice__Some<T>(value))
    false => Ok(Choice__None<T>())

fn choice__checked(value: int) -> Choice__Value<int> rev 1
  emits [choice.denied]
  tests
    some(7) => Ok(Choice__Some<int>(7))
    none(0) => Ok(Choice__None<int>())
    denied(-1) => choice.denied(-1)
  match value < 0, value == 0
    true, _ => choice.denied(value)
    false, true => Ok(Choice__None<int>())
    false, false => Ok(Choice__Some<int>(value))
