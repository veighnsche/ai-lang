// leap-year/leap.can — Gregorian leap-year rule as one flat
// three-slot match (a28): divisibility by 400, 100, and 4. The
// century exception reads top to bottom: 400 wins, 100 loses,
// 4 wins, else loses. Wildcards keep four arms exhaustive, each
// witnessed by its own table row (a03). Follows the std is_*
// predicate naming (std__int__is_zero, std__int__is_prime).

mod leap
  provides [leap__is_leap, Leap__Answer]
  uses []
  emits []

type Leap__Answer rev 1 (
  leap: bool
)

fn leap__is_leap(year: int) -> Leap__Answer rev 1
  emits []
  tests
    quadricentennial(year = 2000) => Ok(leap = true)
    century(year = 1900) => Ok(leap = false)
    typical_leap(year = 2024) => Ok(leap = true)
    typical_common(year = 2023) => Ok(leap = false)
=
  match year % 400 == 0, year % 100 == 0, year % 4 == 0
    true, _, _ => Ok(leap = true)
    false, true, _ => Ok(leap = false)
    false, false, true => Ok(leap = true)
    false, false, false => Ok(leap = false)
