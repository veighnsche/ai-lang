// hello-world/hello.can — the smallest complete program: one module,
// one type, one pure function, one decision-table row. No state, no
// effects, no errors. Tests read as call specifications:
// name(inputs) => expected output.

mod hello
  provides [hello__world, Hello__Message]
  uses []
  emits []

type Hello__Message rev 1 (
  text: str
)

fn hello__world() -> Hello__Message rev 1
  emits []
  tests
    greeting() => Ok(text = "Hello, world!")
=
  Ok(text = "Hello, world!")
