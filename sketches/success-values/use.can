mod use
  provides [use__apply, use__relay, use__box, use__factory, use__factory_apply, use__require, use__recover, use__host, use__host_result]
  uses [success__id@1, success__box@1, success__reference@1, success__require@1]
  emits [option.absent]

error option.absent()

extern use__host(present: bool) -> Success__Pair rev 1
  emits [option.absent]

fn use__host_result(present: bool) -> Success__Pair rev 1
  emits [option.absent]
  tests
    yes(true) => Ok<Success__Pair>(Success__Pair(7, true))
    no(false) => option.absent()
  match call use__host(present)
    given
      yes => [exchange args (present = true) outcome Ok<Success__Pair>(Success__Pair(7, true))]
      no => [exchange args (present = false) outcome option.absent()]
    on Ok<Success__Pair> pair => Ok<Success__Pair>(pair)
    on option.absent e => forward e

fn use__apply<T>(cb: Fn<T, T, []>, value: T) -> T rev 1
  emits []
  tests
    pair<T=Success__Pair>(fnref success__id<Success__Pair>(), Success__Pair(7, true)) => Ok(7, true)
    empty<T=Success__Empty>(fnref success__id<Success__Empty>(), Success__Empty()) => Ok()
    field<T=Success__Value>(fnref success__id<Success__Value>(), Success__Value(9)) => Ok(9)
    integer<T=int>(fnref success__id<int>(), 7) => Ok(7)
    bytes<T=Bytes>(fnref success__id<Bytes>(), Bytes(Seq<int>[0, 255])) => Ok(Bytes(Seq<int>[0, 255]))
    sequence<T=Seq<int>>(fnref success__id<Seq<int>>(), Seq<int>[1, 2]) => Ok(Seq<int>[1, 2])
  match invoke cb with value
    on Ok<T> result => Ok<T>(result)

fn use__relay<T>(value: T) -> T rev 1
  emits []
  tests
    pair<T=Success__Pair>(Success__Pair(7, true)) => Ok(7, true)
    integer<T=int>(7) => Ok(7)
  match call use__apply<T>(fnref success__id<T>(), value)
    on Ok<T> result => forward result

fn use__box<T>(value: T) -> Success__Box<T> rev 1
  emits []
  tests
    pair<T=Success__Pair>(Success__Pair(7, true)) => Ok(Success__Pair(7, true))
    integer<T=int>(7) => Ok(7)
  match call success__box<T>(value)
    given
      pair => [exchange args (value = Success__Pair(7, true)) outcome Ok<Success__Box<Success__Pair>>(Success__Box<Success__Pair>(Success__Pair(7, true)))]
      integer => [exchange args (value = 7) outcome Ok<Success__Box<int>>(Success__Box<int>(7))]
    on Ok<Success__Box<T>> box => Ok<Success__Box<T>>(box)

fn use__factory<T>() -> Fn<T, T, []> rev 1
  emits []
  tests
    pair<T=Success__Pair>() => Ok(fnref success__id<Success__Pair>())
    integer<T=int>() => Ok(fnref success__id<int>())
  match call success__reference<T>()
    given
      pair => [exchange args () outcome Ok(fnref success__id<Success__Pair>())]
      integer => [exchange args () outcome Ok(fnref success__id<int>())]
    on Ok<Fn<T, T, []>> cb => Ok<Fn<T, T, []>>(cb)

fn use__factory_apply<T>(value: T) -> T rev 1
  emits []
  tests
    pair<T=Success__Pair>(Success__Pair(7, true)) => Ok(7, true)
    integer<T=int>(7) => Ok(7)
  match call use__factory<T>()
    on Ok<Fn<T, T, []>> cb => match call use__apply<T>(cb, value)
      on Ok<T> result => Ok<T>(result)

fn use__require<T>(cb: Fn<Success__Option<T>, T, [option.absent]>, value: Success__Option<T>) -> T rev 1
  emits [option.absent]
  tests
    pair_some<T=Success__Pair>(fnref success__require<Success__Pair>(), Success__Some<Success__Pair>(Success__Pair(7, true))) => Ok(7, true)
    pair_none<T=Success__Pair>(fnref success__require<Success__Pair>(), Success__None<Success__Pair>()) => option.absent()
    int_some<T=int>(fnref success__require<int>(), Success__Some<int>(7)) => Ok(7)
    int_none<T=int>(fnref success__require<int>(), Success__None<int>()) => option.absent()
  match invoke cb with value
    on Ok<T> result => forward result
    on option.absent e => forward e

fn use__recover(value: Success__Option<Success__Pair>) -> Success__Pair rev 1
  emits []
  tests
    some(Success__Some<Success__Pair>(Success__Pair(7, true))) => Ok(7, true)
    none(Success__None<Success__Pair>()) => Ok(0, false)
  match call use__require<Success__Pair>(fnref success__require<Success__Pair>(), value)
    on Ok<Success__Pair> result => Ok<Success__Pair>(result)
    on option.absent e => Ok<Success__Pair>(Success__Pair(0, false))
