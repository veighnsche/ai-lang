mod success
  provides [Success__Pair, Success__Value, Success__Empty, Success__Box, Success__Option, Success__Token, success__id, success__box, success__reference, success__value_or, success__require, success__map, success__pair, success__mapped]
  uses []
  emits [option.absent]

error option.absent()

brand Success__Token is str rev 1

type Success__Pair rev 1 (
  left: int
  right: bool
)

type Success__Value rev 1 (
  value: int
)

type Success__Empty rev 1 (
)

type Success__Box<T> rev 1 (
  item: T
)

variant Success__Option<T> rev 1 (
  case Some(value: T)
  case None()
)

fn success__id<T>(value: T) -> T rev 1
  emits []
  tests
    pair<T=Success__Pair>(Success__Pair(7, true)) => Ok(7, true)
    value_field<T=Success__Value>(Success__Value(9)) => Ok(9)
    empty<T=Success__Empty>(Success__Empty()) => Ok()
    integer<T=int>(7) => Ok(7)
    boolean<T=bool>(true) => Ok(true)
    text<T=str>("text") => Ok("text")
    decimal<T=dec>(d"0.5") => Ok(d"0.5")
    bytes<T=Bytes>(Bytes(Seq<int>[0, 255])) => Ok(Bytes(Seq<int>[0, 255]))
    sequence<T=Seq<int>>(Seq<int>[1, 2]) => Ok(Seq<int>[1, 2])
    token<T=Success__Token>(seal Success__Token("token")) => Ok(seal Success__Token("token"))
  Ok<T>(value)

fn success__box<T>(value: T) -> Success__Box<T> rev 1
  emits []
  tests
    pair<T=Success__Pair>(Success__Pair(7, true)) => Ok(Success__Pair(7, true))
    integer<T=int>(7) => Ok(7)
  Ok<Success__Box<T>>(Success__Box<T>(value))

fn success__reference<T>() -> Fn<T, T, []> rev 1
  emits []
  tests
    pair<T=Success__Pair>() => Ok(fnref success__id<Success__Pair>())
    integer<T=int>() => Ok(fnref success__id<int>())
  Ok<Fn<T, T, []>>(fnref success__id<T>())

fn success__value_or<T>(value: Success__Option<T>, alternative: T) -> T rev 1
  emits []
  tests
    pair_some<T=Success__Pair>(Success__Some<Success__Pair>(Success__Pair(7, true)), Success__Pair(0, false)) => Ok(7, true)
    pair_none<T=Success__Pair>(Success__None<Success__Pair>(), Success__Pair(0, false)) => Ok(0, false)
    int_some<T=int>(Success__Some<int>(7), 0) => Ok(7)
    int_none<T=int>(Success__None<int>(), 0) => Ok(0)
  match value
    on Success__Some<T> s => Ok<T>(s.value)
    on Success__None<T> _ => Ok<T>(alternative)

fn success__require<T>(value: Success__Option<T>) -> T rev 1
  emits [option.absent]
  tests
    pair_some<T=Success__Pair>(Success__Some<Success__Pair>(Success__Pair(7, true))) => Ok(7, true)
    pair_none<T=Success__Pair>(Success__None<Success__Pair>()) => option.absent()
    int_some<T=int>(Success__Some<int>(7)) => Ok(7)
    int_none<T=int>(Success__None<int>()) => option.absent()
  match value
    on Success__Some<T> s => Ok<T>(s.value)
    on Success__None<T> _ => option.absent()

fn success__pair(value: int) -> Success__Pair rev 1
  emits []
  tests
    positive(7) => Ok(7, true)
    negative(-3) => Ok(-3, false)
  Ok<Success__Pair>(value = Success__Pair(value, value > 0))

fn success__mapped(value: Success__Option<int>) -> Success__Option<Success__Pair> rev 1
  emits []
  tests
    some(Success__Some<int>(7)) => Ok(Success__Some<Success__Pair>(Success__Pair(7, true)))
    none(Success__None<int>()) => Ok(Success__None<Success__Pair>())
  match call success__map<int, Success__Pair>(value, fnref success__pair())
    on Ok<Success__Option<Success__Pair>> mapped => Ok<Success__Option<Success__Pair>>(mapped)

fn success__map<T, U>(value: Success__Option<T>, transform: Fn<T, U, []>) -> Success__Option<U> rev 1
  emits []
  tests
    pair_some<T=Success__Pair, U=Success__Pair>(Success__Some<Success__Pair>(Success__Pair(7, true)), fnref success__id<Success__Pair>()) => Ok(Success__Some<Success__Pair>(Success__Pair(7, true)))
    pair_none<T=Success__Pair, U=Success__Pair>(Success__None<Success__Pair>(), fnref success__id<Success__Pair>()) => Ok(Success__None<Success__Pair>())
    int_some<T=int, U=int>(Success__Some<int>(7), fnref success__id<int>()) => Ok(Success__Some<int>(7))
    int_none<T=int, U=int>(Success__None<int>(), fnref success__id<int>()) => Ok(Success__None<int>())
    mapped_some<T=int, U=Success__Pair>(Success__Some<int>(7), fnref success__pair()) => Ok(Success__Some<Success__Pair>(Success__Pair(7, true)))
    mapped_none<T=int, U=Success__Pair>(Success__None<int>(), fnref success__pair()) => Ok(Success__None<Success__Pair>())
  match value
    on Success__Some<T> s => match invoke transform with s.value
      on Ok<U> mapped => Ok<Success__Option<U>>(Success__Some<U>(mapped))
    on Success__None<T> _ => Ok<Success__Option<U>>(Success__None<U>())
