mod use
  provides [use__int, use__str, use__bool, use__dec, use__token, use__bytes, use__rows, use__choice, use__apply_bytes, use__apply_token, use__apply_items, use__apply_int, use__factory, use__factory_relay]
  uses [bridge__int@1, bridge__str@1, bridge__bool@1, bridge__dec@1, bridge__token@1, bridge__bytes@1, bridge__rows@1, bridge__choice@1, Data__Token@1, Data__Row@1, Data__Choice@1, data__mint@1, data__bytes@1, data__items@1, data__factory@1, data__add@1]
  emits [bridge.denied]

error bridge.denied()

fn use__int(allow: bool) -> int rev 1
  emits [bridge.denied]
  tests
    yes(true) => Ok(9007199254740993)
    no(false) => bridge.denied()
  match call bridge__int(allow)
    given
      yes => [exchange args (allow = true) outcome Ok(9007199254740993)]
      no => [exchange args (allow = false) outcome bridge.denied()]
    on Ok r => forward r
    on bridge.denied e => forward e

fn use__str() -> str rev 1
  emits []
  tests
    text() => Ok("hello")
  match call bridge__str()
    given
      text => [exchange args () outcome Ok("hello")]
    on Ok r => forward r

fn use__bool() -> bool rev 1
  emits []
  tests
    no() => Ok(false)
  match call bridge__bool()
    given
      no => [exchange args () outcome Ok(false)]
    on Ok r => forward r

fn use__dec() -> dec rev 1
  emits []
  tests
    fraction() => Ok(d"0.125")
  match call bridge__dec()
    given
      fraction => [exchange args () outcome Ok(d"0.125")]
    on Ok r => forward r

fn use__token() -> Data__Token rev 1
  emits []
  tests
    minted() => Ok(seal Data__Token("a"))
  match call bridge__token()
    given
      minted => [exchange args () outcome Ok(seal Data__Token("a"))]
    on Ok r => forward r

fn use__bytes() -> Bytes rev 1
  emits []
  tests
    full() => Ok(Bytes(Seq<int>[0, 255]))
  match call bridge__bytes()
    given
      full => [exchange args () outcome Ok(Bytes(Seq<int>[0, 255]))]
    on Ok r => forward r

fn use__rows() -> Seq<Data__Row> rev 1
  emits []
  tests
    rows() => Ok(Seq<Data__Row>[Data__Row(7)])
  match call bridge__rows()
    given
      rows => [exchange args () outcome Ok(Seq<Data__Row>[Data__Row(7)])]
    on Ok r => forward r

fn use__choice(some: bool) -> Data__Choice<int> rev 1
  emits []
  tests
    yes(true) => Ok(Data__Some<int>(7))
    no(false) => Ok(Data__None<int>())
  match call bridge__choice(some)
    given
      yes => [exchange args (some = true) outcome Ok(Data__Some<int>(7))]
      no => [exchange args (some = false) outcome Ok(Data__None<int>())]
    on Ok r => forward r

fn use__apply_bytes(cb: Fn<Bytes, Bytes, []>, value: Bytes) -> Bytes rev 1
  emits []
  tests
    empty(fnref data__bytes(), Bytes(Seq<int>[])) => Ok(Bytes(Seq<int>[]))
    full(fnref data__bytes(), Bytes(Seq<int>[0, 255])) => Ok(Bytes(Seq<int>[0, 255]))
  match invoke cb with value
    on Ok r => forward r

fn use__apply_token(cb: Fn<str, Data__Token, []>, value: str) -> Data__Token rev 1
  emits []
  tests
    a(fnref data__mint(), "a") => Ok(seal Data__Token("a"))
    b(fnref data__mint(), "b") => Ok(seal Data__Token("b"))
  match invoke cb with value
    on Ok r => forward r

fn use__apply_items<T>(cb: Fn<Seq<T>, Seq<T>, []>, values: Seq<T>) -> Seq<T> rev 1
  emits []
  tests
    ints<T=int>(fnref data__items<int>(), Seq<int>[7, 9]) => Ok(Seq<int>[7, 9])
    rows<T=Data__Row>(fnref data__items<Data__Row>(), Seq<Data__Row>[Data__Row(7)]) => Ok(Seq<Data__Row>[Data__Row(7)])
  match invoke cb with values
    on Ok r => forward r

fn use__apply_int(cb: Fn<int, int, []>, value: int) -> int rev 1
  emits []
  tests
    plus(fnref data__add(delta = 3), 7) => Ok(10)
    minus(fnref data__add(delta = -3), 7) => Ok(4)
  match invoke cb with value
    on Ok r => forward r

fn use__factory_relay(delta: int) -> Fn<int,int,[]> rev 1
  emits []
  tests
    plus(3) => Ok(fnref data__add(delta = 3))
    minus(-3) => Ok(fnref data__add(delta = -3))
  match call data__factory(delta)
    given
      plus => [exchange args (delta = 3) outcome Ok(fnref data__add(delta = 3))]
      minus => [exchange args (delta = -3) outcome Ok(fnref data__add(delta = -3))]
    on Ok r => forward r

fn use__factory(delta: int, value: int) -> int rev 1
  emits []
  tests
    plus(3, 7) => Ok(10)
    minus(-3, 7) => Ok(4)
  match call use__factory_relay(delta)
    on Ok f => forward call use__apply_int(f.value, value)
