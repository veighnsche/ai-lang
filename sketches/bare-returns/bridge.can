mod bridge
  provides [bridge__int, bridge__str, bridge__bool, bridge__dec, bridge__token, bridge__bytes, bridge__rows, bridge__choice, bridge__local]
  uses [Data__Token@1, Data__Row@1, Data__Choice@1]
  emits [bridge.denied]

error bridge.denied()

extern bridge__int(allow: bool) -> int rev 1
  emits [bridge.denied]

extern bridge__str() -> str rev 1
  emits []

extern bridge__bool() -> bool rev 1
  emits []

extern bridge__dec() -> dec rev 1
  emits []

extern bridge__token() -> Data__Token rev 1
  emits []

extern bridge__bytes() -> Bytes rev 1
  emits []

extern bridge__rows() -> Seq<Data__Row> rev 1
  emits []

extern bridge__choice(some: bool) -> Data__Choice<int> rev 1
  emits []

fn bridge__local() -> Bytes rev 1
  emits []
  tests
    full() => Ok(Bytes(Seq<int>[0, 255]))
  match call bridge__bytes()
    given
      full => [exchange args () outcome Ok(Bytes(Seq<int>[0, 255]))]
    on Ok r => forward r
