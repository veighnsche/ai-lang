// broken-login/unknown-emits.ail — DEMO: red squiggle, a manifest naming nothing.
// auth.stale sits in emits but no error auth.stale is declared anywhere.
// Unrealized entries are a conservative upper bound (a12) and compile clean;
// only undeclared entries are refused.

mod auth
  provides [auth__promise, Auth__Promise]
  uses [db__get@1, Db__User@1]
  emits [auth.bad]

error auth.bad()

type Auth__Promise rev 1 (
  id: str
)

fn auth__promise(id: str) -> Auth__Promise rev 1
  emits [auth.bad, auth.stale]
  tests
    happy(id = "u_01") => Ok(id = "u_01")
    missing(id = "u_99") => auth.bad()
    down(id = "u_01") => auth.bad()
=
  match call db__get(id)
    given
      happy => [exchange args (id = "u_01") outcome Ok(id = "u_01", pw_hash = "s", failed_attempts = 0)]
      missing => [exchange args (id = "u_99") outcome db.user_not_found(id = "u_99")]
      down => [exchange args (id = "u_01") outcome db.down()]
    on db.user_not_found _ => auth.bad()
    on db.down _ => auth.bad()
    on Ok u => Ok(id = u.id)
