// broken-login/foreign-raise.can — DEMO: red squiggle, raising outside emits.
// The down arm forwards db.down, but the function only declares auth.bad.

mod auth
  provides [auth__leak, Auth__Leak]
  uses [db__get@1, Db__User@1]
  emits [auth.bad]

error auth.bad()

type Auth__Leak rev 1 (
  id: str
)

fn auth__leak(id: str) -> Auth__Leak rev 1
  emits [auth.bad]
  tests
    happy(id = "u_01") => Ok(id = "u_01")
    missing(id = "u_99") => auth.bad()
    down(id = "u_01") => db.down()
=
  match call db__get(id)
    given
      happy => [exchange args (id = "u_01") outcome Ok(id = "u_01", pw_hash = "s", failed_attempts = 0)]
      missing => [exchange args (id = "u_99") outcome db.user_not_found(id = "u_99")]
      down => [exchange args (id = "u_01") outcome db.down()]
    on db.user_not_found _ => auth.bad()
    on db.down _ => db.down()
    on Ok u => Ok(id = u.id)
