// broken-login/unknown-call.can — DEMO: red squiggle, calling the void.
// db__nope names no function anywhere, so the match can never run.

mod auth
  provides [auth__void, Auth__Void]
  uses [db__get@1, Db__User@1]
  emits [auth.bad]

error auth.bad()

type Auth__Void rev 1 (
  id: str
)

fn auth__void(id: str) -> Auth__Void rev 1
  emits []
  tests
    happy(id = "u_01") => Ok(id = "u_01")
  match call db__nope(id)
    given
      happy => [exchange args (id = "u_01") outcome Ok(id = "u_01", pw_hash = "s", failed_attempts = 0)]
    on Ok u => Ok(id = u.id)
