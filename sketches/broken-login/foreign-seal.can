// broken-login/foreign-seal.can — DEMO: red squiggle, executable code
// mints a foreign brand. Db__Hash is declared in db.can, so sealing it
// in this body is forgery (CAN6004): bodies seal only their own
// module's brands. The same seal in the test row below is checked
// data, not code, and stays clean.

mod auth
  provides [auth__forge, Auth__Sealed]
  uses [Db__Hash@1]
  emits []

type Auth__Sealed rev 1 (
  token: Db__Hash
)

fn auth__forge() -> Auth__Sealed rev 1
  emits []
  tests
    forge() => Ok(token = seal Db__Hash("minted"))
  Ok(token = seal Db__Hash("minted"))
