// broken-login/incomplete-expectation.can — DEMO: red squiggle, a kind
// without its payload. Error expectations must construct the complete
// error value (a12): a bare kind proves nothing about the payload.

mod auth
  provides [auth__need, Auth__Need]
  uses [db__get@1, Db__User@1]
  emits [auth.bad]

error auth.bad()

type Auth__Need rev 1 (
  id: str
)

fn auth__need(id: str) -> Auth__Need rev 1
  emits [auth.bad]
  tests
    ok(id = "u") => Ok(id = "u")
    missing(id = "x") => auth.bad()
    down(id = "u") => auth.bad
=
  match call db__get(id)
    given
      ok => [exchange args (id = "u") outcome Ok(id = "u", pw_hash = "s", failed_attempts = 0)]
      missing => [exchange args (id = "x") outcome db.user_not_found(id = "x")]
      down => [exchange args (id = "u") outcome db.down()]
    on db.user_not_found _ => auth.bad()
    on db.down _ => auth.bad()
    on Ok u => Ok(id = u.id)
