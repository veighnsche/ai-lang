// broken-login/missing-tests.can — DEMO: yellow squiggle, no tests shipped.
// Every function must carry its decision table. This one doesn't.

mod auth
  provides [auth__bare, Auth__Bare]
  uses [db__get@1, Db__User@1]
  emits [auth.bad]

error auth.bad()

type Auth__Bare rev 1 (
  id: str
)

fn auth__bare(id: str) -> Auth__Bare rev 1
  emits [auth.bad]
=
  match call db__get(id)
    given
      happy => [exchange args (id = "u_01") outcome Ok(id = "u_01", pw_hash = "s", failed_attempts = 0)]
    on db.user_not_found _ => auth.bad()
    on db.down _ => auth.bad()
    on Ok u => Ok(id = u.id)
