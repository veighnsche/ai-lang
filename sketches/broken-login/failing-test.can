// broken-login/failing-test.can — DEMO: red squiggle, a test fails at build.
// The missing-user case claims Ok but the code raises auth.bad.

mod auth
  provides [auth__wrong, Auth__Wrong]
  uses [db__get@1, Db__User@1]
  emits [auth.bad]

error auth.bad()

type Auth__Wrong rev 1 (
  id: str
)

fn auth__wrong(id: str) -> Auth__Wrong rev 1
  emits [auth.bad]
  tests
    happy(id = "u_01") => Ok(id = "u_01")
    missing(id = "u_99") => Ok(id = "u_99")
=
  match call db__get(id)
    given
      happy => [exchange args (id = "u_01") outcome Ok(id = "u_01", pw_hash = "s", failed_attempts = 0)]
      missing => [exchange args (id = "u_99") outcome db.user_not_found(id = "u_99")]
    on db.user_not_found _ => auth.bad()
    on db.down _ => auth.bad()
    on Ok u => Ok(id = u.id)
