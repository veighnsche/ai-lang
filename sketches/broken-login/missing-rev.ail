// broken-login/missing-rev.ail — DEMO: red squiggle, versioning missing.
// Every type and function carries rev N. This one doesn't.

mod auth
  provides [auth__unrev, Auth__Unrev]
  uses [db__get@1, Db__User@1]
  emits [auth.bad]

error auth.bad()

type Auth__Unrev rev 1 (
  id: str
)

fn auth__unrev(id: str) -> Auth__Unrev
  emits [auth.bad]
  tests
    happy(id = "u_01") => Ok(id = "u_01")
=
  match call db__get(id)
    given
      happy => [exchange args (id = "u_01") outcome Ok(id = "u_01", pw_hash = "s", failed_attempts = 0)]
    on db.user_not_found _ => auth.bad()
    on db.down _ => auth.bad()
    on Ok u => Ok(id = u.id)
