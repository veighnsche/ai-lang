// broken-login/missing-arm.ail — DEMO: red squiggle, match not exhaustive.
// The db.down outcome has no arm, so the retry path is unhandled.

mod auth
  provides [auth__partial, Auth__Partial]
  uses [db__get@1, Db__User@1]
  emits [auth.bad]

error auth.bad()

type Auth__Partial rev 1 (
  id: str
)

fn auth__partial(id: str) -> Auth__Partial rev 1
  emits [auth.bad]
  tests
    happy(id = "u_01") => Ok(id = "u_01")
    down(id = "u_01") => auth.bad()
=
  match call db__get(id)
    given
      happy => [exchange args (id = "u_01") outcome Ok(id = "u_01", pw_hash = "s", failed_attempts = 0)]
      down => [exchange args (id = "u_01") outcome db.down()]
    on db.user_not_found _ => auth.bad()
    on Ok u => Ok(id = u.id)
