// broken-login/missing-exchange.ail — DEMO: red squiggle, a response
// without its request. Every script row is an exchange binding
// expected call args to one permitted outcome (a12): outcome-only
// rows prove nothing about what was asked.

mod auth
  provides [auth__ask, Auth__Ask]
  uses [db__get@1, Db__User@1]
  emits [auth.bad]

error auth.bad()

type Auth__Ask rev 1 (
  id: str
)

fn auth__ask(id: str) -> Auth__Ask rev 1
  emits [auth.bad]
  tests
    ok(id = "u") => Ok(id = "u")
    missing(id = "x") => auth.bad()
    down(id = "u") => auth.bad()
=
  match call db__get(id)
    given
      ok => [exchange args (id = "u") outcome Ok(id = "u", pw_hash = "s", failed_attempts = 0)]
      missing => [exchange args (id = "x") outcome db.user_not_found(id = "x")]
      down => [db.down()]
    on db.user_not_found _ => auth.bad()
    on db.down _ => auth.bad()
    on Ok u => Ok(id = u.id)
