mod use
  provides [use__number, use__text, Use__Number, Use__Text]
  uses [Option__Value@1, option__value_or@1]
  emits []

type Use__Number rev 1 (
  value: int
)

type Use__Text rev 1 (
  value: str
)

fn use__number(value: Option__Value<int>) -> Use__Number rev 1
  emits []
  tests
    some_int(Option__Some<int>(7)) => Ok(7)
    none_int(Option__None<int>()) => Ok(9)
  match call option__value_or<int>(value, 9)
    given
      some_int => [exchange args (value = Option__Some<int>(7), alternative = 9) outcome Ok(7)]
      none_int => [exchange args (value = Option__None<int>(), alternative = 9) outcome Ok(9)]
    on Ok r => Ok(r.value)

fn use__text(value: Option__Value<str>) -> Use__Text rev 1
  emits []
  tests
    some_str(Option__Some<str>("present")) => Ok("present")
    none_str(Option__None<str>()) => Ok("fallback")
  match value
    on Option__Some<str> s => Ok(s.value)
    on Option__None<str> _ => Ok("fallback")
