mod use
  provides [Use__Bound, Use__Report, use__apply, use__bind, use__go, use__relay, use__checked, use__recover, use__report, use__sugar, use__classify]
  uses [scalar__identity@1, scalar__add@1, scalar__positive@1, scalar__twice@1, scalar__checked@1]
  emits [scalar.negative]

error scalar.negative(value: int)

type Use__Bound rev 1 (
  cb: Fn<int, int, []>
)

type Use__Report rev 1 (
  positive: bool
)

fn use__apply<A, R>(cb: Fn<A, R, []>, value: A) -> R rev 1
  emits []
  tests
    integer<A=int, R=int>(fnref scalar__identity<int>(), 7) => Ok(7)
    text<A=str, R=str>(fnref scalar__identity<str>(), "hello") => Ok("hello")
    boolean<A=bool, R=bool>(fnref scalar__identity<bool>(), false) => Ok(false)
    decimal<A=dec, R=dec>(fnref scalar__twice(), d"0.125") => Ok(d"0.25")
    predicate<A=int, R=bool>(fnref scalar__positive(), 7) => Ok(true)
    captured<A=int, R=int>(fnref scalar__add(delta = 3), 7) => Ok(10)
  match invoke cb with value
    on Ok r => forward r

fn use__bind(delta: int) -> Use__Bound rev 1
  emits []
  tests
    plus(3) => Ok(fnref scalar__add(delta = 3))
    minus(-3) => Ok(fnref scalar__add(delta = -3))
  Ok(fnref scalar__add(delta = delta))

fn use__go(delta: int, value: int) -> int rev 1
  emits []
  tests
    plus(3, 7) => Ok(10)
    minus(-3, 7) => Ok(4)
  match call use__bind(delta)
    on Ok bound => match call use__apply<int, int>(bound.cb, value)
      on Ok r => forward r

fn use__relay(value: int) -> int rev 1
  emits [scalar.negative]
  tests
    yes(7) => Ok(7)
    no(-3) => scalar.negative(-3)
  match call scalar__checked(value)
    given
      yes => [exchange args (value = 7) outcome Ok(7)]
      no => [exchange args (value = -3) outcome scalar.negative(-3)]
    on Ok r => forward r
    on scalar.negative e => forward e

fn use__checked(cb: Fn<int, int, [scalar.negative]>, value: int) -> int rev 1
  emits [scalar.negative]
  tests
    yes(fnref scalar__checked(), 7) => Ok(7)
    no(fnref scalar__checked(), -3) => scalar.negative(-3)
  match invoke cb with value
    on Ok r => forward r
    on scalar.negative e => forward e

fn use__recover(cb: Fn<int, int, [scalar.negative]>, value: int) -> int rev 1
  emits []
  tests
    yes(fnref scalar__checked(), 7) => Ok(7)
    no(fnref scalar__checked(), -3) => Ok(0)
  match invoke cb with value
    on Ok r => Ok(r.value)
    on scalar.negative e => Ok(e.value + 3)

fn use__report(value: int) -> Use__Report rev 1
  emits []
  tests
    yes(7) => Ok(true)
    no(0) => Ok(false)
  match call scalar__positive(value)
    given
      yes => [exchange args (value = 7) outcome Ok(true)]
      no => [exchange args (value = 0) outcome Ok(false)]
    on Ok r => Ok(r.value)

fn use__classify(cb: Fn<int, bool, []>, value: int) -> str rev 1
  emits []
  tests
    yes(fnref scalar__positive(), 7) => Ok("positive")
    no(fnref scalar__positive(), 0) => Ok("not positive")
  match invoke cb with value
    on Ok r => match r.value
      true => Ok("positive")
      false => Ok("not positive")

fn use__sugar(value: int) -> int rev 1
  emits [scalar.negative]
  tests
    yes(7) => Ok(7)
    no(-3) => scalar.negative(-3)
  match value
    _ => forward call use__relay(value)
