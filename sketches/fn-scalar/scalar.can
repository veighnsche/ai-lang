mod scalar
  provides [scalar__identity, scalar__add, scalar__positive, scalar__twice, scalar__checked]
  uses []
  emits [scalar.negative]

error scalar.negative(value: int)

fn scalar__identity<T>(value: T) -> T rev 1
  emits []
  tests
    integer<T=int>(7) => Ok(7)
    big<T=int>(9007199254740993) => Ok(9007199254740993)
    text<T=str>("hello") => Ok("hello")
    empty<T=str>("") => Ok("")
    yes<T=bool>(true) => Ok(true)
    no<T=bool>(false) => Ok(false)
    decimal<T=dec>(d"1.25") => Ok(d"1.25")
    negative<T=dec>(d"-0.125") => Ok(d"-0.125")
  Ok(value)

fn scalar__add(delta: int, value: int) -> int rev 1
  emits []
  tests
    plus(3, 7) => Ok(10)
    minus(-3, 7) => Ok(4)
    big(1, 9007199254740993) => Ok(9007199254740994)
  Ok(value + delta)

fn scalar__positive(value: int) -> bool rev 1
  emits []
  tests
    yes(7) => Ok(true)
    no(0) => Ok(false)
  Ok(value > 0)

fn scalar__twice(value: dec) -> dec rev 1
  emits []
  tests
    fraction(d"0.125") => Ok(d"0.25")
    negative(d"-2.5") => Ok(d"-5.0")
  Ok(value + value)

fn scalar__checked(value: int) -> int rev 1
  emits [scalar.negative]
  tests
    yes(7) => Ok(value = 7)
    zero(0) => Ok(0)
    no(-3) => scalar.negative(-3)
  match value < 0
    true => scalar.negative(value)
    false => Ok(value)
