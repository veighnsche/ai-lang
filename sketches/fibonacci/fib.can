// fibonacci/fib.can — Fibonacci without a loop: fib__at guards the
// domain (negatives are a declared error, not a hang) and fib__from
// walks down one proven self-call per step, carrying both accumulators
// so the decreases proof is a single unit step on n (a11). Same-file
// helper, so no call-site given (a07).

mod fib
  provides [fib__at, fib__from, Fib__Value]
  uses []
  emits [fib.negative_input]

error fib.negative_input(value: int)

type Fib__Value rev 1 (
  value: int
)

fn fib__at(n: int) -> Fib__Value rev 1
  emits [fib.negative_input]
  tests
    zero(0) => Ok(value = 0)
    one(1) => Ok(value = 1)
    two(2) => Ok(value = 1)
    ten(10) => Ok(value = 55)
    negative(-3) => fib.negative_input(value = -3)
  match n < 0
    true => fib.negative_input(value = n)
    false => match call fib__from(n, 0, 1)
      on Ok r => Ok(value = r.value)

fn fib__from(n: int, a: int, b: int) -> Fib__Value rev 1
  decreases n
  emits []
  tests
    base(0, 5, 8) => Ok(value = 5)
    one_left(1, 3, 5) => Ok(value = 5)
    step(2, 2, 3) => Ok(value = 5)
  match n <= 0
    true => Ok(value = a)
    false => match call fib__from(n - 1, b, a + b)
      on Ok r => Ok(value = r.value)
