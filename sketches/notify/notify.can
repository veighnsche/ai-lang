// sketches/notify/notify.can — S2b third consumer: a notification
// desk admitting dispatch requests against a program-owned policy.
// Built on the S2a closed check ops (docs/a91-schema-s2-design.md):
// the validator binds one check per field and forwards check
// outcomes unchanged — no reconstruction arms, no converter
// calls, no producer kinds. Field order stays this program's
// chain; the checks own every triple they raise.

mod notify
  provides [notify__request__validate, notify__request__admit, Notify__Request, Notify__RequestSchema, Notify__RequestValue, Notify__Confirmation]
  uses [std__validate__length_check@1, std__validate__range_check@1, std__validate__membership_check@1, Validate__Length@1, Validate__Range@1, Validate__Membership@1]
  emits [validation.schema_violation]

error validation.schema_violation(path: str, rule: str, value: str)

type Notify__Request rev 1 (
  handle: str
  retries: int
  channel: str
)

type Notify__RequestSchema rev 1 (
  handle_minimum: int
  handle_maximum: int
  retries_lower: int
  retries_upper: int
  allowed_channels: Seq<str>
)

type Notify__RequestValue rev 1 (
  value: Notify__Request
)

type Notify__Confirmation rev 1 (
  handle: str
  retries: int
  channel: str
)

// Fail-fast order is this program's chain (length, then range,
// then membership); everything inside one check — including the
// minimum-nonnegative precheck — belongs to the check op.
fn notify__request__validate(request: Notify__Request, schema: Notify__RequestSchema) -> Notify__RequestValue rev 1
  emits [validation.schema_violation]
  tests
    ok(Notify__Request("sam", 2, "email"), Notify__RequestSchema(3, 16, 0, 5, Seq<str>["email", "sms"])) => Ok(Notify__Request("sam", 2, "email"))
    handle_short(Notify__Request("ab", 2, "email"), Notify__RequestSchema(3, 16, 0, 5, Seq<str>["email", "sms"])) => validation.schema_violation("handle", "str.length_scalars", "ab")
    handle_long(Notify__Request("abcdefghijklmnopq", 2, "email"), Notify__RequestSchema(3, 16, 0, 5, Seq<str>["email", "sms"])) => validation.schema_violation("handle", "str.length_scalars", "abcdefghijklmnopq")
    handle_min_negative(Notify__Request("sam", 2, "email"), Notify__RequestSchema(-1, 16, 0, 5, Seq<str>["email", "sms"])) => validation.schema_violation("", "schema.handle_minimum", "-1")
    handle_bounds(Notify__Request("sam", 2, "email"), Notify__RequestSchema(9, 4, 0, 5, Seq<str>["email", "sms"])) => validation.schema_violation("", "schema.handle_bounds", "minimum=9;maximum=4")
    retries_below(Notify__Request("sam", -1, "email"), Notify__RequestSchema(3, 16, 0, 5, Seq<str>["email", "sms"])) => validation.schema_violation("retries", "int.closed_range", "-1")
    retries_above(Notify__Request("sam", 6, "email"), Notify__RequestSchema(3, 16, 0, 5, Seq<str>["email", "sms"])) => validation.schema_violation("retries", "int.closed_range", "6")
    retries_bounds(Notify__Request("sam", 2, "email"), Notify__RequestSchema(3, 16, 4, 1, Seq<str>["email", "sms"])) => validation.schema_violation("", "schema.retries_bounds", "lower=4;upper=1")
    channel_bad(Notify__Request("sam", 2, "push"), Notify__RequestSchema(3, 16, 0, 5, Seq<str>["email", "sms"])) => validation.schema_violation("channel", "str.one_of", "push")
    handle_beats_policy(Notify__Request("ab", 2, "email"), Notify__RequestSchema(3, 16, 4, 1, Seq<str>["email", "sms"])) => validation.schema_violation("handle", "str.length_scalars", "ab")
    handle_beats_retries(Notify__Request("ab", 99, "email"), Notify__RequestSchema(3, 16, 0, 5, Seq<str>["email", "sms"])) => validation.schema_violation("handle", "str.length_scalars", "ab")
    retries_beats_channel(Notify__Request("sam", 99, "push"), Notify__RequestSchema(3, 16, 0, 5, Seq<str>["email", "sms"])) => validation.schema_violation("retries", "int.closed_range", "99")
    handle_min_edge(Notify__Request("amy", 2, "email"), Notify__RequestSchema(3, 16, 0, 5, Seq<str>["email", "sms"])) => Ok(Notify__Request("amy", 2, "email"))
    handle_max_edge(Notify__Request("abcdefghijklmnop", 2, "email"), Notify__RequestSchema(3, 16, 0, 5, Seq<str>["email", "sms"])) => Ok(Notify__Request("abcdefghijklmnop", 2, "email"))
    retries_low_edge(Notify__Request("sam", 0, "email"), Notify__RequestSchema(3, 16, 0, 5, Seq<str>["email", "sms"])) => Ok(Notify__Request("sam", 0, "email"))
    retries_high_edge(Notify__Request("sam", 5, "sms"), Notify__RequestSchema(3, 16, 0, 5, Seq<str>["email", "sms"])) => Ok(Notify__Request("sam", 5, "sms"))
    unicode_ok(Notify__Request("héllo世界ab12", 2, "email"), Notify__RequestSchema(3, 16, 0, 5, Seq<str>["email", "sms"])) => Ok(Notify__Request("héllo世界ab12", 2, "email"))
    bigint(Notify__Request("sam", -9007199254740993, "email"), Notify__RequestSchema(3, 16, 0, 5, Seq<str>["email", "sms"])) => validation.schema_violation("retries", "int.closed_range", "-9007199254740993")
    channels_empty(Notify__Request("sam", 2, "email"), Notify__RequestSchema(3, 16, 0, 5, Seq<str>[])) => validation.schema_violation("channel", "str.one_of", "email")
    channel_case(Notify__Request("sam", 2, "Email"), Notify__RequestSchema(3, 16, 0, 5, Seq<str>["email", "sms"])) => validation.schema_violation("channel", "str.one_of", "Email")
    ws_preserved(Notify__Request(" ab ", 2, "email"), Notify__RequestSchema(3, 16, 0, 5, Seq<str>["email", "sms"])) => Ok(Notify__Request(" ab ", 2, "email"))
  match call std__validate__length_check(request.handle, Validate__Length("handle", "handle", schema.handle_minimum, schema.handle_maximum))
    given
      ok => [exchange args (value = "sam", constraint = Validate__Length("handle", "handle", 3, 16)) outcome Ok("sam")]
      handle_short => [exchange args (value = "ab", constraint = Validate__Length("handle", "handle", 3, 16)) outcome validation.schema_violation(path = "handle", rule = "str.length_scalars", value = "ab")]
      handle_long => [exchange args (value = "abcdefghijklmnopq", constraint = Validate__Length("handle", "handle", 3, 16)) outcome validation.schema_violation(path = "handle", rule = "str.length_scalars", value = "abcdefghijklmnopq")]
      handle_min_negative => [exchange args (value = "sam", constraint = Validate__Length("handle", "handle", -1, 16)) outcome validation.schema_violation(path = "", rule = "schema.handle_minimum", value = "-1")]
      handle_bounds => [exchange args (value = "sam", constraint = Validate__Length("handle", "handle", 9, 4)) outcome validation.schema_violation(path = "", rule = "schema.handle_bounds", value = "minimum=9;maximum=4")]
      retries_below => [exchange args (value = "sam", constraint = Validate__Length("handle", "handle", 3, 16)) outcome Ok("sam")]
      retries_above => [exchange args (value = "sam", constraint = Validate__Length("handle", "handle", 3, 16)) outcome Ok("sam")]
      retries_bounds => [exchange args (value = "sam", constraint = Validate__Length("handle", "handle", 3, 16)) outcome Ok("sam")]
      channel_bad => [exchange args (value = "sam", constraint = Validate__Length("handle", "handle", 3, 16)) outcome Ok("sam")]
      handle_beats_policy => [exchange args (value = "ab", constraint = Validate__Length("handle", "handle", 3, 16)) outcome validation.schema_violation(path = "handle", rule = "str.length_scalars", value = "ab")]
      handle_beats_retries => [exchange args (value = "ab", constraint = Validate__Length("handle", "handle", 3, 16)) outcome validation.schema_violation(path = "handle", rule = "str.length_scalars", value = "ab")]
      retries_beats_channel => [exchange args (value = "sam", constraint = Validate__Length("handle", "handle", 3, 16)) outcome Ok("sam")]
      handle_min_edge => [exchange args (value = "amy", constraint = Validate__Length("handle", "handle", 3, 16)) outcome Ok("amy")]
      handle_max_edge => [exchange args (value = "abcdefghijklmnop", constraint = Validate__Length("handle", "handle", 3, 16)) outcome Ok("abcdefghijklmnop")]
      retries_low_edge => [exchange args (value = "sam", constraint = Validate__Length("handle", "handle", 3, 16)) outcome Ok("sam")]
      retries_high_edge => [exchange args (value = "sam", constraint = Validate__Length("handle", "handle", 3, 16)) outcome Ok("sam")]
      unicode_ok => [exchange args (value = "héllo世界ab12", constraint = Validate__Length("handle", "handle", 3, 16)) outcome Ok("héllo世界ab12")]
      bigint => [exchange args (value = "sam", constraint = Validate__Length("handle", "handle", 3, 16)) outcome Ok("sam")]
      channels_empty => [exchange args (value = "sam", constraint = Validate__Length("handle", "handle", 3, 16)) outcome Ok("sam")]
      channel_case => [exchange args (value = "sam", constraint = Validate__Length("handle", "handle", 3, 16)) outcome Ok("sam")]
      ws_preserved => [exchange args (value = " ab ", constraint = Validate__Length("handle", "handle", 3, 16)) outcome Ok(" ab ")]
      admitted => [exchange args (value = "sam", constraint = Validate__Length("handle", "handle", 3, 16)) outcome Ok("sam")]
      rejected => [exchange args (value = "ab", constraint = Validate__Length("handle", "handle", 3, 16)) outcome validation.schema_violation(path = "handle", rule = "str.length_scalars", value = "ab")]
    on validation.schema_violation e => forward e
    on Ok _ => match call std__validate__range_check(request.retries, Validate__Range("retries", "retries", schema.retries_lower, schema.retries_upper))
      given
        ok => [exchange args (value = 2, constraint = Validate__Range("retries", "retries", 0, 5)) outcome Ok(2)]
        retries_below => [exchange args (value = -1, constraint = Validate__Range("retries", "retries", 0, 5)) outcome validation.schema_violation(path = "retries", rule = "int.closed_range", value = "-1")]
        retries_above => [exchange args (value = 6, constraint = Validate__Range("retries", "retries", 0, 5)) outcome validation.schema_violation(path = "retries", rule = "int.closed_range", value = "6")]
        retries_bounds => [exchange args (value = 2, constraint = Validate__Range("retries", "retries", 4, 1)) outcome validation.schema_violation(path = "", rule = "schema.retries_bounds", value = "lower=4;upper=1")]
        channel_bad => [exchange args (value = 2, constraint = Validate__Range("retries", "retries", 0, 5)) outcome Ok(2)]
        retries_beats_channel => [exchange args (value = 99, constraint = Validate__Range("retries", "retries", 0, 5)) outcome validation.schema_violation(path = "retries", rule = "int.closed_range", value = "99")]
        handle_min_edge => [exchange args (value = 2, constraint = Validate__Range("retries", "retries", 0, 5)) outcome Ok(2)]
        handle_max_edge => [exchange args (value = 2, constraint = Validate__Range("retries", "retries", 0, 5)) outcome Ok(2)]
        retries_low_edge => [exchange args (value = 0, constraint = Validate__Range("retries", "retries", 0, 5)) outcome Ok(0)]
        retries_high_edge => [exchange args (value = 5, constraint = Validate__Range("retries", "retries", 0, 5)) outcome Ok(5)]
        unicode_ok => [exchange args (value = 2, constraint = Validate__Range("retries", "retries", 0, 5)) outcome Ok(2)]
        bigint => [exchange args (value = -9007199254740993, constraint = Validate__Range("retries", "retries", 0, 5)) outcome validation.schema_violation(path = "retries", rule = "int.closed_range", value = "-9007199254740993")]
        channels_empty => [exchange args (value = 2, constraint = Validate__Range("retries", "retries", 0, 5)) outcome Ok(2)]
        channel_case => [exchange args (value = 2, constraint = Validate__Range("retries", "retries", 0, 5)) outcome Ok(2)]
        ws_preserved => [exchange args (value = 2, constraint = Validate__Range("retries", "retries", 0, 5)) outcome Ok(2)]
        admitted => [exchange args (value = 2, constraint = Validate__Range("retries", "retries", 0, 5)) outcome Ok(2)]
      on validation.schema_violation e => forward e
      on Ok _ => match call std__validate__membership_check(request.channel, Validate__Membership("channel", schema.allowed_channels))
        given
          ok => [exchange args (value = "email", constraint = Validate__Membership("channel", Seq<str>["email", "sms"])) outcome Ok("email")]
          channel_bad => [exchange args (value = "push", constraint = Validate__Membership("channel", Seq<str>["email", "sms"])) outcome validation.schema_violation(path = "channel", rule = "str.one_of", value = "push")]
          handle_min_edge => [exchange args (value = "email", constraint = Validate__Membership("channel", Seq<str>["email", "sms"])) outcome Ok("email")]
          handle_max_edge => [exchange args (value = "email", constraint = Validate__Membership("channel", Seq<str>["email", "sms"])) outcome Ok("email")]
          retries_low_edge => [exchange args (value = "email", constraint = Validate__Membership("channel", Seq<str>["email", "sms"])) outcome Ok("email")]
          retries_high_edge => [exchange args (value = "sms", constraint = Validate__Membership("channel", Seq<str>["email", "sms"])) outcome Ok("sms")]
          unicode_ok => [exchange args (value = "email", constraint = Validate__Membership("channel", Seq<str>["email", "sms"])) outcome Ok("email")]
          channels_empty => [exchange args (value = "email", constraint = Validate__Membership("channel", Seq<str>[])) outcome validation.schema_violation(path = "channel", rule = "str.one_of", value = "email")]
          channel_case => [exchange args (value = "Email", constraint = Validate__Membership("channel", Seq<str>["email", "sms"])) outcome validation.schema_violation(path = "channel", rule = "str.one_of", value = "Email")]
          ws_preserved => [exchange args (value = "email", constraint = Validate__Membership("channel", Seq<str>["email", "sms"])) outcome Ok("email")]
          admitted => [exchange args (value = "email", constraint = Validate__Membership("channel", Seq<str>["email", "sms"])) outcome Ok("email")]
        on validation.schema_violation e => forward e
        on Ok _ => Ok(request)

// Admission stays pure: a rejected request never reaches its
// dispatch ticket, and the whole path executes under linked-pure
// evaluation with no script fallback for the admit step itself.
fn notify__request__admit(request: Notify__Request, schema: Notify__RequestSchema) -> Notify__Confirmation rev 1
  emits [validation.schema_violation]
  tests
    admitted(Notify__Request("sam", 2, "email"), Notify__RequestSchema(3, 16, 0, 5, Seq<str>["email", "sms"])) => Ok("sam", 2, "email")
    rejected(Notify__Request("ab", 2, "email"), Notify__RequestSchema(3, 16, 0, 5, Seq<str>["email", "sms"])) => validation.schema_violation("handle", "str.length_scalars", "ab")
  match call notify__request__validate(request, schema)
    on validation.schema_violation e => forward e
    on Ok v => Ok(v.value.handle, v.value.retries, v.value.channel)
